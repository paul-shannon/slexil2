                <ANNOTATION_VALUE>28.42 ʔakítiː šaktaːtamaá kimpuskáːt .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
