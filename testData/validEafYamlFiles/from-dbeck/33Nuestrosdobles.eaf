    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="ft" PARENT_REF="Totonac" PARTICIPANT="unknown" TIER_ID="Spanish">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2" ANNOTATION_REF="ann1">
                <ANNOTATION_VALUE>hasta la fecha siguen creyendo los totonacos que todos los seres vivientes,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann4" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>cada uno de ellos tiene su doble..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann6" ANNOTATION_REF="ann5">
                <ANNOTATION_VALUE>algunos le nombran " equivalente ( s ) ".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann7">
                <ANNOTATION_VALUE>no se sabe cómo supieron este conocimiento distinto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>cuentan que los antepasados platicaban todo eso en aquel tiempo remoto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann12" ANNOTATION_REF="ann11">
                <ANNOTATION_VALUE>no saben muy bien cómo surgió esta plática en aquel tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann13">
                <ANNOTATION_VALUE>ahora saben todos en la zona totonaca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>allá por mi pueblo se ven siete cerros y les nombran 'siete cerros'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann18" ANNOTATION_REF="ann17">
                <ANNOTATION_VALUE>aquellos cerros solamente se pueden distinguir desde las lomas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann19">
                <ANNOTATION_VALUE>es porque ya están alejados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>se distinguen ya nada más un poco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann24" ANNOTATION_REF="ann23">
                <ANNOTATION_VALUE>tampoco se ven en todo el tiempo, nada más a veces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann25">
                <ANNOTATION_VALUE>se distinguen bien cuando hace muy buen tiempo al atardecer a la hora que apenas está ocultándose el sol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>se les nota claro en sus puntas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann30" ANNOTATION_REF="ann29">
                <ANNOTATION_VALUE>ojalá pudiéramos platicar con dios.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann31">
                <ANNOTATION_VALUE>le preguntábamos ¿cómo andan nuestros dobles por allá en los siete cerros? ¿andarán bien por allá?.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>?no andarán en peligro pobres de ellos ?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann36" ANNOTATION_REF="ann35">
                <ANNOTATION_VALUE>?se estarán llenando bien?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann37">
                <ANNOTATION_VALUE>cuando nos enfermamos, dizque nuestros dobles se enferman por allá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>o nada más los agarran por allá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann42" ANNOTATION_REF="ann41">
                <ANNOTATION_VALUE>no falta lo que les sucede si nosotros no tenemos cuidado de nuestra vida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann43">
                <ANNOTATION_VALUE>si morimos no nada más de repente nos deja dios.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>primero los agarran nuestros dobles por allá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann48" ANNOTATION_REF="ann47">
                <ANNOTATION_VALUE>y ya entonces nosotros empezamos a enfermarnos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann50" ANNOTATION_REF="ann49">
                <ANNOTATION_VALUE>no nos damos cuenta si a nuestros dobles los han agarrado por allá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann52" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>si nos morimos nada más repentinamente, no a cause de alguna enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann54" ANNOTATION_REF="ann53">
                <ANNOTATION_VALUE>nuestros dobles resultan objetos de cacería.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann56" ANNOTATION_REF="ann55">
                <ANNOTATION_VALUE>y nosotros de un momento a otro dejamos de existir en esta vida (mundo).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann58" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>nada más quedan sorprendidos nuestros familiares al vernos acabar nada más en un rato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann60" ANNOTATION_REF="ann59">
                <ANNOTATION_VALUE>aunque todavía andábamos unos momentos antes, después de un poco rato ya habremos tenido otra vida diferente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann62" ANNOTATION_REF="ann61">
                <ANNOTATION_VALUE>es igual como les sucede a los animales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann64" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>en unos cuantos momentos los eliminan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann66" ANNOTATION_REF="ann65">
                <ANNOTATION_VALUE>así nos irá sucediendo igual si no nos valemos de Dios todos los días al amanecer y al anochecer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann68" ANNOTATION_REF="ann67">
                <ANNOTATION_VALUE>si le rogamos seguido, nos perdonará.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann70" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>nada nos pasará nada más repentinamente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann72" ANNOTATION_REF="ann71">
                <ANNOTATION_VALUE>viviremos contentos igualmente como viven los demás nuestros prójimos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann74" ANNOTATION_REF="ann73">
                <ANNOTATION_VALUE>no debemos (culpar) sentimiento de dios si nos pasa cualquier cosa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann76" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>nosotros no tenemos cuidado de nuestra vida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann78" ANNOTATION_REF="ann77">
                <ANNOTATION_VALUE>cuando algo nos va a suceder en un tiempo no lejano, soñamos de ello a tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann80" ANNOTATION_REF="ann79">
                <ANNOTATION_VALUE>no nada más de repente nos toca algo, cuando nos damos cuenta todavía es tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann82" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>no solamente los animales pueden ser nuestros dobles, dizque hay algunos-as (gentes) sus dobles son árboles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann84" ANNOTATION_REF="ann83">
                <ANNOTATION_VALUE>muchos ya han hallado, dizque, árboles en el bosque que (representan) son dobles, no se puede cortar, son muy duros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann86" ANNOTATION_REF="ann85">
                <ANNOTATION_VALUE>cuando alguien trata de cortarlo(s), dizque comienza a sonar mucho por las ramas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann88" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>se asusta quién su cortador, él solo se le retira.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann90" ANNOTATION_REF="ann89">
                <ANNOTATION_VALUE>ya nunca se le acerca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann92" ANNOTATION_REF="ann91">
                <ANNOTATION_VALUE>viene un día ( que ) entre muchos los derriban ..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann94" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>aunque sonara mucho, no le(s) tienen miedo si son muchos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann96" ANNOTATION_REF="ann95">
                <ANNOTATION_VALUE>dizque al momento de derribarse, suena (truena) mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann98" ANNOTATION_REF="ann97">
                <ANNOTATION_VALUE>grita como si fuera un hombre, se oye desde lejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann100" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>por dondequiera escuchan el sonido tronido de aquel árbol-doble.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann102" ANNOTATION_REF="ann101">
                <ANNOTATION_VALUE>cuentan que dizque aquellos de los que andan sus dobles cerca,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann104" ANNOTATION_REF="ann103">
                <ANNOTATION_VALUE>no duran mucho tiempo, los pescan luego y por eso no llegan a ser viejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann106" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>los cazadores se encuentran muy pronto con ellos, ellos no nada más se limitan con verlos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann108" ANNOTATION_REF="ann107">
                <ANNOTATION_VALUE>luego los eliminan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann110" ANNOTATION_REF="ann109">
                <ANNOTATION_VALUE>es el motivo que no es bueno que anden cerca nuestros dobles, no faltan sus enemigos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann112" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>si acaso logran llegar a ser viejos los que andan cerca sus dobles, todo el tiempo andan nada más con miedo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann114" ANNOTATION_REF="ann113">
                <ANNOTATION_VALUE>no pueden andar libremente a la vista.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann116" ANNOTATION_REF="ann115">
                <ANNOTATION_VALUE>todo el tiempo andan nada más en lugares invisibles, nunca se enseñan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann118" ANNOTATION_REF="ann117">
                <ANNOTATION_VALUE>por allá en los 'siete cerros' ya nadie va.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann120" ANNOTATION_REF="ann119">
                <ANNOTATION_VALUE>por eso allá se han juntado todos nuestros dobles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann122" ANNOTATION_REF="ann121">
                <ANNOTATION_VALUE>allá, ya no van los cazadores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann124" ANNOTATION_REF="ann123">
                <ANNOTATION_VALUE>dizque porque lejos hay un monte bosque, no da ganas de internarse (allí)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann126" ANNOTATION_REF="ann125">
                <ANNOTATION_VALUE>dizque nada más ya presenta un aspecto temoroso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann128" ANNOTATION_REF="ann127">
                <ANNOTATION_VALUE>los mismos animales han reinado todos aquellos que han sido reunidos a través de persecución.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann130" ANNOTATION_REF="ann129">
                <ANNOTATION_VALUE>por eso ahora confiados andan por allá y ya no llegan sus perseguidores (hasta allá).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann132" ANNOTATION_REF="ann131">
                <ANNOTATION_VALUE>dizque a los dobles, los hacen agarrar los brujos cuando (éstos) embrujan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann134" ANNOTATION_REF="ann133">
                <ANNOTATION_VALUE>por eso ahora (pueden) hacer enfermar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann136" ANNOTATION_REF="ann135">
                <ANNOTATION_VALUE>otras veces hacen que sean amarrados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann138" ANNOTATION_REF="ann137">
                <ANNOTATION_VALUE>si luego pagan sus vidas (dando ofrendas) a los que son embrujados, no se mueren.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann140" ANNOTATION_REF="ann139">
                <ANNOTATION_VALUE>se los sueltan sus dobles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann142" ANNOTATION_REF="ann141">
                <ANNOTATION_VALUE>ya entonces se salvan (se alivian), no se malacaban (se mueren).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann144" ANNOTATION_REF="ann143">
                <ANNOTATION_VALUE>solamente no se sabe si también allá en los 'siete cerros' andan los pájaros que representan nuestra vida (nuestros dobles).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann146" ANNOTATION_REF="ann145">
                <ANNOTATION_VALUE>dizque ya muchos (varios) brujos son quienes han visto el reflejo (por medio de los espíritus en el sueño) del lugar donde andan nuestros dobles (tabús).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann148" ANNOTATION_REF="ann147">
                <ANNOTATION_VALUE>dizque (por ese medio) no aparecen los pájaros (por allá).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann150" ANNOTATION_REF="ann149">
                <ANNOTATION_VALUE>es posible que no andan ellos por allá con los demás en los 'siete cerros'.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann152" ANNOTATION_REF="ann151">
                <ANNOTATION_VALUE>es probable que estén reunidos en otro monte distinto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann154" ANNOTATION_REF="ann153">
                <ANNOTATION_VALUE>por ahora nadie ha dicho nada todavía , es posible que habrá quién descubra esta plática oculta muy pronto , hasta entonces sabremos ..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann156" ANNOTATION_REF="ann155">
                <ANNOTATION_VALUE>poco a poco se va sabiendo (conociendo) lo que existe entre nosotros en el mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann158" ANNOTATION_REF="ann157">
                <ANNOTATION_VALUE>así ha venido pasando el tiempo desde hace mucho atrás.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann160" ANNOTATION_REF="ann159">
                <ANNOTATION_VALUE>todavía así hasta nuestra presencia (tiempo, época) lentamente van descubriéndose los que existen y los que andan (viven) a la vista donde han sido criados por el dios.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann162" ANNOTATION_REF="ann161">
                <ANNOTATION_VALUE>solamente él sabe porqué los ha creado esos animales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann164" ANNOTATION_REF="ann163">
                <ANNOTATION_VALUE>es posible que sea complemento de nosotros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann166" ANNOTATION_REF="ann165">
                <ANNOTATION_VALUE>dizque cuando surja alguna (una) epidemia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann168" ANNOTATION_REF="ann167">
                <ANNOTATION_VALUE>presienten toda clase de animales (que) en todos los montes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann170" ANNOTATION_REF="ann169">
                <ANNOTATION_VALUE>empiezan a aullar mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann172" ANNOTATION_REF="ann171">
                <ANNOTATION_VALUE>a veces empiezan a andar mordíndose mucho (dentro del monte ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann174" ANNOTATION_REF="ann173">
                <ANNOTATION_VALUE>nada más por dondequiera se escucha que se hacen chillar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann176" ANNOTATION_REF="ann175">
                <ANNOTATION_VALUE>también se escucha con frecuencia que se corretean piedras al andar rodando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann178" ANNOTATION_REF="ann177">
                <ANNOTATION_VALUE>cuando escuchan así de aquellos animeles, luego se sabe que no tardará para que comience una epidemia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann180" ANNOTATION_REF="ann179">
                <ANNOTATION_VALUE>también seguido forma su casa el sol (un arco iris a su alrededor).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann182" ANNOTATION_REF="ann181">
                <ANNOTATION_VALUE>también nada más por dondequiera se paran de repente los arcos iris, por las mañanas, en las tardes, y en las noches.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann184" ANNOTATION_REF="ann183">
                <ANNOTATION_VALUE>también así aunque sea ella la luna, también todos los días se le forma su casa (se le forma un arco iris a su alrededor).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann186" ANNOTATION_REF="ann185">
                <ANNOTATION_VALUE>por muchas cosas se sabe que se está acercando cuando empiece el tiempo de muerte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann188" ANNOTATION_REF="ann187">
                <ANNOTATION_VALUE>cuando se acabe todo mundo toda la gente dizque sin temor vendrán a hablarnos los animales a los pueblos, encontrándose ya con llantos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann190" ANNOTATION_REF="ann189">
                <ANNOTATION_VALUE>algunos dicen (cuentan) que se saldrán del monte nada más por miedo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann192" ANNOTATION_REF="ann191">
                <ANNOTATION_VALUE>y otros cuentan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann194" ANNOTATION_REF="ann193">
                <ANNOTATION_VALUE>vienen porque empiezan a poder hablar, ya pueden expresar sus pensamientos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann196" ANNOTATION_REF="ann195">
                <ANNOTATION_VALUE>por eso se meten entre (las gentes) en las casas, comienzan a platicar con quién sea cualquiera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann198" ANNOTATION_REF="ann197">
                <ANNOTATION_VALUE>así como andan en el monte y no se cambian de cuerpo para venir al pueblo (en las casas).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann200" ANNOTATION_REF="ann199">
                <ANNOTATION_VALUE>es probable (que) así les dan ese trato que hablen cuando todo mundo se acaba (los seres vivos se acaban totalmente).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann202" ANNOTATION_REF="ann201">
                <ANNOTATION_VALUE>debido que solamente hay un solo dios quién nos está protegiendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann204" ANNOTATION_REF="ann203">
                <ANNOTATION_VALUE>también él mismo los está protegiendo a ellos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann206" ANNOTATION_REF="ann205">
                <ANNOTATION_VALUE>vienen a resultar como si fueran nuestros prójimos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann208" ANNOTATION_REF="ann207">
                <ANNOTATION_VALUE>dizque así dicen en sus pláticas cuando vienen al pueblo (a las casas).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann210" ANNOTATION_REF="ann209">
                <ANNOTATION_VALUE>que son nuestros prójimos y no debemos causarles algún daño.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann212" ANNOTATION_REF="ann211">
                <ANNOTATION_VALUE>debemos tratarlos bien ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann214" ANNOTATION_REF="ann213">
                <ANNOTATION_VALUE>mientras no nos lleva todavía el dios quién nos ha traído al mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann216" ANNOTATION_REF="ann215">
                <ANNOTATION_VALUE>y nuestros dobles, dizque no solamente pueden hablar sino que ellos se cambian de cuerpo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann218" ANNOTATION_REF="ann217">
                <ANNOTATION_VALUE>cada quién imita (se parece) exactamente a quién sea su doble.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann220" ANNOTATION_REF="ann219">
                <ANNOTATION_VALUE>también así sus pláticas, nada en absoluto se les pasa, lo imitan exactamente aunque sea su cuerpo imagen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann222" ANNOTATION_REF="ann221">
                <ANNOTATION_VALUE>ya cuando empiezan a cambiarse de cuerpo los dobles, comienzan a dispersarse y se dirigen hacia el origen del doble.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann224" ANNOTATION_REF="ann223">
                <ANNOTATION_VALUE>si se tardan un poco más andando así y no se esfuman pronto (los seres vivientes) ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann226" ANNOTATION_REF="ann225">
                <ANNOTATION_VALUE>tienen tiempo para alcanzar a sus convivientes dobles al lugar de residencia y comenzar a vivir juntos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann228" ANNOTATION_REF="ann227">
                <ANNOTATION_VALUE>es nada más sorprendente ver dos gentes de caras iguales que andan por dondequiera entre las personas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann230" ANNOTATION_REF="ann229">
                <ANNOTATION_VALUE>después no se distinguen cuál (de los dos) había sido el doble.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann232" ANNOTATION_REF="ann231">
                <ANNOTATION_VALUE>se confunden.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann234" ANNOTATION_REF="ann233">
                <ANNOTATION_VALUE>dizque cuando comienza a esfumarse los seres vivientes, no se apartan los animales sino que se revuelven con las gentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann236" ANNOTATION_REF="ann235">
                <ANNOTATION_VALUE>también los pescados comienzan a andar al campo libre cuando se acerca la expirasión ( esfumación de los seres vivos).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann238" ANNOTATION_REF="ann237">
                <ANNOTATION_VALUE>poco a poco empiezan a salirse del agua, comienzan a comer yerbas, ya nunca regresan al agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann240" ANNOTATION_REF="ann239">
                <ANNOTATION_VALUE>en esta forma nos va a suceder cuando llegue el día de nuestra expiración (nos acabemos).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann242" ANNOTATION_REF="ann241">
                <ANNOTATION_VALUE>ni modo que nos opongamos si así dispone el dios de dejarnos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann244" ANNOTATION_REF="ann243">
                <ANNOTATION_VALUE>ya no permita que vivamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann246" ANNOTATION_REF="ann245">
                <ANNOTATION_VALUE>saber que él nos ha creado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann248" ANNOTATION_REF="ann247">
                <ANNOTATION_VALUE>así como a los animales, por eso nos elimina al mismo tiempo cuando así lo dispone de nosotros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann250" ANNOTATION_REF="ann249">
                <ANNOTATION_VALUE>si todavía falta algún tiempo, ya no nos tocará a nosotros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann252" ANNOTATION_REF="ann251">
                <ANNOTATION_VALUE>les tocará a los que vendrán después (a la generación futura).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann254" ANNOTATION_REF="ann253">
                <ANNOTATION_VALUE>si acaso ya no falta mucho tiempo, ?qué vamos a hacer?.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann256" ANNOTATION_REF="ann255">
                <ANNOTATION_VALUE>debemos soportar y sufrir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann258" ANNOTATION_REF="ann257">
                <ANNOTATION_VALUE>ni modo que aquí vivamos eternamente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann260" ANNOTATION_REF="ann259">
                <ANNOTATION_VALUE>todos hemos de ir al otro lado ( otro mundo ) ..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann262" ANNOTATION_REF="ann261">
                <ANNOTATION_VALUE>por aquí parece como si estuviéramos de paso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann264" ANNOTATION_REF="ann263">
                <ANNOTATION_VALUE>allá no es nuestra verdadera casa donde estaremos para siempre, que ya no nos retiraran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann266" ANNOTATION_REF="ann265">
                <ANNOTATION_VALUE>también viviéramos contentos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann268" ANNOTATION_REF="ann267">
                <ANNOTATION_VALUE>no nada más entre tristezas como estamos padeciendo pobres de nosotros en esta vida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann270" ANNOTATION_REF="ann269">
                <ANNOTATION_VALUE>así platican los totonacos cuando recuerdan lo que les platicó sus abuelos en tiempos pasados, o sus abuelas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann272" ANNOTATION_REF="ann271">
                <ANNOTATION_VALUE>todos así les han platicado hace tiempo desde que todavía eran chicos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann274" ANNOTATION_REF="ann273">
                <ANNOTATION_VALUE>cuentan algunos que ya una vez sucedió así hace tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann276" ANNOTATION_REF="ann275">
                <ANNOTATION_VALUE>por eso así aseguraban los ancianos.  Puntuación corregida!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann278" ANNOTATION_REF="ann277">
                <ANNOTATION_VALUE>ellos estaban enterados si era verdad o no lo que contaban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann280" ANNOTATION_REF="ann279">
                <ANNOTATION_VALUE>y otros dicen que ha de haber alguno quién platicó con el dios del cielo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann282" ANNOTATION_REF="ann281">
                <ANNOTATION_VALUE>todo le ha dicho cómo vivimos sobre la tierra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann284" ANNOTATION_REF="ann283">
                <ANNOTATION_VALUE>por eso se supo, si no fuera así,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann286" ANNOTATION_REF="ann285">
                <ANNOTATION_VALUE>nadie sabría qué fin tendríamos más tarde faltando todavía mucho tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann288" ANNOTATION_REF="ann287">
                <ANNOTATION_VALUE>no sabemos para cuándo, nada más nos estamos dando a saber a tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann290" ANNOTATION_REF="ann289">
                <ANNOTATION_VALUE>no se sabe bien si así va a suceder como lo cuentan ya cuando sea de verdad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann292" ANNOTATION_REF="ann291">
                <ANNOTATION_VALUE>ésta plática es de los totonacos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann294" ANNOTATION_REF="ann293">
                <ANNOTATION_VALUE>no se sabe cómo surgió desde hace tiempo muy lejano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann296" ANNOTATION_REF="ann295">
                <ANNOTATION_VALUE>siguen así todavía, aunque sea nada más de cuando en cuando, platicar de aquello.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann298" ANNOTATION_REF="ann297">
                <ANNOTATION_VALUE>yo creo que eso nunca se les va a olvidar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann300" ANNOTATION_REF="ann299">
                <ANNOTATION_VALUE>van a seguir platicándose de eso por más tiempo que se prolongue.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann302" ANNOTATION_REF="ann301">
                <ANNOTATION_VALUE>no se acabará ya la plática que dieron principo aquellos ancianos de aquel tiempo remoto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann304" ANNOTATION_REF="ann303">
                <ANNOTATION_VALUE>los que escuchan ahora en este tiempo esta plática, lo creen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann306" ANNOTATION_REF="ann305">
                <ANNOTATION_VALUE>empiezan a recordar si de repente sucediera efectivamente así como oyen (platicar).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann308" ANNOTATION_REF="ann307">
                <ANNOTATION_VALUE>empiezan a tener temor de ello (del suceso imaginado), no quisieran morirse, estiman sus vidas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann310" ANNOTATION_REF="ann309">
                <ANNOTATION_VALUE>es mayor (la preocupación) si los que escuchan (la plática) están por casarse todavía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann312" ANNOTATION_REF="ann311">
                <ANNOTATION_VALUE>comienzan a suspirar lamentándose, cada rato se acuerdan de lo que han oído (platicar).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann314" ANNOTATION_REF="ann313">
                <ANNOTATION_VALUE>más tarde no pueden olvidarlo, no quisieran de dejar abandonar ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann316" ANNOTATION_REF="ann315">
                <ANNOTATION_VALUE>ni quisieran alejarse desean de donde han puesto sus miradas anteriormente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann318" ANNOTATION_REF="ann317">
                <ANNOTATION_VALUE>nada más porque no reflexionan bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann320" ANNOTATION_REF="ann319">
                <ANNOTATION_VALUE>si se acaba el mundo, nadie se quedará.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann322" ANNOTATION_REF="ann321">
                <ANNOTATION_VALUE>ellos nada más se espantan demasiado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
