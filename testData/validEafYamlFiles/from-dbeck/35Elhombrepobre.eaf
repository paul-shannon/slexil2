        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann250" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>35.125 ʔakšnií čaːnqúːɫ kščikkán , ¢ukuɫwanií špuskáːt čiškuú laːnλáː λawáɫ tuː liːmaqɫtasiyíɫ  ɫuːwaá tamíːn , tuː λawáɫ taːníː kiːčáːɫ .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann252" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>35.126 matnaːɫmaqáːs tawií tamaá čiškúʔ , liːčaːlihtun kún talakšíhɫi .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann254" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>35.127 ʔáɫ ʔaːlakatanuú kčučutsipií taːníː liːpiːkwataá yaːqúː lakλankačikíʔ .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann256" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>35.128 naːɫtamaqapaliːpatáɫ nakškaːčikiín , tunkunhtatampuːštúɫ .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann258" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>35.129 ʔakšnií mátiː čáːɫ tamaá čiškuú kkaːλankačučutsipí , tunkunhtamaːwáɫ λankačikií tuː puːtawí .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann260" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>35.130 niːʔanán tamaqapalíːt laqpalíːɫ štiwilát .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann262" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>35.131 čiː laː šapuːlaná , niːk¢uːšlakapaːstákaa papiːšamaqtám namín kiɫtamakuú ʔakšnií natakaːštiwilá .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann264" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>35.132 liwišaliːmaːšqaqáːn šlamá , waá čiyuú niːtuːk¢uːšliːlakapaːstáka .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann266" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>35.133 čanaška¢íː piːʔaːɫčanaá nalatamaá niːliːwayá , niːkšniikatitampiːtaštúɫ taliːmaːšqaqáːt .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann268" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>35.134 niːtuːšliːka¢íː kahšamaqtám laqčáːɫ tuː šakaːλáːn .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann270" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>35.135 tiːh šlaqapasqúː , šwanqúː piːčanašqaɫapalán , niːkahšaːqɫaqwá .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann272" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>35.136 puːlaá paːtíːɫ taliːmaːšqaqáːt .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann274" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>35.137 ʔaːwanhlaqčáːɫ tuː šakaːλáːn .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann276" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>35.138 waá tiyúːs puːlalíːɫ taːníː kiːmakláɫ ɫuːwaá  tamíːn , papiːniːčanakawá , niːtuːškiːmakláɫ .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="ft" PARENT_REF="Totonac" PARTICIPANT="unknown" TIER_ID="Spanish">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2" ANNOTATION_REF="ann1">
                <ANNOTATION_VALUE>vivía un hombre ( que ) nada tenía ( era pobre ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann4" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>dizque deseaba tener dinero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann6" ANNOTATION_REF="ann5">
                <ANNOTATION_VALUE>no hallaba cómo logararlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann7">
                <ANNOTATION_VALUE>nada más se sentaba a pensar todos los días.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>no iba a ninguna parte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann12" ANNOTATION_REF="ann11">
                <ANNOTATION_VALUE>además no había quién lo aconsejara cómo ( debe ) vivir en su casa , con qué se había de mantener con su mujer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann13">
                <ANNOTATION_VALUE>nada más estaban aguantándose la pobreza los dos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>llegó un día cuando nada más de repente se le ocurrió que debe emprender el camino , para ver qué podrá hallar , hasta dónde iba a retroceder su camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann18" ANNOTATION_REF="ann17">
                <ANNOTATION_VALUE>nada más se fué a un rumbo indefinido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann19">
                <ANNOTATION_VALUE>además eso , no había aprendido nada ( para saber ) desempeñar algún trabajo donde tuvieran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>no sabía ( conocía ) nada luego y por eso no se ofrecía a ( trabajar con ) patrones ( los que dan trabajos ) de su pueblo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann24" ANNOTATION_REF="ann23">
                <ANNOTATION_VALUE>dizque cuando empezó a preparar su viaje , le explicó a su mujer que se iba a alejar de ella.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann25">
                <ANNOTATION_VALUE>va en busca para el sostén de los dos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>a ver lo que iba a lograr.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann30" ANNOTATION_REF="ann29">
                <ANNOTATION_VALUE>a ver cuándo habrá de regresar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann31">
                <ANNOTATION_VALUE>y la mujer nada más escuchó lo que le dijo su hombre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>no hizo por detenerlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann36" ANNOTATION_REF="ann35">
                <ANNOTATION_VALUE>solamente suspiró dos o tres veces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann37">
                <ANNOTATION_VALUE>luego se fué con su hermana a alcanzarla en su casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>allá fué a obtener posada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann42" ANNOTATION_REF="ann41">
                <ANNOTATION_VALUE>ya se había ido la mujer del hombre cuando él partió.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann43">
                <ANNOTATION_VALUE>emprendió el camino sin punto fijo , como si fuera un loco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>dizque ya había pasado en muchos pueblos cuando encontró a cuatro caminantes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann48" ANNOTATION_REF="ann47">
                <ANNOTATION_VALUE>todo armados iban corre y corre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann50" ANNOTATION_REF="ann49">
                <ANNOTATION_VALUE>dizque deseaba hablarles y no les habló , ( sino que ) nada más los pasó derecho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann52" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>él se imaginó hablarles , a lo mejor nada más se enojan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann55" ANNOTATION_REF="ann54">
                <ANNOTATION_VALUE>por eso no habló , preferió nada más pasar ( los ) derecho. ()</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann57" ANNOTATION_REF="ann56">
                <ANNOTATION_VALUE>ya no caminó lejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann59" ANNOTATION_REF="ann58">
                <ANNOTATION_VALUE>ya se le empezó a obscurecer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann61" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>solamente llegó a otro pueblo , allí se quedó a pasar la noche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann63" ANNOTATION_REF="ann62">
                <ANNOTATION_VALUE>dizque allí le platicaron que se han acercado dos tigres grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann65" ANNOTATION_REF="ann64">
                <ANNOTATION_VALUE>nadie puede ir a matarlos adonde están ocultados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann67" ANNOTATION_REF="ann66">
                <ANNOTATION_VALUE>dizque se ponen muy bravos cuando alguno quiere acercarse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann69" ANNOTATION_REF="ann68">
                <ANNOTATION_VALUE>además eso , dizque no pueden ir los que son hombres valientes tiradores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann71" ANNOTATION_REF="ann70">
                <ANNOTATION_VALUE>no llegan derecho por donde están ocultados los tigres bravos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann73" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>nada más van a asomarse desde la frente ( del ) de un cerro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann75" ANNOTATION_REF="ann74">
                <ANNOTATION_VALUE>allí mismo en la frente del cerro comienzan a disparar ( hacer fuego ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann77" ANNOTATION_REF="ann76">
                <ANNOTATION_VALUE>solamente van a espantarlos y no los matan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann79" ANNOTATION_REF="ann78">
                <ANNOTATION_VALUE>así va pasando el tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann81" ANNOTATION_REF="ann80">
                <ANNOTATION_VALUE>los quieren matar a esos tigres porque los atacan y los comen a los caminantes en las noches.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann83" ANNOTATION_REF="ann82">
                <ANNOTATION_VALUE>no les da cuidado aunque ya está todo descubierto en donde pasa el camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann85" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>van a estar esperando en el paso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann87" ANNOTATION_REF="ann86">
                <ANNOTATION_VALUE>cuando encuentran a alguno ( que va ) caminando , nada más no lo perdonan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann89" ANNOTATION_REF="ann88">
                <ANNOTATION_VALUE>luego se lo comen y por eso han causado indignación.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann91" ANNOTATION_REF="ann90">
                <ANNOTATION_VALUE>quién sabe de dónde salieron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann93" ANNOTATION_REF="ann92">
                <ANNOTATION_VALUE>no había nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann95" ANNOTATION_REF="ann94">
                <ANNOTATION_VALUE>se podía andar en todo el tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann97" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>y ahora en este tiempo hay que andar con cuidado por donde salen los que comen seres humanos si ya se ha obscurecido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann99" ANNOTATION_REF="ann98">
                <ANNOTATION_VALUE>dizque cuando acabó de escuchar aquel hombre hospedado sobre el peligro que existía en el pueblo , se ofreció nada más porque sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann101" ANNOTATION_REF="ann100">
                <ANNOTATION_VALUE>empezó a contar que él puede matar tigres y otros animales bravos procedentes de los montes grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann103" ANNOTATION_REF="ann102">
                <ANNOTATION_VALUE>y el hombre de la casa ( casero ) lo creyó lo que le dijo su huésped.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann105" ANNOTATION_REF="ann104">
                <ANNOTATION_VALUE>al siguiente día fueron a hablarle al que es encargado de mandar a matar a los tigres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann107" ANNOTATION_REF="ann106">
                <ANNOTATION_VALUE>dijo el hombre de ese lugar que el individuo que lo acompañaba , saba ( puede )  matar tigre(s).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann109" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>no le da cuidado aunque sean bravos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann111" ANNOTATION_REF="ann110">
                <ANNOTATION_VALUE>está práctico cómo se matan a los animales bravos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann113" ANNOTATION_REF="ann112">
                <ANNOTATION_VALUE>le preguntaron directamente a aquel hombre si era cierto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann115" ANNOTATION_REF="ann114">
                <ANNOTATION_VALUE>sí es verdad y no es mentira - dijo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann117" ANNOTATION_REF="ann116">
                <ANNOTATION_VALUE>se lo creyeron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann119" ANNOTATION_REF="ann118">
                <ANNOTATION_VALUE>nadie sabía si él no se metía en nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann121" ANNOTATION_REF="ann120">
                <ANNOTATION_VALUE>nada más se estaba ofreciendo porque sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann123" ANNOTATION_REF="ann122">
                <ANNOTATION_VALUE>había salido de su casa sin premeditación sin ningún plan teniendo la idea a ver qué lograba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann125" ANNOTATION_REF="ann124">
                <ANNOTATION_VALUE>cuando acabó de hablar , luego buscaron quién fué a enseñarle por donde estaban los tigres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann127" ANNOTATION_REF="ann126">
                <ANNOTATION_VALUE>salieron después de pasar un rato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann129" ANNOTATION_REF="ann128">
                <ANNOTATION_VALUE>dizque solamente le enseñaron por donde tenía que conducirse y ya él solo se encaminó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann131" ANNOTATION_REF="ann130">
                <ANNOTATION_VALUE>y el que fué a enseñarle , no se acercó más , se detuvo estando todavía lejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann133" ANNOTATION_REF="ann132">
                <ANNOTATION_VALUE>dizque al llegar aquel hombre en la punta delantera del cerro , ( de allí ) se asomó buscándolos por donde podían estar los tigres entre los grandes árboles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann135" ANNOTATION_REF="ann134">
                <ANNOTATION_VALUE>no podía hallarlos con la vista se encontraban dormidos en frente de sus cuevas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann137" ANNOTATION_REF="ann136">
                <ANNOTATION_VALUE>solamente los vió bien si no se movían , poco a poco se fué bajando el hombre de la punta delantera del cerro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann139" ANNOTATION_REF="ann138">
                <ANNOTATION_VALUE>faltaría como cuatro o cinco brazadas para que los alcanzara,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann141" ANNOTATION_REF="ann140">
                <ANNOTATION_VALUE>cuando desenterró una piedra al tamaño que se pueda tomar con una mano , esa les arrojó con fuerza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann143" ANNOTATION_REF="ann142">
                <ANNOTATION_VALUE>dizque le atinó en su mera cabeza a uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann145" ANNOTATION_REF="ann144">
                <ANNOTATION_VALUE>se sorprendió al sentirlo y se despertó luego.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann147" ANNOTATION_REF="ann146">
                <ANNOTATION_VALUE>y el hombre luego se escondió en un árbol grande y no lo vió el tigre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann149" ANNOTATION_REF="ann148">
                <ANNOTATION_VALUE>y al tigre que le tocó la pedrada se vengó con su contigre y comenzaron a pelear.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann151" ANNOTATION_REF="ann150">
                <ANNOTATION_VALUE>se golpearon mucho contra el suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann153" ANNOTATION_REF="ann152">
                <ANNOTATION_VALUE>no se soltaron aunque empezaron a bañarse mucho de la propia sangre de ellos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann155" ANNOTATION_REF="ann154">
                <ANNOTATION_VALUE>se dieron muchos arañazos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann157" ANNOTATION_REF="ann156">
                <ANNOTATION_VALUE>los dos estaban ensangrándose en todo el cuerpo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann159" ANNOTATION_REF="ann158">
                <ANNOTATION_VALUE>ni así se perdonaron , siguieron peleándose.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann161" ANNOTATION_REF="ann160">
                <ANNOTATION_VALUE>suspendieron ( la pelea ) ya cuando en la ( mera ) hora que empezaron a sentirse desmayados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann163" ANNOTATION_REF="ann162">
                <ANNOTATION_VALUE>quedaron estirados a corta distancia de uno al otro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann165" ANNOTATION_REF="ann164">
                <ANNOTATION_VALUE>al poco rato , de repente empezó a suspendérseles la respiración.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann167" ANNOTATION_REF="ann166">
                <ANNOTATION_VALUE>comenzaron a quedarse muertos , ya no se levantaron desde que se tiraron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann169" ANNOTATION_REF="ann168">
                <ANNOTATION_VALUE>solamente se dieron dos o tres estirones , se les cortó la respiración.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann171" ANNOTATION_REF="ann170">
                <ANNOTATION_VALUE>se acabaron de quedar muertos los dos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann173" ANNOTATION_REF="ann172">
                <ANNOTATION_VALUE>ellos solos se mataron nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann175" ANNOTATION_REF="ann174">
                <ANNOTATION_VALUE>y el hombre quién les fué a echar una pedrada a los tigres ......</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann177" ANNOTATION_REF="ann176">
                <ANNOTATION_VALUE>allí mismo estaba parado atrás de un árbol grande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann179" ANNOTATION_REF="ann178">
                <ANNOTATION_VALUE>los vió bien a los tigres cómo se mataron los dos sólos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann181" ANNOTATION_REF="ann180">
                <ANNOTATION_VALUE>se divirtieron bien ellos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann183" ANNOTATION_REF="ann182">
                <ANNOTATION_VALUE>después de haber pasado un rato de ver a los tigres que se habían muerto ya , se vino de allá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann185" ANNOTATION_REF="ann184">
                <ANNOTATION_VALUE>cuando llegó por donde había salido con su guía , dijo que había ido a matar a los dos tigres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann187" ANNOTATION_REF="ann186">
                <ANNOTATION_VALUE>( que ) los había dejado ya muertos acostados por ahí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann189" ANNOTATION_REF="ann188">
                <ANNOTATION_VALUE>se sorprendieron los que le escucharon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann191" ANNOTATION_REF="ann190">
                <ANNOTATION_VALUE>ellos creyeron que era mentira.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann193" ANNOTATION_REF="ann192">
                <ANNOTATION_VALUE>no es verdad también nada más comenzó a reír el hombre quién le había buscado su guía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann195" ANNOTATION_REF="ann194">
                <ANNOTATION_VALUE>no creían que fuera verdad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann197" ANNOTATION_REF="ann196">
                <ANNOTATION_VALUE>pero estaba insistiendo que era verdad que había matado a los dos tigres , no es una mentira.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann199" ANNOTATION_REF="ann198">
                <ANNOTATION_VALUE>no se lo creían porque ya habían ido allá muchos hombres bravos valientes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann201" ANNOTATION_REF="ann200">
                <ANNOTATION_VALUE>además eran de buena puntería.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann203" ANNOTATION_REF="ann202">
                <ANNOTATION_VALUE>nadie se les había acercado quién debería haberlos matado a esos tigres bravos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann205" ANNOTATION_REF="ann204">
                <ANNOTATION_VALUE>y aquel hombre que fué a alcanzarlos , no llevó absolutamente nada , fué nada más así sin nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann207" ANNOTATION_REF="ann206">
                <ANNOTATION_VALUE>por ese motivo no se lo creían nadie se los creía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann209" ANNOTATION_REF="ann208">
                <ANNOTATION_VALUE>aunque no le creían sus palabras , fueron con él a ver a los tigres ( para ver ) si era verdad ( que ) estaban muertos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann211" ANNOTATION_REF="ann210">
                <ANNOTATION_VALUE>hasta entonces lo creyeron ya que fueron personalmente a donde estaban tirados los tigres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann213" ANNOTATION_REF="ann212">
                <ANNOTATION_VALUE>ellos mismos se encargaron de dar la noticia cuando regresaron que sí era cierto que habían muerto los dos tigres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann215" ANNOTATION_REF="ann214">
                <ANNOTATION_VALUE>no era mentira lo que había dicho el hombre quién los fué a matar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann217" ANNOTATION_REF="ann216">
                <ANNOTATION_VALUE>también el que estaba encargado de mandar a vigilar todos los días a los tigres ......</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann219" ANNOTATION_REF="ann218">
                <ANNOTATION_VALUE>ordenaba que los mataran , lo creyó hasta que otros lo hicieron creer ( lo aseguraron ) que sí habían muerto los tigres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann221" ANNOTATION_REF="ann220">
                <ANNOTATION_VALUE>sin pérdida de tiempo , luego mandó a dar avisos el hombre quién estaba encargado de la vigilancia de los tigres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann223" ANNOTATION_REF="ann222">
                <ANNOTATION_VALUE>les dijeron a los del pueblo que ya mataron a los tigres los que salían a atacar y comer en el camino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann225" ANNOTATION_REF="ann224">
                <ANNOTATION_VALUE>ahora debemos hacerle honor al que los mató.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann227" ANNOTATION_REF="ann226">
                <ANNOTATION_VALUE>nos hizo un beneficio de acabar los que nos molestaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann229" ANNOTATION_REF="ann228">
                <ANNOTATION_VALUE>se juntó mucha gente al siguiente día.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann231" ANNOTATION_REF="ann230">
                <ANNOTATION_VALUE>empezaron a tronar mucho cuete desde muy temprano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann233" ANNOTATION_REF="ann232">
                <ANNOTATION_VALUE>también se juntaron desde temprano los músicos y las danzas bailadores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann235" ANNOTATION_REF="ann234">
                <ANNOTATION_VALUE>le festejaron todo el día y toda la noche a ese hombre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann237" ANNOTATION_REF="ann236">
                <ANNOTATION_VALUE>le juntaron mucho dinero con que le recompensaron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann239" ANNOTATION_REF="ann238">
                <ANNOTATION_VALUE>ya no sabían qué darle de tanto homenaje que le hicieron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann241" ANNOTATION_REF="ann240">
                <ANNOTATION_VALUE>todo le juntaron aunque sean maíz , panela , frijol , gallinas y guajolotes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann243" ANNOTATION_REF="ann242">
                <ANNOTATION_VALUE>todo lo que le juntaron , no se lo llevó él mismo , sino que fueron a dejarle gratuitamente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann245" ANNOTATION_REF="ann244">
                <ANNOTATION_VALUE>también al regresar a su pueblo , que ya no fuera a pie , regresó en un buen caballo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann247" ANNOTATION_REF="ann246">
                <ANNOTATION_VALUE>llegando luego fué a llamar a su mujer a donde se había ido a hospedarse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann249" ANNOTATION_REF="ann248">
                <ANNOTATION_VALUE>le dijo que ya había regresado ( regresó ) , luego lo acompañó su mujer para su casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann251" ANNOTATION_REF="ann250">
                <ANNOTATION_VALUE>cuando llegaron a sus casas , el hombre comenzó a contarle a su mujer como prodedió para obtener mucho dinero , y lo que hizo por donde fué a llegar ( de donde se regresó ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann253" ANNOTATION_REF="ann252">
                <ANNOTATION_VALUE>dizque el hombre ya no permaneció más tiempo en el mismo lugar , luego se cambió al día siguiente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann255" ANNOTATION_REF="ann254">
                <ANNOTATION_VALUE>se fué a otro pueblo en donde ya hay bastantes casas grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann257" ANNOTATION_REF="ann256">
                <ANNOTATION_VALUE>ya no quiso detenerse en su pueblo , luego se separó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann259" ANNOTATION_REF="ann258">
                <ANNOTATION_VALUE>dizque cuando llegó aquel hombre al pueblo grande , luego compró una casa grande y en ella se estableció.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann261" ANNOTATION_REF="ann260">
                <ANNOTATION_VALUE>sin pérdida de tiempo cambió su modo de vivir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann263" ANNOTATION_REF="ann262">
                <ANNOTATION_VALUE>y anteriormente no se imaginaba para nada si de repente iba a haber un día cuando tenía que posesionarse mejor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann265" ANNOTATION_REF="ann264">
                <ANNOTATION_VALUE>vivía muy pobre y por eso no se ilusionaba ( ambicionaba ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann267" ANNOTATION_REF="ann266">
                <ANNOTATION_VALUE>estaba acostumbrado ( conforme ) que así viviría ( iba a vivir ) en todo el tiempo , nunca se libraba de la pobreza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann269" ANNOTATION_REF="ann268">
                <ANNOTATION_VALUE>sin estar prevenido de repente le llegó ( le tocó ) lo mejor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann271" ANNOTATION_REF="ann270">
                <ANNOTATION_VALUE>los que lo conocían , decían que así era su destino no nada más porque sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann273" ANNOTATION_REF="ann272">
                <ANNOTATION_VALUE>primero sufrió pobreza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann275" ANNOTATION_REF="ann274">
                <ANNOTATION_VALUE>más tarde le tocó lo mejor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann277" ANNOTATION_REF="ann276">
                <ANNOTATION_VALUE>el dios lo fué guiando a donde fué a obtener mucho dinero , si no fuera así , no lograba nada</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <LINGUISTIC_TYPE GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="tx" TIME_ALIGNABLE="true"/>
    <LINGUISTIC_TYPE CONSTRAINTS="Symbolic_Association" GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="ft" TIME_ALIGNABLE="false"/>
