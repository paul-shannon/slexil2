        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a415" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>he: ti: xka:le:ní' i'xchiká'n i xka:n tzukúka' ka:talho:kán ja:'n tato:lá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>i'xmákni' pu:sikwalán lhó:ka' a'htín galera</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>ma:x chi' de trenta m:tros lhó:ka' tza'má galera ja:' chi' ja:' i'xwa'yankán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a270">
                <ANNOTATION_VALUE>a'kxní a'hsputhó:'ka tza'má chi' kristiánu' ti: taka:xtawi:lhtzá' pus taka:maxki:ka'tzá tza'má chik ti: ja:tzá' tu: i'xchiká'n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>he: a:mah'a:'pi'tzí'n tapu'tzálh ja: ka:talhó:ka' i'xchiká'n tzukuka'tzá' ka:lho:kán chik de he:cartón o tampa:taxama:ní:lu' tampa:xu:nu:kí'wi' ho: tampa:cartón xka:talho:má:ka' xchiká'n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>tza'má kristiánu' tzej tali:puwánli' [ja: …] ja:tzá' la: chi' xtalá ja: la: skujkán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a273">
                <ANNOTATION_VALUE>i'xtapala:xlamá:lh tza'má kapéj pero a:li:stá:n tza'má a'kxní pa:lhe'he:hó:'lh tza'má ha'lhaná'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>li:ta:'ktalhtzá' kapéj ja:tzá' tu: xtapálh wánli'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>ásta chu:wá ja:tzá' ja:tzá' tu: xtapálh kapéj le:ma:lhtzá la'ha'hkitzís ká:'ta' chu:wá [ja: …] ja: tu: xtapálh kapéj ja: [tu: … tu: …] tu: tali:wa'yán kristiánu' [ja: …] ja:tzá' a'kchá:'n i'xtumi:nká'n tu: tali:wa'yán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a424" ANNOTATION_REF="a276">
                <ANNOTATION_VALUE>por eso chu:wá tza'má kristiánu' ma'ha:'pí'tzi' ti: ja:tzá' tato:laku'tún wa:tzá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a425" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>nakMexico, nakEstados Unidos ma'hát ma'hatzá' taa'ma:'nálh [ja: …] ja:tzá' tu: taskujút ja: [tu: …] tu: tu: ka:li:ma:skuju:kán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a426" ANNOTATION_REF="a278">
                <ANNOTATION_VALUE>taskujút má:ski' wi:lh pero ja: tu: tumí:n tu:n li:ma:skujú:ya' cha:'tín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>ma:ntzá' ka'ks talakawán [ja:tz …] ja:tzá' la: tu: talhó: kristiánu'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a428" ANNOTATION_REF="a280">
                <ANNOTATION_VALUE>wa:má: kit [i'x æ] tza'má tza'má kinho:lú' Rosendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a429" ANNOTATION_REF="a281">
                <ANNOTATION_VALUE>wa:tza ikwi:lh na'ixchik</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a430" ANNOTATION_REF="a282">
                <ANNOTATION_VALUE>y tawila:nálh kilakstín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a431" ANNOTATION_REF="a283">
                <ANNOTATION_VALUE>tzey wa:má: kila:la'hmini:'táj wa:tzá: nakinchiká'n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>bueno nakchík wa:má: i'kla'hcha'ha:nán i'kski'tí he: tzi'sáj i'kta:'kí: tzi'sáj las tres o las cuatro de la mañana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a433" ANNOTATION_REF="a285">
                <ANNOTATION_VALUE>he: i'klhó: tza'má kuwi:wá:' a'nkán naka:'takúxtu'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a434" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>he: tza'má, he: a:li:stá:n pus chi' las diez i'klho:palá i'xchojká'n lakstín ti: taá'n nakskwéla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a435" ANNOTATION_REF="a287">
                <ANNOTATION_VALUE>he: i'klho:palá kili:lhó: a:li:stá:n i'ktzukupalá i'kla'hcha'ha:nán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a436" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>he: ho:tanu: wampalaj chu chu:ntzá: tu: lho:pala</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a437" ANNOTATION_REF="a289">
                <ANNOTATION_VALUE>tza'má tama'haxto'hkán tza'má pú:'lá' wa:má, na: wa:má tza'má tama'haxto'hkán pú:'lá' na: wa:má preparaláya' tza'má a:li:stá:n tza'má na:tama:wa:kán pó'htu' tu: talakaskí'n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a438" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>pó'htu' tu: nawakán he: tza'má lú'xu' palh tzapá:tu' palh lú'xu' tu: chu' tu: talakaskí'n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a439" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>he: tza'má a:li:stá:n pus a'kxní a'kchín tza'má [tzel …] wachí' como si fuera a'htin plazo naa'kchin tza'má kilhtamakuj xni tama'haxto'hkán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a440" ANNOTATION_REF="a292">
                <ANNOTATION_VALUE>pus taalistarli:ni:'ta'tzá' wila:ho:lhtzá' tza'má padrinos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a441" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>tza'má wi:lh padrino [de] de bebida ho: tza'má de pastel ho: de vestido</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a442" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>ho: tza'má [xla] xla lú'xu' xla tzapá:tu' pó'htu'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a443" ANNOTATION_REF="a295">
                <ANNOTATION_VALUE>pu'tzakán bue:no chu:wá pu'tzakantzá' pero la'hma'jtzá' ja: chu:ntzá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a444" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>la'hma'jtzá' ma:n tza'má u:tzá: xma:n noviotzá' i'xtama:wá: pó'htu'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a445" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>he: tza'má pero chu:wá kambiarli:lhtza chu:wá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a446" ANNOTATION_REF="a298">
                <ANNOTATION_VALUE>chu:wá ma'htintzá' tapu'tzá xapadrino po'htu'tzá'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a447" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>tapu'tzá tza'má xla lú'xu' pó'htu' xla tzapá:tu' xla pó'htu' tu: chu' talakaski'má:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a448" ANNOTATION_REF="a300">
                <ANNOTATION_VALUE>he: la'hma'jtzá' ja: chu:ntzá: ma:n tza'má he: ma:n tza'má novio i'xtama:wa:hó:' pó'htu' tu: talakaskí'n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a449" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>chu:wá pus xtumtzá' li:lamá:ka'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Analysis" PARENT_REF="Line" TIER_ID="Prsd"/>
