    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss" PARENT_REF="Ex" TIER_ID="L3Gloss">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a107" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>Llegando el 16 de diciembre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>cuando este, este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a109" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>los fiscales se juntaban para juntar los topiles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE> juntaban a los avisadores,  juntaban a las policias</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a111" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>este 16 deciembre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>despues este se ponian de acuerdo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a113" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>se compraba refino, y les repartian a los avisadores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>de a medio litro uno por uno a los regidores, y tambien se les daba a los avisadores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a115" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>y asi tambien se les daba a los policias quienes eran los jefes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>y los topiles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a117" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>y despues ahora, cuando es el 16 de diciembre, se juntaban todos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>se platicaban quien se va quedar de jefe</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>quien va ir de jefe de los topiles y fiscal teniente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>y despues ahora empezaban a tomar en la casa del viejo fiscal</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a121" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>y para los que no llegaban muy temprano, le dejaban en un vaso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>asi como cuantas veces ya se ha servido se le va vaciando en su vaso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a123" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>y después cuando, este, … van y los llevan a la fuerza en sus casas los que no llegaban luego</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a124" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>ya estaba sus refinos lo que se les habia vaciado en su vaso grande</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a125" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>entonces, se les hacian tomar todo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a126" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>y ahora quien no quierian tomar le obligaban a tomar y a los que no quieran a tomar les hacian disparar (pagar por la bebida)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a127" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>y despues ahora cuando se terminaba todos se emburrachaban, cuando amanecia todos se ponian burrachos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a128" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>se dispersaban pero una vez que todos estaban borrachos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a129" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>y despues ahora ya por la noche va salir la posada</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a130" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>ese dia cuando salío en la tarde la primera posada</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a131" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>esos topiles se ensayaban cuando todavia no pasaba todos santos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a132" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>pues cuando la primera pasada ya iba a bailar, no llegaban en la iglesia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a133" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>despues iban a bailar en la noche y en el dia, y tambien estaban de comer y estaban bebida</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>y cuando el pasaba todo eso, despues llegaba el 25, o el 24 de diciembre se juntaba mucha gente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a135" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>iba mucha gente a la iglesia y iban a bailar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a136" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>entonces quemaban el torito, lo que compraban los topiles y los fiscales, lo que quemaban en la iglesia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>y ahora terminaba eso ya en la madrugada, se iban a sus casas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>ya despues al otro dia, el 25 de diciembre, ya iban a dejar ese cargo que tenia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>pues ese dia iban a dejar ese cargo que tenia los avisadores, y tambien iban a bailar en la casa de la nueva avisador</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>pues despues, cuando terminaba de bailar en la casa de la nueva avisador, iban a la iglesia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a141" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>entonces iban a bailar y ponian naguas los que iban a dejar ese cargo donde estaba jefe de los avisadores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>doce veces bailaban en la casa del nuevo avisador, y despues iban a la iglesia tambien bailaban doce veces alla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a143" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>entonces despues, se terminaba de bailar a la iglesia, ya iban en la casa del mayor avisador, que va saliendo de su cargo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a144" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>entonces empazaron a comer y prepararon mole, y despues ya empazaron a tomar bebidas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a145" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>ya despues cuando terminaban de comer, pues a el que no había ido, ese que no comió …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>cuando ya terminaban todos a comer, se la llevaban a sus casas, los que tiene corgo, que ya iban saliendo de sus cargos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a147" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>despues llegaban los avisadores un dia viernes, y se juntaban otra vez la gente (los avisadores) para ir a cortar palos para hacer cruzes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a148" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>y despues, los avisadores ponian cruzes en las calles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a149" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>entonces ponian tarros tambien, y despues iban los fiscales a traerlos, estes tarros</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a150" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>despues, cada ocho dias colgaban las palmillas y tambien la flor del platano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a151" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>iban a traerlos mucha gente para adornar enfrente de la iglesia y en las esquinas de las calles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a152" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>cuando terminaban de adornar las esquinas de la calle, despues llegaba la semana santa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a153" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>terminaba como sabado o viernes lo tendian o ponian estas hojas de palo de agua en adentro de la interior de la iglesia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>pero el mero principio de este, cuando tenia ese cargo, se juntaban muchas personas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a454" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>entonces, cuando pasaba ya todos la semana santa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a455" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>llegaba la fiesta del ocho de septiembre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a456" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>buscaban un cohetero, quien lo hacia castillo, y asi toritos, cualquier cosa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a457" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>despues cuando habia fiesta, ya los iban a llamar los musicos, y tambien el sacerdote,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a458" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>cuando habia fiesta, entonces el sacerdote no estaba aqui; vivia en Jopala</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a459" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>alla iban a traer a caballo el sacerdote y los bailadores que bailaban, el padre vino a caballo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a460" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>empazaban a echar cohetes cuando venian en camino de rio abajo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a461" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>y despues iban a traer bailando enfrente del sacerdote</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a462" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>y tambien se arrodillaban delante de el</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a463" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>y tambien le besaban sus manos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a464" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>y ese sacerdote no se bajaba de su caballo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a465" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>y le besaban sus manos, lo traian bailando delante de el, y despues cuando llegaban a la iglesia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a466" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>asi lo traian bailando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a467" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>cuando terminaban de llegar a la iglesia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a468" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>despues ya iban al centro a bailar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a469" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>cuando terminaban de bailar, ya regresaban de nuevo a tomar otra vez en la casa del mayor topil</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a470" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>pues tambien en la presidencia echaban cohetes, y lo tronaban </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a471" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>entonces el cohete lo empiezaban a tronar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a472" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>todo el dia habia fiesta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a473" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>hace mucho tiempo no habia que comer, no habia maiz, y tambien no habia trabajo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>pus los pobres se sentian triste porque no habia donde sacar dinero (dance?)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a475" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>no tenian a donde trabajar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a476" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>habian los musicos y les juntaban tortillas y pedian casa por casa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>hay unos que no daban y hay unos que daban porque no tenian para comprar su maiz para echar nixcomen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>era una gran tristesa para los antiguas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>un dia lunes hicimos faena alli donde estaban construyendo una escuela de bachiller nueva</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>entonces toda la gente nos reunimos alli, y tambien cortamos palos para hacer un corral</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>y despues, cuando regresamos de cortar palos, nos reunimos en la escuela nueva que estaba construyendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>donde ya lo habian terminado de construir la escuela bachiller</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a483" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>entonces ese dia era como la una de la tarde empezo a llover</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a484" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>empezo a llover y a llover que ya estabamos adentro la escuela</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a485" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>despues estabamos platicando de comprar una computadora para los jovenes lo que se va quedar a la escuela</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a486" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>pues entonces nosotros los hombres estuvimos platicando para coperar(?) (contribute) dia cincuenta pesos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>pues nosotros nos habiamos si iba venir la creciente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a189">
                <ANNOTATION_VALUE>entonces al oscuricerse, estaba llueve llueve un dia lunes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>despues nos habiamos si iba venir la cresciente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a490" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>ya cuando vino la creciente, estuvo lluviendo ya toda la noche</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a491" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>pues empezo a crecer y a crecer el rio, y la gente no creia que va crecer el rio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>todovia no lo habian visto los que vivian en la orilla del rio como pasaba la creciente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a493" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>despues iban a despertar las personas en sus casas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a494" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>pues no quisieron despertar y no quisieron levantarse</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a495" ANNOTATION_REF="a196">
                <ANNOTATION_VALUE>y dicen, "cuando va crecer el rio?"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a496" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>aqui no va pasar a traer el rio, aqui nunca va llegar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a497" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>aqui nunca nos va llegar el rio, dijeron</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a498" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>se volvieron a dormir aunque los iban a levantarlos </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a499" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>entonces, cuando unos personas se levantaron ya, empezaron a ver el rio que empezo a crecer y a crecer</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a500" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>pues hay unos que sacaron sus cosas y hay unos que sacaron por que no creian si ya iba llover</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a501" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>cuando terminaron de ver, era como seis de la manaña</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a502" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>y lo vieron ya que ya no podian salir del rio, los que vivian mas a la orilla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a503" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>despues lo que hicieron cuando ya no podian salir, les pusieron un laso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a504" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>donde empezaron a pasar en un costal </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a505" ANNOTATION_REF="a206">
                <ANNOTATION_VALUE>hicieron uno donde estaban adentro que los sacaban jalando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a506" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>hay unas personas que sacaron sus ropas y hay unos que no lo sacaron no mas así salieron</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a507" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>despues esas personas sacaron los que vendian cervesa o refino cerca del rio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a508" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>todo que habia una tienda</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a509" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>entonces despues, estan dos personas que les gustaba tomar, ya no más empezaron …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a510" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>agarrar serbe:sa o refino o sardinas o galletas, alli estaban comiendo donde estaban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a511" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>como ellos pensaron que el agua, ya no nos iba pasar a traer porque nosotros sabemos nadar y sabemos cruzar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a512" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>asi pensaron, pus tomaron mucho, hasta emborracharse</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a513" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>despues una persona, como tenia sus hijos y su esposa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a514" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>que querría que cruzara,  tenia puesto una bota grande, y andaba con esa bota </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a515" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>alli se le metio el agua en sus botas, y cuando le peso sus botas, alli se solto y se cayó en medio del agua</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a516" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>y como ese rio llevaba mucho lodo no se veia qué habia adentro del agua, iba puro lodo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a517" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>y como esa persona se metio en al agua ya no pudo salir y ya asi se lo llevaron</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a518" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>ahora otra persona que habia subido en el techo de la casa </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a519" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>estaba lluviendo mucho, y ya nomas lo tenia puesto en la cabeza una cosa como nailo o carton</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a520" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>lo tenia puesto en la cabeza y subió a la azotea</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a521" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>despues lo pasaron a tombar la casa donde estaba arriba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a522" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>y despues lo cambio otra vez, fue a subir en otro techo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a523" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>entonces cuando ese dia amanecio y atardeció</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a524" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>entonces ese senor todavia estaba arriba cuando oscureció</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a525" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>después ahora, cuando amaneció ese señor,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a526" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>entonces ya había pasado a tombar esa casa donde estaba arriba, y se murió y se lo llevo la creciente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a527" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>aparte los que no quisieron pasar los demas jovenes los que estaban alli</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a528" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>ellos estaban en medio del monte, y ya no tenian que comer, y ya iban a morir de hambre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a529" ANNOTATION_REF="a230">
                <ANNOTATION_VALUE>no les podian pasar alimento aunque les quisieron dar, porque el rio iba grande</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a530" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>y ya no les podian hacer nada hasta habian hecho milpas, y habian hecho milpas donde estaban </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a531" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>y ya nomas estaban comiendo elote, a lo mejor se llenaron con ese elote (retranslate?)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a532" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>cuando se bajo el agua ya los sacaron esas personas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a533" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>ahora los puercos cualquier cosa que andaban y aqui han la presidencia, se habian juntado muchas personas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a534" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>habia mucha gente lo que estaban comiendo alla los que les pasaron a tumbar sus casas, y ya no podian a donde quedarse</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a535" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>pues alli les daban de comer, les hacían tortillas cualquier comida, una vaca pasaban a dejar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a536" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>esa vaca ya habio torcido de su pie ya nomas lo mataron alla y lo trajeron y ya todos comieron</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a537" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>tambien (even?) los puercos los que habian pasado alla donde estaban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a538" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>tambien los que estaban al otro lado del rio todos comieron pollos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a539" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>despues empezaron a dar tambien ropa lo mandaron de alla en cualquier parte</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a540" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>les daban a los pobres los que les paso a traer la creciente sus casas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a541" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>pues ya estaban tristes, ya no tenian lo que ponian zapatos, chamarra, camas, catre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a542" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>entonces muchos los que les dieron esas personas que les llevo la creciente sus casas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a543" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>entonces ese dia cuando amanecio cuando vino el creciente empezaron a llevarse las casas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a544" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>pues muchas casas los iban llevando volteando, y asi los llevaron</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a545" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>tambien todas las casas de materiales todo los paso a traer el rio, y tambien los casas que no son buenas, todos los llevo ese rio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a546" ANNOTATION_REF="a247">
                <ANNOTATION_VALUE>entonces esa escuela de bachiller todavia estaba aguantando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a547" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>entonces ese bachiller ya cuando empezo a sumir el agua, ya pum(?) lo paso a tumbar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a548" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>entonces este ayudó al pueblo, porque la creciente ya no pudo pasar, ya la creciente empujo la escuela al otro lado del rio, y ya hizo caer la escuela</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a549" ANNOTATION_REF="a250">
                <ANNOTATION_VALUE>muchas personas se pusieron tristes cuando la creciente empezo </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a550" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>pues muchos soldados empezaron a bajar y tambien las policias</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a551" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>empezaron a bajar esos carros de Villa Juarez, de La Selliva, y de La Union, para llevar las mujeres y tambien los ninos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a552" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>todos los que ya no tenian a donde vivir, y ya no tenian sus casas, estaban triste, y estaban llorando ya</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a553" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>entonces ya termino esa creciente, ya se sumio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a554" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>ya les empezaron a pasar lo que van a comer de El Encianll y de Cuamaxalco</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a555" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>a los de San Pedros les mandaban del otro lado maiz y azucar y todo lo que comian, lo que se necesitaban para comer</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a556" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>lo estaban pasando en una cable como las personas que estaban ya moriendas de hambre, los que estaban del otro lado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a557" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>los de Tiplatlan y de Huatichalotla ya estaban tristes porque ya no tenian que comer</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a558" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>entonces ya cuando empezo a sumir el agua, ya empazaron a arreglar el puwente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a559" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>ya pusieron un cable, y ya despues se sentieron bien las personas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a560" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>entonces en este pueblo, todas las personas que vivian aqui empezaron a trabajar, a hacer faenas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a561" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>donde habian entrado este lodo en las casas donde no habian tumbado, empezaron a sacar lodo en las casa en cuadrilla, quince o dia veinte personas que les mandaban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a562" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>un mes trabajaron, les ayudaron las personas donde habia entrado lodo  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a563" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>pues entonces eso paso como un mes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a564" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>alla despues empezaron a bajar otra vez</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a565" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>entonces llegaron esas personas, las que no les habia tumbado sus casas el rio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a566" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>y los que les habia llevado sus casas el rio les empezaron a ayudar hacer sus casas, donde van a vivir</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a567" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>atras de la iglesia hicieron una galera</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a568" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>como trenta metros hicieron ese galera, donde comian</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a569" ANNOTATION_REF="a270">
                <ANNOTATION_VALUE>cuando terminaron esas personas, ya tuvieron lugar los que no tenian casa, ya les dieron lugar para vivir alli</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a570" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>y las otras personas buscaron a donde ayudarles hacer sus casas, y ya empazaron ayudar hacer sus casa de techo de carton, de tablas de tejamanil, de tablas de jonote, y tablas de karton, les ayudaron hacer sus casas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a571" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>esas personas bien que pusieron tristes, porque ya no podian hacer nada, ya no podian trabajar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a572" ANNOTATION_REF="a273">
                <ANNOTATION_VALUE>estaba muy buen precio el cafe, pero ya despues cuando paso la creciente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a573" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>ya bajo el precio de cafe, ya no valio mucho</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a574" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>pues hasta hora, ya estaba muy barato el cafe, pues ya lleva cinco anos de que ya estaba muy barato el cafe, y las personas ya no les alcanza sus dineros con que comer</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a575" ANNOTATION_REF="a276">
                <ANNOTATION_VALUE>ahora esos personas los que ya no quieren quedarse aqui</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a576" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>entonces, ya se van a Mexico, a los Estados Unidos, ya se van muy lejos, y ya no hay trabajo para darles a trabajar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a577" ANNOTATION_REF="a278">
                <ANNOTATION_VALUE>aunque trabajo hay pero el dinero no hay con que les va a dar trabajo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a578" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>ya nomas se ponen a pensar, ya no puen a ser nada las personas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a579" ANNOTATION_REF="a280">
                <ANNOTATION_VALUE>este, yo, mi esposo es Rosendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a580" ANNOTATION_REF="a281">
                <ANNOTATION_VALUE>aqui estoy en su casa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a581" ANNOTATION_REF="a282">
                <ANNOTATION_VALUE>y tengo mis hijos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a582" ANNOTATION_REF="a283">
                <ANNOTATION_VALUE>pues esta bien que nos vienes a visitar a nuestra casa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a583" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>bueno, en la casa, lavo la ropa y muelo y tambien me levanto en la madrugada las tres o las cuatro de la mañana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a584" ANNOTATION_REF="a285">
                <ANNOTATION_VALUE>y tambien hago lonche para que llevan al monte</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a585" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>entonces, despues como las diez de la manana, empiezo a preparar hacer lonches de los ninos que van a la escuela</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a586" ANNOTATION_REF="a287">
                <ANNOTATION_VALUE>y hago mequihacer despues y empezo a lavar otra vez</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a587" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>y tambien en la tarde lo mismo algo mequihacer</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a588" ANNOTATION_REF="a289">
                <ANNOTATION_VALUE>despues para casarse tiene que estar preparada, despues van a comprar las cosas que se necesita</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a589" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>todo lo que se va comer tambien la ropa o los zapatos y la ropa, lo que se necesita</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a590" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>pues como el dia asi cuando llega el plazo de como se casan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a591" ANNOTATION_REF="a292">
                <ANNOTATION_VALUE>pus ya estas alistado, y ya estan todos los padrinos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a592" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>este hay padrino de bebida, este de pastel, o de vestido</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a593" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>ya sea este de ropa o de zapatos todo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a594" ANNOTATION_REF="a295">
                <ANNOTATION_VALUE>se buscan . . . bueno, ahora ya se buscan, pero hace tiempo no era asi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a595" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>hace tiempo nomas el novio compraba todo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a596" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>y este ahora ya cambio [el cambio] todo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a597" ANNOTATION_REF="a298">
                <ANNOTATION_VALUE>ahora ya todos buscan los padrinos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a598" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>buscan este de ropa todo, de zapatos, todo lo que se necesitan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a599" ANNOTATION_REF="a300">
                <ANNOTATION_VALUE>y hace tiempo no era asi, todo lo que se necesitaba lo compraba todo el novio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a600" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>ahora pues ya es muy differente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
