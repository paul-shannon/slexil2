        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>Patla, Jopala, Puebla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>en la voz de Sr. Rosendo Melo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>y nos va a platicar acerca del sistema de cargos, en el pueblo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>Na'kchín tza'má xhelhkaujcha:xán diciembre </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a61" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>a'kxní tza'má, tza'má  […n}</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a62" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>pixká:lhna' [na] natala:ma:stó'ha ka:ma:sto'hkán tza'má ma:yú:lhnu'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a63" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>ka:ma:sto'hkán tza'má ma:skuju:nu'ní:n, i'xka:ma:sto'hkán pu:la:siyájna'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>tza'má xhelhkaujcha:xán diciembre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>a:li:stá:n tza'má [i'x] i'xla:li:tachiwi:ni'kán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>[i'xka:…] i'xtama:wa:kán kú'chu', i'xka:ma'hpi'tzikán tza'má skujní'n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>i'tá:tna' litru cha:'a'tú'nu' cha:'a'túnu' skujní'n he: [i'xka:ma: …] i'xka:maxki:palakán tza'má ma:skuju:nu'ní:n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>chu:ntzá: wampaláj i'xka:maxki:kán i'xka:maxki:palakán pu:la:siyájna' [ti:] ti: xanapuxkú'nu'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>he: ma:yú:lhnu'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>a:li:stá:n chu:wá a'kxní tza'má [i'x] … tza'má dieciséis xhelhkaujcha:xán diciembre la:ma:he:sto'ho:kán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>li:tachiwi:nikaní:' tza'má ti: na:á'n [li:…] li:púxku' [ma:skuju: … púxku']</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>ti: naá'n li:puxku:'ma:yú:lh li:pixka:lhteniénte</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>a:li:stá:n chu:wá i'xtzukukán la'hwá: ho'tkán [nak …] naki'xchík tza'má ho:lu:pi:xkálh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>ti: ja: i'xchá:'n paláj pus i'xa'hxte'he:ya:wa:ni'kán a'htín nakpá:su'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>chu:ntzá: chi' ma'hla'htzá' makaskujkaní:' wa:má [ma:...] wili:ni'má:ka' nakpá:su' a'hxte'he:ni'má:ka'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>a:li:stá:n chu:wá tza'má a'kxní [nak… na: … naka:ki … naka:' …] a'nkán ka:tanlha'hate:kán na'ixchikán ti: ja: paláj i'xchá:'n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>ixwi:lhtza' ixkuchu'kani:' tu: ka'axte'he: ya:wa:nikani:' naka'tin nakpasu' xahalha'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>entonces, tza'má [i'x …] i'xka:ma:wani:ho:'kán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>chu:wá [i'x …] ti: ja: i'xwaku'tún kuwésa i'xma:wi:kán he: ti: ja: i'xwaku'tún i'xli:ma:makawani:kán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>a:li:stá:n chu:wá tza'má i'xa'hsputkán tza'má [la'ho:] la'hwá: ha'chi:ho:'kán ásta chi' i'x’a'ha:hó:' la'hwá: ha'chi:ho:'kani:'tzá'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>i'xtalaktilhkán pero ma'htín la'hwá: ha'chi:kán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>chu:wá a:li:stá:n nataxtutzá' sikwalán i'xli:sma:lanhán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>[i'x … i'x … i'x … prime: …] chi' ma'htín a'kxní [el … tza'má …] i'xtaxtú i'xli:sma:lanhán tza'má sikwalán [i'x …]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>tza'má ma:yú:lhnu' [i'x … i'x … i'xtala: …] ixtala'htawahá: a'kxní ja:'n a'kxní tza'má chi' pa:lhe'hé: ka:'wa'yát</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>a:li:stá:n chu:wá tza'má a'kxní ixa'kchintzá' nataxtú sikwalán [i'x … i'x… ] ixtaá'n [ta:…] talhí: [ja: … ja:]… ja: xcha:'n sikwalán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>a:li:stá:n [ix] chi: tza'má ixtaá'n talhí ka:'tzí'sa' he: xaka:'kuwiní i'xka:ma:wi:kán i'xka:ma:wa'htu:kán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>chu:wá a'kxní xpa:lhe'he:pala'hó:' tza'má ásta a'kxní i'xchín tza'má el veinticinco, el veinticuatro, el veinticinco [i'x …] i'xla'hwá: tasto'ho:'kán li:lhú:wa'tu'nká'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>i'xla'hwa:a'nkán naksikwalán [la'hwa: …] la'hwa:lhi:kán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>he: chu:wá la pánhni' ixtatama:wá: ma:yú:lhnu' he: chu:wá pixká:lhna' tza'má pánhni' tu: [x] i'xlhkuyu:kán naksikwalán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>a:li:stá:n tza'má [i'x …] i'xlahó:' tza'má [i'x … i'x …] tzi'sajtzá' i'xtalaktilhkán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
