    <TIER LINGUISTIC_TYPE_REF="%xspa" PARENT_REF="*BR2"
        PARTICIPANT="BR2" TIER_ID="%xspa@BR2">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann496" ANNOTATION_REF="ann495">
                <ANNOTATION_VALUE>tráelo tu carro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann499" ANNOTATION_REF="ann497">
                <ANNOTATION_VALUE>no vas a jugar?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann503" ANNOTATION_REF="ann502">
                <ANNOTATION_VALUE>éste nomás siempre los rebasa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann514" ANNOTATION_REF="ann513">
                <ANNOTATION_VALUE>mira ése ya viene llegando José.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann520" ANNOTATION_REF="ann519">
                <ANNOTATION_VALUE>ya los pasó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann523" ANNOTATION_REF="ann522">
                <ANNOTATION_VALUE>mira lo tumbaron tu carro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann525" ANNOTATION_REF="ann524">
                <ANNOTATION_VALUE>José mira cómo lo tumbaron tu carro lo pasaron a tumbar todo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann528" ANNOTATION_REF="ann527">
                <ANNOTATION_VALUE>a ver dámelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann536" ANNOTATION_REF="ann535">
                <ANNOTATION_VALUE>Pedro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann538" ANNOTATION_REF="ann537">
                <ANNOTATION_VALUE>mira José es que ya los enterraron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann559" ANNOTATION_REF="ann558">
                <ANNOTATION_VALUE>es que así está de lado y es que así se va uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann567" ANNOTATION_REF="ann566">
                <ANNOTATION_VALUE>pues hay que desenterrarlo ya.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann573" ANNOTATION_REF="ann572">
                <ANNOTATION_VALUE>ih es que ya lo llevan la moto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann583" ANNOTATION_REF="ann582">
                <ANNOTATION_VALUE>qué? es un coche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann587" ANNOTATION_REF="ann586">
                <ANNOTATION_VALUE>vas a traer el arpón.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann590" ANNOTATION_REF="ann589">
                <ANNOTATION_VALUE>no lo juegues la tierra, dicen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann604" ANNOTATION_REF="ann603">
                <ANNOTATION_VALUE>vamos a hacer otra vez el camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann606" ANNOTATION_REF="ann605">
                <ANNOTATION_VALUE>hay que hacerlo ya.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann608" ANNOTATION_REF="ann607">
                <ANNOTATION_VALUE>ya aquí está, ya no.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann612" ANNOTATION_REF="ann611">
                <ANNOTATION_VALUE>tú vas a hacerlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann614" ANNOTATION_REF="ann613">
                <ANNOTATION_VALUE>vamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann617" ANNOTATION_REF="ann616">
                <ANNOTATION_VALUE>a donde lo estoy empezando lo vas a empezar tú.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann624" ANNOTATION_REF="ann623">
                <ANNOTATION_VALUE>ay se queman los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann633" ANNOTATION_REF="ann632">
                <ANNOTATION_VALUE>el ancho es que es así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann638" ANNOTATION_REF="ann637">
                <ANNOTATION_VALUE>es que así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann644" ANNOTATION_REF="ann643">
                <ANNOTATION_VALUE>es que así José mira.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann646" ANNOTATION_REF="ann645">
                <ANNOTATION_VALUE>es que así los van tumbando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann652" ANNOTATION_REF="ann651">
                <ANNOTATION_VALUE>pero / aunque a poco / la verdad sí es tu piedra?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann658" ANNOTATION_REF="ann657">
                <ANNOTATION_VALUE>lo vas a traer más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann666" ANNOTATION_REF="ann665">
                <ANNOTATION_VALUE>a dónde lo fuiste a traer papá?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann677" ANNOTATION_REF="ann676">
                <ANNOTATION_VALUE>se queman los pies, verdad?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann681" ANNOTATION_REF="ann680">
                <ANNOTATION_VALUE>no mira allí se queman los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann683" ANNOTATION_REF="ann682">
                <ANNOTATION_VALUE>no te vayas a venir papá nomás yo vengo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann696" ANNOTATION_REF="ann695">
                <ANNOTATION_VALUE>yo ya aquí voy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann700" ANNOTATION_REF="ann699">
                <ANNOTATION_VALUE>cuando vas a terminar José, verdad que aquí lo vamos a empezar otra vez?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann714" ANNOTATION_REF="ann713">
                <ANNOTATION_VALUE>así y así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann716" ANNOTATION_REF="ann715">
                <ANNOTATION_VALUE>ya lo estás viendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann718" ANNOTATION_REF="ann717">
                <ANNOTATION_VALUE>yo voy a juntar más piedra y la voy a traer aquí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann720" ANNOTATION_REF="ann719">
                <ANNOTATION_VALUE>ayúdame a juntarlos ya va a empezar otra vez.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann725" ANNOTATION_REF="ann724">
                <ANNOTATION_VALUE>ayúdame a juntarlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann727" ANNOTATION_REF="ann726">
                <ANNOTATION_VALUE>mira aquí papá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann730" ANNOTATION_REF="ann729">
                <ANNOTATION_VALUE>ya fue a traer otra vez.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann760" ANNOTATION_REF="ann759">
                <ANNOTATION_VALUE>ayúdame a hacerlo papá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann766" ANNOTATION_REF="ann765">
                <ANNOTATION_VALUE>mira el mío José cómo lo llevo y el tuyo está más grande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann768" ANNOTATION_REF="ann767">
                <ANNOTATION_VALUE>y el mío no está muy grande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann770" ANNOTATION_REF="ann769">
                <ANNOTATION_VALUE>mira así lo voy a hacer mi volteo como o.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann774" ANNOTATION_REF="ann773">
                <ANNOTATION_VALUE>mejor hay que llevarlas así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann776" ANNOTATION_REF="ann775">
                <ANNOTATION_VALUE>me vas a ayudar José para terminar luego.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann780" ANNOTATION_REF="ann779">
                <ANNOTATION_VALUE>me vas a ayudar a hacerlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann788" ANNOTATION_REF="ann787">
                <ANNOTATION_VALUE>ahora ayúdame a hacerlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann790" ANNOTATION_REF="ann789">
                <ANNOTATION_VALUE>José ayúdame.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann792" ANNOTATION_REF="ann791">
                <ANNOTATION_VALUE>ayúdame, sí?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann794" ANNOTATION_REF="ann793">
                <ANNOTATION_VALUE>el mío todavía hay mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann807" ANNOTATION_REF="ann806">
                <ANNOTATION_VALUE>no me lo crees.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann811" ANNOTATION_REF="ann810">
                <ANNOTATION_VALUE>va a ser mucho el tuyo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann816" ANNOTATION_REF="ann815">
                <ANNOTATION_VALUE>no no vayas a pisarlo es que le dicen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann818" ANNOTATION_REF="ann817">
                <ANNOTATION_VALUE>yo ya voy a terminar ya no te voy a ayudar José.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann826" ANNOTATION_REF="ann825">
                <ANNOTATION_VALUE>no ya es poquito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann828" ANNOTATION_REF="ann827">
                <ANNOTATION_VALUE>mira ahí voy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann865" ANNOTATION_REF="ann864">
                <ANNOTATION_VALUE>dulce.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann869" ANNOTATION_REF="ann868">
                <ANNOTATION_VALUE>yo ya estoy terminando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann879" ANNOTATION_REF="ann878">
                <ANNOTATION_VALUE>ahora ya voy a terminar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann886" ANNOTATION_REF="ann885">
                <ANNOTATION_VALUE>hay que jugar José.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann888" ANNOTATION_REF="ann887">
                <ANNOTATION_VALUE>voy a traer mi moto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann896" ANNOTATION_REF="ann895">
                <ANNOTATION_VALUE>ahí va a entrar ése?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann898" ANNOTATION_REF="ann897">
                <ANNOTATION_VALUE>el mío mira cómo va.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann900" ANNOTATION_REF="ann899">
                <ANNOTATION_VALUE>y después otra vez.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann902" ANNOTATION_REF="ann901">
                <ANNOTATION_VALUE>ahí voy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann912" ANNOTATION_REF="ann911">
                <ANNOTATION_VALUE>y dónde va a entrar?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann916" ANNOTATION_REF="ann915">
                <ANNOTATION_VALUE>hay que hacerlo otra entrada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann920" ANNOTATION_REF="ann919">
                <ANNOTATION_VALUE>mira ése ése ya va a entrar pero mira no entró.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann936" ANNOTATION_REF="ann935">
                <ANNOTATION_VALUE>tú ya no sabes por dónde entró.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann942" ANNOTATION_REF="ann941">
                <ANNOTATION_VALUE>mira lo está mirando del árbol se subió arriba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann958" ANNOTATION_REF="ann957">
                <ANNOTATION_VALUE>mira es ya no sabe adónde está la entrada es que ya nomás se va a entrar ahí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann960" ANNOTATION_REF="ann959">
                <ANNOTATION_VALUE>José es que bájate, no vas a jugar?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann962" ANNOTATION_REF="ann961">
                <ANNOTATION_VALUE>mira es que el carro grande lo tiene tapado el camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann964" ANNOTATION_REF="ann963">
                <ANNOTATION_VALUE>no vas a jugar José?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann968" ANNOTATION_REF="ann967">
                <ANNOTATION_VALUE>pues órale.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
