    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Text" PARENT_REF="Ex" TIER_ID="Line">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a41" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>cha:tu: arrieru ixtate:txtu a'htin ka:lakchíkni', he: … [00:04]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>cha:tu:, tzamá: li:ta:timín xka:wanikan [00:07]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a43" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>katu:walh ixtasta ho: xtaa'n takiwilalh [00:11]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>chi: ixkilhtun ka:lakchikni' [00:14]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>tiwana ixtatetaxku chatu: arieru tiwana ixka:la’htzinkan [00:18</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>cha:tin wan lehtza iklahati chatin chi ixchatukan le:n [00:23]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a47" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>li:hermana [00:25]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>pus, kit, chuwa kit ika:li:patilh chuwa naika:chipá [00:29]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>naika:lhawá [00:32]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>ja: chuntzá kalá', porque [00:36]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>wa:tzá ka:lakchikni li:pálha wi:lh tzamá: [00:39]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>li:ma:pa’hsi:n nachi:kána’, wani [00:43]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>kala:lh tu: nalá: kit naikalhawa [00:47]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>he yujli ixburro he chi:ya:wa:lh naki’wi’ [00:52]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>kala’ha’nta:'kilh chipalh ka:le:hama:nalh ixcha:tu:kan [00:57]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>ali:sta:n tate:wayalh tzama arieru [01:02]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>tatetaxtulh puhitat ja yalh puchiwin [01:05]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>chuwa tzamá: … tzamá: puska:n chi: kawanikan las dos hermana [LB cha:tu: li:ta:timin] [01:11]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>taa’lh tatalakapuni juez chuwa akxni tachalh nakalakchikni [01:18]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>lakapajtzu nakpuchiwin kalahapastohmakatzá ka:chipakán [01:23]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>kama:chohoka’ kamanuka nakpuchiwin  [01:29]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a61" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>tzukulh helhaskiní arieru juez  [01:33]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
