        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a241" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>pus wamá: hawácha' ixta:tá' tzamá: la'hatín &lt;u&gt;mono&lt;/u&gt;, &lt;u&gt;mono&lt;/u&gt; tzamá: ixta:tá'**</ANNOTATION_VALUE>
