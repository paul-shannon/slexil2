            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>ja: le: porque animá:lh ixwaní:' tzamá: hawácha'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>ja: le:**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>ixka:lhawastí: lakstín**</ANNOTATION_VALUE>
