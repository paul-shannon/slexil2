        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a236" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>tahelhaski'ní chi: li:lí:ta' wamá: hawácha' wa:tzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a237" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>ti: ya: hawácha'?**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a238" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>tatzukúlh tahelhaski'ní porque ja: tzej tala'htzín chu:n animá:lh tala'htzín**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a239" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>pus wamá: hawácha', kinhawácha', wánli' tzamá: puská:t, kinhawácha'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a240" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>pero chi: minhawácha' lháwa'? [li:lháwa']**</ANNOTATION_VALUE>
