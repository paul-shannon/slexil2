        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a227" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>bueno li:chá:nka' tzamá: hawácha' a'ntzá naixchík tzamá: puská:t**</ANNOTATION_VALUE>
