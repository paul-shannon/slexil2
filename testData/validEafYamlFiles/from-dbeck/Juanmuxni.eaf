        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a230" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>chi: talá kristiánus, tajikwán**</ANNOTATION_VALUE>
