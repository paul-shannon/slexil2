        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a462" ANNOTATION_REF="a407">
                <ANNOTATION_VALUE>ka:ki:ma:tayí:lh tzamá:**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a463" ANNOTATION_REF="a408">
                <ANNOTATION_VALUE>ka:ma:kukí:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a464" ANNOTATION_REF="a409">
                <ANNOTATION_VALUE>u:tzá tali:mima:'nálh tzamá: kí'wi' tu: nali:lhawá ixchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a465" ANNOTATION_REF="a410">
                <ANNOTATION_VALUE>chi: li:chá:lh naixpueblo**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a466" ANNOTATION_REF="a411">
                <ANNOTATION_VALUE>jee kristiánu' chi: tajikwán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a467" ANNOTATION_REF="a412">
                <ANNOTATION_VALUE>tajikwán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a468" ANNOTATION_REF="a413">
                <ANNOTATION_VALUE>ásta ja: le: chi: talá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a469" ANNOTATION_REF="a414">
                <ANNOTATION_VALUE>porque chi: tajikwán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a470" ANNOTATION_REF="a415">
                <ANNOTATION_VALUE>tzamá: leon, tigre**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a471" ANNOTATION_REF="a416">
                <ANNOTATION_VALUE>tzamá: misín, pero chi: ta'sate:lhá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a472" ANNOTATION_REF="a417">
                <ANNOTATION_VALUE>leon chu:ntzá ta'sate:lhá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a473" ANNOTATION_REF="a418">
                <ANNOTATION_VALUE>elefante juuta chi: ta'sate:lhá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a419">
                <ANNOTATION_VALUE>wachitzá wa:káx ta'sate:lhá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a475" ANNOTATION_REF="a420">
                <ANNOTATION_VALUE>chi: ja:tzá pa:tí: chi: li:mimá:lh kí'wi'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a476" ANNOTATION_REF="a421">
                <ANNOTATION_VALUE>oso chu:ntzá wampaláj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a422">
                <ANNOTATION_VALUE>pus tzamá: kristiánu' tzamá: tajikwánli' chi: li:chá:lh naixchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a423">
                <ANNOTATION_VALUE>jee chi: talá kristiánu' chi: tajikwán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a424">
                <ANNOTATION_VALUE>pus tzamá: hawácha' ja: le: chi: la pero chi: nalá porque pus ma:skí tajikwán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a425">
                <ANNOTATION_VALUE>pero xla ja: ka:lhawaní kwé:nta**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a426">
                <ANNOTATION_VALUE>he: xla lhawakutumá:lh ixchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a427">
                <ANNOTATION_VALUE>pero kristiánu' ja: ka:mininí: porque tzaj chi: tajikwán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a483" ANNOTATION_REF="a428">
                <ANNOTATION_VALUE>tala'htzín ja: kristiánu' tzamá: hawácha'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a484" ANNOTATION_REF="a429">
                <ANNOTATION_VALUE>tala'htzín wachitzá animá:lh he: xli:ká:na' animá:lh porque ixta:tá' mono**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a485" ANNOTATION_REF="a430">
                <ANNOTATION_VALUE>ixta:tá' tzamá: mono, u:tzá tzamá: chu:ntzá li:taxtúlh tzamá: hawácha'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a486" ANNOTATION_REF="a431">
                <ANNOTATION_VALUE>pero ja:tzá le: chi: la ixtzí:', porque pus a'ntzá ixchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a432">
                <ANNOTATION_VALUE>a'ntzá ki:tawila:pálh tzamá: ixtzí:' tzamá: hawácha'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a433">
                <ANNOTATION_VALUE>he: a'ntzá tawilapálh tzamá: hawácha'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
