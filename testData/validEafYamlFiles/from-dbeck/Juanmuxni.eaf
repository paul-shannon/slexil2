        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a229" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>juuta tzamá: kristiánus a'ntzá naixchík tzamá: ixtzí:' le'htzá chi: tajikwán**</ANNOTATION_VALUE>
