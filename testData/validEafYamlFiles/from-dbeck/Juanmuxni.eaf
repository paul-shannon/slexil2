    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Text" PARENT_REF="Ex" TIER_ID="Line">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>pus ma'htín, tzamá: ixwí:lh cha:tín pu:skát ti: li:xkamaní:n ixwí:lh naixchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>pus chi: li:xkamaní:n ixwí:lh naixchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a8" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>ja: ti: ti: ixlhawaní taskujút**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a9" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>pus u:tzá ixtaxtú he: ixá'n ki'wi'lá: naka:'takúxtu'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a10" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>ixá'n ki'wi'lá:**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>a:li:stá:n chi: tiwána ixá'n ki'wi'lá: ki:tala:manó'hlhli' la'hatín tzamá: &lt;u&gt;mono&lt;/u&gt;**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>ki:tala:manó'hlhli'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>chi: ki:tala:manó'hlhli' tzamá: mono**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a47" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>tzamá: mono tu: lhawálh le:nta:'kí:lh tzamá: puská:t**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>le:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>ki:ma:nú:lh ja: ixamá:lh tzamá: mono**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>a'ntzá ki:ma:nú:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>ja: tzej ixwí:lh ixchík tzamá: mono**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>a'ntzá ki:ma:nú:lh tzamá: puská:t**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>he: chi: ixli:ma'há:'s**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>chi: ixli:ma'há:'s**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>tzamá: tawí:lh cha:tín is’á'ta' tzamá: mono**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>tawí:lh cha:tín is’á'ta'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>pus tzamá: s’á'ta' chi: tawí:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>anima:lhtunká ixwaní:' tzamá: is’á'ta' tzamá: &lt;u&gt;mono&lt;/u&gt; [PS: xanimalhtunká]**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>anima:lhtunká ixwaní:', cha: xma:ntunká ixlakán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>cha: xma:ntunká ixlakán kristiánu' ixtasuyú pero xma:ntunká ixlakán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a61" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>chi: ixtujanín taje:tzá chi: ixha'lhlí: ixchixít**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a62" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>ixmakanín chu:ntzá wampaláj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a63" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>chi: naixmákni' chu:ntzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>wa:'h chixít ixlaho:ní:' ixmákni' porque is’á'ta' mono ixwaní:' tzamá: hawácha'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>bueno tzamá: hawácha' tzukúlh stáka a'ntzá ja: naixchík tzamá: mono**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>tzukúlh stáka**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>akxní stakli'tzá tzamá: hawácha' tzukúlh helhaski'ní ixtzí:'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>waní ixtzí:', bueno chi: li:wilanáuj wa:tzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>wa:tzá wachí ja: tzej ja: wila:náuj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>ka:'lhkájwa ja: wila:náuj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>juuta pus xli:ká:na', waní ixtzí:'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a193" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>xli:ká:na' chi:tzá wána' ka:'lhkájwa ja: wila:náuj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a194" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>porque wa:tzá ixchík tzamá: mono**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a195" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>ixchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a196" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>u:tzá li:wilanáuj wa:tzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a197" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>he: chi: li:taní:'ta' tzamá: mono?**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a198" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>pus, tzamá: [xak] ki'wi'la:lha:'wá:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a199" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>kimanó'hlhli' a'ntzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a200" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>he: ásta ja: kili:mílh wa:tzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a201" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>wa:tzá kili:mílh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a202" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>pus u:tzá chu:wá u:tzá wix li:tawíla' chu:wá wa:tzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a203" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>he: chu:wá chi: tzamá: stakpa:'tzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a204" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>he: palh a:chulá: naktawilayá:j wa:tzá ja: naixchík tzamá: mono**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a205" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>pus naá'n nampalá mistánku' wampaláj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a206" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>chi: xli:ma'há:'s naá'n nampalá mistánku'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a207" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>pus tzamá: hawácha' ja: tzej hexmá'tli'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a208" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>mat wanílh ixtzí:'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a209" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>juutale pus ja: tzej chi: tzamá: xatzéj tzaj ka'mpaláuj naminchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a210" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>kaa'mpaláuj katapa:nú:j wa:tzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>pero ja: le: chi: layá:uj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a212" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>ja: le: chi: layá:uj, porque tzamá: mintá:ta' kinka:ma'hta'halhmá:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a213" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>pero chi: kinka:li:ma'hta'halhmá:n a'mpu'tzá tu: wayá:j**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a214" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>a'mpu'tzá naka:'takúxtu' tu: wáya'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>pus akxní a'mpu'tzá i:nú akxní natza:'laya:ujtzá kinán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>ja: katikatzí:lh chi: natza:'layá:uj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>pero chi: naki:li:pína' porque ka:'lhkájwa wa:tzá, waní ixhawácha'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>pus kit ikatzí: chi: nakle:ná:n, wánli' tzamá: hawácha'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>kit ikatzí: chi: tzej nakle:ná:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a220" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>pero s’a'ta'kús wix ja: le: katila:lé:uj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a221" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>ja: le: katiáuj tzenú:, ja: cha:n, ka:'lhkájwa**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a222" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>tzej nawán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>ásta ja: tilé:lh ixtzí:' [hasta ja: tile:né:lh PS]**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a224" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>kuwésa le:lh a'ntzá ja: naixchík tzamá: ixtzí:'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a225" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>ja: naixchík tzamá: ixtzí:'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a226" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>kuwésa le:lh a'ntzá**</ANNOTATION_VALUE>
