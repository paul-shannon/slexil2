        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a234" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>juuta chi: tajikwán tzamá: kristiánus a'ntzá naixchík tzamá: ixtzí:'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a235" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>tatzukúlh tahelhaski'ní tzamá: puská:t**</ANNOTATION_VALUE>
