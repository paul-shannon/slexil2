        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a253" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>chi: lakpuwána'?**</ANNOTATION_VALUE>
