            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a398">
                <ANNOTATION_VALUE>kit ikatzí: chi: tzej naktayá: tzamá: kí'wi'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a454" ANNOTATION_REF="a399">
                <ANNOTATION_VALUE>naiká'n la'halí: pu'tzá tzamá: kí'wi'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a455" ANNOTATION_REF="a400">
                <ANNOTATION_VALUE>he: nala'htzína' palh ja: nakli:mín tzamá: kí'wi' tu: nakli:lhawayáj tzamá: chik**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a456" ANNOTATION_REF="a401">
                <ANNOTATION_VALUE>a'nta:'kí:lh chi: la'halí: naka:'takúxtu'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a457" ANNOTATION_REF="a402">
