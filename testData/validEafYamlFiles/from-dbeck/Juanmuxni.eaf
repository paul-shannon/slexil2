        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a461" ANNOTATION_REF="a406">
                <ANNOTATION_VALUE>pus wa:'h animá:lh tu: tawanán**</ANNOTATION_VALUE>
