        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>a:li:stá:n tzamá: puská:n pus ja: tzej aná: tala'htzín**</ANNOTATION_VALUE>
