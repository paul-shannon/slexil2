        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>'pues yo era el que estaba en el arbol, es que le dice'</ANNOTATION_VALUE>
