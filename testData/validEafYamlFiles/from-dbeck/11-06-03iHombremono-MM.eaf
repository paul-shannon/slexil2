                <ANNOTATION_VALUE>y en medio de los cerros la tenía</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>la tenía allí mucho tiempo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>y aunque la buscaban mucho, donde, donde no va a encontrar donde la había puesto</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>no la encontraban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>con trabajo la encontraban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a141" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>es que, cuando salía el mono en cualquier lugar donde iba a pasear</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>¿como nadie sabía [que] el mono … o sea, sabían [que era] el mono o no sabía cuando llevo a la mujer?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a143" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>puede ser que se sabía que venía pero no sabián mas que eso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a144" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>aunque supieras cuando la llevó, y … nadie sabía a donde llegaba con ella</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a145" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>la mujer empezaba a decir, e</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>empezaba a decir, tal vez [= tu cha] cuando no estaba el mono </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a147" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>tal vez ya no quedaba lejos del punto del cerro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a148" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>cuando fueron a traer a la mujer, vino [el mono] mucho andaba preguntando [por ella]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a149" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>and what did he say?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a150" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>es que, digo, la buscaba, es que, mujer, mujer, decia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a151" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>tu jijo, tu jijo, decía [deliberate mispronunciation[</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a152" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>es que decia, asi platicaban, es que …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a153" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>si es que antes decian que no se podian andar las mujers</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>las venian a llevar, por eso les decia asi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a155" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>Atilano mucho sabía contar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a156" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>muxer, muxer, decia el mono, dice</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a157" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>asi él sabia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>es él que decia eso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a159" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>ya no pudo ir</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>despues quien sabe tal vez y se fue tranquilo[se acabó] o así</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a161" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>si … nadie … es que … tal vez nadie lo mataba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>ya no llevo su mujer?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a163" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>y ese hijo que tenia en el cerro?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a164" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>¿qué va a pensar la mujer de ir a ver otra vez a su hijo?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a165" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>mm … cuando va a ir?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>ya no quiere ir por que solo se tuvo que venir huyendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a167" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>lo sacaron con laso y la sacaraon así para arriba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
