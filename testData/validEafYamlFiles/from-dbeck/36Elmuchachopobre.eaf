                <ANNOTATION_VALUE>36.605 matʔakšnií laː čiwiːnanqúːɫ tamaá qawása , tunkunhtaːtatampuːštúɫ špuskáːt kpuːtapaːšawaán , ʔakštamhʔanqúːɫ kščikkán .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann1211" TIME_SLOT_REF1="ts1213" TIME_SLOT_REF2="ts1214">
                <ANNOTATION_VALUE>36.606 čiː waá ¢umáːt tiː taskinhšwaníːt , ʔantiyaá tamaqaštáqɫi .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann1213" TIME_SLOT_REF1="ts1215" TIME_SLOT_REF2="ts1216">
                <ANNOTATION_VALUE>36.609 tunkunhpuːtamh¢ukuquːkaá tatampuːštaquːkán .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann1215" TIME_SLOT_REF1="ts1217" TIME_SLOT_REF2="ts1218">
                <ANNOTATION_VALUE>36.607 liːpiːkwaá ¢ukuɫtasašnií ʔakšnií qašmátɫii piːnaːɫtaːtapuːčawamaːká .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann1217" TIME_SLOT_REF1="ts1219" TIME_SLOT_REF2="ts1220">
                <ANNOTATION_VALUE>36.608 nuːymaá liːlakláɫ tapaːšawaán , tiːniːʔaːɫtanλíːɫ .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann1219" TIME_SLOT_REF1="ts1221" TIME_SLOT_REF2="ts1222">
                <ANNOTATION_VALUE>36.610 naːliːpiːkwaá ¢ukuquːɫtaliːpuwaaniiqúː šnaλaːtnií ¢umáːt .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann1221" TIME_SLOT_REF1="ts1223" TIME_SLOT_REF2="ts1224">
                <ANNOTATION_VALUE>36.611. špaːlakátaa piːkahšamaqtám maqaštaqkaá š¢umaːtkán .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann1223" TIME_SLOT_REF1="ts1225" TIME_SLOT_REF2="ts1226">
                <ANNOTATION_VALUE>36.612. niːkšniišlakapaːstakqúː papiːčanaá naaqspuluniːniqúː š¢umaːtkán . .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann1225" TIME_SLOT_REF1="ts1227" TIME_SLOT_REF2="ts1228">
                <ANNOTATION_VALUE>36.613 nuːmaá liːqaɫspútaa tačiwíːn .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="ft" PARENT_REF="Totonac" PARTICIPANT="unknown" TIER_ID="Spanish">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2" ANNOTATION_REF="ann1">
                <ANNOTATION_VALUE>vivía un muchacho era completamente pobre y ya habían muerto todos sus padres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann4" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>no había quién lo protegiera , vivía ya solo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann6" ANNOTATION_REF="ann5">
                <ANNOTATION_VALUE>en donde estaba hospedado no lo trataban bien , le pegaban mucho y lo regañaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann7">
                <ANNOTATION_VALUE>no le tenían ninguna consideración aunque a pesar de que era mucho lo que le hacían trabajar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>lo humillaban nada más y no se conformaban con su trabajo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann12" ANNOTATION_REF="ann11">
                <ANNOTATION_VALUE>se dió cuenta el muchacho que no era un consejo que le daban cuando lo regañaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann13">
                <ANNOTATION_VALUE>nada más porque así lo señalaban ( y ) no lo querían.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>todos los días lo martirizaban pegándole.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann18" ANNOTATION_REF="ann17">
                <ANNOTATION_VALUE>andaba sin sentirse bien de su cuerpo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann19">
                <ANNOTATION_VALUE>todo el tiempo andaba adolorido , es porque le pegaban sin límite.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>dizque a donde lo mandaban a leñar a aquel muchacho,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann24" ANNOTATION_REF="ann23">
                <ANNOTATION_VALUE>a veces allá iba a pasar la noche cuando lo mandaban ya tarde.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann25">
                <ANNOTATION_VALUE>ya no le daba tiempo para regresar , mejor de una vez se quedaba por allá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>hasta al otro día muy temprano regresaba con la leña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann30" ANNOTATION_REF="ann29">
                <ANNOTATION_VALUE>no le preguntaban nada a dónde se quedaba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann31">
                <ANNOTATION_VALUE>tampoco lo extrañaban en las tardes cuando no llegaba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>parece como si él no fuera hijo de dios por el concepto que le tenían.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann36" ANNOTATION_REF="ann35">
                <ANNOTATION_VALUE>no se compadecían de él , pasaba la noche en un campo libre ( raso ) allá por donde iba a leñar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann37">
                <ANNOTATION_VALUE>pobre del muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>dizque con frecuencia se sentaba a llorar en su leñadero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann42" ANNOTATION_REF="ann41">
                <ANNOTATION_VALUE>era porque se acordaba de sus padres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann43">
                <ANNOTATION_VALUE>también se acordaba cómo lo regañaban y le pegaban nada más porque sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>dizque cuando el muchacho pasó la noche por última vez en su leñadero , de repente vió venirse hacia él un águila aura grande , volando a media noche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann48" ANNOTATION_REF="ann47">
                <ANNOTATION_VALUE>no tardó de estar dando la vuelta ( circulando ) para llegar a donde estaba el muchacho durmiendo , llegó rápidamente hacia él.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann50" ANNOTATION_REF="ann49">
                <ANNOTATION_VALUE>comenzó a decirle así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann52" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>" muchacho , qué estás haciendo por aquí tú solo, no tienes miedo ?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann54" ANNOTATION_REF="ann53">
                <ANNOTATION_VALUE>quién ha hecho para que vinieras lejos en la noche ?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann56" ANNOTATION_REF="ann55">
                <ANNOTATION_VALUE>quién te ha perdido en estos montes ? "</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann58" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>el muchacho contestó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann60" ANNOTATION_REF="ann59">
                <ANNOTATION_VALUE>" nadie me ha perdido si me ves que me encuentro solo por aquí en estos montes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann62" ANNOTATION_REF="ann61">
                <ANNOTATION_VALUE>porque vinieron a mandarme a leñar ya muy tarde , ya no pude regresar a mi pueblo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann64" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>por eso ahora me quedé aquí mismo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann66" ANNOTATION_REF="ann65">
                <ANNOTATION_VALUE>ya no emprendí mi camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann68" ANNOTATION_REF="ann67">
                <ANNOTATION_VALUE>completé mi carga ya anocheciendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann70" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>mejor temprano me voy , pensé.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann72" ANNOTATION_REF="ann71">
                <ANNOTATION_VALUE>ya no tengo miedo ahora que me encontraste , porque ya son varias veces que paso la noche por aquí en mi leñadero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann74" ANNOTATION_REF="ann73">
                <ANNOTATION_VALUE>no es la única vez ( que ) me han mandado ( aquí ) ya muy tarde.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann76" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>todo el tiempo así me tratan , no me consideran si no es hora ya a que venga a dar la vuelta hasta acá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann78" ANNOTATION_REF="ann77">
                <ANNOTATION_VALUE>nunca me toman en cuenta no me tienen en consideración.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann80" ANNOTATION_REF="ann79">
                <ANNOTATION_VALUE>se debe porque nada más estoy arrimado en donde estoy trabajando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann82" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>ya hace tiempo que se murieron mis padres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann84" ANNOTATION_REF="ann83">
                <ANNOTATION_VALUE>por eso nada más estoy aguantando como me tratan me hacen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann86" ANNOTATION_REF="ann85">
                <ANNOTATION_VALUE>nadie me defiende.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann88" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>ya nada más yo solo he quedado , también todos mis hermanos han muerto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann90" ANNOTATION_REF="ann89">
                <ANNOTATION_VALUE>creo ( que ) sería bueno hubiera muerto yo también porque no vivo feliz.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann92" ANNOTATION_REF="ann91">
                <ANNOTATION_VALUE>solamente estoy escuchando regaños todos los días.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann94" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>ya no quisiera escucharlo que me dijeran ( algo ) , cuando llegue allá ya nada más porque sí ".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann96" ANNOTATION_REF="ann95">
                <ANNOTATION_VALUE></ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann98" ANNOTATION_REF="ann97">
                <ANNOTATION_VALUE>y el águila nada más estaba parado escuchando lo que el muchacho decía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann100" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>cuando acabó de hablar aquel muchacho , luego hizo preguntas el águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann102" ANNOTATION_REF="ann101">
                <ANNOTATION_VALUE>dijo así ( habló así ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann104" ANNOTATION_REF="ann103">
                <ANNOTATION_VALUE>" quieres ir al mundo del otro lado de donde yo vengo ?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann106" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>allá nadie te va a molestar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann108" ANNOTATION_REF="ann107">
                <ANNOTATION_VALUE>por allá vivirás muy contento si vas a aceptar ( ir allá ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann110" ANNOTATION_REF="ann109">
                <ANNOTATION_VALUE>nadie te va a hacer trabajar como te hacen trabajar por aquí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann112" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>tampoco habrá quién te regañe nada más porque sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann114" ANNOTATION_REF="ann113">
                <ANNOTATION_VALUE>serás bien asistido y no te pasará nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann116" ANNOTATION_REF="ann115">
                <ANNOTATION_VALUE>si vas a ir con seguridad , ? aceptas lo que te dije que allá vivirás mejor ?.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann118" ANNOTATION_REF="ann117">
                <ANNOTATION_VALUE>ya no sufrirás como te están haciendo sufrir por aquí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann120" ANNOTATION_REF="ann119">
                <ANNOTATION_VALUE>mañana te paso a traer en estas horas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann122" ANNOTATION_REF="ann121">
                <ANNOTATION_VALUE>no se te vaya a olvidar lo que te estoy diciendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann124" ANNOTATION_REF="ann123">
                <ANNOTATION_VALUE>ten presente ( en la memoria ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann126" ANNOTATION_REF="ann125">
                <ANNOTATION_VALUE>si pudiera llevarte ahora mismo , luego te hubiera llevado ya.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann128" ANNOTATION_REF="ann127">
                <ANNOTATION_VALUE>ya no sería necesario que viniera yo a traerte mañana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann130" ANNOTATION_REF="ann129">
                <ANNOTATION_VALUE>como primero tengo que advertirle a mi papá , si no lo hiciera así,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann132" ANNOTATION_REF="ann131">
                <ANNOTATION_VALUE>ha de querer comerte mi papá cuando te vea llegar conmigo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann134" ANNOTATION_REF="ann133">
                <ANNOTATION_VALUE>es mejor que le avise primero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann136" ANNOTATION_REF="ann135">
                <ANNOTATION_VALUE>ya no va a decir nada cuando lleguemos , te va a querer ".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann138" ANNOTATION_REF="ann137">
                <ANNOTATION_VALUE>el muchacho no alegó nada , aceptó lo que le dijeron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann140" ANNOTATION_REF="ann139">
                <ANNOTATION_VALUE>" acepto lo que me dijiste.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann142" ANNOTATION_REF="ann141">
                <ANNOTATION_VALUE>te lo agradezco mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann144" ANNOTATION_REF="ann143">
                <ANNOTATION_VALUE>no me imaginaba si traías buenos pensamientos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann146" ANNOTATION_REF="ann145">
                <ANNOTATION_VALUE>cuando te estaba mirando que venías acercándote hacia mí , poco a poco ibas descendiendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann148" ANNOTATION_REF="ann147">
                <ANNOTATION_VALUE>se está acercando hacia mí , - me va a espantar - estaba pensando - no me imaginaba si tú no venías pensando así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann150" ANNOTATION_REF="ann149">
                <ANNOTATION_VALUE>yo soy que nada más sin motivo había empezado a tener miedo , debido a que nunca te había visto todavía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann152" ANNOTATION_REF="ann151">
                <ANNOTATION_VALUE>apenas es la primera vez que estamos hablando ahora - dijo el muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann154" ANNOTATION_REF="ann153">
                <ANNOTATION_VALUE>cuando amaneció el muchacho se fué a donde era su destino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann156" ANNOTATION_REF="ann155">
                <ANNOTATION_VALUE>no dijo nada si algún lado irá a acompañar a la noche , nadie le preguntó tampoco en dónde había pasado la noche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann158" ANNOTATION_REF="ann157">
                <ANNOTATION_VALUE>se esfumó repentinamente en la tarde , emprendió el camino sin dar muestras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann160" ANNOTATION_REF="ann159">
                <ANNOTATION_VALUE>se fué directamente a donde le habián dicho que lo pasaban a traer y por eso se fué.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann162" ANNOTATION_REF="ann161">
                <ANNOTATION_VALUE>a nadie le avisó si se iba a retirar de donde estaba hospedado , nada más de repente se desapareció para siempre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann164" ANNOTATION_REF="ann163">
                <ANNOTATION_VALUE>nadie supo si hubo alguien ( uno ) quién se lo llevó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann166" ANNOTATION_REF="ann165">
                <ANNOTATION_VALUE>todos los que lo conocían platicaban que a veces iba a pasar la noche en el monte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann168" ANNOTATION_REF="ann167">
                <ANNOTATION_VALUE>es probable que por allá se lo comió el tigre o que murió solo andando entre los árboles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann170" ANNOTATION_REF="ann169">
                <ANNOTATION_VALUE>pasó un tiempo ya nadie lo recordó y se olvidaron de él.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann172" ANNOTATION_REF="ann171">
                <ANNOTATION_VALUE>no fué mentira lo que le platicaron a aquel muchacho , sí se lo llevaron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann174" ANNOTATION_REF="ann173">
                <ANNOTATION_VALUE>cuando salieron con él , " te agarras bien de mis brazos ( alas ),</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann176" ANNOTATION_REF="ann175">
                <ANNOTATION_VALUE>no los sueltes cuando yo vuele contigo y has de cerrar los ojos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann178" ANNOTATION_REF="ann177">
                <ANNOTATION_VALUE>y si no , te vas a marear mucho ......</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann180" ANNOTATION_REF="ann179">
                <ANNOTATION_VALUE>es mejor que no abras tus ojos " ( así ) le dijo el águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann182" ANNOTATION_REF="ann181">
                <ANNOTATION_VALUE>así hizo el muchacho como le dijeron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann184" ANNOTATION_REF="ann183">
                <ANNOTATION_VALUE>dizque cuando lo estaban llevando se iba mareando mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann186" ANNOTATION_REF="ann185">
                <ANNOTATION_VALUE>iba sintiendo que ya mero se desbarrancaba en el aire.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann188" ANNOTATION_REF="ann187">
                <ANNOTATION_VALUE>en ninguna parte pasaron a descansar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann190" ANNOTATION_REF="ann189">
                <ANNOTATION_VALUE>desde que emprendieron el camino se fueron derecho a donde termina la tierra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann192" ANNOTATION_REF="ann191">
                <ANNOTATION_VALUE>de día y de noche iban volando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann194" ANNOTATION_REF="ann193">
                <ANNOTATION_VALUE>descansaron cuando llegaron en donde termina la tierra el mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann196" ANNOTATION_REF="ann195">
                <ANNOTATION_VALUE>también allí por donde termina la tierra del otro lado mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann198" ANNOTATION_REF="ann197">
                <ANNOTATION_VALUE>allí estuvieron platicando los dos un gran rato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann200" ANNOTATION_REF="ann199">
                <ANNOTATION_VALUE>tan pronto como acabaron de descansar , emprendieron su camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann202" ANNOTATION_REF="ann201">
                <ANNOTATION_VALUE>se fueron derecho</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann204" ANNOTATION_REF="ann203">
                <ANNOTATION_VALUE>dizque apenas lo llevaban al muchacho , luego iba sintiendo que era distinto para donde iban a llegar con él ..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann206" ANNOTATION_REF="ann205">
                <ANNOTATION_VALUE>no era igual en el mundo de donde había salido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann208" ANNOTATION_REF="ann207">
                <ANNOTATION_VALUE>él luego iba dándose cuenta que ya es muy distinto más allá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann210" ANNOTATION_REF="ann209">
                <ANNOTATION_VALUE>dizque no le daba pesar que lo llevaban cargando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann212" ANNOTATION_REF="ann211">
                <ANNOTATION_VALUE>estaba bien decidido de separarse para siempre de su pueblo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann214" ANNOTATION_REF="ann213">
                <ANNOTATION_VALUE>iba pensando que ya nunca volvía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann216" ANNOTATION_REF="ann215">
                <ANNOTATION_VALUE>cuando llegaron con el muchacho por donde está la casa del águila , luego lo encerraron en una casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann218" ANNOTATION_REF="ann217">
                <ANNOTATION_VALUE>por aquí vas a estar bien , voy a avisarle a mi papá que te traje.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann220" ANNOTATION_REF="ann219">
                <ANNOTATION_VALUE>para que se entere y él diga en dónde vas a estar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann222" ANNOTATION_REF="ann221">
                <ANNOTATION_VALUE>si no le hago saber primero , es posible que de repente quiera comerte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann224" ANNOTATION_REF="ann223">
                <ANNOTATION_VALUE>no tengas cuidado , luego vengo a sacarte tan pronto como termine de hablar con mi papá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann226" ANNOTATION_REF="ann225">
                <ANNOTATION_VALUE>( y ) nos vamos a pasear.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann228" ANNOTATION_REF="ann227">
                <ANNOTATION_VALUE>te voy a dar a conocer ( llevar ) cómo es por aquí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann230" ANNOTATION_REF="ann229">
                <ANNOTATION_VALUE>para que después puedas andar tú solo ya que primero te hayan enseñado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann232" ANNOTATION_REF="ann231">
                <ANNOTATION_VALUE>efectivamente después de gran rato , se lo llevaron al muchacho a pasear.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann234" ANNOTATION_REF="ann233">
                <ANNOTATION_VALUE>cuando regresaron con aquel muchacho , se lo llevaron a donde estaba el viejo papá águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann236" ANNOTATION_REF="ann235">
                <ANNOTATION_VALUE>lo hicieron que lo saludara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann238" ANNOTATION_REF="ann237">
                <ANNOTATION_VALUE>el muchacho estuvo platicando un gran rato con el viejo papá águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann240" ANNOTATION_REF="ann239">
                <ANNOTATION_VALUE>dizque le platicaron todo al muchacho cómo les llaman a las flores que estaban en las fachadas de la casa grande , a quienes representaban , cómo les decían cuando las llamaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann242" ANNOTATION_REF="ann241">
                <ANNOTATION_VALUE>las que estaban en las fachadas de la casa grande son dos ramos de flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann244" ANNOTATION_REF="ann243">
                <ANNOTATION_VALUE>un ramo de color blanco y otro de color azul , y además otro que parecía como estrella muy luminosa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann246" ANNOTATION_REF="ann245">
                <ANNOTATION_VALUE>estaba a poca distancia de las flores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann248" ANNOTATION_REF="ann247">
                <ANNOTATION_VALUE>le mostraron al muchacho en dónde estaban sostenidas ( las flores ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann250" ANNOTATION_REF="ann249">
                <ANNOTATION_VALUE>le dijeron que cuando las llaman por sus nombres, se bajan de allí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann252" ANNOTATION_REF="ann251">
                <ANNOTATION_VALUE>a la de la blanca , se llama blanca-flor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann254" ANNOTATION_REF="ann253">
                <ANNOTATION_VALUE>la de azul , se le llama azul-flor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann256" ANNOTATION_REF="ann255">
                <ANNOTATION_VALUE>y a la tercera , le nombran ' la estrella grande '.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann258" ANNOTATION_REF="ann257">
                <ANNOTATION_VALUE>si quieres cerciorarte que es verdad que entienden por sus nombres , ahorita las voy a llamar delante de ti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann260" ANNOTATION_REF="ann259">
                <ANNOTATION_VALUE>verás que solas se bajarán de allí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann262" ANNOTATION_REF="ann261">
                <ANNOTATION_VALUE>para que no creas que te estoy engañando , - dijo el viejo águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann264" ANNOTATION_REF="ann263">
                <ANNOTATION_VALUE>primero advirtió que las dos ramos de flores , representaban a sus hijas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann266" ANNOTATION_REF="ann265">
                <ANNOTATION_VALUE>y la gran estrella es la ( representación ) de su hijo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann268" ANNOTATION_REF="ann267">
                <ANNOTATION_VALUE>llamó a la flor blanca .</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann270" ANNOTATION_REF="ann269">
                <ANNOTATION_VALUE>mi blanca flor , ven, le dijo al gritarle .</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann272" ANNOTATION_REF="ann271">
                <ANNOTATION_VALUE>luego se bajó de donde estaba sostenida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann274" ANNOTATION_REF="ann273">
                <ANNOTATION_VALUE>luego llamó al otro ramo de flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann276" ANNOTATION_REF="ann275">
                <ANNOTATION_VALUE>mi azul-flor , ven conmigo hacia mí le dijo al gritarle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann278" ANNOTATION_REF="ann277">
                <ANNOTATION_VALUE>luego se bajó de donde estaba sostenida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann280" ANNOTATION_REF="ann279">
                <ANNOTATION_VALUE>y al mismo tiempo la llamaron a la gran estrella.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann282" ANNOTATION_REF="ann281">
                <ANNOTATION_VALUE>mi gran estrella , ven a donde estoy - le dijo al gritarle fuerte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann284" ANNOTATION_REF="ann283">
                <ANNOTATION_VALUE>también se bajó inmediatamente de donde estaba sostenida , no se detuvo ni un momento</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann286" ANNOTATION_REF="ann285">
                <ANNOTATION_VALUE>se juntaron allí en donde estaba el viejo águila y el muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann288" ANNOTATION_REF="ann287">
                <ANNOTATION_VALUE>estuvieron nada más un momento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann290" ANNOTATION_REF="ann289">
                <ANNOTATION_VALUE>luego les dijeron que se regresaran a sus lugares.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann292" ANNOTATION_REF="ann291">
                <ANNOTATION_VALUE>solas se regresaron a sus lugares en la fachada de la casa grande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann294" ANNOTATION_REF="ann293">
                <ANNOTATION_VALUE>parecen como si fueran seres vivos todo hacen lo que les manda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann296" ANNOTATION_REF="ann295">
                <ANNOTATION_VALUE>y el muchacho estuvo pensando así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann298" ANNOTATION_REF="ann297">
                <ANNOTATION_VALUE>es porque son representaciones dobles , tabús por eso entienden lo que se les manda ( dice ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann300" ANNOTATION_REF="ann299">
                <ANNOTATION_VALUE>si no fuera por eso , nunca se moverían solas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann302" ANNOTATION_REF="ann301">
                <ANNOTATION_VALUE>cuando acabaron de platicar con ese muchacho , fueron a enseñarle en donde se ha de pasar las noches todos los días.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann304" ANNOTATION_REF="ann303">
                <ANNOTATION_VALUE>allí estuvo el muchacho , hacía todo lo que le mandaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann306" ANNOTATION_REF="ann305">
                <ANNOTATION_VALUE>no le daba flojera aunque le daban trabajo pesado. (Sic, falta línea 153)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann308" ANNOTATION_REF="ann307">
                <ANNOTATION_VALUE>vivía contento por allá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann310" ANNOTATION_REF="ann309">
                <ANNOTATION_VALUE>le parecía como si estuviera en su propia casa , ya no se sentía si nada más estaba arrimado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann312" ANNOTATION_REF="ann311">
                <ANNOTATION_VALUE>lo que necesitaba todo le daban y nada le escatimaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann314" ANNOTATION_REF="ann313">
                <ANNOTATION_VALUE>a veces creía necesario que pidiera permiso , lo pedía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann316" ANNOTATION_REF="ann315">
                <ANNOTATION_VALUE>a veces cuando ya no creía necesario que pidiera permiso , tomaba las cosas lo que le hacía falta sin avisar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann318" ANNOTATION_REF="ann317">
                <ANNOTATION_VALUE>pero no comenzó pronto a tomar todas las cosas que había sin permiso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann320" ANNOTATION_REF="ann319">
                <ANNOTATION_VALUE>le dijeron muchas veces que no tuviera vergüenza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann322" ANNOTATION_REF="ann321">
                <ANNOTATION_VALUE>lo que haya en la casa , si se le antoja que tomara sin ninguna pena , que lo comiera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann324" ANNOTATION_REF="ann323">
                <ANNOTATION_VALUE>igualmente a otras cosas que hay si desea ocuparlas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann326" ANNOTATION_REF="ann325">
                <ANNOTATION_VALUE>no es necesario pedir permiso primero para tomar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann328" ANNOTATION_REF="ann327">
                <ANNOTATION_VALUE>que tome cualquier cosa cuando se le ofrezca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann330" ANNOTATION_REF="ann329">
                <ANNOTATION_VALUE>que considere como suyo ( de él ) lo que hay en la casa , le dijeron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann332" ANNOTATION_REF="ann331">
                <ANNOTATION_VALUE>por eso andaba muy contento por allá , veía que lo apreciaban mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann334" ANNOTATION_REF="ann333">
                <ANNOTATION_VALUE>no le escatimaban lo que tenían ( allí ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann336" ANNOTATION_REF="ann335">
                <ANNOTATION_VALUE>también a lo que le mandaban nunca desobedecía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann338" ANNOTATION_REF="ann337">
                <ANNOTATION_VALUE>hubo un día ( sin pensar ) cuando le ofrecieron ( una de las ) muchacha(s).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann340" ANNOTATION_REF="ann339">
                <ANNOTATION_VALUE>el viejo águila le dijo así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann342" ANNOTATION_REF="ann341">
                <ANNOTATION_VALUE>muchacho , si haces todo lo que te diga , ( después )  te voy a dar mi hija la que se llama blanca-flor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann344" ANNOTATION_REF="ann343">
                <ANNOTATION_VALUE>te casarás con ella , no se irán lejos , aquí mismo vivirán.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann346" ANNOTATION_REF="ann345">
                <ANNOTATION_VALUE>yo te daré lo que han de comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann348" ANNOTATION_REF="ann347">
                <ANNOTATION_VALUE>no tendrás preocupación , se protegerán bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann350" ANNOTATION_REF="ann349">
                <ANNOTATION_VALUE>mañana te diré lo que has de hacer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann352" ANNOTATION_REF="ann351">
                <ANNOTATION_VALUE>temprano vienes conmigo a la hora que vayas a comer , luego te diriges para acá ".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann354" ANNOTATION_REF="ann353">
                <ANNOTATION_VALUE>está bien , vengo - dijo el muchacho</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann356" ANNOTATION_REF="ann355">
                <ANNOTATION_VALUE>no sabía lo que iban a poner a hacer al otro día.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann358" ANNOTATION_REF="ann357">
                <ANNOTATION_VALUE>cuando fué a comer a medio día , ? qué te dijo mi papá ? le preguntó la muchacha la que se llama blanca-flor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann360" ANNOTATION_REF="ann359">
                <ANNOTATION_VALUE>me dijo que tan pronto como me levante mañana , luego venga yo a comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann362" ANNOTATION_REF="ann361">
                <ANNOTATION_VALUE>tan pronto como acabe de comer iré con él , dizque me va a decir lo que voy a hacer ".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann364" ANNOTATION_REF="ann363">
                <ANNOTATION_VALUE>y dijo la muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann366" ANNOTATION_REF="ann365">
                <ANNOTATION_VALUE>" no se te vaya a pasar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann368" ANNOTATION_REF="ann367">
                <ANNOTATION_VALUE>solamente vas a escucharle lo que te diga , luego vienes conmigo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann370" ANNOTATION_REF="ann369">
                <ANNOTATION_VALUE>yo te voy a decir cómo has de hacer lo que te ordene.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann372" ANNOTATION_REF="ann371">
                <ANNOTATION_VALUE>todo realizarás lo que te diga , en nada te ganará.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann374" ANNOTATION_REF="ann373">
                <ANNOTATION_VALUE>entonces podremos casarnos como te dijo mi papá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann376" ANNOTATION_REF="ann375">
                <ANNOTATION_VALUE>aunque no quieras decirme por vergüenza tuya , luego me doy cuenta lo que te dijo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann378" ANNOTATION_REF="ann377">
                <ANNOTATION_VALUE>se avergonzó mucho el muchacho , quería que todavía no supiera la muchacha si ya le había ofrecido su papá para casarlo con ella.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann380" ANNOTATION_REF="ann379">
                <ANNOTATION_VALUE>dizque cuando se levantó temprano al otro día , luego fué a comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann382" ANNOTATION_REF="ann381">
                <ANNOTATION_VALUE>después fué a preguntar lo que ( tenía ) que hacer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann384" ANNOTATION_REF="ann383">
                <ANNOTATION_VALUE>le dijeron que fuera a matar moscos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann386" ANNOTATION_REF="ann385">
                <ANNOTATION_VALUE>a ver cuántos habrías matado a la hora que ya sea medio día.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann388" ANNOTATION_REF="ann387">
                <ANNOTATION_VALUE>los traes cuando vengas a comer a medio día.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann390" ANNOTATION_REF="ann389">
                <ANNOTATION_VALUE>me los enseñas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann392" ANNOTATION_REF="ann391">
                <ANNOTATION_VALUE>a ver si todavía estarán con vida entre tantos cuando los traigas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann394" ANNOTATION_REF="ann393">
                <ANNOTATION_VALUE>tan pronto como acabaron de decirle , luego fué a avisarle a la muchacha lo que le dijeron , qué cosa lo mandaron a hacer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann396" ANNOTATION_REF="ann395">
                <ANNOTATION_VALUE>y dijo la muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann398" ANNOTATION_REF="ann397">
                <ANNOTATION_VALUE>no te atarantes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann400" ANNOTATION_REF="ann399">
                <ANNOTATION_VALUE>ten un pedazo de panela</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann402" ANNOTATION_REF="ann401">
                <ANNOTATION_VALUE>con ella te embarrará en el cuerpo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann404" ANNOTATION_REF="ann403">
                <ANNOTATION_VALUE>entonces vendrán solos los moscos hacia ti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann406" ANNOTATION_REF="ann405">
                <ANNOTATION_VALUE>allí en tu cuerpo los atrapas ( los agarras ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann408" ANNOTATION_REF="ann407">
                <ANNOTATION_VALUE>se quedarán pegados con la panela.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann410" ANNOTATION_REF="ann409">
                <ANNOTATION_VALUE>está bien – dijo el muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann412" ANNOTATION_REF="ann411">
                <ANNOTATION_VALUE>recibió la panela.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann414" ANNOTATION_REF="ann413">
                <ANNOTATION_VALUE>se fué a sentar en donde había ( muchos ) moscos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann416" ANNOTATION_REF="ann415">
                <ANNOTATION_VALUE>llegando luego se puso a embarrarse con la panela.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann418" ANNOTATION_REF="ann417">
                <ANNOTATION_VALUE>se sentó nada más en un lugar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann420" ANNOTATION_REF="ann419">
                <ANNOTATION_VALUE>ya no fué a ninguna parte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann422" ANNOTATION_REF="ann421">
                <ANNOTATION_VALUE>allí mismo empezaron a rodearlo los moscos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann424" ANNOTATION_REF="ann423">
                <ANNOTATION_VALUE>dizque rápidamente los empezó a agarrar los que fueron quedándose pegados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann426" ANNOTATION_REF="ann425">
                <ANNOTATION_VALUE>cuando comenzó a acercarse al medio día , ya estaba completando los cuarenta y cuatro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann428" ANNOTATION_REF="ann427">
                <ANNOTATION_VALUE>solamente completó los cincuenta , fué a comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann430" ANNOTATION_REF="ann429">
                <ANNOTATION_VALUE>pero primero fué a enseñarle al viejo águila los moscos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann432" ANNOTATION_REF="ann431">
                <ANNOTATION_VALUE>dizque llevaba cuarenta muertos y diez atarantados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann434" ANNOTATION_REF="ann433">
                <ANNOTATION_VALUE>aquí traigo los moscos que me mandaste agarrarlos - dijo ( el muchacho ) al llegar a donde estaba el viejo águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann436" ANNOTATION_REF="ann435">
                <ANNOTATION_VALUE>está bien hijo mío , pudiste agarrar varios.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann438" ANNOTATION_REF="ann437">
                <ANNOTATION_VALUE>ha de traer pocos - decía yo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann440" ANNOTATION_REF="ann439">
                <ANNOTATION_VALUE>no me imaginaba si ibas a agarrar muchos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann442" ANNOTATION_REF="ann441">
                <ANNOTATION_VALUE>por ahora ve a comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann444" ANNOTATION_REF="ann443">
                <ANNOTATION_VALUE>el muchacho fué a comer muy contento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann446" ANNOTATION_REF="ann445">
                <ANNOTATION_VALUE>estando comiendo ( él ) , volvió a decirle la muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann448" ANNOTATION_REF="ann447">
                <ANNOTATION_VALUE>si todavía te va a decir mi papá algo más , no nada más lo sepas tú.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann450" ANNOTATION_REF="ann449">
                <ANNOTATION_VALUE>me has de decir a lo que te mande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann452" ANNOTATION_REF="ann451">
                <ANNOTATION_VALUE>yo te voy a decir cómo has de hacer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann454" ANNOTATION_REF="ann453">
                <ANNOTATION_VALUE>yo sé más que mi papá , él no sabe cómo se les hace a las cosas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann456" ANNOTATION_REF="ann455">
                <ANNOTATION_VALUE>cuando no se pueden realizar , por ser dificultosas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann458" ANNOTATION_REF="ann457">
                <ANNOTATION_VALUE>además eso , mi papá ya está viejo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann460" ANNOTATION_REF="ann459">
                <ANNOTATION_VALUE>a veces no se siente ya bien de su mente como yo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann462" ANNOTATION_REF="ann461">
                <ANNOTATION_VALUE>ya te digo , vienes conmigo cuando te manden en algo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann464" ANNOTATION_REF="ann463">
                <ANNOTATION_VALUE>no sea que por tu pena dejes de venir conmigo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann466" ANNOTATION_REF="ann465">
                <ANNOTATION_VALUE>al siguiente día volvió a ir el muchacho a consultar lo que ha de hacer( en qué ha de trabajar ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann468" ANNOTATION_REF="ann467">
                <ANNOTATION_VALUE>ahora vas a construir una casa para meter los caballos caballeriza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann470" ANNOTATION_REF="ann469">
                <ANNOTATION_VALUE>que tenga cavidad para ochenta ( caballos ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann472" ANNOTATION_REF="ann471">
                <ANNOTATION_VALUE>quiero que ya esté entera al caer la tarde.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann474" ANNOTATION_REF="ann473">
                <ANNOTATION_VALUE>allí la pasarán ya en esta noche ..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann476" ANNOTATION_REF="ann475">
                <ANNOTATION_VALUE>vienes a avisarme a la hora que regreses en la tarde.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann478" ANNOTATION_REF="ann477">
                <ANNOTATION_VALUE>llevas tus tortillas y allá comerás.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann480" ANNOTATION_REF="ann479">
                <ANNOTATION_VALUE>tan pronto como acabó de escuchar el muchacho lo que tenía que hacer , luego se fué con la muchacha quién lo estaba aconsejando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann482" ANNOTATION_REF="ann481">
                <ANNOTATION_VALUE>le comunicó lo que le ordenaron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann484" ANNOTATION_REF="ann483">
                <ANNOTATION_VALUE>y la muchacha dijo eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann486" ANNOTATION_REF="ann485">
                <ANNOTATION_VALUE>no tengas cuidado , solamente lleva todas las herramientas que se necesitan para construir una casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann488" ANNOTATION_REF="ann487">
                <ANNOTATION_VALUE>cárgale al caballo para que se las lleve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann490" ANNOTATION_REF="ann489">
                <ANNOTATION_VALUE>tan pronto como llegues con las herramientas , solamente las pones formadas en el suelo , luego te vienes para que platiquemos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann492" ANNOTATION_REF="ann491">
                <ANNOTATION_VALUE>en la tarde irás a traerlas , las herramientas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann494" ANNOTATION_REF="ann493">
                <ANNOTATION_VALUE>así hizo el muchacho como le indicó la muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann496" ANNOTATION_REF="ann495">
                <ANNOTATION_VALUE>en nada se ocupó , nada más estuvieron platicando en la casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann498" ANNOTATION_REF="ann497">
                <ANNOTATION_VALUE>cuando llegó el muchacho en donde había ido a dejar las herramientas , quedó sorprendido al ver mirar construída una casa grande y nueva.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann500" ANNOTATION_REF="ann499">
                <ANNOTATION_VALUE>y las herramientas estaban igual como las había dejado en la mañana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann502" ANNOTATION_REF="ann501">
                <ANNOTATION_VALUE>no se notaba si habían sido ocupadas ( en algún trabajo ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann504" ANNOTATION_REF="ann503">
                <ANNOTATION_VALUE>dizque fué el muchacho a asomarse por todos lados , quería ver quiénes habían construído la casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann506" ANNOTATION_REF="ann505">
                <ANNOTATION_VALUE>fué a andar un gran rato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann508" ANNOTATION_REF="ann507">
                <ANNOTATION_VALUE>si acaso se encontraba con alguno quién podría informarle si son hombres quienes hav venido a construir aquella casa nueva ..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann510" ANNOTATION_REF="ann509">
                <ANNOTATION_VALUE>nada más se cansó en vano , no vió a nadie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann512" ANNOTATION_REF="ann511">
                <ANNOTATION_VALUE>cuando llegó aquel muchacho fué a avisarle al viejo águila que ya había ido a hacer a lo que le había ordenado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann514" ANNOTATION_REF="ann513">
                <ANNOTATION_VALUE>está bien , ahorita voy a ver cómo quedó si cabe la cantidad de caballos que te dije.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann516" ANNOTATION_REF="ann515">
                <ANNOTATION_VALUE>solamente eso dijo , luego fué a ver si era verdad que había una casa nueva.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann518" ANNOTATION_REF="ann517">
                <ANNOTATION_VALUE>al regresar le dijo al muchacho así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann520" ANNOTATION_REF="ann519">
                <ANNOTATION_VALUE>estás saliendo muy buen muchacho , es probable que te va a tocar mi hija , no me imaginaba si eres muy listo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann522" ANNOTATION_REF="ann521">
                <ANNOTATION_VALUE>pero el viejo águila no sabía si su hija de él la que ya la había ofrecido era la que lo estaba dirigiendo a ese muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann524" ANNOTATION_REF="ann523">
                <ANNOTATION_VALUE>no pasaron muchos días lo volvieron a enviar a otro lado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann526" ANNOTATION_REF="ann525">
                <ANNOTATION_VALUE>le dijeron así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann528" ANNOTATION_REF="ann527">
                <ANNOTATION_VALUE>ahora vas a ir al río.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann530" ANNOTATION_REF="ann529">
                <ANNOTATION_VALUE>traes muchos pescados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann532" ANNOTATION_REF="ann531">
                <ANNOTATION_VALUE>llenas a las dos pailas ( cazos ) de las grandes que hay.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann534" ANNOTATION_REF="ann533">
                <ANNOTATION_VALUE>vienes a avisarme cuando las acabes de llenar para ir a verlas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann536" ANNOTATION_REF="ann535">
                <ANNOTATION_VALUE>está bien dijo el muchacho , volvió a ir a decirle a la muchacha lo que le ordenaron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann538" ANNOTATION_REF="ann537">
                <ANNOTATION_VALUE>acabando de escuchar la muchacha , dijo así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann540" ANNOTATION_REF="ann539">
                <ANNOTATION_VALUE>no te preocupes , nada más ve a agarrar un pescado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann542" ANNOTATION_REF="ann541">
                <ANNOTATION_VALUE>lleva una bolita de masa , le echas por las orillas del río.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann544" ANNOTATION_REF="ann543">
                <ANNOTATION_VALUE>vendrán corriendo los pescados cuando la vean , se le juntarán.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann546" ANNOTATION_REF="ann545">
                <ANNOTATION_VALUE>llevas prevenido un palo largo puntiagudo y delgado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann548" ANNOTATION_REF="ann547">
                <ANNOTATION_VALUE>estando amontonados los pescados , ensartas a uno con el palo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann550" ANNOTATION_REF="ann549">
                <ANNOTATION_VALUE>estando ensartado lo sacas poco a poco , ( después ) lo ensartas por la boca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann552" ANNOTATION_REF="ann551">
                <ANNOTATION_VALUE>lo traes arrastrando así ensartado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann554" ANNOTATION_REF="ann553">
                <ANNOTATION_VALUE>cuando llegues con él , luego lo echas en el cazo ( en la paila ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann556" ANNOTATION_REF="ann555">
                <ANNOTATION_VALUE>después de un gran rato verás que llegarán solos los pescados y se echarán en la paila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann558" ANNOTATION_REF="ann557">
                <ANNOTATION_VALUE>lo vendrán siguiendo lo que traigas arrastrando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann560" ANNOTATION_REF="ann559">
                <ANNOTATION_VALUE>solamente eso harás.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann562" ANNOTATION_REF="ann561">
                <ANNOTATION_VALUE>al caer la tarde vas a avisarle a mi papá que ya has llenado a las dos pailas con pescados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann564" ANNOTATION_REF="ann563">
                <ANNOTATION_VALUE>está bien , dijo el muchacho - así hizo como le dijo la muchacha</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann566" ANNOTATION_REF="ann565">
                <ANNOTATION_VALUE>al hacerse tarde , fué el muchacho a avisar al viejo águila que ya había llenado a las dos pailas grandes de pescado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann568" ANNOTATION_REF="ann567">
                <ANNOTATION_VALUE>cumplió lo que le había dicho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann570" ANNOTATION_REF="ann569">
                <ANNOTATION_VALUE>está bien - dijo el viejo águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann572" ANNOTATION_REF="ann571">
                <ANNOTATION_VALUE>fué a ver si era verdad que estaban llenas las dos pailas grandes de pescado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann574" ANNOTATION_REF="ann573">
                <ANNOTATION_VALUE>solamente fué a ver las pailas llenas , dijo que está bien , no habló más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann576" ANNOTATION_REF="ann575">
                <ANNOTATION_VALUE>se llenó de alegría el muchacho ( al ver ) que va ( pudiendo ) realizando todo lo que se le ordena.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann578" ANNOTATION_REF="ann577">
                <ANNOTATION_VALUE>ya entonces empezó a quedarse muy agradecido por la muchacha , debido a que ella le estaba haciendo favor de dirigirlo en lo que le iban ordenando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann580" ANNOTATION_REF="ann579">
                <ANNOTATION_VALUE>también desde entonces se dió cuenta bien aquel muchacho que tenía mucha capacidad de pensamientos la muchacha la que le habían ofrecido de casarse con ella ( que se case con ella ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann582" ANNOTATION_REF="ann581">
                <ANNOTATION_VALUE>lo que le decía todo se realizaba aunque parecía ser incierto al escuchar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann584" ANNOTATION_REF="ann583">
                <ANNOTATION_VALUE>dizque el muchacho se imaginaba de sí mismo ( en esta forma ) , ( siempre ) cuando se encontraba solo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann586" ANNOTATION_REF="ann585">
                <ANNOTATION_VALUE>nadie lo molestaba en donde se quedaba la noche ( pasaba la noche ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann588" ANNOTATION_REF="ann587">
                <ANNOTATION_VALUE>ha de quererme bastante aquella muchacha y por eso me dice todo cómo he de hacer lo que me ordena su papá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann590" ANNOTATION_REF="ann589">
                <ANNOTATION_VALUE>ha de estar decidida que se ha de casar conmigo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann592" ANNOTATION_REF="ann591">
                <ANNOTATION_VALUE>solamente no hay seguridad si siempre me querrá igual al prolongarse más tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann594" ANNOTATION_REF="ann593">
                <ANNOTATION_VALUE>si llega a cambiar su opinión ya cuando yo esté con ella , ( después ) viviré o andaré con tristeza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann596" ANNOTATION_REF="ann595">
                <ANNOTATION_VALUE>viviré sin tranquilidad más tarde.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann598" ANNOTATION_REF="ann597">
                <ANNOTATION_VALUE>o que de repente me abandona , ( de todos modos ) creo que me buscará dificultades.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann600" ANNOTATION_REF="ann599">
                <ANNOTATION_VALUE>ahora aunque le tengo vergüenza , es mejor que le pregunte de una vez si me quiere mucho como la veo cuando voy a platicar con ella.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann602" ANNOTATION_REF="ann601">
                <ANNOTATION_VALUE>si está decidida unirse conmigo y no cambie su opinión más tarde.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann604" ANNOTATION_REF="ann603">
                <ANNOTATION_VALUE>dizque tan pronto como amaneció al siguiente día , luego le preguntó cuando fué a almorzar ..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann606" ANNOTATION_REF="ann605">
                <ANNOTATION_VALUE>la muchacha dijo lo siguiente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann608" ANNOTATION_REF="ann607">
                <ANNOTATION_VALUE>no tengas pendiente de mí , a ti te considero como si fueras mi alma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann610" ANNOTATION_REF="ann609">
                <ANNOTATION_VALUE>yo sabré cómo viviré contigo ya cuando nos casemos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann612" ANNOTATION_REF="ann611">
                <ANNOTATION_VALUE>no tengas cuidado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann614" ANNOTATION_REF="ann613">
                <ANNOTATION_VALUE>yo tendré cuidado para nuestro sostén si tú no te consideras competente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann616" ANNOTATION_REF="ann615">
                <ANNOTATION_VALUE>tan pronto como acabó de comer el muchacho , fué nuevamente a preguntar qué trabajo iba a hacer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann618" ANNOTATION_REF="ann617">
                <ANNOTATION_VALUE>luego le dijeron lo que ha de hacer en todo el día , a dónde tenía que ir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann620" ANNOTATION_REF="ann619">
                <ANNOTATION_VALUE>ahora vas a ir a matar una víbora grande del agua , vé al río , allá anda en el fondo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann622" ANNOTATION_REF="ann621">
                <ANNOTATION_VALUE>vienes a avisarme a ver a qué horas la matas - dijo el viejo águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann624" ANNOTATION_REF="ann623">
                <ANNOTATION_VALUE>está bien , dijo el muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann626" ANNOTATION_REF="ann625">
                <ANNOTATION_VALUE>luego volvió a ir con la muchacha a decirle lo que le dijo su papá , cómo hacía para matar a una gran ( vie jo ) v'i or del agua</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann628" ANNOTATION_REF="ann627">
                <ANNOTATION_VALUE>volvió a decirle la muchacha cómo tendrá que hacer para matar a la gran víbora del agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann630" ANNOTATION_REF="ann629">
                <ANNOTATION_VALUE>y dijo la muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann632" ANNOTATION_REF="ann631">
                <ANNOTATION_VALUE>no te preocupes de lo que te ordenó mi papá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann634" ANNOTATION_REF="ann633">
                <ANNOTATION_VALUE>aquí está el cuchillo y ponte en la cintura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann636" ANNOTATION_REF="ann635">
                <ANNOTATION_VALUE>cuando llegues al río te paras sobre de una piedra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann638" ANNOTATION_REF="ann637">
                <ANNOTATION_VALUE>la gran víbora sola vendrá hacia ti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann640" ANNOTATION_REF="ann639">
                <ANNOTATION_VALUE>abrirá la boca antes de venir a alcanzarte , no le vayas a tener miedo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann642" ANNOTATION_REF="ann641">
                <ANNOTATION_VALUE>llegando apenas hacia ti tú mismo brincas y te metes en su boca , que ahí te trague.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann644" ANNOTATION_REF="ann643">
                <ANNOTATION_VALUE>no te va a pasar nada , te va a tragar entero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann646" ANNOTATION_REF="ann645">
                <ANNOTATION_VALUE>no te va a masticar , vas a llegar vivo a su estómago.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann648" ANNOTATION_REF="ann647">
                <ANNOTATION_VALUE>no te detengas después que te haya tragado , luego te pones a cortar para salir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann650" ANNOTATION_REF="ann649">
                <ANNOTATION_VALUE>no tardarás en salirte del estómago de la gran víbora del agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann652" ANNOTATION_REF="ann651">
                <ANNOTATION_VALUE>cuando acabes de cortar y salir , ella ya habrá muerto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann654" ANNOTATION_REF="ann653">
                <ANNOTATION_VALUE>ya no te hace nada , luego vienes corriendo a avisarle a mi papá que ya has matado a la gran víbora del agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann656" ANNOTATION_REF="ann655">
                <ANNOTATION_VALUE>aunque vaya a verla , la va a hallar muerta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann658" ANNOTATION_REF="ann657">
                <ANNOTATION_VALUE>anda y no tengas cuidado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann660" ANNOTATION_REF="ann659">
                <ANNOTATION_VALUE>el muchacho dijo que está bien , hizo así como le dijo la muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann662" ANNOTATION_REF="ann661">
                <ANNOTATION_VALUE>dizque cuando el viejo águila fué a verla , le dijo así al muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann664" ANNOTATION_REF="ann663">
                <ANNOTATION_VALUE>estás saliendo muy bueno , no me imaginaba si eres muy listo desde hace tiempo que estás aquí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann666" ANNOTATION_REF="ann665">
                <ANNOTATION_VALUE>apenas ahora te estoy acabando de conocer que tienes escondidos tus conocimientos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann668" ANNOTATION_REF="ann667">
                <ANNOTATION_VALUE>crees que siempre te ha de tocar mi hija.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann670" ANNOTATION_REF="ann669">
                <ANNOTATION_VALUE>y el muchacho no contestó nada , solamente escuchó lo que le dijeron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann672" ANNOTATION_REF="ann671">
                <ANNOTATION_VALUE>ya entonces ( en esa fecha ) llamaron al muchacho en la tarde.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann674" ANNOTATION_REF="ann673">
                <ANNOTATION_VALUE>él sabía que al siguiente día iría a preguntar personalmente lo que tenía que hacer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann676" ANNOTATION_REF="ann675">
                <ANNOTATION_VALUE>( en esa vez ) no fué así , lo llamaron para ponerlo a trabajar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann678" ANNOTATION_REF="ann677">
                <ANNOTATION_VALUE>dizque diez costales de frijol y cinco costales de maíz se los habían revuelto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann680" ANNOTATION_REF="ann679">
                <ANNOTATION_VALUE>llegando le dijeron que eso tenía que escoger</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann682" ANNOTATION_REF="ann681">
                <ANNOTATION_VALUE>aquí está ahora tu quehacer , los escoges en toda la noche , pones aparte el maíz y el frijol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann684" ANNOTATION_REF="ann683">
                <ANNOTATION_VALUE>quiero que ya hayas terminado cuando amanezca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann686" ANNOTATION_REF="ann685">
                <ANNOTATION_VALUE>apenas saliendo el sol vengo a verte a ver si ya habrás terminado , le apuras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann688" ANNOTATION_REF="ann687">
                <ANNOTATION_VALUE>no quiero que duermas en esta noche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann690" ANNOTATION_REF="ann689">
                <ANNOTATION_VALUE>toda la noche vas a estar escogiendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann692" ANNOTATION_REF="ann691">
                <ANNOTATION_VALUE>si no lo haces como te estoy diciendo , no hayas terminado al amanecer , me voy a enojar mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann694" ANNOTATION_REF="ann693">
                <ANNOTATION_VALUE>nada más acabó de escuchar el muchacho lo que le dijeron , qué trabajo le dió el viejo águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann696" ANNOTATION_REF="ann695">
                <ANNOTATION_VALUE>luego volvió a ir a decirle a la muchacha lo que le mandó hacer su papá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann698" ANNOTATION_REF="ann697">
                <ANNOTATION_VALUE>no tengas cuidado yo sé cómo le voy a hacer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann700" ANNOTATION_REF="ann699">
                <ANNOTATION_VALUE>antes que amanezca se apartarán lo que te entregaron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann702" ANNOTATION_REF="ann701">
                <ANNOTATION_VALUE>nada más te levantas mañana temprano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann704" ANNOTATION_REF="ann703">
                <ANNOTATION_VALUE>vas luego a ver si ya han sido terminados de escoger lo que te encargó hacer mi papá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann706" ANNOTATION_REF="ann705">
                <ANNOTATION_VALUE>a la hora que tengas sueño , vas a dormir</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann708" ANNOTATION_REF="ann707">
                <ANNOTATION_VALUE>y el muchacho no sabía cómo hacía para escoger el maíz revuelto con el frijol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann710" ANNOTATION_REF="ann709">
                <ANNOTATION_VALUE>ya sabía el muchacho que así iba a resultar como le dijo la muchacha blanca-flor , dizque acabando de obscurecer fué a dormir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann712" ANNOTATION_REF="ann711">
                <ANNOTATION_VALUE>al despertar el muchacho en plena noche , se le ocurrió ir a donde estaba el trabajo que le habían dado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann714" ANNOTATION_REF="ann713">
                <ANNOTATION_VALUE>nada más quería cerciorarse si todavía estaba intacto lo que él tenía que hacer o ya había sido escogido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann716" ANNOTATION_REF="ann715">
                <ANNOTATION_VALUE>dizque apenas iba llegando en donde estaba el maíz y el frijol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann718" ANNOTATION_REF="ann717">
                <ANNOTATION_VALUE>escuchó que alguien hacía un ligero ruido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann720" ANNOTATION_REF="ann719">
                <ANNOTATION_VALUE>comenzó a tener miedo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann722" ANNOTATION_REF="ann721">
                <ANNOTATION_VALUE>ya no se acercó</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann724" ANNOTATION_REF="ann723">
                <ANNOTATION_VALUE>mejor se devolvió inmediatamente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann726" ANNOTATION_REF="ann725">
                <ANNOTATION_VALUE>fué a traer su luz.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann728" ANNOTATION_REF="ann727">
                <ANNOTATION_VALUE>con ella fué a ver lo que producía ruído en donde estaba el maíz con el frijol revuelto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann730" ANNOTATION_REF="ann729">
                <ANNOTATION_VALUE>al acercarse alzó mucho su luz lámpara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann732" ANNOTATION_REF="ann731">
                <ANNOTATION_VALUE>él creía que era grande lo que hacía ruído , empezó a buscar por todos lados en donde había escuchado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann734" ANNOTATION_REF="ann733">
                <ANNOTATION_VALUE>al mirar bien por el suelo , miró hormigas arrieras sobre lo que él tenía que haber escogido</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann736" ANNOTATION_REF="ann735">
                <ANNOTATION_VALUE>dizque ellas estaban apuradas separando el maíz y el frijol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann738" ANNOTATION_REF="ann737">
                <ANNOTATION_VALUE>cada cosa estaban poniendo aparte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann740" ANNOTATION_REF="ann739">
                <ANNOTATION_VALUE>dizque nada más fué a darse cuenta el muchacho de lo que hacía ruído , luego se volvió a ir a acostar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann742" ANNOTATION_REF="ann741">
                <ANNOTATION_VALUE>al levantarse muy temprano el día siguiente , fué a ver si ya se habían retirado las hormigas arrieras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann744" ANNOTATION_REF="ann743">
                <ANNOTATION_VALUE>si han terminado también lo que estuvieron haciendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann746" ANNOTATION_REF="ann745">
                <ANNOTATION_VALUE>dizque cuando llegó ( allí ) , ya no pareció ni una hormiga arriera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann748" ANNOTATION_REF="ann747">
                <ANNOTATION_VALUE>ya todas se habían ido cuando llegó ese muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann750" ANNOTATION_REF="ann749">
                <ANNOTATION_VALUE>también ya estaban separados y amontonados tanto el maíz como el frijol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann752" ANNOTATION_REF="ann751">
                <ANNOTATION_VALUE>dizque cuando se enteró de que ya se había terminado lo que él debería haber hecho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann754" ANNOTATION_REF="ann753">
                <ANNOTATION_VALUE>solamente fué a almorzar aquel muchacho ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann756" ANNOTATION_REF="ann755">
                <ANNOTATION_VALUE>luego fué a decirle al viejo águila que ya terminó el trabajo que le había dado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann758" ANNOTATION_REF="ann757">
                <ANNOTATION_VALUE>está bien - dizque dijo el viejo águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann760" ANNOTATION_REF="ann759">
                <ANNOTATION_VALUE>empezó a rascarse la cabeza al oír lo que le dijo el muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann762" ANNOTATION_REF="ann761">
                <ANNOTATION_VALUE>no habló más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann764" ANNOTATION_REF="ann763">
                <ANNOTATION_VALUE>y anteriormente hablaba más , dizque pensó el muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann766" ANNOTATION_REF="ann765">
                <ANNOTATION_VALUE>acabando de hablar luego se retiró y fué a comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann768" ANNOTATION_REF="ann767">
                <ANNOTATION_VALUE>el viejo águila ya no tenía nada que ponerle a hacer al muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann770" ANNOTATION_REF="ann769">
                <ANNOTATION_VALUE>ya había escogido todo lo más difícil para ponerlo a hacer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann772" ANNOTATION_REF="ann771">
                <ANNOTATION_VALUE>no podía ofenderlo nada más porque sí , veía muy bien al muchacho que nunca desobedecía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann774" ANNOTATION_REF="ann773">
                <ANNOTATION_VALUE>era obediente para lo que le ordenaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann776" ANNOTATION_REF="ann775">
                <ANNOTATION_VALUE>por eso quería ganarlo en otra forma distinta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann778" ANNOTATION_REF="ann777">
                <ANNOTATION_VALUE>cuando no pueda hacer lo que le ordene o que no le sepa hacer , había pensado el viejo águila comer al muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann780" ANNOTATION_REF="ann779">
                <ANNOTATION_VALUE>pero como pudo cumplir todo lo que se le ordenó aquel muchacho , no se lo podían comer nada más porque sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann782" ANNOTATION_REF="ann781">
                <ANNOTATION_VALUE>siempre le daba vergüenza un poco el viejo águila , ( mejor ) pensó con lo que tenía que ganarlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann784" ANNOTATION_REF="ann783">
                <ANNOTATION_VALUE>lo mandaron llamar al muchacho antes que dieran las doce del día , para advertirle lo que tenía que hacer en toda la noche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann786" ANNOTATION_REF="ann785">
                <ANNOTATION_VALUE>muchacho , en esta noche vas a estar pendiente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann788" ANNOTATION_REF="ann787">
                <ANNOTATION_VALUE>vas a verme en donde me acuesto , por allí cerca arreglas tu cama.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann790" ANNOTATION_REF="ann789">
                <ANNOTATION_VALUE>al hablarte cada vez , me has de contestar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann792" ANNOTATION_REF="ann791">
                <ANNOTATION_VALUE>aquí estoy - me has de decir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann794" ANNOTATION_REF="ann793">
                <ANNOTATION_VALUE>para saber que estás acostado , tan pronto como amanezca veremos cómo nos ha de ir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann796" ANNOTATION_REF="ann795">
                <ANNOTATION_VALUE>nada más acabó de escuchar el muchacho lo que le dijeron , luego fué a avisar nuevamente a la muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann798" ANNOTATION_REF="ann797">
                <ANNOTATION_VALUE>cuando acabó de escuchar todo la muchacha lo que le habían dicho al muchacho , luego comprendió lo que había planeado su papá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann800" ANNOTATION_REF="ann799">
                <ANNOTATION_VALUE>ahora no hay remedio , mi papá te quiere comer y por eso te dijo que fueras en donde está.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann802" ANNOTATION_REF="ann801">
                <ANNOTATION_VALUE>tiene pensado que toda la noche te va a absorber chupar de lejos en donde te acuestes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann804" ANNOTATION_REF="ann803">
                <ANNOTATION_VALUE>a la hora que empiecen a adormecer todo tu cuerpo , ya no podrás contestarle, y entonces piensa ir a comerte en esa hora ( en tu lecho ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann806" ANNOTATION_REF="ann805">
                <ANNOTATION_VALUE>yo no estoy de acuerdo que te trate así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann808" ANNOTATION_REF="ann807">
                <ANNOTATION_VALUE>adónde creeré que habrás ido después que te haya comido mi papá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann810" ANNOTATION_REF="ann809">
                <ANNOTATION_VALUE>andaría llorando sin descansar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann812" ANNOTATION_REF="ann811">
                <ANNOTATION_VALUE>aunque fuera mi papá , le voy a hacer a un lado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann814" ANNOTATION_REF="ann813">
                <ANNOTATION_VALUE>no debería yo actuar así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann816" ANNOTATION_REF="ann815">
                <ANNOTATION_VALUE>y qué podré hacer ahora.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann818" ANNOTATION_REF="ann817">
                <ANNOTATION_VALUE>le voy a faltar el respeto nada más por no dejarte a ti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann820" ANNOTATION_REF="ann819">
                <ANNOTATION_VALUE>me he familiarizado contigo, mucho , no comprendo a qué se debe ..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann822" ANNOTATION_REF="ann821">
                <ANNOTATION_VALUE>muchacho, mejor vé a arreglar lo poco que tengas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann824" ANNOTATION_REF="ann823">
                <ANNOTATION_VALUE>nos vamos al lugar de tu procedencia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann826" ANNOTATION_REF="ann825">
                <ANNOTATION_VALUE>no se va a dar cuenta mi papá por donde nos vamos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann828" ANNOTATION_REF="ann827">
                <ANNOTATION_VALUE>cuando empiece a obscurecer vas y te haces la pantomima como que estás arreglando en donde te has de acostar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann830" ANNOTATION_REF="ann829">
                <ANNOTATION_VALUE>no llevarás todavía tus cosas las que vas a arreglar ahorita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann832" ANNOTATION_REF="ann831">
                <ANNOTATION_VALUE>yo te las llevaré personalmente a la hora que pase por ti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann834" ANNOTATION_REF="ann833">
                <ANNOTATION_VALUE>nos vamos corriendo en la noche, nadie nos verá por donde nos hemos de ir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann836" ANNOTATION_REF="ann835">
                <ANNOTATION_VALUE>nada más que no se te vaya a olvidar lo que has de hacer a la hora de acostarte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann838" ANNOTATION_REF="ann837">
                <ANNOTATION_VALUE>comienzas a escupir constantemente y llevas prevenida una poca de agua para ir echándote en la boca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann840" ANNOTATION_REF="ann839">
                <ANNOTATION_VALUE>de ese modo podrás juntar bastante saliva.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann842" ANNOTATION_REF="ann841">
                <ANNOTATION_VALUE>aunque ya no esté acostado y entonces tu saliva contestará por ti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann844" ANNOTATION_REF="ann843">
                <ANNOTATION_VALUE>si empieza a secar tu saliva al anochecer más , o ya para amanecer , ya comenzará a callarse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann846" ANNOTATION_REF="ann845">
                <ANNOTATION_VALUE>ya dejará de contestar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann848" ANNOTATION_REF="ann847">
                <ANNOTATION_VALUE>hasta entonces sabrá mi papá que no estás acostado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann850" ANNOTATION_REF="ann849">
                <ANNOTATION_VALUE>aunque te busque y en dónde le aparecerás , ( en esa hora ) ya habremos ido lejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann852" ANNOTATION_REF="ann851">
                <ANNOTATION_VALUE>no se te vaya a olvidar lo que te dije.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann854" ANNOTATION_REF="ann853">
                <ANNOTATION_VALUE>dizque el muchacho hizo como le dijo la muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann856" ANNOTATION_REF="ann855">
                <ANNOTATION_VALUE>nada se le pasó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann858" ANNOTATION_REF="ann857">
                <ANNOTATION_VALUE>por eso pudieron salir de noche a escondidas sin que oyera el viejo águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann860" ANNOTATION_REF="ann859">
                <ANNOTATION_VALUE>él seguía hablando solo ( adentro ) ( y ellos ) ya hacía tanto rato que se habían partido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann862" ANNOTATION_REF="ann861">
                <ANNOTATION_VALUE>estaba pensando que iba a comer sabroso , no se imaginaba si era saliva que le estaba contestando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann864" ANNOTATION_REF="ann863">
                <ANNOTATION_VALUE>dizque ya había pasado el primer canto del gallo del otro mundo ( procedencia del muchacho ) cuando comenzó a secarse la saliva y ya no contestó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann866" ANNOTATION_REF="ann865">
                <ANNOTATION_VALUE>y el viejo águila notó que ya no le contestaban de estar hablando desde su cama.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann868" ANNOTATION_REF="ann867">
                <ANNOTATION_VALUE>se levantó y fué a ver al lugar donde estaba acostado el muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann870" ANNOTATION_REF="ann869">
                <ANNOTATION_VALUE>nada más miró bien que ya no estaba acostado ( el muchacho ) en donde lo había visto acostarse el día anterior ..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann872" ANNOTATION_REF="ann871">
                <ANNOTATION_VALUE>se enojó mucho ( al mirar ) que no estaba el muchacho acostado en su cama .</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann874" ANNOTATION_REF="ann873">
                <ANNOTATION_VALUE>dizque ya había pensado comerlo si lo hubiera hallado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann876" ANNOTATION_REF="ann875">
                <ANNOTATION_VALUE>dizque nada más fué a buscar bien en donde iba el muchacho antes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann878" ANNOTATION_REF="ann877">
                <ANNOTATION_VALUE>cuando se cansó bien dejó de andar ( suspendió ) mejor comenzó a oler por donde se habían ido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann880" ANNOTATION_REF="ann879">
                <ANNOTATION_VALUE>luego también se dió cuenta de que era su hija quién lo había guiado al muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann882" ANNOTATION_REF="ann881">
                <ANNOTATION_VALUE>si hubiera querido irse solo ese muchacho, no hubiera podido engañarme sino por mi hija que lo guió cómo partió escondido en la noche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann884" ANNOTATION_REF="ann883">
                <ANNOTATION_VALUE>no se ha de quedar así , me detengo hasta que los halle ( localice ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann886" ANNOTATION_REF="ann885">
                <ANNOTATION_VALUE>de no ser así , y el tiempo se pasará nada más y no habrá remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann888" ANNOTATION_REF="ann887">
                <ANNOTATION_VALUE>tendrán que dejar satisfecho a mi alma los dos y no se les pasará.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann890" ANNOTATION_REF="ann889">
                <ANNOTATION_VALUE>hasta que sepan quién soy yo, me han faltado el respeto y no soy juguete de ellos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann892" ANNOTATION_REF="ann891">
                <ANNOTATION_VALUE>nunca me imaginaba de mi hija que algún día se huiría con aquel muchacho del otro mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann894" ANNOTATION_REF="ann893">
                <ANNOTATION_VALUE>aunque sí le había ofrecido mi hija , de todos modos yo soy el que sé  cómo había pensado hacerlo terminar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann896" ANNOTATION_REF="ann895">
                <ANNOTATION_VALUE>no me imaginaba si ellos ya solos se iban a aconsejar cómo realizar lo que yo platiqué entre mis alegrías.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann898" ANNOTATION_REF="ann897">
                <ANNOTATION_VALUE>dizque de cólera platicaba así solito el viejo águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann900" ANNOTATION_REF="ann899">
                <ANNOTATION_VALUE>cuando halló sus huellas con su olfato por donde se habían ido, los siguió corriendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann902" ANNOTATION_REF="ann901">
                <ANNOTATION_VALUE>iban sonando rrr-rrr -- rrr sus ruedas al irse en ellas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann904" ANNOTATION_REF="ann903">
                <ANNOTATION_VALUE>para nada los hizo descansar a los caballos que iban jalando las ruedas carreta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann906" ANNOTATION_REF="ann905">
                <ANNOTATION_VALUE>aunque fueran en las subidas y en las bajadas , siempre los caballos seguían corriendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann908" ANNOTATION_REF="ann907">
                <ANNOTATION_VALUE>también así los iban pegando constantemente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann910" ANNOTATION_REF="ann909">
                <ANNOTATION_VALUE>y ellos los jóvenes que los iban siguiendo , dizque iban platicando alegres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann912" ANNOTATION_REF="ann911">
                <ANNOTATION_VALUE>no se imaginaban si les hallaron sus huellas camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann914" ANNOTATION_REF="ann913">
                <ANNOTATION_VALUE>cuando volteó para atrás la muchacha , luego alcanzó a ver su papá que iba corriendo siguiéndolos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann916" ANNOTATION_REF="ann915">
                <ANNOTATION_VALUE>dizque todavía no se distinguía bien , porque venía lejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann918" ANNOTATION_REF="ann917">
                <ANNOTATION_VALUE>inmediatamente se cambiaron de cuerpo , el muchacho se convirtió en un pastor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann920" ANNOTATION_REF="ann919">
                <ANNOTATION_VALUE>y la muchacha se volvió en cabras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann922" ANNOTATION_REF="ann921">
                <ANNOTATION_VALUE>cuando llegó el viejo águila por donde ellos venían pasando , nada más vino a encontrar una cabra y un niño que la andaba cuidando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann924" ANNOTATION_REF="ann923">
                <ANNOTATION_VALUE>aunque le preguntaron a ese muchacho - no sé ni los he visto - dijo al contestar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann926" ANNOTATION_REF="ann925">
                <ANNOTATION_VALUE>el viejo águila se enojó mucho porque nadie sabe por donde se habían ido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann928" ANNOTATION_REF="ann927">
                <ANNOTATION_VALUE>de allí mismo se devolvió.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann930" ANNOTATION_REF="ann929">
                <ANNOTATION_VALUE>ya se había ido lejos el viejo águila cuando la muchacha y el muchacho empezaron a caminar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann932" ANNOTATION_REF="ann931">
                <ANNOTATION_VALUE>todavía no habían avanzado tanto cuando volvió a mirar para atrás la muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann934" ANNOTATION_REF="ann933">
                <ANNOTATION_VALUE>volvió a ver su papá que venía otra vez corriendo en su carreta ruedas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann936" ANNOTATION_REF="ann935">
                <ANNOTATION_VALUE>acabando de darse cuenta que ya otra vez los iban siguiendo , inmediatamente se volvieron a cambiar de cuerpo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann938" ANNOTATION_REF="ann937">
                <ANNOTATION_VALUE>la muchacha se volvió un cerro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann940" ANNOTATION_REF="ann939">
                <ANNOTATION_VALUE>y el muchacho se convirtió un cazador.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann942" ANNOTATION_REF="ann941">
                <ANNOTATION_VALUE>dizque en frente del cerro se regresó el viejo águila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann944" ANNOTATION_REF="ann943">
                <ANNOTATION_VALUE>nuevamente volvió su camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann946" ANNOTATION_REF="ann945">
                <ANNOTATION_VALUE>solamente vino a hablarle a un cazador que lo halló en frente del cerro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann948" ANNOTATION_REF="ann947">
                <ANNOTATION_VALUE>acabando de desaparecer el padre de la muchacha , luego emprendieron su camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann950" ANNOTATION_REF="ann949">
                <ANNOTATION_VALUE>ellos creían que se había regresado para siempre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann952" ANNOTATION_REF="ann951">
                <ANNOTATION_VALUE>no se imaginaban si no iba a resultar así</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann954" ANNOTATION_REF="ann953">
                <ANNOTATION_VALUE>venían contentos platicando en todo el camino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann956" ANNOTATION_REF="ann955">
                <ANNOTATION_VALUE>cuando se asomó otra vez la muchacha para atrás , se fijó detenidamente en lo largo del camino por donde ellos habían pasado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann958" ANNOTATION_REF="ann957">
                <ANNOTATION_VALUE>pudo distinguir por donde venía su papá regresando otra vez , dizque luego nuevamente se cambiaron de cuerpo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann960" ANNOTATION_REF="ann959">
                <ANNOTATION_VALUE>el muchacho se convertió en lodo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann962" ANNOTATION_REF="ann961">
                <ANNOTATION_VALUE>y la muchacha se convertió en un arroyo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann964" ANNOTATION_REF="ann963">
                <ANNOTATION_VALUE>aunque hizo la lucha el viejo águila para atravesar al arroyo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann966" ANNOTATION_REF="ann965">
                <ANNOTATION_VALUE>y el lodo , no pudo atravesarlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann968" ANNOTATION_REF="ann967">
                <ANNOTATION_VALUE>allí mismo vino a detenerse y tuvo que volver a regresar su camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann970" ANNOTATION_REF="ann969">
                <ANNOTATION_VALUE>acabando de desaparecer el viejo águila , otra vez emprendieron luego su camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann972" ANNOTATION_REF="ann971">
                <ANNOTATION_VALUE>ya no faltaba lejos donde abarca el mundo de esta vida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann974" ANNOTATION_REF="ann973">
                <ANNOTATION_VALUE>les dió mucho gusto cuando llegaron en el lindero donde abarca el mundo del infierno o sea del otro mundo o vida , en donde se vive ya todo distinto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann976" ANNOTATION_REF="ann975">
                <ANNOTATION_VALUE>dizque nada más un rato pasaron a descansar en el lindero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann978" ANNOTATION_REF="ann977">
                <ANNOTATION_VALUE>venían atravesando grandes bosques ya sin cuidado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann980" ANNOTATION_REF="ann979">
                <ANNOTATION_VALUE>y además ya fué un poco lo que caminaron en medio de la soledad ( o silencio ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann982" ANNOTATION_REF="ann981">
                <ANNOTATION_VALUE>ya luego comenzaron a cantar los gallos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann984" ANNOTATION_REF="ann983">
                <ANNOTATION_VALUE>de eso se dieron cuenta que ya no tardaba en amanecer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann986" ANNOTATION_REF="ann985">
                <ANNOTATION_VALUE>dizque venían platicando del viejo águila que ya no los iba a seguir derecho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann988" ANNOTATION_REF="ann987">
                <ANNOTATION_VALUE>aunque haga la lucha si todavía regresara , allí vendrá a detenerse en donde termina el mundo del otro lado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann990" ANNOTATION_REF="ann989">
                <ANNOTATION_VALUE>ahora sí ya nos introducimos en otra vida distinta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann992" ANNOTATION_REF="ann991">
                <ANNOTATION_VALUE>ahora ni mañana o pasado regresaremos de donde hemos salido , ya nos hicimos cargo mutuamente para siempre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann994" ANNOTATION_REF="ann993">
                <ANNOTATION_VALUE>tú eres mi esposo ( mi hombre ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann996" ANNOTATION_REF="ann995">
                <ANNOTATION_VALUE>yo soy tu esposa ( tu mujer ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann998" ANNOTATION_REF="ann997">
                <ANNOTATION_VALUE>viviremos juntos hasta que se termine nuestra existencia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1000" ANNOTATION_REF="ann999">
                <ANNOTATION_VALUE>nos cuidaremos y nos asistiremos mutuamente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1002" ANNOTATION_REF="ann1001">
                <ANNOTATION_VALUE>siempre viviremos contentos por el tiempo indefinido - dijo la muchacha por el camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1004" ANNOTATION_REF="ann1003">
                <ANNOTATION_VALUE>así también lo deseo si es que no haya quién venga a descomponer  nuestro hogar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1006" ANNOTATION_REF="ann1005">
                <ANNOTATION_VALUE>así contestó el muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1008" ANNOTATION_REF="ann1007">
                <ANNOTATION_VALUE>dizque cuando ya fueron acercándose a su mero pueblo del muchacho , donde era nativo , comenzaron a escuchar que alguien estaba celebrando mucha fiesta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1010" ANNOTATION_REF="ann1009">
                <ANNOTATION_VALUE>dizque luego tuvo deseos el muchacho de ir a la fiesta tan pronto como escuchó que tenían fiesta en su pueblo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1012" ANNOTATION_REF="ann1011">
                <ANNOTATION_VALUE>no pudo estar escuchando nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1014" ANNOTATION_REF="ann1013">
                <ANNOTATION_VALUE>le dijo a su esposa con quien venía llegando , la muchacha del otro mundo , que deseaba ir a ver qué fiesta están celebrando en donde se oye la música.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1016" ANNOTATION_REF="ann1015">
                <ANNOTATION_VALUE>a ver si se encontraba con sus conocidos y que les preguntaría cómo están sus tíos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1018" ANNOTATION_REF="ann1017">
                <ANNOTATION_VALUE>que luego iba a preguntar si va a haber en donde alojarse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1020" ANNOTATION_REF="ann1019">
                <ANNOTATION_VALUE>y la muchacha dijo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1022" ANNOTATION_REF="ann1021">
                <ANNOTATION_VALUE>está bien , vas a ver qué fiesta hay aquí en tu pueblo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1024" ANNOTATION_REF="ann1023">
                <ANNOTATION_VALUE>preguntas todo lo que quieras saber.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1026" ANNOTATION_REF="ann1025">
                <ANNOTATION_VALUE>nada más que no acompañes a tomar lo que están tomando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1028" ANNOTATION_REF="ann1027">
                <ANNOTATION_VALUE>aunque quisieran invitarte , no recibas ( nada ) ( les ) dirás que estás muy lleno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1030" ANNOTATION_REF="ann1029">
                <ANNOTATION_VALUE>que te perdonen , así les dices a los que traten de ofrecerte lo que están tomando en la fiesta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1032" ANNOTATION_REF="ann1031">
                <ANNOTATION_VALUE>si acompañas a tomar lo que están tomando , no habrá remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1034" ANNOTATION_REF="ann1033">
                <ANNOTATION_VALUE>allí te quedarás a acompañar para siempre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1036" ANNOTATION_REF="ann1035">
                <ANNOTATION_VALUE>ya no regresarás a donde habré de estar esperándote.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1038" ANNOTATION_REF="ann1037">
                <ANNOTATION_VALUE>lo que acompañes a tomar es lo que te va a hacer olvidar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1040" ANNOTATION_REF="ann1039">
                <ANNOTATION_VALUE>ya tampoco recordarás nada de mí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1042" ANNOTATION_REF="ann1041">
                <ANNOTATION_VALUE>habrás de ir para siempre o porque tus paisanos te detengan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1044" ANNOTATION_REF="ann1043">
                <ANNOTATION_VALUE>no me va a suceder como tú te imaginas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1046" ANNOTATION_REF="ann1045">
                <ANNOTATION_VALUE>luego vengo tan pronto acaben de decirme lo que voy a preguntar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1048" ANNOTATION_REF="ann1047">
                <ANNOTATION_VALUE>aunque me ofrezcan lo que están tomando allí , yo no recibiré nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1050" ANNOTATION_REF="ann1049">
                <ANNOTATION_VALUE>nada más voy por un rato y luego regresaré.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1052" ANNOTATION_REF="ann1051">
                <ANNOTATION_VALUE>es lo que dijo el muchacho , después de que le dijeron lo que le iba a suceder si acompañaba a tomar lo que están tomando en la fiesta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1054" ANNOTATION_REF="ann1053">
                <ANNOTATION_VALUE>dizque ( por fin ) el muchacho fué a la fiesta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1056" ANNOTATION_REF="ann1055">
                <ANNOTATION_VALUE>lo que le dijo a la muchacha , quién era ya su esposa , no lo hizo así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1058" ANNOTATION_REF="ann1057">
                <ANNOTATION_VALUE>llegando a la fiesta luego comenzó a recibir lo que fueron ofreciendo y se puso a bailar en compañía</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1060" ANNOTATION_REF="ann1059">
                <ANNOTATION_VALUE>todo se le olvidó lo que tenía que hacer después , a la hora que regresara en donde lo estaba esperando su esposa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1062" ANNOTATION_REF="ann1061">
                <ANNOTATION_VALUE>aunque aseguró al decir que luego iba a regresar , no lo cumplió así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1064" ANNOTATION_REF="ann1063">
                <ANNOTATION_VALUE>y la muchacha decía a sí misma esperándolo , -- ya vendrá , ya vendrá -- y no llegó al caer la tarde y la noche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1066" ANNOTATION_REF="ann1065">
                <ANNOTATION_VALUE>habiendo anochecido ya mucho rato , buscó en donde hospedarse ( pasar la noche ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1068" ANNOTATION_REF="ann1067">
                <ANNOTATION_VALUE>no fué a alcanzar el muchacho a donde había ido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1070" ANNOTATION_REF="ann1069">
                <ANNOTATION_VALUE>se aguantó nada más lo que le sucedió.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1072" ANNOTATION_REF="ann1071">
                <ANNOTATION_VALUE>no se imaginaba si así ( sucedería ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1074" ANNOTATION_REF="ann1073">
                <ANNOTATION_VALUE>y el muchacho muy contento andaba bailando por allá ( en la fiesta ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1076" ANNOTATION_REF="ann1075">
                <ANNOTATION_VALUE>dizque habiendo pasado mucho rato de estar bailando aquel muchacho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1078" ANNOTATION_REF="ann1077">
                <ANNOTATION_VALUE>comenzaron a ofrecérsele unas muchachas señoritas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1080" ANNOTATION_REF="ann1079">
                <ANNOTATION_VALUE>cada una de ellas quería bailar siempre con él.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1082" ANNOTATION_REF="ann1081">
                <ANNOTATION_VALUE>una tras otra se le ofrecía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1084" ANNOTATION_REF="ann1083">
                <ANNOTATION_VALUE>el muchacho ya no sabía con cuál mera tenía que bailar cada vez que tocaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1086" ANNOTATION_REF="ann1085">
                <ANNOTATION_VALUE>luego se le amontonaban las muchachas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1088" ANNOTATION_REF="ann1087">
                <ANNOTATION_VALUE>dizque ya hacía dos días que andaba bailando el muchacho en compañía de las demás gentes , le dijo a una muchacha que si le gustaría vivir con él.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1090" ANNOTATION_REF="ann1089">
                <ANNOTATION_VALUE>que se casaban y no nada más así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1092" ANNOTATION_REF="ann1091">
                <ANNOTATION_VALUE>aceptó la muchacha lo que le dijeron y prometió que sí ( dió su palabra ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1094" ANNOTATION_REF="ann1093">
                <ANNOTATION_VALUE>pasó un tiempo , ya cuando se iban a casar al siguiente día ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1096" ANNOTATION_REF="ann1095">
                <ANNOTATION_VALUE>celebró el tío de la muchacha una fiesta en su casa , la que estaba ya por casarse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1098" ANNOTATION_REF="ann1097">
                <ANNOTATION_VALUE>llamaron ( los invitaron ) a los dos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1100" ANNOTATION_REF="ann1099">
                <ANNOTATION_VALUE>fueron a presenciar la fiesta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1102" ANNOTATION_REF="ann1101">
                <ANNOTATION_VALUE>ellos seguían creyendo que seguramente se casarían al siguente día.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1104" ANNOTATION_REF="ann1103">
                <ANNOTATION_VALUE>no se imaginaban si de repente había de haber lo que les impediera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1106" ANNOTATION_REF="ann1105">
                <ANNOTATION_VALUE>ya estaba todo completo lo que iban a necesitar para el casamiento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1108" ANNOTATION_REF="ann1107">
                <ANNOTATION_VALUE>ya no tenían nada pendiente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1110" ANNOTATION_REF="ann1109">
                <ANNOTATION_VALUE>ya se sentían desahogados tranquilos los encargados del casamiento y los contrayentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1112" ANNOTATION_REF="ann1111">
                <ANNOTATION_VALUE>no resultó real lo que había planeado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1114" ANNOTATION_REF="ann1113">
                <ANNOTATION_VALUE>la muchacha la que había traído ( el muchacho ) del otro mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1116" ANNOTATION_REF="ann1115">
                <ANNOTATION_VALUE>( que ) ya la habían considerado como su esposa , y le debía ( a ella ) muchos favores anteriormente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1118" ANNOTATION_REF="ann1117">
                <ANNOTATION_VALUE>dizque no se atrevía de hablarle al muchacho sin previo motivo de momento en donde lo encontraba , lo pasaba derecho nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1120" ANNOTATION_REF="ann1119">
                <ANNOTATION_VALUE>la muchacha es la que reconocía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1122" ANNOTATION_REF="ann1121">
                <ANNOTATION_VALUE>y el muchacho todo se le había olvidado desde aquella vez que empezó a recibir lo que estaban tomando en la fiesta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1124" ANNOTATION_REF="ann1123">
                <ANNOTATION_VALUE>así se quedó ya nada recordaba ni al otro día ni al tercer día.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1126" ANNOTATION_REF="ann1125">
                <ANNOTATION_VALUE>dizque supo la muchacha la verdadera esposa de aquel muchacho , que su esposo ( de ella ) iba a ir a una fiesta , y la muchacha con quién estaba por casarse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1128" ANNOTATION_REF="ann1127">
                <ANNOTATION_VALUE>dizque también la muchacha olvidada fué a la fiesta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1130" ANNOTATION_REF="ann1129">
                <ANNOTATION_VALUE>nada más por ir a encontrar con su esposo y quería hablar con él detenidamente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1132" ANNOTATION_REF="ann1131">
                <ANNOTATION_VALUE>dizque cuando llegó ( a la fiesta ) aquella muchacha del otro mundo luego comenzó a bailar en compañía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1134" ANNOTATION_REF="ann1133">
                <ANNOTATION_VALUE>dizque entre todas las muchachas que andaban bailando en la fiesta ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1136" ANNOTATION_REF="ann1135">
                <ANNOTATION_VALUE>solamente ella estaba mejor vestida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1138" ANNOTATION_REF="ann1137">
                <ANNOTATION_VALUE>a las demás muchachas se les notaba que a ella le guardaban más respeto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1140" ANNOTATION_REF="ann1139">
                <ANNOTATION_VALUE>tampoco le hablaban como quiera , también le tenían una poca de vergüenza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1142" ANNOTATION_REF="ann1141">
                <ANNOTATION_VALUE>ya hacía mucho rato que estaba bailando la muchacha cuando el muchacho pensó así - iré a bailar con aquella muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1144" ANNOTATION_REF="ann1143">
                <ANNOTATION_VALUE>dizque al momento de verla , le empezó a gustar mucho de lejos hasta donde estaba la muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1146" ANNOTATION_REF="ann1145">
                <ANNOTATION_VALUE>dejó a su prometida , fué a bailar con la muchacha quién le estaba gustando desde lejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1148" ANNOTATION_REF="ann1147">
                <ANNOTATION_VALUE>creía que nada más ( iba a bailar ) dos o tres ( piezas ) veces , no se imaginaba si se le retiraba para siempre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1150" ANNOTATION_REF="ann1149">
                <ANNOTATION_VALUE>dizque apenas habían empezado a bailar cuando la muchacha comenzó a hacerle recuerdos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1152" ANNOTATION_REF="ann1151">
                <ANNOTATION_VALUE>todo desde que habían comenzado a relacionarse en el otro mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1154" ANNOTATION_REF="ann1153">
                <ANNOTATION_VALUE>le relataron detalladamente al muchacho el motivo de haberse venido ( los dos ) por aquí , cómo venían platicando en el camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1156" ANNOTATION_REF="ann1155">
                <ANNOTATION_VALUE>al relatarle todo lo que le había ido aconteciendo anteriormente y fueron  a decirle hasta la llegada ( de los dos ) al pueblo de él muchacho , cómo se apartaron y en dónde mero fué.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1158" ANNOTATION_REF="ann1157">
                <ANNOTATION_VALUE>dizque al darle fin el relato , poco a poco fué recordando en su mente que era verdad lo que le habían hecho escuchar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1160" ANNOTATION_REF="ann1159">
                <ANNOTATION_VALUE>él mismo reconoció que no solamente lo decepcionaban con lo que le platicaron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1162" ANNOTATION_REF="ann1161">
                <ANNOTATION_VALUE>nada más acabando de reflexionar que no nada más chisme era lo que le refirieron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1164" ANNOTATION_REF="ann1163">
                <ANNOTATION_VALUE>ya él mismo recordó por su cuenta solamente le indicaron cómo había venido pasando su vida antes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1166" ANNOTATION_REF="ann1165">
                <ANNOTATION_VALUE>cómo vivía y en dónde lo asistían.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1168" ANNOTATION_REF="ann1167">
                <ANNOTATION_VALUE>dizque empezó a sentir mucha tristeza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1170" ANNOTATION_REF="ann1169">
                <ANNOTATION_VALUE>sintió una revelación ( panorama ) cómo mucho había sufrido en tiempos anteriores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1172" ANNOTATION_REF="ann1171">
                <ANNOTATION_VALUE>transcurrió un tiempo y se lo querían comer , no se lo comieron porque le hizo favor aquella muchacha la que era su verdadera esposa de salvarlo y no le pasó nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1174" ANNOTATION_REF="ann1173">
                <ANNOTATION_VALUE>dizque sin pérdida de tiempo se paró a hablar , que siempre ya no se iba a casar al día siguiente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1176" ANNOTATION_REF="ann1175">
                <ANNOTATION_VALUE>hizo que escucharan a todos los que habían ido a presenciar la fiesta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1178" ANNOTATION_REF="ann1177">
                <ANNOTATION_VALUE>todos guardaron silencio cuando empezó a hablar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1180" ANNOTATION_REF="ann1179">
                <ANNOTATION_VALUE>voy a darles la noticia a todos ustedes ( vosotros ) que están presentes en esta fiesta , que siempre ya no me voy a casar mañana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1182" ANNOTATION_REF="ann1181">
                <ANNOTATION_VALUE>el motivo es que ya tengo mi verdadera esposa y aquí está presente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1184" ANNOTATION_REF="ann1183">
                <ANNOTATION_VALUE>luego la fué a traer en donde la había dejado acabando de bailar y se paró junto a ella.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1186" ANNOTATION_REF="ann1185">
                <ANNOTATION_VALUE>le aplaudieron mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1188" ANNOTATION_REF="ann1187">
                <ANNOTATION_VALUE>yo soy que la había olvidado pobre de mi esposa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1190" ANNOTATION_REF="ann1189">
                <ANNOTATION_VALUE>ya no me acordaba si ya había quién su destino se había unido con el mío.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1192" ANNOTATION_REF="ann1191">
                <ANNOTATION_VALUE>por eso busqué otra con quien pensaba casarme.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1194" ANNOTATION_REF="ann1193">
                <ANNOTATION_VALUE>como ahora ya me dí cuenta que está mi verdadera esposa y no la puedo despreciar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1196" ANNOTATION_REF="ann1195">
                <ANNOTATION_VALUE>ya me ha hecho muchos favores anteriormente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1198" ANNOTATION_REF="ann1197">
                <ANNOTATION_VALUE>por esta razón no pienso hacerla a un lado ya que ella misma me hizo recordar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1200" ANNOTATION_REF="ann1199">
                <ANNOTATION_VALUE>le hablo sinceramente que ahora ya no estoy pensando casarme.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1202" ANNOTATION_REF="ann1201">
                <ANNOTATION_VALUE>así quedan enterados que no me caso mañana y aunque prometí hacerlo cuando pedí a la muchacha con quien me iba a casar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1204" ANNOTATION_REF="ann1203">
                <ANNOTATION_VALUE>quedan notificados que no la engañé intencionalmente , sino que fué un error mío.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1206" ANNOTATION_REF="ann1205">
                <ANNOTATION_VALUE>me hacen favor de acompañar en la ida de aquella muchacha que vino conmigo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1208" ANNOTATION_REF="ann1207">
                <ANNOTATION_VALUE>ya no puedo ir a dejarla a su casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1210" ANNOTATION_REF="ann1209">
                <ANNOTATION_VALUE>dizque acabando de hablar aquel muchacho , luego se retiró de la fiesta con su esposa y juntos se fueron para sus casas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1212" ANNOTATION_REF="ann1211">
                <ANNOTATION_VALUE>y la muchacha la que era novia ( pedida ) , allí mismo se quedó por el momento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1214" ANNOTATION_REF="ann1213">
                <ANNOTATION_VALUE>luego todos empezaron a retirarse poco a poco</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1216" ANNOTATION_REF="ann1215">
                <ANNOTATION_VALUE>se soltó llorando sin descansar al escuchar que ya no habrá casamiento con ella.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1218" ANNOTATION_REF="ann1217">
                <ANNOTATION_VALUE>en esta forma quedó suspendida la fiesta , ya nadie bailó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1220" ANNOTATION_REF="ann1219">
                <ANNOTATION_VALUE>también reinaron los sentimientos y aflicciones entre los padres de la muchacha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1222" ANNOTATION_REF="ann1221">
                <ANNOTATION_VALUE>porque la hija de ellos la abandonaron repentinamente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1224" ANNOTATION_REF="ann1223">
                <ANNOTATION_VALUE>nunca se imaginaban que a su hija ( de ellos ) le iba a tocar esa suerte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1226" ANNOTATION_REF="ann1225">
                <ANNOTATION_VALUE>en esta forma termina el relato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <LINGUISTIC_TYPE GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="tx" TIME_ALIGNABLE="true"/>
    <LINGUISTIC_TYPE CONSTRAINTS="Symbolic_Association" GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="ft" TIME_ALIGNABLE="false"/>
    <LINGUISTIC_TYPE CONSTRAINTS="Symbolic_Association" GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="ref" TIME_ALIGNABLE="false"/>
