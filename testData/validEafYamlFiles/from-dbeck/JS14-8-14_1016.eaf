        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>se va a casar conmigo y va a mandar a hacer un puente, dice</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>pues ¿qué dices tú, será una persona o es otro? porque aquí no hay personas, nunca vemos a nadie, le dice su papá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a16">
