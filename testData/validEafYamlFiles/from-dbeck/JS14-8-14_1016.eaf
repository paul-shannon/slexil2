        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>pues me ofrece un terreno que es de allí del otro lado (de cerro o arroyo) este, es grande allí que se alcanza a ver</ANNOTATION_VALUE>
