    <TIER LINGUISTIC_TYPE_REF="glossing" PARENT_REF="José Sosa Reyes" TIER_ID="translation">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>pues ahora este pus en cada pueblo han pasado cosas diferentes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>porque como aquí en Patla lo que pasó es diferente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>ahora en otros lugares se dice que en un pueblo, es puro cerro, no se puede trabajar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>vino un día se levantó ese hombre, es que tenía una hija</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>porque dios puso el mundo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>uno por uno los va a salvar como dicen la palabara y si hay una persona le va a entregar Dios (agent)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>pues ese hombre que le gusta trabajar tenía un pedazo de terreno donde trabajaba, le dijo a ese, a este hombre, lo encontró, ¿adónde vas?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>estoy llevando lonche, es que era las doce, le estoy llevando a mi papá, le dijo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>le llevo lonche a mi papá, le dijo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>¿dónde trabaja?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>allí trabaja, le dijo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>un pedazo de terreno dónde está trabajando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>y ahora le dice, y ¿no te gusta ese terreno?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>mira lo que está de aquel lado. es plano, está grande para trabajar. alla va a trabajar tu papá, ¿no te gusta? (the man is offering a better plot for the father to work on)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>alla va a trabaja más grande tu papá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>este, ¡no más piénsale!</ANNOTATION_VALUE>
