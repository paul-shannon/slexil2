        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>ahora le dice, papá, le dice, encontré a un hombre pero parecía rico llevaba diente de oro, su gorra era bonito, llevaba pistola, dice</ANNOTATION_VALUE>
