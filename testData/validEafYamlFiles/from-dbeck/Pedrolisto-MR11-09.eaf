    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss" PARENT_REF="Ex" TIER_ID="L2Gloss">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a402" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>‘it’s just that we threw our tack into the river, the muleskinners said to each other’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss" PARENT_REF="Ex" TIER_ID="L3Gloss">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1461" ANNOTATION_REF="a1201">
                <ANNOTATION_VALUE>‘cuidaba a los puercos’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1462" ANNOTATION_REF="a1202">
                <ANNOTATION_VALUE>‘día tras día lo llevaba, cuidaba a los puercos’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1463" ANNOTATION_REF="a1203">
                <ANNOTATION_VALUE>‘entonces parece que se aburrió y ya no quiso cuidarlos’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1464" ANNOTATION_REF="a1204">
                <ANNOTATION_VALUE>‘pues, vendió tres’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1465" ANNOTATION_REF="a1205">
                <ANNOTATION_VALUE>‘después, pusó tres en el pantano’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1466" ANNOTATION_REF="a1206">
                <ANNOTATION_VALUE>‘después dice al dueño’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1467" ANNOTATION_REF="a1207">
                <ANNOTATION_VALUE>‘está mal, se hundieron sus puercos’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1468" ANNOTATION_REF="a1208">
                <ANNOTATION_VALUE>‘ahora, ve, ayudarme a sacarlos’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1469" ANNOTATION_REF="a1209">
                <ANNOTATION_VALUE>‘van a ir a ver’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1470" ANNOTATION_REF="a1210">
                <ANNOTATION_VALUE>‘entonce le dijo el dueño’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1471" ANNOTATION_REF="a1211">
                <ANNOTATION_VALUE>‘ve a traer un lazo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1472" ANNOTATION_REF="a1212">
                <ANNOTATION_VALUE>‘vamos a sacarlos’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1473" ANNOTATION_REF="a1213">
                <ANNOTATION_VALUE>‘allá están divisando para acá los otros tres’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1474" ANNOTATION_REF="a1214">
                <ANNOTATION_VALUE>‘rapido viene para allá’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1475" ANNOTATION_REF="a1215">
                <ANNOTATION_VALUE>‘pues, ahora le dijo, ahora llegó el dueño’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1476" ANNOTATION_REF="a1216">
                <ANNOTATION_VALUE>‘¡tiende el petate!’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1477" ANNOTATION_REF="a1217">
                <ANNOTATION_VALUE>‘tenemos que acostarnos un rato’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1478" ANNOTATION_REF="a1218">
                <ANNOTATION_VALUE>‘y así te habla tu patrón’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1479" ANNOTATION_REF="a1219">
                <ANNOTATION_VALUE>‘le dijo así’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1480" ANNOTATION_REF="a1220">
                <ANNOTATION_VALUE>‘me dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1481" ANNOTATION_REF="a1221">
                <ANNOTATION_VALUE>‘debes ir a acostarte un ratitio’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1482" ANNOTATION_REF="a1222">
                <ANNOTATION_VALUE>‘mejor te vayas, le dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1483" ANNOTATION_REF="a1223">
                <ANNOTATION_VALUE>‘agarra un garrote y lo quiere pegar’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1484" ANNOTATION_REF="a1224">
                <ANNOTATION_VALUE>‘huyó otra vez’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1485" ANNOTATION_REF="a1225">
                <ANNOTATION_VALUE>‘entonces, vino el dueño’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1486" ANNOTATION_REF="a1226">
                <ANNOTATION_VALUE>‘¿dónde fue Pedro, por qué no trajo el lazo?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1487" ANNOTATION_REF="a1227">
                <ANNOTATION_VALUE>‘¡que no va a llevar el lazo allá!’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1488" ANNOTATION_REF="a1228">
                <ANNOTATION_VALUE>‘nada más me está diciendo las groserías, es que le dijiste allí’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1489" ANNOTATION_REF="a1229">
                <ANNOTATION_VALUE>‘ve acostarte con ella un rato’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1490" ANNOTATION_REF="a1230">
                <ANNOTATION_VALUE>‘te vas a acostar con mi esposa, le dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1491" ANNOTATION_REF="a1231">
                <ANNOTATION_VALUE>‘así solo me paso a decir y se fue, dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1492" ANNOTATION_REF="a1232">
                <ANNOTATION_VALUE>‘ah, es pendejo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1493" ANNOTATION_REF="a1233">
                <ANNOTATION_VALUE>‘¿a dónde se fue?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1494" ANNOTATION_REF="a1234">
                <ANNOTATION_VALUE>‘no sabía adonde fue’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1495" ANNOTATION_REF="a1235">
                <ANNOTATION_VALUE>‘ahora lo voy a buscar’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1496" ANNOTATION_REF="a1236">
                <ANNOTATION_VALUE>‘lo fue a buscar y ya no lo encontro’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1497" ANNOTATION_REF="a1237">
                <ANNOTATION_VALUE>‘entonces, &lt;u&gt;pendejo&lt;/u&gt; se acabaron los puercos’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1498" ANNOTATION_REF="a1238">
                <ANNOTATION_VALUE>‘mataron a los tres’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1499" ANNOTATION_REF="a1239">
                <ANNOTATION_VALUE>‘nada mas los vendí, dice ese hombre’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1500" ANNOTATION_REF="a1240">
                <ANNOTATION_VALUE>‘los puercos, todos se perdieron’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1501" ANNOTATION_REF="a1241">
                <ANNOTATION_VALUE>‘seis’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1502" ANNOTATION_REF="a1242">
                <ANNOTATION_VALUE>‘entonces, se hacía una casa’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1503" ANNOTATION_REF="a1243">
                <ANNOTATION_VALUE>‘allí estaba Pedro arriba mirando’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1504" ANNOTATION_REF="a1244">
                <ANNOTATION_VALUE>‘están saliendo unas muchachas’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1505" ANNOTATION_REF="a1245">
                <ANNOTATION_VALUE>‘qué haces, Pedro?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a192" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>‘no hago nada, les dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a193" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>‘que tienes en la pompa? le dijeron’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a194" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>‘lo que tengo en la pompa es para adornar el corazon’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a195" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>‘que adornes mi corazon, dice una muchacha’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a196" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>‘después bajó y jugueteaba con ella’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a197" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>‘pues entonces llegó (con una de sus amigas)’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a198" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>‘le dijo, Pedro me adornó el corazon’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a199" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>‘¿y te adorna? ese solo está jugueteando contigo, le dijeron’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a200" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>‘otra vez la mandó con él’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a201" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>‘ahora que te lo saque’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a202" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>‘¿cómo que la va a levantar?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a203" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>‘fue a jugar otra vez con ella’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a204" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>‘misspoken’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a205" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>‘ya me sacó, es que dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a206" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>‘y no ha sacado, soló fur a jugar con ella’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a207" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>‘pues, ahora se va Pedro’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a208" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>‘entonces, los encuentra los arrieros’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a209" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>‘no quieres que me acueste aquí, aquí debo descansarme la espalda’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a210" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>‘descánsatela, allí están costales’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>‘en esas acuestate, le dijeron’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a212" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>‘mejor me voy a meter’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a213" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>‘tengo mucho frío, dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a214" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>‘se acostó’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>‘se metió en el costal’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>‘ahora dicen los arrieros’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>‘ahora mejor vamos a echar ese Pedro al rio’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>‘porque no está bueno lo que anda haciendo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>‘mejor lo tiramos al río’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>‘ahoravamos a echarlo al rio, dicen los arrieros’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a407" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>‘lo llevaron columpiandose’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>‘lo llevaron dentro del costal’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>‘ahora, lo columpian y con fuerza lo arrojan al agua’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>‘entonces, adíos Pedro, le dicen’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>‘adíos, les dijo de allí del otro lado del río’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a412" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>‘entonces dicen los arrieros’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a413" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>‘juta madre, nos engañó’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a414" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>‘dice ahora, hay un hombre’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a415" ANNOTATION_REF="a230">
                <ANNOTATION_VALUE>‘¿qué hacen Uds. aquí?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>‘nada, yo estoy cuidando mi dinero, dijo ese Pedro’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>‘se va otra vez’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>‘pues este, qué haces sentado aquí?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>‘así como digo, cuido mi dinero, dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>‘¿no vendes?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>‘yo vendo si lo compras’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>‘dámela, le dice el arriero’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>‘voy a comprar, dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a424" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>‘esta floreciendo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a425" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>‘puro dinero da, dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a426" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>‘mucho dinero se da, ya dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>‘y todavía no era verdad’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a428" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>‘solo con esto lo ha engañado’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a429" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>‘pues, compró’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a430" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>‘entonces, no cayó nada’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a431" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>‘no se dio nada de dinero’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a247">
                <ANNOTATION_VALUE>‘engaño al arriero’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a433" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>‘después, nada mas por eso vendió todos sus caballos’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a434" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>‘dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a435" ANNOTATION_REF="a250">
                <ANNOTATION_VALUE>‘ahora no hay nada, mejor no le hubiera dicho y ahora se acabaron todos mis caballos’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a436" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>‘ahora dice el padre, vayanse a llamar ese Pedro’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a437" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>‘de veras engaña’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a438" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>‘¿para qué engaña con los dos animales?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a439" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>‘fueron a llamarlo por él’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a440" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>‘entonces llega, ¿qué quieres conmigo?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a441" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>‘te llamó por si acaso traes algo para engañar’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a442" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>‘no lo llevo, ahora no le he traído, les dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a443" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>‘lo con que engaño está allí en la iglesia’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1198" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>‘y está lejos donde está? le dicen’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1199" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>‘está lejos’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1200" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>‘ve a traerle’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a444" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>‘te voy a dar me caballo, vas en él, le dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a445" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>‘pues, lo voy a traer si me das tu caballo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a446" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>‘allí donde tú dices, dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a447" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>‘por que está lejos’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a448" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>‘pues vas en mi caballo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a449" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>‘le da su caballo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a450" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>‘mucho lo hace corcovear’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a451" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>‘no me llevó su caballo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a452" ANNOTATION_REF="a270">
                <ANNOTATION_VALUE>‘se pone bravo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>‘mejor me das todos tus libros’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a454" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>‘entonces, mi dueño me monta, va a pensar’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a455" ANNOTATION_REF="a273">
                <ANNOTATION_VALUE>‘y me llevará’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a456" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>‘y solo así me va a llevar’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a457" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>‘te los voy a dar, le dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a458" ANNOTATION_REF="a276">
                <ANNOTATION_VALUE>‘le dió todos sus libros’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a459" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>‘y la mascara le dió’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a460" ANNOTATION_REF="a278">
                <ANNOTATION_VALUE>‘y ahora monta el caballo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a461" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>‘se lo lleva’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a462" ANNOTATION_REF="a280">
                <ANNOTATION_VALUE>‘pues, lo lleva y ya no trae el caballo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a463" ANNOTATION_REF="a281">
                <ANNOTATION_VALUE>‘ahora este padre’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a464" ANNOTATION_REF="a282">
                <ANNOTATION_VALUE>‘no viene Pedro y quiero ir a pasear’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a465" ANNOTATION_REF="a283">
                <ANNOTATION_VALUE>‘estoy queriendo mi caballo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a466" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>‘ahora el no lo trae, dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a467" ANNOTATION_REF="a285">
                <ANNOTATION_VALUE>‘bueno, por que a proposito lo mandaste a llevar? le dicen’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a468" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>‘parece que es él que viene alli’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a469" ANNOTATION_REF="a287">
                <ANNOTATION_VALUE>‘vayan a llamármelo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3942" ANNOTATION_REF="a1506">
                <ANNOTATION_VALUE>‘le voy a hablar’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a470" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>‘ese es, está trayendo mi caballo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a471" ANNOTATION_REF="a289">
                <ANNOTATION_VALUE>‘mucho está arrastrando al caballo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a472" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>‘cuando llegó con el caballo estaba viejo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a473" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>‘yo te he llamado’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a292">
                <ANNOTATION_VALUE>‘no quiero vender mi caballo, está bonito’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a475" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>‘me gustó, por eso lo tuve que comprar, dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a476" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>‘y es él que ha llevado el caballo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a295">
                <ANNOTATION_VALUE>‘entonces, véndemelo te voy a pagar como me pides’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>‘bien, si me pagas como te pido, te lo doy’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>‘y vendió su caballo, estaba engañando otra vez’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a298">
                <ANNOTATION_VALUE>‘se engaño el padre’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>‘ahora, báñenmelo, voy a pasear en el’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a300">
                <ANNOTATION_VALUE>‘entonces, se lavó todo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a483" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>‘ese que es mi caballo, hijomadre, me engaño’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a484" ANNOTATION_REF="a302">
                <ANNOTATION_VALUE>‘no está bien lo hace ese Pedro’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a485" ANNOTATION_REF="a303">
                <ANNOTATION_VALUE>‘acaso ya se fue lejos?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a486" ANNOTATION_REF="a304">
                <ANNOTATION_VALUE>‘te lo vamos a buscar, les dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a305">
                <ANNOTATION_VALUE>‘lo fueron a buscar y ya no está’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a306">
                <ANNOTATION_VALUE>‘ya se ha huído otra vez’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a307">
                <ANNOTATION_VALUE>‘hasta al cura Pedro le engaño’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a490" ANNOTATION_REF="a308">
                <ANNOTATION_VALUE>‘pues entonces, me egañó’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a491" ANNOTATION_REF="a309">
                <ANNOTATION_VALUE>‘de veras engaña, dice el cura’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a310">
                <ANNOTATION_VALUE>‘no lo pudieron traer, le engaño’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
