    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Text" PARENT_REF="Ex" TIER_ID="Line">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>pús kit nakwaniyán cuento David [00.00]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>xkwento chínalimin chíchini' [00.02]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a39" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>mat mat xwi:lh a'htin chiwíx a:ntzá xtátawaka lakstín xtapa:s'o porque chíchi ixhalhí [00.07]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>tsúkuka' lakputzakán chi: nalhawakán [00.14]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a41" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>tasati:ka' tzama: kilhxkaját [00.17]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>wanikán wix nala'hpálha' porque á'lha minkilhchújpi [00.23]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a43" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>mat tzukúlh wili:ní mat [00.27]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>makastín ma:yúju:ní he: pe'hxpe'hx ki:lhlá pús taki:lh talhtahálh kilhchújpi [00.31]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>[ali:s]tán waní tzama: wanikán ti:xka:putza:ní s'punín [00.39]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>tséj karpintéru kawaní xláh [00.44]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a47" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>kilh hase:ro porque kit ja: pálha' kinki:lhní tawaní [00.47]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>naktasati:ka' cha:kán wanikán wix kilhhase:ru wix nalháwaya' [00.51]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>tzukúlh kilh wili:ní tzukúlh pá'hlh– pa'hlhli' xláh [00.58]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>taxtúlh a'htín makchuná a:súlh wa' pero laklálh ja:tzá chíchiwanli' [01.03]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>[ali:s]tán pu:tzapaláka chi: nali:makalakán tu: chíchi' [01.10]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>[ali:s]tan waní tala:waní tzama: xkúti' he: chichí [01.15]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>pu:tzama:ka' mat na:maklakán  tu: chíchi' wankanamín chíchini' [01.22]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>naná: ma'hla'hapáxto'há: wan he: pero chi: nálho:yá kinán </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>pús kinán wix he: kit kala:mu– lamasá kwaniyá mintalahá:nu' he: masakwaniyán kila'h mat wanikán chichí [01.34]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>tala:lá' pali:lh ha:máka:tzá [01.43]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>chu:wá tzukúka' ka:préparar, ka:maskatikán ma'hapítzi' s'punín chi:ntapixlí' chinamíntzá chíchini' ' [01.47]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>chu:wá ka:wanikán mán ti:laktséwani ix.. ixhe:chixitkán [01.55]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>ka:ma:núka naktzaxka:maskati:má:ka' chi: píxlini:kán ma'hapítzi: s'punín chuwá wan [02.01]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>ja: tzama: tzama: tzilín s'pun ja: kati:ska'hli' tzama: xalhhénti'   [02.09]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a61" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>ja: ti: xmanú puró he:pún xlata:yá [02.14]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a62" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>ma'he:lhchá xtalakanu:ta:yá  [02.18]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a63" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>júta: xní chu:wá nína ka:maskati:ho: xní wankán namintzá chíchini' chu:wa na:nájtzá  [02.20]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>júta chu:wá tu: go kamat'ohopaláka' ka:lénka [02.30]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE> chuwá xni wanílh... chuwá kapixli:tít ti: tzá mi:malhtzá kawanikán tzama: s'pun [02.33]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>s'punin júta ja: tu: tutakatzílh lhátapixlilh  [2.38]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>ta:tala'hpali:hólh ixtapixli:kán xtumxtum tapixlilhchí tanatúnu' [02.43]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>chu:wá waní chu: tzukúlh pi:xlí tzama: tzilín s'pun júta kalaksásawán tséwani chípixlilh [02.53]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>ka:s'awiho:lh pó'htu' spunín [02.58]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>u:tzá  a:xmán makawánli' u:tzá kashawiho:lh ixtas'punín ha:chulá xlá ska'hli' chi: pixlikán he: ja: ma'hapi:tzín [03.01]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Analysis" PARENT_REF="Ex" TIER_ID="Morph"/>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Analysis" PARENT_REF="Ex" TIER_ID="ILEG"/>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss" PARENT_REF="Ex" TIER_ID="L2Gloss"/>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss" PARENT_REF="Ex" TIER_ID="L3Gloss">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>'yo te voy a contar un cuento David' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>'el cuento de como va a salir el sol' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>'es que abia una piedra allí se subian los niños para calentarse porque estaba caliente' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>'empezaron a buscarle como iban a hacer [para quitar esa piedra que tapaba el sol]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>'llamaron al tucan' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>'le dicen, tu vas a romper esa piedra porque tu pico es grande'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>'es que empezo a pegar [la piedra] es que' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>'de poquito rompia la piedra a pedacitos pues su pico se rompio' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>'despues le dicen a ese el que abia buscado a los pajaros' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>'mejor dille al [pajaro] carpintero, el' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>'su pico es de hacero, yo mi pico no es duro, le dice [el tucan al señor]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>'es que llamaron al pajaro carpintero, le dicen, tu vas a romper [la piedra] porque tu pico es de hacero'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>'empezo a pegarle [la piedra], empezo a romperlo, el lo rompio' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>'salio una bola redonda que parecia azul pero se descompuso, ya no era caliente' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>'despues, buscaron como lo iban a encontrar lo que era caliente, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>'despues se dicen, esos el tejón y el perro' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>'estan buscando es que lo van a encontrar lo que esta caliente, se dice que va a salir el sol' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>'vamos a ir a acompañarlos, dice, y pero como le vamos a hacer nosotros? [se dicen el perro y e tejón]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>'pues nosotros, tu y yo, me vas a emprestar tu máscara (cara), y yo te voy a prestar el mio, le dicen al perro' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>'se intercambiaron [las mascaras] y ya se iban'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>'ahora empezaron a preparar, les enseñaron a los demas pajaros como iban a cantar porque iba a salir el sol' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>'ahora les dicen [a los pajaros], nada mas los que tienen plumas bonitas'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>'los metieron allí donde le estaban inseñando a cantar como a los otros pajaros, ahora dice:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>'no ese ese pajaro canario, no va a aprender a cantar, porque es bien tonto' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>'no lo dejaban entrar [donde estaban enseñando a los otros], lo dejaban afuera' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>'en la puerta se quedaba viendo' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>'ijole, dijieron ahora cuando ya estaban listos dicen ja va a salir el sol, ahora ya nos vamos a ir [a esperarlo]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>'ijole, ahora cuando los juntaron, se los llevaron a esperar </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>'ahora cuando les dijieron, ahora canten porque ya viene [el sol], asi les dicen  a los pajaros' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>'los pajaros, ijole, no superion cantar'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>'cambiaron todos sus cantos y cada uno empezo a cantar a su manera' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>'ahora empezo a cantar ese pajaro canario, ijole, cantaba bien afinado, canto bien bonito </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>'les gano a todos los pajaros'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>'es el que gano al final, el gano a todos los pajaros, el aprendio a cantar mejor que los de mas [pajaros]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
