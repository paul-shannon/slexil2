        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>chuntzá nala:ninipalayán minkúxu'</ANNOTATION_VALUE>
