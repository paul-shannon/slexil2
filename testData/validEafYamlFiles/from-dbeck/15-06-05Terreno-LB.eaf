        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>jú:ta chi: tawi:lá xa:wát</ANNOTATION_VALUE>
