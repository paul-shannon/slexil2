        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>a:chulá xatzéj [kaj...] ma:n ne'hninkán he: talakán a'hasitma:pi:kán</ANNOTATION_VALUE>
