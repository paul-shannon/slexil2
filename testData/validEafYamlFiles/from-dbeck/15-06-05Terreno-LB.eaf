        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>ja: tajé: katitaka:katzaní:lh</ANNOTATION_VALUE>
