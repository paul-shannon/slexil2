            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>cará pus na'hsputpaláya' chuwá: na...</ANNOTATION_VALUE>
