    <TIER LINGUISTIC_TYPE_REF="%xspa" PARENT_REF="*BR2"
        PARTICIPANT="BR2" TIER_ID="%xspa@BR2">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann343" ANNOTATION_REF="ann342">
                <ANNOTATION_VALUE>¿dónde está su banco?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann350" ANNOTATION_REF="ann349">
                <ANNOTATION_VALUE>allá está.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann357" ANNOTATION_REF="ann356">
                <ANNOTATION_VALUE>ya no está.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann361" ANNOTATION_REF="ann360">
                <ANNOTATION_VALUE>ya no está.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann383" ANNOTATION_REF="ann382">
                <ANNOTATION_VALUE>ése es mío mamá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann390" ANNOTATION_REF="ann389">
                <ANNOTATION_VALUE>sí ¿a poco el tuyo está pegado?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann393" ANNOTATION_REF="ann392">
                <ANNOTATION_VALUE>¿está pegado tu dibujo?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann397" ANNOTATION_REF="ann396">
                <ANNOTATION_VALUE>¿verdad mamá? aunque dámelo le voy a enseñar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann401" ANNOTATION_REF="ann400">
                <ANNOTATION_VALUE>¿a poco es tuyo éste?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann414" ANNOTATION_REF="ann413">
                <ANNOTATION_VALUE>¿a dónde está el tuyo?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann417" ANNOTATION_REF="ann416">
                <ANNOTATION_VALUE>ya lo quemaron ya no hay.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann434" ANNOTATION_REF="ann433">
                <ANNOTATION_VALUE>de azúcar traía así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann451" ANNOTATION_REF="ann449">
                <ANNOTATION_VALUE>se escapó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann464" ANNOTATION_REF="ann463">
                <ANNOTATION_VALUE>¿tú fuiste a agarrar?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann467" ANNOTATION_REF="ann466">
                <ANNOTATION_VALUE>mira éste es la carne.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann470" ANNOTATION_REF="ann469">
                <ANNOTATION_VALUE>te engañé cascabel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann509" ANNOTATION_REF="ann508">
                <ANNOTATION_VALUE>mira cascabel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann571" ANNOTATION_REF="ann570">
                <ANNOTATION_VALUE>aunque.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann580" ANNOTATION_REF="ann579">
                <ANNOTATION_VALUE>está amargo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann583" ANNOTATION_REF="ann582">
                <ANNOTATION_VALUE>¿verdad que es igual?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann586" ANNOTATION_REF="ann585">
                <ANNOTATION_VALUE>está amargo ¿a poco es que está amargo?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann619" ANNOTATION_REF="ann618">
                <ANNOTATION_VALUE>yo lo lavé mami lo que ocupé tomar café.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann795" ANNOTATION_REF="ann794">
