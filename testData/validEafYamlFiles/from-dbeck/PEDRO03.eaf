            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann944" ANNOTATION_REF="ann943">
                <ANNOTATION_VALUE>ya me lo quitaste ya me lo quitó papi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann948" ANNOTATION_REF="ann947">
