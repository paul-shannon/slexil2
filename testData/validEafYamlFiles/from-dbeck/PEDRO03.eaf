            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann819" ANNOTATION_REF="ann818">
                <ANNOTATION_VALUE>no hay tortilla lo han guardado tortilla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann829" ANNOTATION_REF="ann828">
                <ANNOTATION_VALUE>no mami ya lo acabaron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann845" ANNOTATION_REF="ann844">
