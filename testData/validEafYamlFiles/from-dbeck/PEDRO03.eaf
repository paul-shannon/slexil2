            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann932" ANNOTATION_REF="ann930">
                <ANNOTATION_VALUE>mamá nomás hace lo que quiere el José.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann938" ANNOTATION_REF="ann937">
