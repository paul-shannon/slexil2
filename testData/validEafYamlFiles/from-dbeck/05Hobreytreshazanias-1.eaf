        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>5.3 ʔakšnií ščapapatankán, tunkunh¢aːláɬ. kkaːλankaakiwiín tanúːɬ. naːɬška¢íː taːníː šlamaːčáʔ.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>5.4 míɬ maqtám kaː¢iːsníʔ, niːšliːka¢íː kahšamaqtám qašmátɬii piː¢ukukahmakawankán kštampíːn kaːkiwiín</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
