        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>5.7 ʔakšnií činqúːɬ kštampíːn kiwií tuː špuːwakaá tamaá čiškuú tiː šmakawantiːɬaqúː, ʔantaá takaːštiwilaqúːɬ, ¢ukuquːɬqaɬčiwiːnanqúː</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
