                <ANNOTATION_VALUE>5.8 laːqaɬskinqúːɬ tuː šλawaquːníːtiː štaliːqaɬiːnhkán nakkaːčučutsipihníʔ.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
