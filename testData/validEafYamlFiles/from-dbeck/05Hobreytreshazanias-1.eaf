            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts495" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>5.124 maːštukaá čučút,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts499" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>5.125 naːwaá čaːtám čiškuú tiː kiːmaːsiyíɬ,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>5.126 liːpiːkwaá čiyuú ksiː¢iːmá, niːšakka¢íː papiːnaka¢iːkán,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>5.127 čiyú, ʔuːnuú kaxaščáːw λankaaliyá, naːɬmaqát káːw."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts511" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>5.128 tunkunhwaá čaːtám,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>5.129 "niːqanqawaːnanaːtín šaliːwáːy kaɬstiyaːnú (karstiyaːnú)?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts521">
                <ANNOTATION_VALUE>5.130 maːšwií tiː kinkaːqaɬaqašmatmáːn, naláy wií laka¢úː,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts525">
                <ANNOTATION_VALUE>5.131 kapa¢ačáːw,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>5.132 wanqúː piːpaksšqašmatmaá čiškuú tuː škiɬwamaːqúː, čuː ʔakšnií lakaštám špa¢amaːqúː, kštampíːn kaːkiwiín.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>5.133 ʔaktanksʔakšiɬqúːɬ ¢ukuquːɬtawakaqúː kkiwií tuː špuːwaká, liːpiːkwaá ¢ukuɬpiːkwán.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>5.134 ʔakšnií taːqsqúːɬ taːníː ¢iːqšwaká, šwataːktiːqúːɬ.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts541">
                <ANNOTATION_VALUE>5.135 ʔantatunkún kštantíːn kiwií maqniːqúːɬ, liːmakatám waqúːɬ.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts543" TIME_SLOT_REF2="ts545">
                <ANNOTATION_VALUE>5.136 ʔantaá tamaqaštáqɬii čiškúʔ, naːɬtaspítɬi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts547" TIME_SLOT_REF2="ts549">
                <ANNOTATION_VALUE>5.137 ni:ška¢í ipapi:čanaá a:qspulú liwipaːšawaá ʔakšnií takáːšɬii kščiki, naːčanaá ktʃniíntʃaɬtʃintin kiwiín tu: tili: tawakáɬ.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts553">
                <ANNOTATION_VALUE>5.138 ʔaːnqaɬíːn šlakapaːstakmaá piːɬuːwaá tamíːn nataːtaspíta.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts557">
                <ANNOTATION_VALUE>5.139 páks tuː tilakapaːstákɬi, niːmaːλaːníːɬ.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>5.140 ʔantaá laqspútɬii taːníː taːqská. naːɬtaspítɬi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="Spanish">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts2">
                <ANNOTATION_VALUE>5.0 El hombre y las tres hazañas</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>muchos saben (mucha gente sabe) que vivía un hombre, era muy malcriado</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>nadie lo quería, por eso lo desterraron lejos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>cuando querían agarrarlo, luego se huyó. se metió en un gran bosque. y (allá andaba sin rumbo) ya no sabía por donde andaba</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>llegó una noche, sin imaginarse de repente oyó que empezaron a hacer ruido debajo de los árboles. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>dizque tuvo mucho miedo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>luego se subió en un árbol grande.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>cuando llegaron debajo del árbol en que estaba subido aquel hombre los que venían haciendo ruido, allí se acomodaron a sentarse, empezaron a conversar.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>se preguntaron de sus maldades que habían hecho en los pueblos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>empezó a contar uno que venía por delante</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>está muriendo ya la hija del rey, yo le puse debajo de su cama lo que la está chupando.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>muchos médicos vinieron ya a verla, no la pueden aliviar</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>si le quitaran lo que la está chupando, entonces se aliviará</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>ya no habrá nada que la moleste.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>y el otro relató así.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>yo escondí su agua a un pueblo, ahora ya están padeciendo de sed. ya no tienen nada que beber.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>lo puse debajo de la plaza, allí se está juntando.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>nadie sabe si allí está su agua (de ellos) los tontos que se están aguantando,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>y dijo el tercero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>le escondí su maíz a otro pueblo, lo metí dentro de un cerro,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>ahora ya nada más están padeciendo hambre (hambreándose). ya no tienen nada que comer, se les ha acabado todo por completo su maíz de ellos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>que se aguanten, (a) eso estaban queriendo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>nunca les faltaba nada en sus casas. creían que todo el tiempo iban a tener todo completo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE> no se imaginaban si iba a llegar un tiempo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>entonces ayunarían como ahora están padeciendo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>que allá sigan padeciendo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>cuando terminaron sus conversaciones, se fueron tomando cada quien por su lado (su ruta).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>y el hombre quien estaba subido en el árbol, oyó todo lo que se dijeron los tres (sujetos).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>que ya se fueran, ya se retiraran -- deseaba el hombre cuando estaban conversando debajo del árbol en el que estaba subido. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>cuando amaneció, se bajó aquel hombre, tomó un camino que va derecho a un pueblo cercano.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>apenas iba por la orilla (del pueblo) cuando empezó a preguntar (que) por dónde vivía el rey,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>cuando encontró por donde vivía, allí se quedó, solicitó trabajo y le dieron, empezó a trabajar</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>no dijo luego si él sabía lo que la estaba venciendo a la hija del rey,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>se llegó un día, empezó a platicar con el rey, le dijo así. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>patrón, si me das mucho dinero, yo sé por donde está un animal lo que la está chupando a tu hija,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>si está enferma de gravedad (es por algo),</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>no puede aliviarse, (el animal) está cerca de su cama</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>el rey dijo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>no es cierto -- no lo creía,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>muchas veces le dijo que sí era cierto (que) sabía</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>dijo el rey,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>si es cierto, está bueno.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>te voy a dar la mitad de mi dinero de lo que tengo, si no es cierto, nada más estás diciendo, me trabajarás gratuitamente cuatro años, solamente haré gastos de tu comida</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>no sabía si era cierto lo que estaba diciéndole su mozo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>al siguiente día buscó muchos sus mozos el rey, ellos mudaron leña de donde había sido apilada, allí se escondía el animal que la estaba chupando la muchacha.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>todos los días allí iba de día a esconderse, solamente en la(s) noche(s) iba a alcanzar a la muchacha en su cama.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>cuando hallaron los mozos aquel animal, lo mataron inmediatamente, pusieron lumbre grande y allí lo echaron ya muerto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>luego al siguiente día empezó a hablar la muchacha, también empezó a comer bien.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>y anteriormente ya no comía. ya nada más estaba quieta en su cama. ya no se movía,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>se alegró mucho el rey cuando supo que era cierto lo que le había dicho un mozo suyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>siempre le dieron a ese hombre el dinero que le habían declarado,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>se llevó mucho dinero. nada más de favor le buscaron quien lo acompañó a llevar</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>cuando llegó a otro pueblo, empezó a pedir de comer. en muchas partes del pueblo fué a preguntar, nadie le dió de comer.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>por eso creyó que era cierto que no había maíz, estaban padeciendo mucha hambre.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>C</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>vengo a decirles si pueden aceptar mi (promesa) palabra, sobre lo que voy a manifestarles</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>pobre el pueblo en la forma que está sufriendo, no tiene nada que tomar, vive en medio de la tristeza.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>si me dan mucho dinero, yo sé a donde está el maíz</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>y las autoridades no se lo creían, ellas pensaban que nada más estaba mintiendo ese hombre.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>ya por muchas veces que se estaba ofreciendo que sí sabía por donde estaba el maíz, contestó el presidente.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>si es cierto lo que estás diciendo, está bien. si no va a dar resultado tus palabras, tú lo sabes. después nos arreglaremos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>luego al siguiente día juntó el presidente al pueblo, les dijo que vino un hombre, dizque sabe en dónde está nuestro maíz</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>solamente necesita que le demos mucho dinero.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>cuando acabó de oír el pueblo, se alegró mucho. luego llevaron sus instrumentos de trabajo al cerro por donde estaba mucho maíz de ellos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>todos se ayudaron mutuamente_, no tardaron en romper el cerro a pesar de que era grande, solamente no podían alcanzar bien el maíz (localizar), estaba lejos (más allá).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>cuando (lograron) alcanzarlo hasta donde estaba, empezaron a acarrearlo, después ya no podían llevar todo a sus casas, aunque entre todos tomaron parte en el acarreo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>cuando acabaron en el lugar donde estaba allá, se alegraron mucho. bailaron, le hicieron mucho honor a ese hombre quien enseñó por donde estaba el maíz.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>le dieron mucho dinero, también le buscaron gratuitamente quien lo acompañó a llevar su dinero.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>llegó a otro pueblo, también así hizo como había hecho donde había pasado apenas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>empezó a pedir agua,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>en muchas casas fué, nadie le dió.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>no hay agua -- le decían.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>solamente terminó de desengañarse que efectivamente no había,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>estuvo sentado un gran rato en el portal del juzgado. después empezó a preguntar por qué no había agua. y le dijeron,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>no sabemos qué cosa lo que nos está pasando.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>ya le hablamos al cura que haya nuestra agua</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>contestó aquel hombre,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>yo sé adonde está el agua,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>solamente quiero que les avisemos a las autoridades</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>también quiero que me den mucho dinero, no es gratis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>cuando les dijeron a las autoridades, dijo (el hombre) que él sabe por donde está el agua,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>(que) él enseñaría si querían,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts330">
                <ANNOTATION_VALUE>lo aceptaron,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>está bueno -- dijeron</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>luego le avisaron al pueblo que vino un hombre, quien sabe en donde está nuestra agua.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>al siguiente día se juntaron muchos hombres, trajeron sus con que escarbar (zapapicos (o) barretas). entre todos se pusieron a escarbar mucho,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>nadie sabía si estaba muy cerca el agua,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>estaba enterrada en medio de la plaza, allí la encontraron.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>cuando la vieron, creyeron que sí efectivamente estaba el agua,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts356" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>todos en conjunto empezaron a alegrarse,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>no sabían si estaba muy cerca el agua enterrada, cuando (el tiempo) estaban padeciendo sed.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>sin pérdida de tiempo juntaron el dinero lo que le dieron a ese hombre,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>también se lo buscaron gratuitamente quien lo acompañó a llevar su dinero a su casa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>cuando llegó a su casa, empezó luego a arreglar su guardadinero, ya no sabía qué hacerle por haber tanto</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>a cada uno de sus amigos, les dió una jícara (llena) de dinero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>delante de ellos todos sus amigos le ordenó a su esposa, le dijo así.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts384" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>vé a darle una jícara (llena) de dinero a quien no quería verme, él tiene la culpa que me haya huído, le dices que ya vine.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts390">
                <ANNOTATION_VALUE>cuando andaba por aquí, él era mi contrario. estaba muy seguro que me iba a matar,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>cuando lo supe, luego me separé (huí).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>no se te vaya a olvidar, le dices que ya regresé.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>(que) traje mucho dinero.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>llevó la mujer una jícara (llena) de dinero, así le dijo como le dijo su esposo -- está bien gracias, dijo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>recibió el dinero queriéndose reír,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE>luego en la tarde fue a preguntarle adónde tomó, (y) adónde halló mucho dinero lo que trajo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>todo le dijo, lo que hizo en dónde andaba, (y) en dónde fue a recorrer, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>solamente acabó de escuchar él que había sido su contrario -- también me voy -- dijo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>vete -- le dijo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>luego se fue, el día siguiente. se metió lejos en un monte, (hasta llegar al) alcanzó el árbol grande en donde había ido a subir el otro hombre. allí estuvo esperando</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>solamente escuchó que hacían ruído debajo de los árboles ya cerca, luego se subió en el árbol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>los que venían (sonando) haciendo ruído, llegaron derecho al tronco del árbol en que estaba subido.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>empezaron a platicar.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>se preguntaron uno por uno.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>el que venía por delante, empezó a hablar.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>¿cómo te ha ido? -- le dijo a uno. y contestó él</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>mal, quién sabe quién nos escuchó,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>se supo lo que platicamos aquella vez que era un animal lo que la estaba chupando a la hija del rey, mataron al pobre animal. lo encontraron en donde estaba.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>ahora, ya se está aliviando la muchacha,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>y a ti -- le dijo al otro.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>también así me sucedió.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>se supo en donde había yo puesto el maíz, rompieron el cerro.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts482">
                <ANNOTATION_VALUE>se metieron a fuerza aunque había ido a dejar lejos, a esconderlo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>quién sabe cómo supo un hombre él que fue a enseñar,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>luego contestó el tercero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>quién sabe lo que nos pasó, también supieron lo que había yo hecho.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts498">
                <ANNOTATION_VALUE>desenterraron el agua,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts502">
                <ANNOTATION_VALUE>también fue un hombre él que fue a enseñar,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts506">
                <ANNOTATION_VALUE>(ahora estoy muy disgustado) harto ahora me estoy enojando, no me imaginaba yo si iban a saber,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts510">
                <ANNOTATION_VALUE>ahora aquí descansemos un rato, ya no vayamos lejos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>luego dijo uno de ellos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>¿no huelen ustedes a carne humana?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>ha de haber quién nos está escuchando, ha de estar (por aquí) cerca,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>busquemos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>dicen que todo estaba oyendo (aquel) hombre lo que estaban diciendo, también (oía) cuando por todos lados lo estaban buscando, debajo de los árboles.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>los vió bien (que) empezaron a subir al árbol en que él estaba trepado, empezó a tener mucho miedo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts536" TIME_SLOT_REF2="ts538">
                <ANNOTATION_VALUE>cuando lo hallaron por donde estaba trepado y escondido, lo bajaron a fuerza (a jalones)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts540" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>luego allí mismo en el tronco del árbol lo mataron, entre todos se lo comieron.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts544" TIME_SLOT_REF2="ts546">
                <ANNOTATION_VALUE>allí se quedó el hombre, ya no regresó.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts548" TIME_SLOT_REF2="ts550">
                <ANNOTATION_VALUE>no sabía si así le iba a suceder, tenía mucho gusto cuando salió de su casa, igualmente cuando llegó al tronco del árbol en que se trepó.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts552" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>todo el tiempo estaba pensando que iba a regresar con mucho dinero.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts556" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>todo lo que había planeado, no le resultó.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>allí se esfumó por donde encontraron. ya no regresó.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
