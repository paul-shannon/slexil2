    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss" PARENT_REF="Ex" TIER_ID="L3Gloss">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>'cuando jesus andaba aqui en la tierra' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a8" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>'y esos anzianitos es que estaban tristes' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a9" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>'ya eran anzianitos y es que escuchaban es que jesus es que'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>'puede hacerlos mas jovenes aunque ya estan bien ancianitos, y ahora es que se dicen [los viejitos]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>'ahora es que fueron a esperar por donde pasaba [jesus], los sabados iba/pasaba '</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>'en un pueblo, ijole, es que cuando venia [jesus], es que' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>'porque, porque me buscan, pues nosotros estamos tristes porque ya estamos viejitos y escuchamos que tu...'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a103" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>'puedes hacer jovenes a los viejitos... y pues...' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a156" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>'se pueden hacerse jovenes, es que le dice [Jesus]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a157" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>'y que vamos a hacer, [prejuntan los viejitos]' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>'pues les voy a decir una cosa' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a105" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>'primero busquen a otros para que sean 12 viejitos' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>'y cuando ya esten completos todos me avisan otra vez' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a107" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>'encontraron a todos y ahora es que fueron a esperar a Jesus por donde pasaba es que '</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>'ya venia [Jesus] otra vez, un sabado' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a109" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>'pues ya estamos completos los doce' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>'pues ahora que vamos a hacer, es que dicen' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a111" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>'todavia les falta por hacer una cosa.  Que cosa, es que dicen' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>'ahora van a cortar leña doce rollos, es que les dice' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a113" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>'cortaron doce rollos de leña, esos viejitos, y a completaron los doce rollos [de leña], y ahora es que dice:' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>'ahora ya completamos [los 12 rollos] ahora vamos ir a esperar a Jesus'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a115" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>'nos va a decir lo que vamos a hacer, es que fueron un sabado, es que'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>'ya venia otra vez [J.], ahora ya tenemos la leña pero les falta una cosa.  Que cosa?' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a117" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>'ahora buscan un horno de pan donde nunca lo han ocupado ni han prendido fuego' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>'lo que esta nuevo, es que lo buscaron y lo encontraron, ahora es que fueron a esperar a Jesus otra vez por donde pasaba' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>'s que le dicen, ya encontramos el horno,' 'pues ahora ya los voy a hacer jovenes' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>'fueron y les dicen a los viejitos, ya metanse en el horno' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a121" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>'ahora los voy a hacer jovenes' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>'le metieron leña all'horno le prendieron fuego' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a123" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>'empezo ijole los quemaron a los viejitos, los quemaron a los doce' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a124" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>'ahora se quemo toda la leña y se apago el fuego' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a125" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>'ahora dice Jesus, que se acercan los familiares de estos a los que queme' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a126" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>'ya los voy a hacer chiquitos, es que dice, ijole!'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a127" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>'y se acercaron.. como se llamaba tu pariente? [prejunto J.]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a128" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>'ijole es que agarro un puño de ceniza' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a129" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>'cuando los nombraba carmelo es que aparecia parado un niño chiquito'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a130" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>'agarraba otro puño de este como se llama, ceniza' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a131" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>'nombrava a pedro, ijole aparecia otro niño chiquito' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a132" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>'acompleto a los doce viejitos' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a133" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>'ahora ya hico chiquitos a los viejitos, pues ahora yo ya me voy otra vez a donde voy, es que dice [Jesus]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>'esta bien... ahora abia un hombre, es que lo vio' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a135" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>'y es que se fue a un pueblo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a136" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>'allí les dijo es que como, es que les dijo que como hizo jesus' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>'quienes que son viejitos, y estan tristes, yo los voy a hacer chiquitos, es que' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>'los voy a hacer niños chiquitos, los voy a hacer es que dice' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a159" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>'y ahora este ese hombre nada mas quieria hacer como hizo Jesus' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>'y pero el no tenia poder' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a161" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>'como se llama, en un pueblo, fue a engañar a unos viejitos, ijole es que' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>'asi les dijo, como les dijo jesus, que buscaron doce viejitos' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a163" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>'y encontraron y se juntaron todos y ahora les dice, que van a cortar leña, lo cortaron' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a164" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>'ahora les dice, que van a buscar un horno u lo encontraron, ahora' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a165" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>'ahora ya los voy a hacer chiquitos, ya metanse en el horno, les dicen a esos viejitos' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
