        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>P	tzáj a:ná xatapalájni' - [00.38]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>M	tzama: wachí: wachí: kuésatzá xatapalájni' kwan wachitzá [00.39]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>M	wachi misín máx tzama: [00.42]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>tzama: hánpalhtzá [00.45]</ANNOTATION_VALUE>
