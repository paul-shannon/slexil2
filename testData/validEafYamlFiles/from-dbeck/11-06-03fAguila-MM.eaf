        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>D	ixcuento ese picháwa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>P	chá xacuento picháwa ka:tzíya'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>P	chu:wá tatanú nak.. usea tán xtátahe:tolá naxhe:nchík chík tawán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>M	aah peru xlá'h.. tzama: a:na'h picháwa, tzama:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>ja: tzáj ja: xkátzi: chi: li:taxtúpálh [00.25]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>pálh tzáj... pálh tzáj ani:málhtunká chichú: [00.32]</ANNOTATION_VALUE>
