        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32"
                TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>pus tza'má tatantu:lhí:n kuwésa ma:x chu' na: ...  natalakaskí'n xla'ha:tawáj palh chu' tu: nali:pa:lhe'hé:ya' nalhí:ya'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33"
                TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>ja: tza'j xma:n lhi:kán a:ná: pus a:ná: nali:la'halhu:ma:nán dios ja: kati'sputní:'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34"
                TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>hanán ja: tu: mintumí:n pero dios namaxki:yá:n tu: nali:pa:lhe'hé:ya' porque ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92"
                TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>wachí' pa:xwapá:' naka:'kilhtamakúj xataka'tzí:n chu:ntzá: cha: li:ma:su'yu:ní:' dios</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35"
                TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>he: chu:wá tza'má pus la'hsputku'tún pero ja: kati'la'hsputhé:'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36"
                TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>aha'túnu' li:chi'ki:'tawí:lh pus wachí' ja:tzá' tasu'yuku'tún kristiánu' porque ja:tzá' taska'tku'tún lakstín pus spute:lhatzá'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37"
                TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>tama'hasputku'tún he: porque na: púxku' ja: lakaskí'n kaspútli' na: chu' dios ma:lakapa:sta'kni:má:lh chi' wa: cha:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38"
                TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>chu:wá lakstín ti: ska'te:lhá ska'te:lhá pus</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39"
                TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>tza'má xakilhtzukúni', chi' cha: kit i'kwán, chi' cha: tasu'yuní:', ja: kati'spútli'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40"
                TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>ja: cha: sputmá:lh chu' ki:to:lamá:lh ki:to:lamá:lh tza'má talhí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97"
                TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>tza'j xma:n ja:tzá' talhi:ku'tún lakamanán ti: wa: cha: chu:wá tasta'kma:'nálh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41"
                TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>wi:lh ti: la'hatí: wi:lh ti: ja: la'hatí: pus chu:wá li:lama:'náj naka:'kilhtamakúj</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="glossing" PARENT_REF="José Sosa Reyes" TIER_ID="translation">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>pues bueno este palabra ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>cuando se hizo el mundo todavía no habían danzas, todavía no había nada</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>y pues a lo mejor apareció el dios en que ahora se le cree (tu: hahai:nikan, tu: kanajlinikan—PS)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a47" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>pues ellos creyeron en él y a lo mejor todavía no existían las crecencias como esa del relámpago o algo (creencia = taka:nájla' —PS)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>les invitaban a comer le decían como dios los enviaba y pues a nadie invitaba a comer ese palo que pararon</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>pues ahora ese palo, se puso un (palo) largo se paró ese que le dicen palo de los voladores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>ellos a lo mejor aprendieron a bailar así como se ensaya a bailar y ellos aprendieron a bailar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>pues llegó la fiesta pues ahora pararon el palo de voladores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>ahora a lo mejor este en el tiempo del aguacero es cuando le toca aquí en este pueblo cuando está completo en septiembre,la fiesta de la Virgin María (PS has he: tze: septimebre)	</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>pues ahora ellos subieron y volaron, subieron por la primera vez</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>pues no alcanzaron a llegar hasta abajo con sus lasos (tatu:ta 'touch the ground')</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>empezó a hacer aire, empezó a hacer aire ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>apenas se les había desenredado (unwound) un poco el laso ahora cuando empezaron a volar, empezó a hacer aire</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>se les chispó la rueda (pole came out of socket) ese viento</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a61" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>ahora se llevaron</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a62" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>pues se hacían volar ahora las personas que estaba arriba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>pues se llevaron por 10 días</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>les estaban esperando que llegaran 6 días (que) se les dejaba que llegaran, que llegaran</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>dicen ahora otros ahora este ... esperemos vendrá, vienen, regresan otra vez, van a regresar, los va a devolver el viento, dicen (taspi'tpalá &gt; natatapita—PS)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>pues como ... así dios ha enseñado (el baile) por que los llevaron pues a lo mejor a estos que regresaron les dijeron como deben de hacer o qué</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>y ahora pues este ... arrancaron ese palo, lo quitaron, lo tumbaron, estaba tirado ese palo de voladores cuando ellos regresaron de nuevo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>cuando se cumplieron los 12 días aparecieron ellos otra vez (I think PS is hearing mat i as mat ti:)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>ya no se subieron allí, no estaba parado el palo de voladores ya no bajaron</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>pues le volvieron a llevar a lo mejor este quedó en los manos de dios</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>ahora ese palo de volador, pues volvieron a hacer el siguiente año</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>mejor ya les hicieron sus tortillas así como están las abuelitas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>le dieron a comer al palo y a lo mejor ya con esto se hicieron la ofrenda en la iglesia, y ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>y si mataron el guajolote así como custumbran hacer allí donde hacen la fiesta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>hacen fiesta ahora</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>se le da de comer ahora por el propósito o sea al palo o a cualquier cosa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>anunciaron de qué casa va a salir el capitán de la danza</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>pues, así por eso practican aquí en este mundo, y ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>apareció ese danza porque por eso (el viento) había llevado a los primeros que les pusieron a trabajar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>cuando habían bailado ellos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>pues los llevaron y a lo mejor por eso se los acuerdan los que bailan hoy</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>pues este en el mundo ese apareció los bailadores los voladores los quetzales ellos, pues ellos se daba vuelta en un palo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>ellos ofrecen su comida mataban pollos, guajolotes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>cuando ellos terminan daban de comer ellos por sus danzas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>pues esos danzas también es necesario ofrecer mucho alimento porque estás pasando del baile</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>no nomás danzan también dios te va a compadecer por que no haya acabado (el costumbre)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>hay o no hay dinero pero dios te va a dar lo que vas a ocupar por participar porque ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>parece que estás disfrutando en tu vida el pensamiento y tal vez por eso dios ha enseñado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>ahora ese como se quiere terminar pero a fuerza no se va acabar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>en cada pueblo parece ya no se quieren aparecen las personas porque ya no quieren apender los niños pus se viene acabando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>lo quieren acabar porque también el gobierno no quiere que se acabe también dios le da idea así como</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>ahora los niños los que van aprendiendo van aprendiendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>ese es el inicio, así como digo, así que apareció yo no se va a acabar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>no está acabando sigue existiendo/apareciendo esa danza</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>nada más ya no quieren bailar los niños que ahora están creciendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>hay los que disfrutan y hay los que no disfrutan pues ahora así come estamos viviendo en este mundo/esta vida</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
