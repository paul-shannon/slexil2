        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>tzamá: skauj mat, mat tzamá: [ix]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>tzamá: skauj [tzaj] ixla'hlha:'wán wamá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>a'hs’awílh tzamá: misín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>ixwakutún he: lha: walh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>a'hs’awílh [akxní antzá ...] akxní wamá: tza:'lanita:'kí:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>pus a:li:stá:n wamá: … tzamá: skauj a'lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>a:li:stá:n akxní la'hchá:lh tzamá: misín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>chu:wá nakwayá:n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>porque [lha:] ma:ntzá kit s’awipá:', nakwaya:ntzá,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>chu:wá nakwaya:ntzá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
