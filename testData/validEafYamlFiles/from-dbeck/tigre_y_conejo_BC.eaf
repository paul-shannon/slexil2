        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1008" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>‘aunque pruebalo, está muy sabroso’</ANNOTATION_VALUE>
