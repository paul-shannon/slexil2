        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1003" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>‘porque sólo me estás engañando, te voy a comer’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
