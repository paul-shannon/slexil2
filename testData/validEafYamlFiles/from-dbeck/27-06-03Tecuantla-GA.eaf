    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Text" PARENT_REF="Ex" TIER_ID="Line">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a10" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>aja, bueno nakwaniyán wamá: cuento, David</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a11" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>akxní xwi:laka nakChíla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>ja:x tala:'hapása tu: ixla: Dios cristiano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a13" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>tamílh ti: tali:chiwinán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a14" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>kawaníka kristianu xlakán natata'hpáxa he: natatama'haxtóha paxlakán, ja:...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a15" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>ja: kamininílh ma'hapítzi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a16" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>tala:ma:katzinihólh pó'htu ka:lakchíkni' chi: xwiláka</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a17" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>chuwá: mima:lhtzá chi: naka:náj lakán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a18" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>chi: wixinán wana:tít</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>na'hpaxáuj hentama'haxtoháuj ho: &lt;tu:&gt; tu:n lhawayáuj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a31" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>lhú:wa ti: tawanlitzá xatzáj kaníuj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>tawánli' [pero] júncha kilu:wakán tala:waní:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>kilu:wakán nama'hniyáuj, nawayáuj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>wánka, talhawánli' kristianu tala:ma:katzi:ní</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>chuwá: ma'hní:ka lú:wa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>chuwá: chatín chixkú' ixlá: tama'haxto'hkutún</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>a'lh naka:takuxtu ja: ti: wáya' lú:wa' palh nali:tanikána' wanikán pu:skát</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a103" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>he: xla: [la'htzílh] la'htzílh he: [le'htzá xli:...] le'htzá xli:káni' ho'spulá xakáltu</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>pus ja: wálh tzamá: puská:t</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a105" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>pus ali:stá:n tzamá: puská:t</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>[ma:lh] tzamá: ma:lh kilhtamakúj mat wa:tzá matutún hora</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a107" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>júncha chuwá: kit chi: naklá:, chuwá: a'nhokatzá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>ixtapitzinitzá tiyá'h he: mat tzukma:lhtzá tala'hatzumáj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a109" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>chuwá: puská:t a'nta:kílh tzajtzá ka:tatújnu a'lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>ja:tzá, ja:tzá paláj makachá:lh porque hotanu:lhtzú</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a111" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>ali:stá:n tzajtzá a: a'ktín taknú:lh ixmákni'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>bueno</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a113" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>chu:wá ixa'ní:' chixkú' ka:takúxtu</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>tzukúlh ta'hcho'hó ka:lakchíkni' la'htzín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a115" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>ja: ti: kristianu pó'htu a'nhóka</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>wanikán wamá: [tek] talaná:n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a117" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>chi: ta:li:la:spútli' [tas..] tasa:kaj taknú:lh kristianu</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>chuwá: tzamá: chixkú' chí:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>la'htzí:lh lhapaya:wanikaní:' ixcháuj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>pus xla: ja: katzí ti: chu: xlawanimá:lh ixli:wáj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a121" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>xá'n ka:takúxtu' ixchí:n ya:pa:lhtzá ixcháuj ixli:wáj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>wayamá:lh pero mi:lh a'htín kilhtamakúj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a123" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>chuwá: tu: naklhawá: nakma'htahá'lha </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a124" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>ti: chu: ya: kristiánu a'hataxtunikús</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a125" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>ti: kinta:wayamá:lh mat wan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a126" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>he:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a127" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>ma'hta'hálhi: ja: paláj maklá:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a128" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>chuwá: la'htzí:lh ixchichí</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a129" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>ixhalhí: ixla'hatín chichí xatzí:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a130" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>la'htzílh minchá: ma:x chi: ma'htutún &lt;u&gt;hora&lt;/u&gt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a131" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>ali:stán tohohe:chá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a132" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>chuwá: chi:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a133" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>chi:lh tzamá: chixkú'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>he: tzamá: mat chichí</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a135" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>xtapu:xtuní:' ixhe:hó:x’a he: xcha:hé:n ma:hé:lhcha ixwi:li:ní:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a136" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>chuwá: tzamá: chixkú' wa'háj tayá:lh lhkaká:n ta'puta'pu helhma:waká</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>chuwá: tawaká'lh naka'hapi:xán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>chuwá: akxní: mi:lh tzamá: ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>mat chi: ixla:ní he: chichí ixla:ní: li:puská:t</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>[ix...] ixa'ní che'he xhawáj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a141" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>he: tzukúlh lhawá [ix...] ixpatamá:lh ixpín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>he: ja: xla'hapása matzát</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a143" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>tzamá: chichí, he: xatzi: chichí porque tzaj ixla:ní:' li:puská:t</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a144" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>chuwá: tzukúlh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a145" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>tzamá: xenhxenh kinkawán mat la'hmojó ixi:lít, tzamá:...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>ixpí'n tu: lhawamá:lh ixtaxpá'ta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
