    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Text" PARENT_REF="Ex" TIER_ID="Line">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a25" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>ikwani:paliyan wama kuento ixla: Juan tonto wanikán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a26" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>bueno ixchatukán lakstin ixchatukán kamana' cha:tín le:he xli:xumpi' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>lhkawa' wani: ixta:tin</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a28" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>naanaw la'hatunkuwiya naix'ha'han kí'wi' wani:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a29" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>chu:wá taalh tatawaka:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>chu:wá wan xapuxku</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a31" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>chu:wá nun tilimilh kinpaxni'kán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>palh lakaskína' kana tiya wan xastánku' u:tzá tixaxumpi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a33" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>milh ki:tiyachi ma'helhcha' le:lh xla'haxo'ho páxni'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>chu:wá wani: iktantikutun wan tzamá: ti: xastánku' ti: xalhkawa' [00.40]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a35" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>he: pero talawi:lhanalh a'has'hawininin ma'ha'hju</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>he: tan... tantilh [00.53]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a37" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>tawan s'hawininin yujma:lh xanat, yujma:lh xanát wama kí'wi' tawan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>tantimalh tzamá: hawácha' xaklhkawa' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a39" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>chu:wá wani: puxku naik'holunun wani: x'holunulh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>chu:wá tawan s'ha'honinin yujma:lh sikulanaxka:n, sikulanaxka:n yujma:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a41" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>chu:wá wani: ixpuxku ka: nakmakan ma:hélhcha'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>ja: kamakapi, nakmakan uh mat makamincha' ta:lhman le'ha makasanantilha </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a43" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>chu:wá tawan s'ha'howinin yujma:lh a'hapun, yujma:lh a'hapun tawan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>ju: tatzaletajilh s'la'ha tumin xwi:lh nakmesa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>ni ni'ix'ha'ahlh tayujlhi tzamá: kaman hi: chixwi:lh tumin tale:ntaki:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>tale:nilh pa:lej </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a47" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>ja: katzi ixla ja: katzilh ja: tataya:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>chu:wá wani:n tajatatla kintzi:kán wan xapuxku pus kamata'halhti wanikán kit kana ikskuja' wan xapuxku xastánku' tawi:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Analysis" PARENT_REF="Line" TIER_ID="Prsd"/>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Analysis" PARENT_REF="Prsd" TIER_ID="Morph"/>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="MGloss" PARENT_REF="Morph" TIER_ID="ILEG"/>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss" PARENT_REF="Ex" TIER_ID="L2Gloss"/>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss" PARENT_REF="Ex" TIER_ID="L3Gloss">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>'te voy a decir otras vez este cuento Juan tonto se llama'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>'bueno los dos niños, los dos muchachos, uno era bien grosero'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>'grosero le dijo a su hermano'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>'vamos a quedarnos en la rama del arbol del arbol le dijo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>'ahora se fueron y se subieron'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>'ahora dice el mayor'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>'ahora no trajimos nuestro puerco'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>'si quieres voy a traer dice el menor, ese es el grosero'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>'vino a traer la puerta, se la llevo, el repuesto del puerco'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>'ahora le dijo quiero hacer del baño dice quine es el menor, quien es el grosero'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>'si, pero alli estan los diablos alli abajo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>'y su hizo del baño'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a61" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>'dicen los diablos se estan cayendo las flores, se estan cayendo las flores en este arbol dicen'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a62" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>'esta haciendo del baño el muchacho grosero'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a63" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>'ahora le dijo el mayor me voy a orinar le dijo y se orino'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>'ahora dicen los diablos esta cayendo agua bendita, agua bendita esta cayendo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>'ahora dijo el mayor voy a hechar la puerta'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>'no la heches, la voy a hechar y la hecho de arriba y cayo con mucho ruido'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>'ahora dicen los diablos esta cayendo el cielo, esta cayendo el cielo dicen'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>'pero como huyeron habia mucho dinero en la mesa'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>'cuando amanecio bajaron esos muchachos pero como habia mucho dinero y se </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>'se lo llevaron al cura</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>'el no sabe, no supo de donde sacaron el dinero'</ANNOTATION_VALUE>
