    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss"
        PARENT_REF="Ex" TIER_ID="L3Gloss">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1992" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>‘y entonces, dizque este’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1993" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>‘le daba de comer, la pone encima de una montaña’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1994" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>‘siempre le llevaba lo que comía’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1995" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>‘ahora la hace embarazada’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1996" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>‘y dijo ese muchacho’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1997" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>‘todavía estaba chico, sí que todavía estaba chico, como dos años tiene’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1998" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>‘ahora ya te voy a llevar’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1999" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>‘ya no viene mi papá mucho’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2000" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>‘y ¿qué comemos?'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2001" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>‘no hay que comer, dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2002" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>‘bajó a su mamá y fue con ella a su casa’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2003" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>‘ahora dice su abuelo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2004" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>‘todavía vive el papá de la mujer’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2005" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>‘bueno, dale a comer, vas a criar a ese hijo de animal, le dijeron’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2006" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>‘como era, la mitad liso y la otra peludo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2007" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>‘pus entonces lo crió’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2008" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>‘se hizo alto’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2009" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>‘empezaron a mandarlo a la escuela’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2010" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>‘tiene que estudiar, dice’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2011" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>‘no aprende nada’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2012" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>‘no juega ese muchacho’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2013" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>‘entonces dice, ¿Qué vamos a hacer?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2014" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>‘ese hijo de animal no quiere aprender nada’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2015" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>‘mejor este, ... regálaselo al cura’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2016" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>‘hazlo su padrino, dice su abuelo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2017" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>‘pues, lo mandaron a la custodia del padre’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2018" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>‘y pasa igual con el cura’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2019" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>‘no pudó hacerlo entender nada porque es hijo de animal’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2020" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>‘pues igual peleaba con los otros niños’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2021" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>‘y luego los mata’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2022" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>‘¿cómo vamos a hacer? y ahora los mata’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2023" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>‘no se puede hacerlo entender nada, dijo el cura’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2024" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>‘¿ya ves? yo hasta lo mandé a la escuela’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2025" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>‘voy a mandarlo a cuidar (ganado)’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2026" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>‘vienen los animales’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2027" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>‘enfrenta hasta con animales’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2028" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>‘pues, ¿cómo harémos?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2029" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>‘no se puede hacer nada’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2030" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>‘entonces le dice ahora’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2031" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>‘ahora vas a ir a ver la campana’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2032" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>‘se quiere robar’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2033" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>‘irás a ver’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2034" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>‘bien, dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2035" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>‘se mandó otra vez, lo ponen a ver la campana’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2036" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>‘y a propósito se lo fue a poner su padrino’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2037" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>‘va a espantarlo ese diablo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2038" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>‘así le ha puesto a agarrar la campana parado’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2039" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>‘¿qué haces?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2040" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>‘¿a cáso estás bajando otra vez la campana?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2041" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>‘dicen que quieres robar la campana, dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2042" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>‘lo quiero llever, pero te lo están poniendo a cuidar, dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2043" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>‘¡pues llévate tu campana!’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2044" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>‘se agarraron, se pelearon’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2045" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>‘tumbó ese que quería agarrar la campana’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2046" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>‘llega a donde su padrino’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2047" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>‘tumbé a ese que quiso agarrar la campana’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2048" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>‘lo maté, dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2049" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>‘¿tú no te da miedo nada?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2050" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>‘no hay, no hay nada que me da miedo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2051" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>‘bueno, ahora mañana vas a ir a leñar’
	</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2052" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>‘allí vas a traer leña’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2053" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>‘y al otro día lo mandaron otra vez a traer leña’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2054" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>‘well, the burro went, he made it carry firewood’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2055" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>‘now then the jaguars came’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2056" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>‘dos le comieron su burro’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2057" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>‘entonces dice ese’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2058" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>‘¿bien, ahora qué?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2059" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>‘Uds. van a llevar esa leña’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2060" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>‘ya comieron mi burro’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2061" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>‘ahora Uds. lo llevarán’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2062" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>‘porque nomás vinieron a comer me burro, les dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2063" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>‘amarró por el cuello esos tigres’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2064" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>‘ése los hacía traer la leña’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2065" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>‘entonces llegó a donde su padrino, el cura’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2066" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>‘esos que estás trayendo comen a la gente, dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2067" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>‘no comen, dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2068" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>‘¿y tu burro?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2069" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>‘pues, lo comieron, por eso les hice venir trayendo leña, le dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2070" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>‘¿tú no te da miedo nada?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2071" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>‘no hay lo que (me da miedo)’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2072" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>‘¿a poco me van a comer mis compañeros?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2073" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>‘ahora llevalos otra vez’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2074" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>‘esos me dan miedo, me van a comer, dijo ese cura’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2075" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>‘su padrino le hizo llevarlos otra vez al monte’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2076" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>‘fue a dejar los tigres’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2077" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>‘bien, ¿con nada entiendes?’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2078" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>‘nada, a mí nada me hace entender, dijo’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
