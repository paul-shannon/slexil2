    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Text" PARENT_REF="Ex" TIER_ID="Line">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>le:lh tzamá: mat puská:t tzamá: tzamá: mú:xni'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>he: a:li:stá:n mat wamá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>ma:wí: wili:má:lh xa'kpú:n talhpán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>pus mat, tiwána le:nihé:' tu: ma:wí:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>mat chu:wá mat, ma:kamali:lhtzá chu:wá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>he: mat wan chu:wá tzamá: hawácha'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>s’a'ta'kús, jú:ncha' s’a'ta'kús, mat chi: &lt;u&gt;dos&lt;/u&gt; &lt;u&gt;años&lt;/u&gt; &lt;u&gt;tiene&lt;/u&gt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>pus a:li:stá:n mat wan, chu:wá nakuka:le:nantzá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>wamá:, ja:tzá min kintá:ta' tiwána</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>he: tu: wayá:uj?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>ja: tu: tu: wayá:uj, wankán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>kuka:li:mílh ixtzí:', mat ma:yujú:lh naxa'kpú:n talhpán xwilí: [chilit]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a103" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>ma:yujú:lh ixtzí:' he: ta:'mílh naxchík </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>mat wan chu:wá tzamá: ixpá'p</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a105" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>wi:lhkús ixta:tá' tzamá: puská:t</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>bueno, kamá:wi:', nama'hastá'ka tzamá: is’á'ta' animá:lh, mat wanikán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a107" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>chi: mat a'ktín lipénhe' he: a'ktín makchi'xí'xi'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>pus mat a:li:stá:n, ma'hastá'kli'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a109" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>a'kchunajtzá wánli'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>mat tzukulhtzá maká:'n nakskwéla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a111" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>ma:helhtawaha:hé:', mat wan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>ja: mat tu: ská'ta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a113" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>ja: mat hama:nán tzamá: hawácha'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>a:li:stá:n mat wan, chi: nalhawayá:uj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a115" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>tzamá: is’á'ta' animá:lh ja: tu: ska'tkutún</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>xatzéj wamá: … kama:le:ní: pa:léj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a117" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>u:tzá isku'na:tá:ta' kalhawálh, mat wan tzamá: ixpá'p</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>pus mat ma:le:ní:ka' pa:léj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>he: chu: chu:ntzá tzamá: pa:léj</ANNOTATION_VALUE>
