        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>naikwaniyan ixkuento tzamá:... [00.00]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a39" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>ayan chuni' he: sasán [00.04]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>tzamá: sasán mat is'hawimá:lh ayan chuni' [00.07]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a41" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>la'has'hawimalh ixlakasmú' [00.10]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>mat he: chi: naiktlawa wan [00.12]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a43" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>naikmala'hax'ho'oni chi:ama chi: kilhlhawamá:lh mat wan ayan chuni' [00.14]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>pero naik'has'haswi naanan a'htín katani naikwani: a'ntzá nakixita:t a'hapun [00.19]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>he: mat wani: [00.25]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
