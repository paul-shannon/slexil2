            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a150" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>'aqui vamos a ver si deveras eres hombre es que le dicen'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a151" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>'hijole como grita, como tiene miedo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a152" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>'ya nunca te voy a hacer asi'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a153" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>'pero ya no me entierres porque ya no aguanto es que...'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>'hasta lo hicieron cagar de miedo a ese, ese zorrillo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a155" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>'llegaron a la tierra con toda la fuerza del aire' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a156" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>'[dice el zorrillo] ya nunca mas te voy a hacer algo es que le dicen al zopilote, pues esta bien [responde el zopilote]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a157" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>'si otra vez lo vuelves a hacer de todas maneras las vas a tener que pagar'</ANNOTATION_VALUE>
