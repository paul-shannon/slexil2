    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Text" PARENT_REF="Ex" TIER_ID="Line">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>pus kristiano chi: ka:li:a'hspulá:lh [nak...]naka:li:mi:sí:n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>mat xka:ma'hpaxikutún palé:j</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a47" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>xka:ma:ma'haxtó'hli' ja: mat xtatama'haxto'hní</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>mat ka:la'hmakálh ka'psná'p</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>naka:li:misín, ka:la'hmakánka kristianu</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>chuwá: wan tzamá: ka'psná'p</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>ja: tala'hapása chi: wan chi: tzo'hnuní:' pa:lej</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>nakmejikánu tzo'hní</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>he: tala'hapásli'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>pus chuwá: tzamá: alhka:lhté ja: la'hapása mat ka:waní:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>pus wan ixkapsnáp</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>tzamá: mat naa'lhiyáuj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>[naminau....] namín palé:j</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>nakinka:ma:pa'hxiyán he: nakinka:ma:ma'haxto'hán mat wan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>pero xma:n wan ixka'psnáp</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>mat helhatojón nawá kristianu tzisáj ixkwayúj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a61" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>he: helhatojón ho:tanú:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a62" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>[utzá] chuntzá wan ixka'psnáp</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a63" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>chi: wanatít wixinán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>ka:mininiyán mat ka:wanikán kristianu</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>júta [pus chi: tzamá:] ja: tzej chuntzá chi: tzamá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>porque chi: tzamá: nakinka:wahoyán mat tawán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>xatzej tu: nalhawayáuj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>ja: ti: katihalhí:lh xatzéj natzala:yáuj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>natzala:niyáuj kalhawálh natanuyáuj naklhú'ku' mat tawán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>ma:n tu:n lhawayáuj tu: wi:lh kilu:wakán, nama'hniyáuj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>he: nawayá:n lhawayáuj ka:táni' mat tawán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>tama'hní:lh ixlu:wakán mat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>tawálh taka:taní:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>chu:wá cha:tín chixkú'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>ja: mat ka:lhawaní:' kwenta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
