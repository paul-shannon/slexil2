    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="ft" PARENT_REF="Totonac" PARTICIPANT="unknown" TIER_ID="Spanish">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2" ANNOTATION_REF="ann1">
                <ANNOTATION_VALUE>la creencia de los totonacos es que no hay muchos dioses.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann4" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>solamente (hay) uno quién está protegiendo en toda la extensión del mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann6" ANNOTATION_REF="ann5">
                <ANNOTATION_VALUE>no tienen la creencia si hay otros dioses quienes están vigilando todo lo que existe en el mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann7">
                <ANNOTATION_VALUE>ellos cuentan que todo lo que hay alrededor nuestro, tiene sus amos quienes lo tienen bien protegidos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>cuando comienzan las enfermedades de los animales del pueblo, gallina(s), guajolote(s), puerco(s), dicen lo siguiente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann12" ANNOTATION_REF="ann11">
                <ANNOTATION_VALUE>pobres de los animales (que) están muriendo, nadie tiene la culpa, nosotros mismos son los culpables.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann13">
                <ANNOTATION_VALUE>no le hablamos ni lo veneramos a sus amos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>ellos se han enojado si nuestros animales se están muriendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann18" ANNOTATION_REF="ann17">
                <ANNOTATION_VALUE>luego buscan uno (hombre) quién les conoce a los amos de los animales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann19">
                <ANNOTATION_VALUE>a él le hablan, que ya no sigan muriendo más animales, que se les retiren sus enfermedades.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>si está cerca un padre, a él lo van a ver.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann24" ANNOTATION_REF="ann23">
                <ANNOTATION_VALUE>mandan a hacer dos o tres misas con motivo de las enfermedades de los animales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann25">
                <ANNOTATION_VALUE>transcurren diez o quince días, los animales siguen muriéndose.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>no ha disminuído nada, al contrario ha aumentado todavía un poco más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann30" ANNOTATION_REF="ann29">
                <ANNOTATION_VALUE>así les llega a resultar después, de nada les sirve aunque mandan a hacer misa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann31">
                <ANNOTATION_VALUE>nada más pagan a precio alto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>se acaba su dinero y sus animales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann36" ANNOTATION_REF="ann35">
                <ANNOTATION_VALUE>solamente se comenta más los amos de los animales de los caseríos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann37">
                <ANNOTATION_VALUE>se sabe que todos los animales que viven sobre la tierra, tienen sus amos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>y los que se dan en los campos, maíz, frijol, chile, calabaza, chayote, chilacayote, yuca, camote, plátano, naranja, mamey, y otras cosas más lo que se comen como antojo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann42" ANNOTATION_REF="ann41">
                <ANNOTATION_VALUE>lo que son más indispensables para nuestra vida, consideran (que) solamente son tres cosas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann43">
                <ANNOTATION_VALUE>maíz, frijol, chile.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>y a las demás nada más las consideran secundarias.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann48" ANNOTATION_REF="ann47">
                <ANNOTATION_VALUE>dizque cuando no se dan (bien) estas tres cosas, a veces es porque llueve demasiado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann50" ANNOTATION_REF="ann49">
                <ANNOTATION_VALUE>se pudren, no pueden madurarse, se echan a perder nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann52" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>y a veces dura haciendo calor el tiempo que están por florecerse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann54" ANNOTATION_REF="ann53">
                <ANNOTATION_VALUE>cuando empiezan a florecer, luego se les cae la flor, no llegan a formarse (el fruto). )</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann56" ANNOTATION_REF="ann55">
                <ANNOTATION_VALUE>entonces hay un tiempo (que) no se da nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann58" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>todas las siembras se acaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann60" ANNOTATION_REF="ann59">
                <ANNOTATION_VALUE>de eso comentan así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann62" ANNOTATION_REF="ann61">
                <ANNOTATION_VALUE>se han enojado sus amos, nadie antes les venera (ruega de rodillas).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann64" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>cuando sembremos, deberíamos antes hacerle honor (pedirle perdón) a sus amos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann66" ANNOTATION_REF="ann65">
                <ANNOTATION_VALUE>y al que es el verdadero dios nuestro padre del cielo quién nos está vigilando todos los días.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann68" ANNOTATION_REF="ann67">
                <ANNOTATION_VALUE>si vamos a tener cuidado, nunca olvidaremos de venerar a quién nos hará caridad, (así) tendremos lo que hemos de comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann70" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>y también tendremos buena vida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann72" ANNOTATION_REF="ann71">
                <ANNOTATION_VALUE>tienen otra creencia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann74" ANNOTATION_REF="ann73">
                <ANNOTATION_VALUE>dizque si contínuamente va uno a cazar en el monte, se enojan los amos de los animales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann76" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>se desquitan con uno (se vengan con uno).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann78" ANNOTATION_REF="ann77">
                <ANNOTATION_VALUE>el que se dedica a ir a cazar, no tiene mucho tiempo de vida, se muere luego.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann80" ANNOTATION_REF="ann79">
                <ANNOTATION_VALUE>su alma se lo llevan allá en el cerro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann82" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>algunos no se mueren de enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann84" ANNOTATION_REF="ann83">
                <ANNOTATION_VALUE>se privan repentinamente, ya no vuelven (su sentido), se esfuman para siempre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann86" ANNOTATION_REF="ann85">
                <ANNOTATION_VALUE>y otros no se mueren en sus casas, sino que se quedan por allá en la caza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann88" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>no falta lo que les suceda, se desbarrancan, o que les pica alguna víbora.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann90" ANNOTATION_REF="ann89">
                <ANNOTATION_VALUE>allá mismo se quedan muertos, ya no regresan a sus casas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann92" ANNOTATION_REF="ann91">
                <ANNOTATION_VALUE>los van a traer ya muertos, los sepultan (entierran).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann94" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>dicen que así les sucede a los que se dedican a la caza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann96" ANNOTATION_REF="ann95">
                <ANNOTATION_VALUE>una ocasión me dijo un hombre que no es bueno cazar seguido, prohiben los amos de los animales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann98" ANNOTATION_REF="ann97">
                <ANNOTATION_VALUE>me contó en esta forma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann100" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>cuando cazaba seguido tejón(es), a veces todos los días.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann102" ANNOTATION_REF="ann101">
                <ANNOTATION_VALUE>a veces cada tercer día, a veces uno sólo, a veces dos o tres a un tiempo los cazaba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann104" ANNOTATION_REF="ann103">
                <ANNOTATION_VALUE>soñé una vez que me estaban correteando dos hombres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann106" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>todos iban armados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann108" ANNOTATION_REF="ann107">
                <ANNOTATION_VALUE>si me hubieran alcanzado, hacían blanco conmigo (me mataban).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann110" ANNOTATION_REF="ann109">
                <ANNOTATION_VALUE>no me alcanzaron, me huí corriendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann112" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>me los perdí, no me vieron por donde me interné.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann114" ANNOTATION_REF="ann113">
                <ANNOTATION_VALUE>dizque había cometido graves delitos, (que) por eso me estaban agarrando, así estaba pensando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann116" ANNOTATION_REF="ann115">
                <ANNOTATION_VALUE>estaba muy asustado al despertarme, me llené de alegría después que no era cierto, nada más era sueño</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann118" ANNOTATION_REF="ann117">
                <ANNOTATION_VALUE>ya entonces suspendí la caza (de cazar), ya ni una vez fuí a cazar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann120" ANNOTATION_REF="ann119">
                <ANNOTATION_VALUE>me dí cuenta de que prohiben tocar a los animales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann122" ANNOTATION_REF="ann121">
                <ANNOTATION_VALUE>y otro hombre me contó en esta forma</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann124" ANNOTATION_REF="ann123">
                <ANNOTATION_VALUE>dizque nada más de repente se encontró con un tejón en el camino, le disparó, (lo mató).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann126" ANNOTATION_REF="ann125">
                <ANNOTATION_VALUE>dizque lo soñó, (que) se enojó mucho el amo del tejón.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann128" ANNOTATION_REF="ann127">
                <ANNOTATION_VALUE>dizque le dijo así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann130" ANNOTATION_REF="ann129">
                <ANNOTATION_VALUE>si querías comer de verdad al hacer blanco con mi hijo, no hubieras tirado su suciedad, su estómago, sus tripas, con todo lo hubieras comido</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann132" ANNOTATION_REF="ann131">
                <ANNOTATION_VALUE>nada en absoluto hubieras tirado, hubieras comido todo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann134" ANNOTATION_REF="ann133">
                <ANNOTATION_VALUE>se vería que es verdad que tenías ganas (de comerlo), no lo hubieras desperdiciado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann136" ANNOTATION_REF="ann135">
                <ANNOTATION_VALUE>por eso ahora harto me estoy disgustando, no me agrada tu delito que has cometido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann138" ANNOTATION_REF="ann137">
                <ANNOTATION_VALUE>y no se quedará así, to voy a arrancar tu corazón.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann140" ANNOTATION_REF="ann139">
                <ANNOTATION_VALUE>no te he de perdonar, así como lo oyes (sélo).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann142" ANNOTATION_REF="ann141">
                <ANNOTATION_VALUE>dizqueestaba muy asustado cuando se despertó</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann144" ANNOTATION_REF="ann143">
                <ANNOTATION_VALUE>ahora me voy a morir, no hay remedio, estaba pensando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann146" ANNOTATION_REF="ann145">
                <ANNOTATION_VALUE>también seguido tenía mucho miedo (estaba temiendo).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann148" ANNOTATION_REF="ann147">
                <ANNOTATION_VALUE>se pasó el tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann150" ANNOTATION_REF="ann149">
                <ANNOTATION_VALUE>dizque nada le sucedió, no se enfermó, nada más estaba temiendo mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann152" ANNOTATION_REF="ann151">
                <ANNOTATION_VALUE>ya entonces se dió cuenta que tienen amos los animales quiénes los protegen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann154" ANNOTATION_REF="ann153">
                <ANNOTATION_VALUE>y el otro hombre me contó así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann156" ANNOTATION_REF="ann155">
                <ANNOTATION_VALUE>dizqueestaba trabajando en su rancho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann158" ANNOTATION_REF="ann157">
                <ANNOTATION_VALUE>no se daba cuenta si estaba cerca un gavilán en una rama de un árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann160" ANNOTATION_REF="ann159">
                <ANNOTATION_VALUE>ya se estaba pasando de medio día, devisó para donde estaba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann162" ANNOTATION_REF="ann161">
                <ANNOTATION_VALUE>después de un gran rato, fué a descolgar su arma por donde lo había colgado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann164" ANNOTATION_REF="ann163">
                <ANNOTATION_VALUE>poco a poco se le fué acercando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann166" ANNOTATION_REF="ann165">
                <ANNOTATION_VALUE>ya no faltaban muchos pasos para alcanzarlo cuando hizo blanco con él (le disparó)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann168" ANNOTATION_REF="ann167">
                <ANNOTATION_VALUE>luego cayó ya muerto el gavilán en el suelo, ya no se movió para nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann170" ANNOTATION_REF="ann169">
                <ANNOTATION_VALUE>se lo llevó contento para su casa, mandó a cocerlo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann172" ANNOTATION_REF="ann171">
                <ANNOTATION_VALUE>dizque no podía cocerse, estaba duro, así se lo comió aunque no estuvo bien cocido</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann174" ANNOTATION_REF="ann173">
                <ANNOTATION_VALUE>dizque toda la noche soñó aquel hombre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann176" ANNOTATION_REF="ann175">
                <ANNOTATION_VALUE>supo que lo estuvo regañando una mujer alta y gorda</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann178" ANNOTATION_REF="ann177">
                <ANNOTATION_VALUE>le dijo en esta forma</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann180" ANNOTATION_REF="ann179">
                <ANNOTATION_VALUE>no está bien lo que le hiciste a mi protegido, no te estaba mirando a ti, su mirada la tenía fijada lejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann182" ANNOTATION_REF="ann181">
                <ANNOTATION_VALUE>si es seguro que te fías de tu arma, te crees hombre, nos veremos mañana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann184" ANNOTATION_REF="ann183">
                <ANNOTATION_VALUE>no te vayas a lamentar, vas a sentir si está bien o no</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann186" ANNOTATION_REF="ann185">
                <ANNOTATION_VALUE>aquel hombre no hi¢o aprecio a lo que soñó</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann188" ANNOTATION_REF="ann187">
                <ANNOTATION_VALUE>se fué contento a su rancho</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann190" ANNOTATION_REF="ann189">
                <ANNOTATION_VALUE>se llevó su arma</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann192" ANNOTATION_REF="ann191">
                <ANNOTATION_VALUE>dizque apenas había llegado al lugar de su trabajo, volvió a venir otro gavilán.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann194" ANNOTATION_REF="ann193">
                <ANNOTATION_VALUE>allá se detuvo por donde estaba el día anterior él con que hizo blanco (al que mató).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann196" ANNOTATION_REF="ann195">
                <ANNOTATION_VALUE>él no pensaba matarlo, estaba apurado trabajando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann198" ANNOTATION_REF="ann197">
                <ANNOTATION_VALUE>no estaba vigilando al gavilán si allí mismo estaba por donde lo había visto detenerse (acomodarse, sentarse, posarse).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann200" ANNOTATION_REF="ann199">
                <ANNOTATION_VALUE>y el gavilán allí mismo permanecía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann202" ANNOTATION_REF="ann201">
                <ANNOTATION_VALUE>no se cambiaba de lugar, de repente empezó a chillar a cada momento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann204" ANNOTATION_REF="ann203">
                <ANNOTATION_VALUE>!i...u i...u i...u!.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann206" ANNOTATION_REF="ann205">
                <ANNOTATION_VALUE>así estuvo diciendo en el ramal de un árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann208" ANNOTATION_REF="ann207">
                <ANNOTATION_VALUE>hacía mucho rato que estaba chillando , volvió a ir a traer su arma el hombre ..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann210" ANNOTATION_REF="ann209">
                <ANNOTATION_VALUE>poco a poco se le fué (se le acercó) por donde estaba chillando, le apuntó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann212" ANNOTATION_REF="ann211">
                <ANNOTATION_VALUE>cuando le disparó (hizo blanco con él) luego se desbarrancó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann214" ANNOTATION_REF="ann213">
                <ANNOTATION_VALUE>y aquel hombre, iba corriendo a recogerlo por donde lo había visto caer</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann216" ANNOTATION_REF="ann215">
                <ANNOTATION_VALUE>no se imaginaba si iba a cambiarse (de cuerpo) el gavilán al desbarrancarse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann218" ANNOTATION_REF="ann217">
                <ANNOTATION_VALUE>fué a hallar una víbora nagu"iyaqui.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann220" ANNOTATION_REF="ann219">
                <ANNOTATION_VALUE>luego le brincó a la cara y le picó la nariz.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann222" ANNOTATION_REF="ann221">
                <ANNOTATION_VALUE>se atarantó el hombre, luego se cayó, se privó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann224" ANNOTATION_REF="ann223">
                <ANNOTATION_VALUE>se fueron corriendo a levantarlo los que andaban cerca de él.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann226" ANNOTATION_REF="ann225">
                <ANNOTATION_VALUE>ellos creían que se había matado él mismo .</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann228" ANNOTATION_REF="ann227">
                <ANNOTATION_VALUE>no se imaginaban si lo picó una víbora, (y) lo privó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann230" ANNOTATION_REF="ann229">
                <ANNOTATION_VALUE>dizque cuando fueron a alcanzarlo sus vecinos, luego lo hicieron tomar el agua de tabaco y con eso volvió en sí</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann232" ANNOTATION_REF="ann231">
                <ANNOTATION_VALUE>se lo llevaron a su casa, lo hicieron tomar un jarro con manteca</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann234" ANNOTATION_REF="ann233">
                <ANNOTATION_VALUE>con eso se le calmó el dolor del piquete de la víbora nagu"iyaqui.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann236" ANNOTATION_REF="ann235">
                <ANNOTATION_VALUE>no duró mucho tiempo para aliviarse, solamente en un mes padeció de dolor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann238" ANNOTATION_REF="ann237">
                <ANNOTATION_VALUE>dizque desde entonces se enteró bien que todos los animales tienen sus amos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann240" ANNOTATION_REF="ann239">
                <ANNOTATION_VALUE>así me contó en una ocasión aquel hombre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann242" ANNOTATION_REF="ann241">
                <ANNOTATION_VALUE>me mostró su cicatriz por donde lo había picado la víbora nagu"iyaqui</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
