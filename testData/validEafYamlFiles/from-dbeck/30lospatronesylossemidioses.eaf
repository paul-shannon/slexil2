        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann0" TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts2">
                <ANNOTATION_VALUE>30 los patrones y los semidioses.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
