        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann1" TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>30.1 waá štaka¢iːnhkán tutunaːkuhníʔ , niːčaːɫuːwaá ʔanán tiyúːs .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann3" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>30.2 šmáːn čaːtám tiː maqtaqaɫnamaá kšliːkaːλankaá kaːtašaːwát .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann5" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>30.3 niːqaɫiːqúː štapuwaanhkán papiːʔananqúː ʔaːmaqapí¢ii tiyuːsníːn tiː kʷiːntahλawaquːníːt páks tuː ʔanán kkaːtašaːwát .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann7" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>30.4 waníːn wanqúː piːpáks tuː ʔanán kkimaqčuquhkán , qaɫiːqúː šmaːlaanakán tiː kʷiːntahλawaquːníːt .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann9" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>30.5 ʔakšnií ¢ukuú štaxatatkán taqaɫíːn šalakkaːčikiín , štiːláːn , čiwiláʔ , pašníʔ , nuːmaá wanqúː .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="ann11" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>30.6 "paːškatníːn niːmaːqúː taqaɫíːn , tiːníː škʷiːntá , maːnhkinkʷiːntahkán .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
