    <TIER LINGUISTIC_TYPE_REF="translation" PARENT_REF="lushootseedSpeech" TIER_ID="englishGloss">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a13" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>In the distant past, there was no daylight.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a14" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>The land, it was dark in the distant past.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a15" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>The people talked it over.  How can we manage to obtain it?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a16" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>Daylight is up there in the upriver country but how can we manage to get it?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
