            <REF_ANNOTATION ANNOTATION_ID="a133" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>te:lakalhka:lh nakpusikwalan nakixtankilhtin lunklh lunklh ta:yawa alh [05.08] </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>ja: tuwi:lh wani: pa:lej tu la'hatzi mat [05.13]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a135" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>manklhatzilh wani: cha:tin palh animalh ja: ixkatzi [05.16]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a136" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>te:lakalhka:lh naktankilhtin pu:sikwalan lunklhu lunklhu te:'he'la'holh chi'ha [05.19]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>ixman u:tzá la'hatzi, xman u:tzá ikla'hatzi [05.25]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>mm chu:wá ja: makan mat wan pa:lej [05.27]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>chu:wá akxní namin chichini' naikma:ta'ho'heni inu antza ja:tzá katimilh [05.31]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>akxní milh chichini' la'hamakanka inu le:chatzá chichini' antza watzá sputa' wama [05.36]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Analysis" PARENT_REF="Ex" TIER_ID="Morph"/>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Analysis" PARENT_REF="Ex" TIER_ID="ILEG"/>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss" PARENT_REF="Ex" TIER_ID="L2Gloss"/>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss" PARENT_REF="Ex" TIER_ID="L3Gloss">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a141" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>'el mono y la mujer, la mujer fue a leñar y le salio el mono y lo agarro, lo jaloneo y lo llevo a una peña'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>'le sigo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a143" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>'despues lo subio y lo metio en la cueva y le tapo la entrada [a la cueva]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a144" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>'y se fue a pasear y ahora cuando regreso'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a145" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>'ya le traia lo que va a comer, el mono fue a robar lo que se come'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>'y ahora despues'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a147" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>'cuando yo te decia vamos a ir es que le decia vamos a ir a divertir le decia vamos a ver los que bailan, y es que no eran bailadores eran arrieros que pasaban'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a148" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>'como van montados van brincando por eso le decia que eran bailadores le decia el'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a149" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>'y ahora en la noche le decia vamos a ir a ver el castillo le decia otra vez'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a150" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>y eso no era castillo de a deberas le decian sino que era luciernaga'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a151" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>'y esa mujer se fastidio y la llevaron otra vez a la peña'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a152" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>'y ahora la embarazaron a esa mujer, la embarazo el mono'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a153" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>' y ahora despues nacio su bebe'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>'empezo a crecer, y cuando empezo a recapasitar ese muchacho'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a155" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>'le dijo a su madre que haces a donde estas adentro le dice fue tu padre el que me trajo es que dice'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a156" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>'empezo a romper ese muchacho y quitar la piedra con que lo habian tapado la entrada de la cueva'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a157" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>'no se puede porque pesa la piedra'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>'ahora'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a159" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>'cada ocho dias se iba aumentando la fuerza de ese muchacho cuando empezo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>'empezo a empujar lo movio, ya hasta los quince dias cuando ya tumbo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a161" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>'y ahora le dice su mama vamos ahora le dice'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>'se bajaron en el bejuco y se fueron a las casas'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a163" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>'ahora ahora te dijo le dice su mama este mi hijo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a164" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>'es bien agresivo si va a ir a donde esta los niños les va a pegar'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a165" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>'empezo a ir con los otros niños'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>'es que es cuando fua a ver al cura en la escuela'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a167" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>'habia ido a acostarlos tuvo miedo su mama'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a168" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>'cuando le dijo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a169" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>'y hora le voy a dar al cura'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a170" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>'y que vea con en que lo va a mandar hacer'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a171" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>'se fue con el cura y ahora le dijo este muchacho es bien grosero'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a172" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>'tu sabes con que lo vas a mandar hacer'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a173" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>'porque cuando les pega a los niños casi los quiere acabar de matar'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a174" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>'yo tengo miedo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a175" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>'al cura le dije yo quiero asi como es de gresero porque yo tengo un potrero en... alli y...'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a176" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>'estan comiendo los becerros, esta comiendo el tigre, y...'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a177" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>'va a ir voy a mandar a cuidar vamos a ver si es que va a regresar es que dice el padre'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a178" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>'lo mandaron'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a179" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>'hijole y ahora cuando salieron muchos tigres, salieron muchos tigres, leon, es que no tiene miedo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a180" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>'lo lazo y lo monto al tigre y ahora cuando amanecio los trajo amarrados los demas y traia montado al tigre'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>'lo regaño el padre le dijo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>'para que quieres a esos animales pues eso es lo que estaban comiendo tus vacas'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>'pues hechalos aqui no los quiero para nada esos'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>'los hecho porque no sabia que hacer el cura'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a185" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>'es que dice que le voy a hacer a este muchacho es que bien valiente y ahora los voy a mandar es que dice'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a186" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>'en el panteon alli pero como espantan dice aver si pudo regresar otra vez es que dice'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a187" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>'lo volvieron a mandar'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a188" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>'hijole cuando es media noche empezaron a hablar los muertos y dicen misa, misa dicen los muertos y dice ese muchacho les responde longaniza les dice'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a189" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>'y ahora paso la media noche todo quedo en tranquilidad'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a190" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>'como amanecio llego otra vez a donde estaba el sacerdote le dijo'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a191" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>'regreso, regreso por fin que viste le dijo' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a192" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>'pues yo vi este'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a193" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>'salen los muertos y hablan y que dicen, pues uno dice misa, misa dice, y yo le respondi longaniza, le dije mm'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a194" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>'que le hago es que dice el cura'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a195" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>'ahora lo voy a mandar y voy a tocar la campana a media noche'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a196" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>'va a ver que cosa hay'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a197" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>'pero como espantan mucho'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a198" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>'se fue'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a199" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>'hijole es que fue a repicar la campana a media noche'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a200" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>'lo vio'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a201" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>'el animal es que venia'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a202" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>'se persigno en la iglesia y salto, salto y se fue'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a203" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>'no hay nada le dijo el cura, y que viste le es que [le dice]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a204" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>'nama mas vio a uno si es animal no lo se'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a205" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>'paso a persignarse en la puerta de la iglesia, brinco, brinco, asi'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a206" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>'nada mas este lo viste, nada mas ese lo vi'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a207" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>'y ahora donde lo voy a mandar es que dice el cura'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a208" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>'y ahora cuando salga el sol con el le voy a seguir solomente alli ya no va a poder regresar'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a209" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>'cuando salio el sol alli lo enviaron y el sol se lo llevo y ya no pudo regresar, aqui termina esto'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
