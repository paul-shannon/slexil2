                <ANNOTATION_VALUE>16.27 waníːn lakaskinqúː piːwaá namaːlaːnanqúː kšliːkaːλankaá kaːtašaːwát.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
