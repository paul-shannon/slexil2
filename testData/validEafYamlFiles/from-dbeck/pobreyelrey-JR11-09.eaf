    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Text" PARENT_REF="Ex" TIER_ID="Line">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>pus, wajtzananú ixwí:lh cha:tín chi'xkú' chi: ixka:ha'lhí: lhú:wa' ixlakstín**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a31" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>helhatu'tún xtawila:nálh ti: ja: ixtaa'hpaxní:'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>pus mat waní ti: ma:wí:**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a33" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>klakaskí'n naka:ma:'hpaxi:kantzá tzamá: lakstín**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>he: ju: chu:wá ikwanikutún kaka:lé:n naksikwalán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a35" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>kwanikutún cha:tín rey**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>mat waní ti: ma:wí:**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a37" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>pero cha:tín rey wachí ja: tzej xakatzí:n porque rico tzamá: rey**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>bueno pero, u:tzá klakaskí'n, u:tzá kaka:lé:lh tzamá: kilakstín naksikwalán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a39" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>u:tzá kaka:lé:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>a pus wix ka'tzí:ya', mat waní ti: ma:wí:**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a41" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>pus mat u:tzá waníka' tzamá: rey**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>kaka:lé:lh tzamá: lakstín naksikwalán, kataa'hpáxli'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a43" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>pus mat wan tzamá: rey, tzej naika:lé:n, naika:lé:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>ka:lé:lh helhatu'tún tzamá: lakstín**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>pus, ixkumpajtzá wánli' tzamá: rey**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>a:li:stá:n mat wan tzamá: &lt;u&gt;rey&lt;/u&gt;, ju: chu:wá klakaski'má:lh a'htín &lt;u&gt;favor&lt;/u&gt;**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a47" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>nala:ma:ma'hxto'há:uj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>tu: klakaskí'n nakinta:'pína'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>nahanán a'htín &lt;u&gt;reunión&lt;/u&gt;**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>ja: natatastó'ha tzamá: li:réyes**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>he: kiwanikaní:' a:'ná: kit naika:la'há'n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>he: chu:wá tu: klakaskí'n nakinta:'pína', mat wan ixkumpáj &lt;u&gt;pobre&lt;/u&gt;**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>tzej, mat wan tzamá: ixkumpáj, tzej**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>pus mat waní ti: ma:wí:, chu:wá mat nakta:'á'n kinkumpáj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>nakta:'á'n mat natawilá a'htín &lt;u&gt;reunión&lt;/u&gt;**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>mat tataxtó'ha tzamá: li:réyes**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>he: pus mat a:'ná:' u:tzá nama'hsta:lá:**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>naá'n a'ntzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>naka:la'há'n tzamá: li:réyes**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>pero chi: li:ta:'pína', wix pobre, mat waní ti: ma:wí:**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>wix pobre**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>ja: tu: mintumí:n tu: tzej nali:pína'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a141" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>má:ski' tzaj chu:ntzá xma:n kakila:lhawaníj kincháuj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>kis’o'ho:'cháuj, he: u:tzá naklé:n kis’o'ho:'cháuj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a143" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>pus mat u:tzá lhawanílh la'hwá: s’o'ho:'cháuj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a144" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>he: ta:'á'lh ixkumpáj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a145" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>tatayá tzamá: ixtejkán, taa'lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>naktéj tatzukúlh tawayán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a147" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>he: xla, u:tzá tu: lhawálh, ma:xtúlh is’o'hocháuj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a148" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>he: tzukúlh wa**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a149" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>bueno, tawayanhó:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a150" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>tatayapálh ixtejkán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a151" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>po'hlhwanánli'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a152" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>ja: po'hlhwanánli' mat wi:lh a'htín kí'wi'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a153" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>mat wan tzamá: pobre, chu:wá wa:tzá la'hapo'hlhwanana:ujtzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>jú:ncha' chu:wá ja: natama:yá:uj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a155" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>pus chu:wá ja: naktiyá'h katitamá:uj, wan tzamá: rey**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a156" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>naktawakayá:uj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a157" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>wa' wi:lh tzamá: kí'wi', a'ntzá tawakayá:uj he: a'ntzá nalhtatayá:uj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>pero ja: tzej katiwánli', wan tzamá: pobre**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a159" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>ja: tzej katiwánli' &lt;u&gt;porque&lt;/u&gt; jú:ncha' palh lhtu:n naki:tzukuyá:uj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>tzej nawán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a161" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>chu:n tzamá: rey ja: lhtatá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>pus xla tzej wani:'nílh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a163" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>he: ixlawí:lh a'ntzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a164" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>tawaká'lh nakí'wi' he: xla ja: lhtatálh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a165" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>&lt;u&gt;pero&lt;/u&gt; tzamá: &lt;u&gt;pobre&lt;/u&gt; ka:xwilí:lh ja: lhtatálh, &lt;u&gt;y&lt;/u&gt; lhtatálh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>he: chi: lhtatálh, tzamá: rey tu: lhawálh ma:xtunílh ixla'hastapún ixkumpáj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a167" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>ma:xtunílh ixla'hastapún**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a168" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>he: u:tzá chu:ntzá li:lhawálh porque ja:tzá le:nkutúnli' ja:, ja: taa'ma:'nálh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a169" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>ja:tzá le:nkutúnli', ma:xanán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a170" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>ja: le:nkutún ixkumpáj pobre, ja: le:nkutún**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a171" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>pus tzaj ma:xtunílh ixla'hastapún**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a172" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>a:li:stá:n tzamá: pobre pus ixli:ma:ntzá tawí:lh nakí'wi'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a173" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>he: tzamá: rey yújli' he: a'lh, a'lhtzá ixli:má:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a174" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>bueno, he: tzamá: pobre a:li:stá:n mat li:puwamá:lh, li:puwamá:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a175" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>akxní hexmá'tli' mat ta:'chiwi:nánka'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a176" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>hexmá'tli' le'h tzamá: tzukúka' ta:'chiwi:nankán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a177" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>mat wanikán, tu: lhawawíla' wa:tzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a178" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>ja: tu:, ja: tu: iklhawamá:lh wa:tzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a179" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>tzaj xakta:'a'má:lh kinkumpáj tzamá: rey**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a180" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>xakta:'a'má:lh he: wi:lh a'htín &lt;u&gt;reunión&lt;/u&gt;**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>tzamá: tatastó'hli' tzamá: li:réyes he: a'ntzá xaka'má:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>xakta:'a'má:lh kinkumpáj**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>he: xla tzamá: kinkumpáj, tu: kilhawanílh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>chi: ja: kile:nkutún a:li:stá:n ja:tzá kile:nkutún**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a185" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>kima:xtunílh kila'hastapún**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a266" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>kima:xtunílh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a267" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>pus chu:wá ju: wa:tzá ikwí:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a268" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>ja:tzá le: ikyúja porque ja:tzá tu: kila'hastapún**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a269" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>pus mat waní ti: tzukúlh ta:'chiwi:nán, mat waní**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>pus wa:tzá wi:lh mili:kúchu:', mat waní**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a271" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>wa:tzá wi:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a272" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>pero ja: chu: tzej wi:lh?**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>wa:tzá wi:lh, tzaj xma:n tu: lhawáya' wix**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>nalhawáya' a'htín taskujút**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>wi:lh a'htín pueblo**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>ja: tali:la'hni:ma:'nálh tzamá: chi: tahelhpu:ti:xni:ma:'nálh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>tahelhpu:ti:xni:ma:'nálh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a247">
                <ANNOTATION_VALUE>pus lhu:wa'tzá kristiánu' taní:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>he: chu:wá a'ntzá wix nate:skúja' a'ntzá chi: napína' naminchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>he: nate:skúja' a'ntzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a250">
                <ANNOTATION_VALUE>porque naka:ma:nó'hlha cha:tú' kristiánus**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>cha:tú' chi'xkuwín naka:ma:nó'hlha**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>natawaniyá:n chi: tzej talama:'nálh naixchikán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>tahelhpu:ti:xni:ma:'nálh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>lhu:wa'tzá tani:ma:'nálh a'ntzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>he: chu:wá wix pus a'ntzá nate:skúja'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>he: wa:tzá wi:lh mili:kúchu', mat wanikán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>pero tu: ya: li:kúchu:', mat wampálh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>pus ju: ixpé'hni' wamá: kí'wi'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>u:tzá ixpé'hni' kí'wi'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>natayayá:uj ixpé'hni' kí'wi'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>he: xaxká:n tzamá: ixpé'hni' kí'wi' nali:lhawáya' [tzamá:] mila'hastapún he: naka:xlá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>naka:xlá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>nalakawanána'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>mat tzukúlh lhawá chu:ntzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>mat tzukúlh ma:nu:ní xaxká:n pá'hlhma'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a328">
                <ANNOTATION_VALUE>ka:xlálh, lakawanálh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a329">
                <ANNOTATION_VALUE>a:li:stá:n mat yújli' tzamá: chi'xkú'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a330">
                <ANNOTATION_VALUE>i:nú yujli'tzá tayálh ixtéj a'ma:lhtzá naixchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a331">
                <ANNOTATION_VALUE>ixli:ká:na' naktéj ka:ma:nó'hlhli' tzamá: cha:tú' kristiánus, cha:tú' chi'xkuwín**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a332">
                <ANNOTATION_VALUE>ka:ma:nó'hlhli'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a333">
                <ANNOTATION_VALUE>tatzukúlh tawaní chi: tzej tali:lama:'nálh naixchikán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a334">
                <ANNOTATION_VALUE>tahelhpu:ti:xni:ma:'nálh, ja: tu: ixka:nkán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a335">
                <ANNOTATION_VALUE>he: ja: taka'tzí: ja: tu: tzej natatayá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>jú:ncha' chu:wá, mat ka:waní, chi: puwana:tít**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a337">
                <ANNOTATION_VALUE>pus, tu: klakaski'ná:uj ja:sá wix ka'tzí:ya' ja: chu: tzej wi:lh tzamá: xka:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a358">
                <ANNOTATION_VALUE>tzamá: tu: klakaski'ná:uj [inaudible] nate:láya' nakinchikán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a359">
                <ANNOTATION_VALUE>nate:láya'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a360">
                <ANNOTATION_VALUE>napu'tzáya' ja: chu: tzej wi:lh tzamá: xka:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a361">
                <ANNOTATION_VALUE>he: natamaxki:yá:n tzamá: tumí:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a362">
                <ANNOTATION_VALUE>natala'halhu:ma:ná:n tzamá: tumí:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a363">
                <ANNOTATION_VALUE>ja: tzaj maksti'náj, lhú:wa' tu: natamaxki:yá:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a364">
                <ANNOTATION_VALUE>tzej, mat ka:waní, tzej**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a424" ANNOTATION_REF="a365">
                <ANNOTATION_VALUE>ka:ta:'á'lh naixchikán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a425" ANNOTATION_REF="a366">
                <ANNOTATION_VALUE>tzamá: chi'xkuwín ka:ta:'á'lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a426" ANNOTATION_REF="a367">
                <ANNOTATION_VALUE>mat ka:ma'hstó'hli' tzamá: kristiánu'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a368">
                <ANNOTATION_VALUE>katalhawálh a'htín faena**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a428" ANNOTATION_REF="a369">
                <ANNOTATION_VALUE>katama'haya:wá:lh tzamá: chiwíx**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a429" ANNOTATION_REF="a370">
                <ANNOTATION_VALUE>katama:pa:nú:lh tzamá: chiwíx**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a430" ANNOTATION_REF="a371">
                <ANNOTATION_VALUE>he: a'ntzá naixtampí:n tzamá: chiwíx ixlatanu:má:lh tzamá: chacha'há't**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a431" ANNOTATION_REF="a372">
                <ANNOTATION_VALUE>pus tzamá: chacha'há't u:tzá wamá:lh tzamá: xka:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a373">
                <ANNOTATION_VALUE>he: naixtáni' taxtunima:pálh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a433" ANNOTATION_REF="a374">
                <ANNOTATION_VALUE>a'ntzá taxtumá:lh lakatín ja: makaa'má:lh tzamá: xka:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a434" ANNOTATION_REF="a375">
                <ANNOTATION_VALUE>u:tzatzá tali:helhpu:ti:xni:ma:'nálh porque wamá: chacha'há't lakatín makaa'má:lh tzamá: xka:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a435" ANNOTATION_REF="a376">
                <ANNOTATION_VALUE>pus he: chi: nali:hanán tzamá: xka:n, u:tzá ka:lhawasti:má:lh a'ntzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a436" ANNOTATION_REF="a377">
                <ANNOTATION_VALUE>a:li:stá:n pus, mat tzamá: tatzukúlh taponhnún**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a437" ANNOTATION_REF="a378">
                <ANNOTATION_VALUE>talhawálh faena, tzukúlh taponhnún, taponhnún**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a438" ANNOTATION_REF="a379">
                <ANNOTATION_VALUE>tama'haya:wá:lh tzamá: chiwíx**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a439" ANNOTATION_REF="a380">
                <ANNOTATION_VALUE>xli:ká:na' a'ntzá tanu:má:lh tzamá: há'lha' chacha'há't**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a440" ANNOTATION_REF="a381">
                <ANNOTATION_VALUE>mat a'ntzá tanu:má:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a441" ANNOTATION_REF="a382">
                <ANNOTATION_VALUE>tama:xtúlh tzamá: chacha'há't**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a442" ANNOTATION_REF="a383">
                <ANNOTATION_VALUE>tama'hní:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a443" ANNOTATION_REF="a384">
                <ANNOTATION_VALUE>chi: tama'hní:lh, pus tzamá: tzukúlh taxtú tzamá: xka:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a444" ANNOTATION_REF="a385">
                <ANNOTATION_VALUE>jú:ta kristiánu' chi: tapa:xwahó:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a445" ANNOTATION_REF="a386">
                <ANNOTATION_VALUE>tala'htzín chi: tzukúlh taxtú xka:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a446" ANNOTATION_REF="a387">
                <ANNOTATION_VALUE>jú:ta chi: talá kristiánu'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a447" ANNOTATION_REF="a388">
                <ANNOTATION_VALUE>chi: talhawálh tzamá: a'htín há'lha' ka:'táni'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a448" ANNOTATION_REF="a389">
                <ANNOTATION_VALUE>tzej tali:ma:panhe:nílh, tamaká:'n &lt;u&gt;cohete&lt;/u&gt;**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a449" ANNOTATION_REF="a390">
                <ANNOTATION_VALUE>talhawálh ka:'táni' porque chi: tapa:xwa:hó:lh chi: ma:'kxtúka' tzamá: xka:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a450" ANNOTATION_REF="a391">
                <ANNOTATION_VALUE>ma'hní:ka' tzamá: chacha'há't**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a451" ANNOTATION_REF="a392">
                <ANNOTATION_VALUE>lhkuyú:ka'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a452" ANNOTATION_REF="a393">
                <ANNOTATION_VALUE>pus jú:ta mat chi: tzukúka' maxki:kán la'hwá: tumí:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a394">
                <ANNOTATION_VALUE>mat wa:'h oro tzukúka' maxki:kán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a454" ANNOTATION_REF="a395">
                <ANNOTATION_VALUE>ásta ja: ma:tzumá:lh a'htín há'lha' &lt;u&gt;bolsa&lt;/u&gt;**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a455" ANNOTATION_REF="a396">
                <ANNOTATION_VALUE>a:li:stá:n tzamá: tumí:n ja:tzá le: chi: xlhawá ja:tzá le: ixlé:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a456" ANNOTATION_REF="a397">
                <ANNOTATION_VALUE>ja:tzá le: ixlé:n naixchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a457" ANNOTATION_REF="a398">
                <ANNOTATION_VALUE>tama'hta:yálh tata:'lé:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a458" ANNOTATION_REF="a399">
                <ANNOTATION_VALUE>tata:'á'lh talé:lh tzamá: tumí:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a459" ANNOTATION_REF="a400">
                <ANNOTATION_VALUE>li:chá:lh tzamá: tumí:n naixchík**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a460" ANNOTATION_REF="a401">
                <ANNOTATION_VALUE>jú:ta pus, mat waní ti: ma:wí:**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a461" ANNOTATION_REF="a402">
                <ANNOTATION_VALUE>jú:ncha' wix chi: li:tampa:'tzá**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a462" ANNOTATION_REF="a403">
                <ANNOTATION_VALUE>he: kinkumpajkán ja: na: a:mín**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a463" ANNOTATION_REF="a404">
                <ANNOTATION_VALUE>ah, pus, tzamá: kinkumpajkán ja: na: min pero kit iktaspi'tayá:lh porque ixkima'hni:kutumá:lh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a464" ANNOTATION_REF="a405">
                <ANNOTATION_VALUE>ma:xtúlh kila'hastapún, ja:tzá xaklakawanán**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a465" ANNOTATION_REF="a406">
                <ANNOTATION_VALUE>pus, iktaspí'li' xma:n kit**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a466" ANNOTATION_REF="a407">
                <ANNOTATION_VALUE>ka:xlálh kila'hastapún**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a467" ANNOTATION_REF="a408">
                <ANNOTATION_VALUE>&lt;u&gt;pero&lt;/u&gt; tzaj cha:tín ja: ika'tzí: ti: chu: tzej kimaxkí:lh tzamá: li:kúchu:''**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a468" ANNOTATION_REF="a409">
                <ANNOTATION_VALUE>he: ikli:lakawanálh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a469" ANNOTATION_REF="a410">
                <ANNOTATION_VALUE>he: chu:wá iktaspi'tayá:lh he: ikte:skújli'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a470" ANNOTATION_REF="a411">
                <ANNOTATION_VALUE>ju: tu: klhajálh**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a471" ANNOTATION_REF="a412">
                <ANNOTATION_VALUE>mat ma:suyunílh ti: ma:wí:**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a472" ANNOTATION_REF="a413">
                <ANNOTATION_VALUE>u:tzá wamá: tu: klhajálh tu: kimaxkí:ka' ja: ikte:skújli'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a473" ANNOTATION_REF="a414">
                <ANNOTATION_VALUE>ju: chi: tapa:xwahó:lh ixlakstín**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a415">
                <ANNOTATION_VALUE>he: ti: ma:wí: chi: tapa:xwahó:lh chi: tala'htzín la'hwá: tumí:n**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a475" ANNOTATION_REF="a416">
                <ANNOTATION_VALUE>wa:'h oro maxki:kaní:'**</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
