                <ANNOTATION_VALUE>18.9 tunkunhtakaːšqúːɫ, qaːtawií kawaːyuú ¢umáːt ʔáɫ. waá qawásaa puːláɫ.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>18.10 kahkuʔaq¢úː šλaːwanquːníːt, tunkunhtanuːqúːɫ kkaːkiwiín. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
