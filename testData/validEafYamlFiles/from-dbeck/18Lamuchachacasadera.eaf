        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1" TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>18.1 maqaːsaá šlamaá čaːtám ¢umáːt, ʔaːnqaɫíːn šwán piːniːʔakšniikatitaːtapuːčawáɫ waá tiː niːλáːn ɫaqaːnán, waá tiː niːqaɫíː tamíːn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts9">
                <ANNOTATION_VALUE>18.2 šwán piːwaá nataːtapuːčawaá tiː qaɫíː tamíːn, tiː λáːn ɫaqaːnán.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>18.3 míɫ kiɫtamakú, ʔaɫčaqanán štaːstám, špukɫniinán ¢inú,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>18.4 liwipaːšawaá ščaqanamá, niːška¢íː tuː naːqspulú. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>18.5 šamaqtám maːlaka¢uːwíːɫ čaːtám qawása, liwiλáːn škaːšyá, šqaɫíː škawaːyú. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>18.6 ¢ukuɫšaqaλíː, liwipaːšawaqúː ščaːtiyhkán šqaɫčiwiːnamaːqúː λankaaliyá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>18.7 qaɫskiniːnáɫ qawásaa papiːniːlakaskín ¢umáːt nataːtapuːčawá, tunkunhmaːλaːníːɫ ¢umáːt,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
