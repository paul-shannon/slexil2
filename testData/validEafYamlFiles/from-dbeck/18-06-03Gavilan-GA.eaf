    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Text" PARENT_REF="Ex" TIER_ID="Line">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>bueno, kit nakwaniyán wamá ixkwénto cha:tín hawácha' ixtapalája li:wáya </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a33" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>waní chi: ixmátli' mat [00.08]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>osea mat wankán minla'hatin ha:ni:málh he: mat ha:lh ja: ix– ixchiyáwakaní cha:tín tzumaját [00.12]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a35" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>he: mat la'ha: xkalhwaya:lh la'hchílh mat waní tzumaját tú:la' kalhwana' [00.22]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>ha: tú klikalhwama:lh porque namintzá' la'hatín ha:ni:málh naki:wá [00.27]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a37" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>ja: kajikwánti' nakma'ta:yán waní [00.33]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>ja: mat ní:ya' tzama: ho:lú:ya' ha:ni:málh [00.37]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a39" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>palh chu:ntzá ja: ja: ti: palh ja ti:k ha:nán natanu: kalakchíkni' ka:woho: kristianu [00.40]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>u:tzá ki:li:yáwakaní wa:tzá [00.46]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a41" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>ja: ka:lipiwánti' kit nakma'hapa:taxtuyá:n [00.50] </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>kwaní man nakma'hní [00.53]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a43" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>he: wix ja: ma'hníya' ja: ti: ti:ma'hní tzama: hani:málh tzunúyá' u:tzá tzu:nuyahálha' [00.55]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>wix ja: hachi: ka:kátzi' kit nakma'hní [01.02]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>chi: nalhawáya' tu: li:ma'hni:ya' ja: tu: tu:li:tána' [01.04]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>wix man kahexpá'htí [01.08]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a47" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>kit nakma'hní he: nakma'hní [01.11]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>peru ja: helhha:ha:hiniyán waní [01.14]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>bueno, kit nakxkután napína naminchík, napína naminchík [01.21]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>he: man nakwaniyántunká palh chu:ntzá nakintatawiláya [01.27]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>la'hmaxtuyán palh chu:ntzá ja: kakinti:tatawi:lá ja: ti: la'hmaxtún waní porque wix' [01.32]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>palh chu:ntzá kila:la'hmaxtuyá naktatawiláyán wan tzama: tzumaját [01.40]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>xkútli' tzama: ti:la: li:wa:yá waní pús kapít halh naxchík [01.45]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>chu:wá chalh naxchík waní ta:tatúla tána' waní [01.50]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>pús chilh cha:tín hawácha' wan nama'hní tzama: hani:málh he: ja: namatni' [01.54]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>wá hani:málh ja: ti: ti:ma'hní porque lamahálha' [01.58]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>he: he: nama'hní wan pero chi:n lhawá tu: nali:ma'hní  [02.03]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>pús xlah katzí chi: nama'hní</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>he: he: kapít kapít porque palh chu:ntzá ja:n ta:spíta' ja: xchi:yawakani:ta'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>kit nakhi:ma'hnikán waní he: he: nama'hní tzama: hawácha' [02.13]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a61" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>ha:palhxli:kána' pús tzéj he: tama'hxte'hli' tzama: tzumaját [02.18]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE> ju:ta ni:taxtúchi: makasanante:lhá taxtu:chi tzama: hanimálh tzúnuya u:tzá [02.22]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>chi: ki: ti:yá ja: waní tzami:málh chu:wá [02.28]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a113" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>tálaka pálh tzúmalhtzá ha:kxní tasálh li:wa:yá lhti:n tujnúlh ha:kxní [02.35]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>wahá te:ma:xtú:nílh xla'hastapun a'htín te:taxtupálh ha: le: xpe'hka:ná [02.45]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a115" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>ma:xtúni:pálh hi: nu: ja:tzá lakawa:nán tzama: hanimálh chu:wá waní [02.53]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>chu: ha:xmántzá wa:má ixta:tzán xalhmán ixkolmi:yo maxtunílh [03.00]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a117" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>kilh maxtunílh a'htú he:hálh tzumaját hani:tzá [03.06]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>ma'hnílh chu:wá hálh naka:lakchikni tzama: hawácha'  [03.11]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>ja: xa: la– ja: a:ntzá xwílh tzama: nakalakchíkni' ja: xwílh tzumaját [03.14]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>xa: la: ha:lakatín xwaní... chálh tzukúlh pu:tzá ja: katzi: ja: namakla: [03.18]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a121" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>chu:wá chílh karbune:ru waní [03.25]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>ti: nakmaxtu:ní xtatzán wa:má he: kit nakta:to:lá tzumaját [03.28]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a123" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>peru tzáj chi: xa: laha:ntzá [03.32]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a124" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>maxtunílh xta:tzán peru ja: tzá u:tzá kolmiyo tu: xatzéj [03.35]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a125" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>le:lh kit ikma'hnílh tzama: halhá hani:málh chu:wá kit nakta:tolá mintzumaját  [03.39]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a126" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>ja: wix ma'hnini:ta' tzama: hawácha' ma'hnílh tu: wix tzá karbone:ro [03.47]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a127" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>ha'htu: li:ma:su:yúlh la'hasa:wíka' tzama: hawácha' tzama: tzumaját [03.54]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a128" ANNOTATION_REF="a111">
