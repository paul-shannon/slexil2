        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>'[el carbonero] llevo [el colmiyo], yo lo mate ese animal grande, ahora yo me voy a casar con tu hija' </ANNOTATION_VALUE>
