    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss" PARENT_REF="Ex" TIER_ID="L3Gloss">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a62" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>bueno, yo te voy a racontar este cuento de un muchacho que se convierte en gavilan'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a63" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>'cuando escucho es que...' (meaning?)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>'osea se dice que viene un animal y es que se fue [el muchacho] a donde estaba amarrada una muchacha'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>y es que estaba llorando mucho, cuando llego [el muchacho], es que le dice a la muchacha, porque lloras?' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>'ah, estoy llorando porque ya va a venir un animal y me va a comer' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>'no tengas miedo, te voy a ayudar, le dice'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>'donde lo vas a matar, ese es un animal grande'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>'si es que no estoy va a entrar en las casas y se va a comer a toda la gente' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>'por eso me pusieron aqui'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>'no tengas miedo, yo te voy a ayudar' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>'te estoy diciendo que lo voy a matar' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>'y tu donde lo vas a matar, nadie lo mata porque es muy grande ese animal, es muy grande'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>'tu no te preoccupes, yo lo voy a matar' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>'como le vas a hacer, con que lo vas a matar?, tu no traes nada'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>'tu no mas escucha [dice el muchacho]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>'yo lo voy a matar, lo voy a matar'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>'pero yo no te creo, lo que dices' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>'bueno, yo te voy a desatar, vas a ir a tu casa, vas a ir a tu casa' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>'y nada mas te digo una cosa: si es que te vas a casar conmigo,' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>'te voy a rescatar, si es que no te vas a casar conmigo, no te voy a rescatar, le dice, porque tu...'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>'si es que me vas a rescatar, me voy a casar contigo, dice la muchacha' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>'lo desato ese [muchacho] que se convierte en gavilan, y le dice, pues vete a tu casa, y se fue a su casa' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>'y ahora llego a su casa y le dicen, porque te veniste, le dicen'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>'pues llego un muchacho, dice que lo va a matar ese animal; y como lo va a matar? [le prejuntan]'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>'ese animal nadie lo puede matar, porque es muy grande' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>'no no, si lo va a matar, dice [la muchacha], pero como lo va a matar, con que lo va a matar?, prejuntaron', </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>'pues el save como lo va a matar'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>'no no, vete vete porque si no regresas donde te abian amarrado,'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>'a mi me va a matar [l'animal], no no lo va a matar ese muchacho'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>'ah si es verdad, pues esta bien, y se quedo la muchacha'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>'ijole, cuando venia venia haciendo ruido, ese animal, era un animal muy grande'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a129" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>'la tierra se movia, y ahora dice, allí viene' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a130" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>'ya venia cerca cuando silvo el gavilan, volo cuando...'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a131" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>'le paso a sacar un ojo [al animal], cuando paso otra vez del lado derecho' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a132" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>'le saco otro ojo y entonces ya no veia ese animal, y ahora le dice' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a133" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>'ya nada mas este su diente grande su colmiyo le saco' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>'le saco dos [colmiyos], y se fue [el muchacho]; la muchacha ya se abia hido'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a135" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>'lo mato y ahora se fue en el pueblo ese muchacho'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a136" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>'de donde– no vivia allí ese [muchacho], en ese pueblo donde vivia la muchacha' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>'era de otro pueblo, llego y empezo a buscarla, no sabia donde encontrarla' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>'ahora llego el carbonero y le dice:' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>'le voy a sacar su diente a este y yo me voy a casar con la muchacha' </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>'pero como era de alli [el carbonero]...'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a141" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>'le saco su diente pero ya no era colmiyo de verdad'</ANNOTATION_VALUE>
