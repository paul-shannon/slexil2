    </TIER>
    <TIER LINGUISTIC_TYPE_REF="%com" PARENT_REF="*FR1" PARTICIPANT="FR1" TIER_ID="%com@FR1">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann374" ANNOTATION_REF="ann369">
                <ANNOTATION_VALUE>she stands up and goes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann393" ANNOTATION_REF="ann388">
                <ANNOTATION_VALUE>she wants FR2 to move out, FR2 complains, they fight a little.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann423" ANNOTATION_REF="ann418">
                <ANNOTATION_VALUE>she is playing with CHI's toys, she invites him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann461" ANNOTATION_REF="ann455">
                <ANNOTATION_VALUE>FR1 goes out, CHI goes with her and closes the door.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann559" ANNOTATION_REF="ann553">
                <ANNOTATION_VALUE>CHI shares his chips with FR1 too, the girls talk quietly, it is not possible to hear.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann598" ANNOTATION_REF="ann592">
                <ANNOTATION_VALUE>CHI plays with FR1, he rides the little plastic horse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann791" ANNOTATION_REF="ann786">
                <ANNOTATION_VALUE>she closes the door and doesn't allow CHI to go out and the girls finally leave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="%com" PARENT_REF="*FR2" PARTICIPANT="FR2" TIER_ID="%com@FR2">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann467" ANNOTATION_REF="ann462">
                <ANNOTATION_VALUE>she goes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann505" ANNOTATION_REF="ann500">
                <ANNOTATION_VALUE>she comes back to the front door.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann520" ANNOTATION_REF="ann515">
                <ANNOTATION_VALUE>it seems that she is inviting him over, she goes and CHI joins FR1 and SIS again.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann643" ANNOTATION_REF="ann638">
                <ANNOTATION_VALUE>from the front door.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann650" ANNOTATION_REF="ann645">
                <ANNOTATION_VALUE>she laughs.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann695" ANNOTATION_REF="ann690">
                <ANNOTATION_VALUE>she sews.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
