                <ANNOTATION_VALUE>descends from the swing and points to the drawings on CHI's shirt.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann81" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>referring to the name of some cartoons characters.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann118" ANNOTATION_REF="ann112">
                <ANNOTATION_VALUE>she gives him chips</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann131" ANNOTATION_REF="ann125">
                <ANNOTATION_VALUE>she gives him chips again.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann572" ANNOTATION_REF="ann566">
                <ANNOTATION_VALUE>CHI starts coughing.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann578" ANNOTATION_REF="ann573">
                <ANNOTATION_VALUE>she goes to the kitchen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann610" ANNOTATION_REF="ann605">
                <ANNOTATION_VALUE>CHI plays with the girls and shares his chips.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann617" ANNOTATION_REF="ann612">
                <ANNOTATION_VALUE>she is mad at CHI.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann631" ANNOTATION_REF="ann625">
                <ANNOTATION_VALUE>someone arrives, they look at the front door.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann663" ANNOTATION_REF="ann658">
                <ANNOTATION_VALUE>she asks CHI for more chips.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann806" ANNOTATION_REF="ann800">
                <ANNOTATION_VALUE>CHI opens the door and goes out, it seems he wants to follow the girls.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann838" ANNOTATION_REF="ann832">
                <ANNOTATION_VALUE>they eat chips.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann856" ANNOTATION_REF="ann851">
                <ANNOTATION_VALUE>she wants CHI to sit with her.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann896" ANNOTATION_REF="ann891">
                <ANNOTATION_VALUE>she follows CHI, they are both in the front yard.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1047" ANNOTATION_REF="ann1042">
                <ANNOTATION_VALUE>she wants CHI to wear an old hat and runs after him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1061" ANNOTATION_REF="ann1056">
                <ANNOTATION_VALUE>he shouts to the puppy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1064" ANNOTATION_REF="ann1063">
                <ANNOTATION_VALUE>picks up the hat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1084" ANNOTATION_REF="ann1078">
                <ANNOTATION_VALUE>CHI keeps the hat and wants to hit GRM.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1145" ANNOTATION_REF="ann1139">
                <ANNOTATION_VALUE>he goes back.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1431" ANNOTATION_REF="ann1425">
                <ANNOTATION_VALUE>CHI goes to the kitchen and starts playing with his car.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1567" ANNOTATION_REF="ann1561">
                <ANNOTATION_VALUE>she counts up to eighteen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1582" ANNOTATION_REF="ann1576">
                <ANNOTATION_VALUE>CHI makes car sounds.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1656" ANNOTATION_REF="ann1651">
                <ANNOTATION_VALUE>she goes with MOT.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1659" ANNOTATION_REF="ann1658">
                <ANNOTATION_VALUE>makes car sounds and brings little stones to the game as they are playing with construction trucks.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1671" ANNOTATION_REF="ann1666">
