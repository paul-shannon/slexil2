    <TIER LINGUISTIC_TYPE_REF="%com" PARENT_REF="*CHI" PARTICIPANT="CHI" TIER_ID="%com@CHI">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann41">
                <ANNOTATION_VALUE>he is eating cheetos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann149" ANNOTATION_REF="ann144">
                <ANNOTATION_VALUE>he makes eating sounds.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann258" ANNOTATION_REF="ann257">
                <ANNOTATION_VALUE>takes out all the toys.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann260" ANNOTATION_REF="ann259">
                <ANNOTATION_VALUE>CHI keeps eating chips.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann474" ANNOTATION_REF="ann469">
                <ANNOTATION_VALUE>he comes back with FR1.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann508" ANNOTATION_REF="ann507">
                <ANNOTATION_VALUE>CHI joins FR2.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann670" ANNOTATION_REF="ann665">
                <ANNOTATION_VALUE>he gives SIS the chips.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
