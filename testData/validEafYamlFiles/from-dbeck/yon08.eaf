            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1995" ANNOTATION_REF="ann1990">
                <ANNOTATION_VALUE>she leaves the kitchen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2150" ANNOTATION_REF="ann2144">
