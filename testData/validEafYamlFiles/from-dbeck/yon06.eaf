        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann246" ANNOTATION_REF="ann241">
                <ANNOTATION_VALUE>shouting.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann277" ANNOTATION_REF="ann276">
                <ANNOTATION_VALUE>CHI takes INT's purse and plays with it.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann336" ANNOTATION_REF="ann335">
                <ANNOTATION_VALUE>makes crying noises.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann730" ANNOTATION_REF="ann725">
                <ANNOTATION_VALUE>he sounds like he is making a big effort.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann763" ANNOTATION_REF="ann757">
                <ANNOTATION_VALUE>CHI and SIS talk at the same time.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann869" ANNOTATION_REF="ann864">
                <ANNOTATION_VALUE>they ask CHI to take out the tiger but as he is unable he says MOT is going to do that.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann882" ANNOTATION_REF="ann877">
                <ANNOTATION_VALUE>idph for eating tulolhtulolh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann903" ANNOTATION_REF="ann897">
                <ANNOTATION_VALUE>he gets down of the bed.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann910" ANNOTATION_REF="ann905">
                <ANNOTATION_VALUE>probably he wants SIS to get down too.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann930" ANNOTATION_REF="ann925">
                <ANNOTATION_VALUE>we don't know what xaha' means.</ANNOTATION_VALUE>
