            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1073" ANNOTATION_REF="ann1067">
                <ANNOTATION_VALUE>he goes back to the kitchen.</ANNOTATION_VALUE>
