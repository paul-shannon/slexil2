    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Text" PARENT_REF="Ex" TIER_ID="Line">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>mat ixma'hala:má:lh santiyá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>y mat wan ka'na:chak ta:wá kinkumpáj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>santiyá, mat wan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>pus mat a'lh ta:wá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>chu: mat tzamá: xkumpá mat chukúlh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>ja: a:tzamá tu: pu:la'htanumá:lh tu: waninikán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>ka:, li:katzí: [kikuma...] kinkuma:léj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>kinkitawachí isanti:yá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>isanti:ya ja:tzá tu: pula'htanumá:lh tu: waninikán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>pu:la'hwaxtuni:'tzá mat wan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>ja: tzéj chi: la: tzajtzá ixkilhwám kintita:wáchi mat wan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>pus chuwá: kakitayatít</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>nali:chiyáuj, mat wan tzamá: xkumpá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>pus mat kitayáka' tzamá: tá'ho'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>pus li:chinkatzá chuwá: mat wanikán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>ja: tzéj chuntzá lá:'ya wa kinkitawachíta misandía</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>pus ja:tzá tu: pu:la'htanumá:lh tu: waninikán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>pu:la'hwaxtunitatzá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>mat waní:' ixkumpá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>ja: kit ikpu:la'hwaxtuní:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>ma:x wi:lh tumima:lh wa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>tzamá:... pero chuwá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>nakma'htahá'lha nakchipá tu: mima:lh wa mat wan tzamá: tá'ho'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>pus mat, yawaní:lh li:lhtám</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>chuwá: taxtúchi mat tzamá: skauj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>[mat nexte...] naixtéj ixya:wanikaní:' mat lilhtá:m</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>chuwá: mat wan skauj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>tu: lhawayá' lakchawayá' nakintéj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>kamácha mat wan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>ja: helhti:nín mat tzamá: tu: yawakaní:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>ja: hexpáta' kamácha mat waní:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>ja: helhti:nín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>wix kwanimá:n palh ja: hexpápa nakwi:li:niyán mat waní:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>ja: helhti:nín chuntzá li:lhtám yawakaní:' mat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>pus mat lanklh lakpa:lásli'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>lantáj makachipálh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>ja: kakintima'hxté'hti'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>pus ja: kakintima'hxté'hti' a'mpalayá' tzamá: hentín mat waní:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>lanklh lakpa:laspá:lh xma'hahentín </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a103" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>mat ma'hahe:tutzá tu: chipálh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>ja: katilama'hxté'hwi naklakchintayán mat waní:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a105" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>lanklh a'htantuá'lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>mat chipapálh a'lh tantú hentín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a107" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>kakimaxtéti palh ja: kimaxté'ha ampalayácha' la: hentín mat waní:' akxní a'lhtantú a'mpálh mat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>lantáj tantuchipapalachá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a109" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>tanholujtzá tawaká'lh tzamá: skauj ja:tzá lej mat chi: la:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>chuwá: x’há:lh mat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a111" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>taxtutzá tzamá: tá'ho la'htzín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>tácha chi:tzá lakawawá'ka</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a113" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>halhawaná' ma:ntzá tzejtzá kimastuwáni'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>chuwá: kili:wanimáka'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a115" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>chi: lhawaní:ta kisanti:yá'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>waní wíx tzej pu:la'hwaxtupá:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a117" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>mat wan tzamá: tá'ho' pus mat talakán ho'chiwaká'lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>chi: wakáka' tzamá: skauj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>pus kanaktayá' mili:wá wanikán mat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>a'lh ma:chichí li:ká:n tzamá: táho' tu: tanya:wa:kán tzamá: skauj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a121" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>júta xlamisín mat taxtuchá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>tu: li:lakána' chi:tzá chi: wakakaní:ta'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a123" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>wanikán mat skauj</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a124" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>cará kinchiwaká'lh tzamá: tá'ho' ja: mat ikta:tawi:lá xta:nát</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a125" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>he: utzachá kili:chiwaká'lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a126" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>palh lakpu:wána' wix ixta:tawí:la' he:...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a195" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>naikta:tawi:lá minta:nát nawaníya' akxní namín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a196" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>nata:tawi:láya' mat waní:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>kala:xkútwi'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>wix katawáka kila'hxó'ho</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>mat wanikán misin</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>xli:ka:naj kawálh naktawaká' kila'hxó'ho mat wan misín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>xli:kána' chuntzá kinwaní:' tzamá: tá'ho</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
