    </TIER>
    <TIER LINGUISTIC_TYPE_REF="close transcription" PARENT_REF="Sebastián" PARTICIPANT="Sebastián López Cano" TIER_ID="Traducción2">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a10" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>aja, pues es así como existe el cuento o leyenda de esta flor</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a11" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>que era un niño o una nina, esto que conocemos como una flor</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>es por eso, que así se conoce hoy en día</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>pues hasta ahora, así se siente y conoce, como cuando uno va al monte</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>las flores miran hacia abajo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>allí se pone la flor bonita junto a la otra</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>de esta manera sabemos que así fué como pasó, que fueron abandonados en el monte</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>pues hasta ahora así es como la gente los conoce, la flor más bonita es la niña y la menos vistosa es el niño</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>es así como se origino la leyenda de esta flor</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>por eso esta flor nunca crece sobre el suelo, siempre esta en la paredes rocosas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>se le llama qalhwantalhaqajuy porque estaban llorando mirando hacia abajo cuando ya no podían bajar, pero fué intensional la manera en que los dejaron  en el cerro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a63" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>entonces estaban llorando porque ya no podían bajar, debido a que estaban pequeños</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>pues así es como inició el nombre de esta flor, niña y niño como ahora los conocemos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>por eso mismo se llama de esta manera, porque la flor es muy similar, solo que estas son pequeñas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>pero de allí se originó su nombre de la flor grande</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>solo así se conoce, porque así florece y crece sobre los árboles como mirando hacia abajo, nunca lo verás en el suelo siempre esta en partes altas, por eso también se llama qalhwantalhaqajuy </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>pues estos que se llaman tsinkulho pa:tax o talhaqa:n, porque uno de estas florecitas tiene ojos y el rostro. por ello le llamaban talhaqa:n los abuelos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>hay unos que lo conocen por tsinkulho pa:tax pero es esta misma flor, tambien hay otros similares a patitos que florecen bonito, por ello se le llama tsinkulho pa:tax porque esta agachado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>le dicen así por la flor, tsinkulho pa:tax por la forma bonita en la que se acomoda, casi en forma de patito, por eso los ancianos así le dices y hasta ahora nosotros así lo conocemos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>aja, por eso las demás flores que ya no los distinguen, los llaman como tsinkulho pa:tax solo por el parecido que tienen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>pero, hay otra flor que conocen con el nombre de xkaki xanat, familiar de tsinkulho pa:tax</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>pero, la floración es distinta, la floración es amarilla por es llamado xkaki xanat, porque es amarillo el elotamal, el que se come</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>entonces, de aquí toman el nombre, porque el elotamal que se come es amarillo la masa, entonces, por eso llaman así a esta flor xkaki xanat, además tiene un olor agradable, entonces, por eso lo llaman...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>como huele el elotamal y la flor, entonces, de aquí toman el nombre de xkaki xanat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a105" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE> se llaman de la misma manera, pero a la que conocen como xkaki xanat es la amarilla, florece amarillo mientras que los demás son de color blanco y café, son otros colores pero es el mismo nombre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>le dicen ma:yoh xanat porque en mayo es cuando florece, cuando inicia mayo es cuando está en gran floración esta planta, de aquí viene su nombre flor de mayo, por florecer en este mes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>hay muchos más, como por ejemplo makskat xanat que también florece en mayo, también, algunos lo conocen como flor de mayo, pero nosotros aquí lo nombramos makskat xanat, pero también, florece en mayo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a115" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>en mayo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>existe el azul, pero este ya no se llama flor de mayo, porque no florece en mayo, sin embargo, son hermanos, la verdadera flor de mayo conocida es la amarilla que florece en mero mayo y el azul florece en otro mes, este casí no lo conoce la gente, pero estos son hermanos </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a124" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>esto es lo que ocupaban los abuelos, porque aún no existían los juguetes de fábrica</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a125" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>pues buscaban mucho los abuelos con que entretener a sus hijos, iban a cortar el tallo de makskat xanat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a130" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>este árbol esta bonito porque no se parte, y cuando se seca tiene un sonido agradable</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a131" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>tenía sonido este árbol, cuando lo jugaban sonaba kalhaks kalhaks (onomatopeya *kalhaks*)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a132" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>entonces,  por ello se gustaba a los padres emplear este palo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>pues los niños de ahora ya casi no lo ocupan, porque ahora les compran juguetes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>pero, en el pasado, esto es lo que hacían y enseñaban los ancianos para jugar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>conozco muchos, también conozco el lhalhne', lo ocupaban mucho cuando yo crecí, hacían una llanta de esta manera hecha de lhalhne'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>tienes que tallar de esta manera la llanta y perforarla, se le pone su tabla y las llantas de lhalhne'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a155" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>y esto es con lo que se remolcaban en la calle aún sin pavimentar, pero, en el mejor lugar arrastraban todos los niños esto que conocían como carrito</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a156" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>o pequeño carro, pero, su llanta era de lhalhne'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a157" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>redondos, se le colocaban cuatro a la tabla, y se remolcaban hasta señores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a161" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>todos, los más adultos hacían llantas más grandes, y se arrastraban por las calles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a170" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>así es como jugaban, porque, no existían los juguetes o casas como las que hoy conocemos como los juegos mecánicos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a171" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>no había nada, se fabricaban los juguetes como: baleros, trompos y demás juguetes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a172" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>para el balero utilizaban mucho el akxwat, el tallo del akxwat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a173" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>tenías que hacer tallado tu balero, jugaban mucho con esto y hacían competencias</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a178" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>había algunos jugadores muy buenos, lo paraban en la palma de su mano, entonces, todos fabricaban su propio juguete</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a180" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>no... no vendían juguetes, fabricaban baleros, fabricaban trompos, fabricaban todos sus juguetes, hacían muñecos de palo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>hay otro árbol, algunos usaban el akxwat, porue, no se parte y se le puede dar una bonita figura, pero, usaban varios tipos de árboles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a189" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>también hay otro árbol qa:xi kiwi', su nombre proviene qa:xi kiwi' de que era muy empleado por los ancianos para fabricar su banco</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a190" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>para sentarse, cortaban el árbol de qa:xi kiwi' más grueso, lo tallaban y hacían sus bancos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a193" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>porque no se partía y no pesaba al secarse, se hacía bonito este qa:xi kiwi'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a194" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>lo usaban para sentarse, elegían este árbol y jonote</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a196" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>también utilizaban jonote para elaborar estos banquitos, no había, no vendían sillas o casas buenas como</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a198" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>para sentarse, todos hacían sus bancos, lo hacían tallados</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>también se tallaban, de allí viene el nombre de lavadero, porque, es un árbol que tiene forma, entonces</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a220" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>eh... tallaban para emplearlo como lavadero o para mezclar la masa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a221" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>para vender chicharron de cerdo, para todo esto ocupaban, para cucharones</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a222" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>todos cortaban encino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>no, ya no es qa:xi kiwi', ahora se corta encino y se le da figura de cucharon, este es tasani: kukut</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a224" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>tasani: kukut u oqsmiya:k, este se raja muy bien este el oqsmiya:k</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a225" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>este encino se raja muy bien, entonces, sacaban de este el cucharon, lo ocupaban para mover la carne</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a226" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>o lo ocupaban este... para mover el nixtamal, todos cortaban este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a227" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>porque hay buenos árboles, por ejemplo, el encino es un árbol muy bueno como leña</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a228" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>y si es un árbol duro, hay unos que no se emplean porque dicen que son árboles malos, por ejemplo, lhalhne',</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a229" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>nadie utiliza la leña, porque, dicen que el humo hace daño, daña a los ojos, puede provocar ceguera</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a230" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>por eso no usan lhalhne', porque su humo, si tienes algún animal, si tienes una gallina, los dejará ciegos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a238" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>por esa razón no lo ocupan, lo que conocen como buena leña es lo que cortan, como encino, lhkutapiks,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a241" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>aqxu:nan kiwi', lhilhpatat, liquidambar, esto es lo que emplean para leñar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a242" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>y liquidambar lo usaban mucho para construir casas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a247" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>esto que llamaban alfarda los ancianos, todos lo ocupaban, eh... en el techo de sus casas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a248" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>porque como solo techaban con carto o con teja, pues empleaban este árbol de liquidambar, porque, crece muy derecho</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a254" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>ocupaban mucho como alfarda el helecho arborescente, el helecho arborescente que se coloca en las esquinas, la alfarda</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a260" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>es donde se soportan las trabes, entonces, el helecho arborescente lo prefieren porque no se pudre luego</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a261" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>solo el helecho  arborescente, pero aquel que tenía dinero mandaba a aserrar encinos, de encino también se puede hacer alfardas solo que debe ser aserrado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a265" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>el que tenía más dinero mandaba a aserrar un encino, para sus trabes, travesaño, cintas, mandaba a aserrar y a hacer su casa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a270">
                <ANNOTATION_VALUE>y el pobre que no tenía dinero ocupaba solo helecho arborescente, y su travesaño solo era de un tronco</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>ocupaban liquidambar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>todo es de liquidambar, así como las cintas, estas se tallaban para darles forma, todo es de liquidambar hasta en el techo, solo era de helecho arborescente las alfardas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a280">
                <ANNOTATION_VALUE>para los pobres  que no tenían dinero, tallaban jonote y le daban forma de tablas, con eso cubrían su casa o con troncos redondos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>pues mandaban a aserrar tablas de akxwat, para sus trabes y travesaños de xkija:k, para las tablas ocupaban akxwat porque es un árbol de buena madera</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a287">
                <ANNOTATION_VALUE>el zarzo es para quién tiene sus mazorcas, entonces, el tenía que construir su zarzo, para ello se amarraban carrizos. carrizos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>y no había lasos, entonces, buscaban tánchachu' y lo pelaban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>pelaban tánchachu', le quitaban la corteza, lo secaban y con eso le haciían todos los amarres al zarzo, con eso le hacían todos los amarres al zarzo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a292">
                <ANNOTATION_VALUE>y se colocaban los carrizos más largos de manera muy junta y se amarraban, las trabes también se colocaban con poca distancia de separación</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>y todos colocaban el maíz aquí, como cien o doscientos huacales, wahkat llamaban así el huacal, con huacales acarreaban el maíz, y como venían llegando los trabajadores con la carga, lo subían al zarzo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a298">
                <ANNOTATION_VALUE>y la escalera solo lo hacían</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>también con qa:xi kiwi', buscarían este árbol para hacer una escalera o un jonote grueso que lo hacían escalera, y con ello se subían al zarzo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a304">
                <ANNOTATION_VALUE>aquel que no tenía nada también ocupaba los carrizos como paredes, todo lo cercaban de carrizos, para aquellos que conforme fueron pasando los años llegaron a tener algún ahorro se compraron sus tablas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a305">
                <ANNOTATION_VALUE>y el carrizo ya solo era para enjaular a las gallinas, para quien tenía gallinas allí los encerraban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a306">
                <ANNOTATION_VALUE>en el principio solo amarraban royos de zacate, amarraban royos de zacate, es con lo que techaban, todos amarraban zacate, lo subían y amarraban al techo, ocupaban la caña</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a313">
                <ANNOTATION_VALUE>el zacate de la caña o la hoja de la caña es lo que arreglaban, lo amarraban y es lo que ponian encima de la casa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a317">
                <ANNOTATION_VALUE>ah... este lo que también ocupaban mucho es el jonote, la gente ocupaba mucho el jonote, le quitaba la corteza al jonote, pero hacían que esta se pudra,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a319">
                <ANNOTATION_VALUE>la corteza la hacían que se pudra, lo lavaban, entonces, a este se le sacaban a lo que conocían como fibra</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a320">
                <ANNOTATION_VALUE>este es el material con el que se hacía en huacal, algunos hacían sus lasos largos a manera de entrelazar las fibras del jonote</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a325">
                <ANNOTATION_VALUE>tánchachu' y jonote, pero para hacer las casas es otro material, con el que se hacían los amarres entre la alfarda y trabes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a329">
                <ANNOTATION_VALUE>lo amarraban con stapu miya:k del monte, con este hacían los amarres, lo buscaban,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a330">
                <ANNOTATION_VALUE>este hacían el amarre en el encaje de la alfarda, lo hacían con esta liana del monte</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a335">
                <ANNOTATION_VALUE>hay otra liana que ocupaban mucho llamado kaxapat porque no se quiebra aunque le den vueltas y lo estiren, con esto amarraban y no le pasaba nada</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>por eso lo ocupaban los ancianos, hasta cuando iban a traer sus troncos de árboles con esto lo amarraban y lo arrastraban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>aja</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a345">
                <ANNOTATION_VALUE>lo que ocupaban mucho los ancianos es la lima, un tallo de la lima recto para moldearlo el cual era muy resistente, pero, empleaban varios tipos, empleaban las garras de gavilán, hay una tipo de liana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>entonces, también lo ocupaban mucho para hacer los marcos y lo hacían a manera de gustos, si lo quieren grande como de doce cuartas, diez cuartas, nueve cuartas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a349">
                <ANNOTATION_VALUE>ocho cuartas, como lo quisiensen lo median, entonces, y para unir las puntas de los marcos se amarraban con la fibra del jonote</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a355">
                <ANNOTATION_VALUE>para lo que se ocupaban en las cosechas eran de los grandes, a lo que llamaban de doce cuartas y para los bebés son pequeños</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a356">
                <ANNOTATION_VALUE>los que ocuoaban para cargalos, pero, es la misma fibra y árbol, para todo es lo mismo, hasta estos con el que se cargaban los bebés</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a361" ANNOTATION_REF="a360">
                <ANNOTATION_VALUE>es más pequeño el del bebé, y el que se ocupaba en las cosechas para transportar las marzocas en un huacal grande</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a365">
                <ANNOTATION_VALUE>pues para todo, el huacal es donde metían al bebé, aunque tenia muchos usos con eso transportaban las calabazas, plátanos, la jícama cuando hace muchos años lo cultivaban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a369" ANNOTATION_REF="a368">
                <ANNOTATION_VALUE>todo lo echaban en el huacal, lo ocupaban para muchas cosas con eso cargaban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a371">
                <ANNOTATION_VALUE>al nacer el bebé lo bañaban, lo bañaban con la hoja santa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="close transcription" PARENT_REF="Osbel" PARTICIPANT="Osbel" TIER_ID="Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>Hablémos de qalhwantalhaqajuy, acerca, de lo que saben nuestros ancianos, del conocimento,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>las creencias, como nos contaban nuestros antepasados</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>y también, de lo bello de las flores, que encontramos en el bosque</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a16" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>así es, como cuentan que existió un hombre, que tenia dos hijastros</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a17" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>tenia dos, un niño y una niña</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a18" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>y se dice que este hombre no los quería</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a20" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>seguramente, porque no eran propiamente sus hijos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a22" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>y este señor los llevó al monte a pasear</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a26" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>y los adentro a lo profundo del bosque</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>y los puso en la parte alta de un cerro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a28" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>y dicen, que allí es donde este señor los abandono</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>y allí es, donde los pequeños se encontraban llorando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>aquí es donde el padre uye, sin embargo, los niños no puedieron bajar y allí se quedaron llorando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>se dice que fué tanto su llanto, que la tristeza los mató   </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>y como se encotraban llorando en lo alto del cerro, en por ello que murieron de tristeza</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a39" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>la niña se convirtió en el qalhwantalhaqajuy más bonito y el niño en el qalhwantalhaqajuy de varias flores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>los ancianos dicen que aún siguen llorando cuando estas flores florecen, provocando los aguaceros</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>dicen que si alguien ve esta flor cuando va a leñar al monte la cortan, cortan solo la flor no se traen la planta completa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>argumentado que es como si cuidaran de los niños cuando se traen las flores a la casa para adornar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>hay otro que llaman qalhwantalhaqajuy pequeno, tal vez ya no tenga el significado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>del primero, solo por la semenjansa de la flor grande la niña</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>Tal véz ya no tenga nada que ver, solo porque es muy similar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>hablémos de otro tipo de flores del monte que se emplean como ornamento, existen unos que son muy deseados como el tsinkulho pa:tax y talhaka:n, entre otras plantas que florecen sobre los árboles que son muy vistosos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>¿le llaman así por la flor?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>estos son los parecidos que existen a qalhwantalhaqajuy, que crecen sobre árboles o en la paredes rocosas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>como huele el elotamal</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>pero hay otros similares a xkaki xanat, hay uno blanco y otro como que más pequeño de coloración rojiza, ¿pero se llamaran de la misma manera?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>abunda</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>hay muchos flores que emplean como adorno muy parecidos, hay unos largos que florecen en la época de calor llamados ma:yoh xanat, familia de las flores vistosas que se emplean para adornar, por su agradable aroma y apariencia al florecer</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>también es uno de los más empleados para adornar en mayo, en tiempos de calor, pero dicen algunos que el verdadero ma:yoh xanat también existe en color azul, bueno solo es dicen, nadie sabe si existe realmente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>el verdadero ma:yoh xanat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a126" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>hablamos también de makskat xanat, he escuchado que también se emplean las raíces, el tallo, para fabricar juguetes tallados</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>y ahora, ¿sabes si aún emplean lo que ocupaban hace muchos años?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>¿conoces algún otro árbol, hierba u otro que se empleaba para fabricar juguetes?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a147" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>lhalhne, ¿también lo ocupan?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a148" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>¿lo tallan?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>¿lo hacían redondo?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>todos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a174" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>¿te acuerdas de algún otro árbol que se utilizaban?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a175" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>¿akxwat?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a176" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>¿cómo se hacían?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>¿es el mismo árbol o es otro el que se tallaba?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a191" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>¿se talla fácilmente o porque los abuelos lo preferían?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a200" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>y las cosas que se emplean en casa como lavaderos y otras cosas ¿también se tallaban o esas se compraban?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a231" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>¿es el mismo árbol?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a232" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>ah ¿este ya no es qa:xi kiwi'?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a233" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>cucharon</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a234" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>y los que se emplean solo como combustible, hay árboles a los que prefieren más que otros, aunque sabemos que todos los árboles los inflamables</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a235" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>¿por esa razón no lo ocupan?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a236" ANNOTATION_REF="a206">
                <ANNOTATION_VALUE>ah... ¿por eso no utilizan lhalhne'?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a249" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>ah..¿para hacer casas?,¿cómo lo empleaban?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a250" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>ah</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a255" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>y ¿qué otros árboles conoces que se ocupan como alfardas, en las goteras, para techar o para paredes de las casas? </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>¿akxan?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a262" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>¿y para las trabes que árbol se empleaba?¿y para las alfardas solo se ocupa el helecho arborescente o hay otros árboles que se pueden usar?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a266" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>entonces podemos decir que ¿los más pobres empleaban el helecho arborescente y los que tenían más dinero podían adquirir lo mejor?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>¿y para eso que árbol ocupaban?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>liquidambar ¿y para las trabes?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>y para las paredes de la casa, ¿se ocupaba el mismo árbol o era otro el que se empleaba para cercar?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>¿y aquel que tenía un poco más?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a283">
                <ANNOTATION_VALUE>se dice que hace mucho todas las casas de madera tenían un zarzo, un lugar donde se guardaban las cosechas, ¿de que material lo hacían?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>¿y eso con que lo hacían?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a302">
                <ANNOTATION_VALUE>hay casas con paredes de carrizo, ¿es exclusivo para las personas de menos recursos o es solo para corrales de gallinas o jaulas de animales?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a303">
                <ANNOTATION_VALUE>y por último, para techar la casa ¿que material empleaban? </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a315">
                <ANNOTATION_VALUE>hace rato hablabas que tánchachu' lo ocupaban en los amarres como laso, ¿conocerás otra hierba o árbol, que también han sido empleados para realizar amarres?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a323">
                <ANNOTATION_VALUE>¿ocupaban solo estos dos?¿tánchachu' y jonote?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a327">
                <ANNOTATION_VALUE>¿y para eso que se ocupaba?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a333">
                <ANNOTATION_VALUE>¿solo es esta liana u ocupaba algún otro?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>¿kaxapat?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a340">
                <ANNOTATION_VALUE>hace rato comentaste que del jonote se extraía el laso para hacer los huacales, y para el contorno del huacal ¿que material se emplea, es una liana o un árbol flexible?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>se dice que el huacal tiene algo así como dos utilidades, se usaba en la cosecha de maíz para acarrear las mazorcas y como cuna para bebés</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a353">
                <ANNOTATION_VALUE>¿es el mismo modo para su elaboración o son dos formas distintas, una para los niños y otro para las cosechas?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a359">
                <ANNOTATION_VALUE>todo los materiales son los mismos, solo que este es más pequeño</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a363">
                <ANNOTATION_VALUE>¿solo esto ucupaba para cuidar a los bebés?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a367">
                <ANNOTATION_VALUE>y hablemos del nacimiento de los bebés, se emplean varías hierbas para lavarlos contra las enfermedades o para bañar a las madres</ANNOTATION_VALUE>
