            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>pues asta u:ku:nu chana xa:nchu lhi:lhaqapasa tachixkwi:tati pi, aqatami nu xatsama:ti xanat aqatami nu xaqawasa ni:ma:ni ni lhustlha:ni paqlh</ANNOTATION_VALUE>
