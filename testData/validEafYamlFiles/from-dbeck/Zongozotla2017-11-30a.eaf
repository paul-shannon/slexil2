                <ANNOTATION_VALUE>pues chana nayma kilhtsukuni:ti iyma xa xa xa leyenda iyma iyma xanat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>por eso wayma xanat lhu:wa ni tawalhiyi xa palha kah ka katsutsu:w, anqalhi:ni xa anta lhakamintawalha ksipih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>wa xanchu lhi:wanikani qalhwantalhaqajuy porque kah xtasa talhaqajuma:qo:chi akxni wa:ma ni:lha taktaqo:lh pero ka qas ti ki maqaxtaqo:ka xanchu ksipih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>kax tasawalhaqo:lhi xa:nchu nilh nilha:nu taktaqo:lh kumu lhaktsuku xwanqoni:ti:no</ANNOTATION_VALUE>
