        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>wa:ntu lhikwa xmaklhakaskinqo:yi lhak ta:tahna' wa:xa lhi:mah eh...wa xakiwi lhi:mah ni:ma slhapwa na lhqotika:n wa xa:nchu tlhaq pa:lha', pero, lhu:wa' ti:pa lhu:wa xmaklhakaskinqo, xmaklhakaskinqo xmakasiyin wa:ya', wi na:ma miya:k </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>entonces, na xlhi... lhu xlhi:tlhawaqo:yi chu xa... xastilhi:t xwaniqo:y xastilhi:t chu:na na lhkaqo:yi:nchu iyma palha tlhanka lhaqatiqo do:se kuarta, die:s kuarta, nue:be kuarta,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>o:cho kuarta, tlha:ntlha xlhaqati:qo:y kak lhkaqo:y, entonces, cha:nchu xtlhawaqo:yi kstilhi:t kan wa:nchu na lhi... wa:nchu na lhi:lhakachiqo:yi iyma xu:nik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>wa ni:ma xa xlhi:xqa:nankan lhaktlhanka xa' wa:xa xa do:se, xa do:se kuarta xwaniqo:yi lhaktlhanka, lhaktlhanka wahkat wa xa:nchu kah puxqa:nankan,  wa:nchu wa kah xlha sqata' tlhaq kah lhaktsu xa:nchu</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>wa:n kah xpu:kukakani sqata', pero, na watiya xa:nchu eh... xu:nik chu:n kiwi' paksa wa xa:nchu este na pu:kukuqo:kani sqata'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>kah wa:ma... kah tlhaq aktsuwi xlha sqata', wa:nchu wa lha puxq:nanka:n este spu:tiyikani kuxi' xa tlhanka xa:nchu wahkat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>paks wa xa:nchu iyma wa xa:nchu wahkat anta xa:nchu xmujuqo:kán cha:nchu katu:wa katu:wa xlhi:maklhakaskinqo:y xpu:tiyiqo:yi iyma nipxi', xpu:tiyiqo:yi seqna', xpu:tiyiqo:yi maqa:sa xchanqo:kani uyim</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>paks anta xki mujuqo:kani iyma wahkat, katu:wa xlhi... lhu:wa xmaklhakaskinqo:kán eh... xpu:kukananqo:kán</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>wa akxni na chini sqata' este na chaqe:kán wa:xa na lhi:chaqe:kani ji:ni', ji:ni' tawa:ni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
