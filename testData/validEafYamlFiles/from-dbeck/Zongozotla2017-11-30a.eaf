        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>pues chana:no kilhtsukuni:ti xtakawani eh... lhaq.. osa xa tsama:ti iyma xanat lhi:lhaqapasa:w chunchu cha:tami xa qawas</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>wa xa:nchu iyma maqstawani:y porque na watiya:n chux na lhu:chana  xta:chana xa xanati lhantlha iyma qalhwantalhaqajuy kawaxanchu xa lhaktsu:w por eso wa xa:nchu lhi:wanikani lhaktsu qalhwantalhaqajuy</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>peroh anta xa:nchu kilhtsukuni:ti xtakawani wayma xa tlhanka qalhwantalhaqajuy</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>kawaxa:nchu cha:na lhi:lhaqapaska:n porque na nachana:nchu paqlh chu:na kah tawalhiyi jkiwi' chu na:ka nu:ma lhakamintawalha:nchu ni maqstami xa ka ti uxkilhti palha aktsa yah sinoke anqalhi:n kah talhaqaju xa:nchu por eso wa lhi:wanikani qalhwantalhaqajuy </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>pus wayma tsinkulho pa:tax usa talhaqa:n wanika:n porque wayma aktsu aktsu xanat wi aqtami na:ma aktsu talhaqa:n qalhiyi xlhaqastap chux este paksi xlhakán por eso wa:nchu lhi:wanikani talhaqa:n xwaniqo: maqa:sa lhak ta:tahna'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>u:winchu tin tsinkulho pa:tax lhi:lhaqapa:s pero watiya ayma xanat chu tipalhu:wa' winchu nima na:ma lhaktsu pa:tax lhi:tami ayma este na:watiya:nu stlha:ni palhqo:y por eso cha:na:nchu lhi:lhaqapaskani tsikulho pa:tax pi ka  ka tsinkilha tawalhah </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE> wa:xa xanati maqstawaniyi iyma tsinkulho pa:tax porque kah kah stlha:ni tawalh... takaxtawalhi iyma xanat casi en forma de patito xa:nchu tawalha por eso wa:chu china lhi:waniqo:yi lhak ta:tahna' tsinkulho pa:tax asta u:ku kini cha:na lhi:lhaqapasa:w </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>aja, por eso ka wa:nchu a:maqapitsi:ni xanatinchu ka nilh nilh lhaqapasqo:yi:nchu ka paks chana:nchu waniqo:yi tsinkulho pa:tax ni:ma xta:chana tasiyóh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>pero walhapa:no xanati ni:ma xkaki xanat waniqo:y na na watiya xa:nchu xnata:lhani ayma tu lhaqapasqo:kani tsinkulho pa:tax</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>pero tanaja xa:chu paqlh usa ka sanaka xa:nchu paqlh wa xa:nchu lhi:wanikani xkaki xanat, porque ka sananka xa:nchu iyma xka:k wa:ntu wakán</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>entonces, anta xa:nchu iyma kilhtiqo:yi xtakawani, porque wayma xka:ki tu waka:n ka sananka xa chow, entonces, wa:nu lhi:wanikani iyma xanat xkaki xanat, cha:nchu stlha:ni kankanlhah, entonces wa:xa:nchu maqstawaniyi iyma...  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>tlha:ntlha kankanlha xka:k cha:nchu xanat, entonces, anta:nchu kilhti:ka xtakawani xkaki xanat wanika:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>watiya xa:nchu waniqo:kán pero watuwa:nchu lhu lhu lhi:lhaqapaskani xkaki xanat wa:xa xasananka', sananka pqlh wa:nchu wa otros ka xasnapap xa xaxqoni:wa' pus tanaja xa:nchu tanaja color xa:nchu pero watiya wa xtakawani'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>wa xa:nchu maqsta waniyi ma:yoh xanat porque lhu akxni xa:nchu paqlha ma:yoh, ma:yoh xanat wanika:n lhi:lhaqapaskani:ncho porque akxni tsukuyi ma:yoh akxni xa:nchu lhikwa paqlha iyma xanat, entonces, anta:no kilhtiqo:yi iyma este xtakawani pi ma:yoh komo ma:yoh paqlh entonces ma:yoja ma:yoh xanati:nchu lhi:lhakapaska:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>lhu:wa walhaqo:lh naychu na paqlhpalha makskat xanat, na ma:yoh xa:nchu paqlh, chana:nchu na chana:nchu lhi:lhaqapasqo maqapitsi na ma:yoh xanat lhi;lhaqapasqo:y, pero u:ma kini:nchu wi kini:nchu xtakawani' makskat xanati kini:nchu lhi:lhaqapasa:w, porque na ma:yoh xa:nchu paqlh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>en ma:yoh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>anani xa:nchu xaspupuk pero nilh ma:yoh waniqo xa:nchu porque ni ma:yoh xa:nchu paqlh,pero wa xa:nchu xta:lha xa... spupuk  xaspupuk wa:nchu wa ma:yoh xanat waxan:chu lhu:lhilhaqapaska:ni xasananka porque mero ma:yoh xa:nchu paqlh, wa:nchu wayma xa xaspupuk tanaja mesi xa:nchu paqlh ni:lhu lhaqapasa xa:nchu tachixkwi:tat pero na:wa xa:nchu xta:lha'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>wa xa:nchu lhu xlhakaskinqo:yi lhaj lhak ta:tahna kumu ni:na xanani iyma este palha lhi:qama:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>pus lhikwa xpatsaqo:yi iyma chu lhak ta:tahna tu lhi... nama:lhiqamaniqo xlhaqsqata:n, xanqo:yi xka:qoy xkiwi makskat xanat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>stlha:ni iyma kiwi ni panq, chu akxni naska:k stlha:ni na makawa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>kxqalhi ksonido iyma kiwi, lhu akxni na lhi:qamananka:n stlha:ni kalhaks kalhaks namakawa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE> entonces, wa xa:nchu lhi:lhaqatiqo:yi xlhi:lhaqatiqo:yi iyma este natlha:tna' xlhakaskinqo xa kiwi'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>nilh lhu:lhakaskinyo:nchu wa:uku este palha lhaqsqata:n porque kah tamawaniqo:kani xlh:qama:n kan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>pero wa:nchu wa maqa:sa lhu:wa xa:nchu maklhakaskinqo:yi lhak ta:tahna lhux kaqo:y na... na:malhiqamaniqo:yán</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>a:a' lhaqapa:s katuwa klhi...chu klhaqapasa lhalhne', lhux maklhakaskinqo:yi iyma akxni kini:nu xstakwi xtlhawaqó xa yantah nu:mah yantah wa xlha lhalhne'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>ka nalh pi:ta nu:ma:xi xa yantah na lhaqlhiki:ya', nawalhinikani:nu xa xa tama', na walhinikani chu:xa xa yantasi lhalhne'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>wa:no na lha:puxwataqo:kani ktlhanka:ti ni:na pavimento xwani:t kahku ni taka:slham, pero anta:ni ka:tlha:n anta:nchux xtalhatamaqo:yi paksi lhaqsqata:ni xtalhatamaqo:yi kxwataqo:yi iyma  aktsu ka:rro lhi:lhaqapasqo:y</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>usa aktsu pu:tlha:wi xwaniqo:y, pero, wa:xa:nchu xlha yantah xlha lhalhne'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>ka lhakstilhilhi:wán aqta:ti nawalhinikani tama', na lha:puxwataqo maski lhak chixkwi:na'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>paks wa:ntino ti lhakchixkwina tlhaq lhaktlha:ka xa xtlhawaqo xa yantah, na lha:ta... na lha:lhtanlhiqi:yi ktlhanka:ti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>cha:na xa:nchu na:ma xqamananqo porque ni:tu xana:ni lhi:qama:n ni:tu xana:ni palha tu lha:ntlha u:ku lhaqapasa:wi palha juegos meka:nicos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>ni:tu xana:n ka xkaxtlhawaqo:kani lhi:qama:n, balero, trompoh, lhu:wa tux lhi:qamananqo:kán</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>wa xa:nchu balero wa xa:nchu lhikwa xlhi:tlhawaqo:kani palha palha akxwat,akxwati xa kiwi'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>na:ka nalhpita' nakaxtlhawaya mi... mi balero, na lhi:qamanana lhikwa xlhi:qamananqo:kán xlha:lhitlhajaqo:y</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>wi:nti lhikwa xkatsiniqo xma... xmaqamaniqo:yi u:ma xya:waqo kxmaka:n kan, entonces, paks ka xkaxtlhawaqo xlhi:qama:nam kan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>ni... niksta:kani lhi:qama:n ka xkaxtlhawaqo:yi balero, xkaxtlhawaqo:yi trompos, xkaxtlhaqaqo:yi paksi lhi:qama:n kan, munieko xtlhawaqo:kani xlha kiwi'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>wi ta:noh kiwi' wi:ti xtlhawaqo:yi palha xlha akxwat porque na:ni panq stlha:ni:n maxki:kani figura, lhu:wa xmaklhakaskinqo kiwi'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>cha:nchu walhapa:n kiwi chu:n qa:xi kiwi', anta xa:nchu mini:ti xtakawani qa:xi kiwi' lhikwa xmaklhakaskinqo lhak ta:tahna wa:xa xtlhawaqo:yi xta:xtikit kan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>tux xlhaktawalhaqo:yi lhak ta:tahna wa xa:nchu ma:n kiwi qa:xi kiwi' cha:tlhanka na ka:kán na lhpitqo:no na tlhawaqo:no xta:xtikit kan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>ka:ni kumu ni:tu lhani nix panq cha:nchu ni... ni tsinka xwa:ni akxni ska:k stlha:n xwa:ni iyma este qa:xi kiwi'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>xmak lhakaskinqo xlhak... xlhak tawalhaqo:y wa xa:nchu iyma este xlhaksajqo:yi kiwi ni:ma ni tsink chu xu:nik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>xu:nik na:wa lhi:tlhawaqo:y iyma lhaktsu xlhaktawi:lh kan, ni:tu xana:ni nik sta:kani:nchu siyah ni:na tu xananqo:yi u:ma eh... palha lhakwani iyma tu</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>lhaktawalhaqo:kán paks ka kaxtlhawaqo:yi xlhaktawi:lh kan xlha... paksi tu:na lhaktawalhaqo paks wa xkaxtlhawaqo wak kxlhpitqo:y</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>na:ka klhpitka:n anta mini:ti xtakawani iyma kiwi qa:xi' porque kiwi' kiwi xa:nchu ka:wa xkikani:ti nu:ma xkaxtlhawaqo:y, entonces,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>eh... klhpitqo:yi chu xmaklhakaskinqo:yi:nchu iymax palha xpu:lhaqchaqe:n kan usa lhqomaqo:yi xma:sah kan kskitit kan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>xpu:sta:kani palha lhakswayim paks wa xa:nchu iyma xmaklhakaskinka:n cha:nchu este palha xlhi:lhtoq kan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>paks wa xa:nchu xka:qo:yi wa xa:nchu kukut xka:palhaqo:y</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>ni:wa xa:nchu qa:xi kiwi' wa xa:nchu kukuti na ka:kani:nchu na maxtakani:nchu xa lhi:lhtoq, wa xa:nchu este tasani: kukut</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>tasani: kukut usa oqsmiya:k, wa:nu iyma stlha:ni este stlha:ni:na tasqa:y wa iyma oqsmiya:k</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>wayma stlha:ni tasqa:yi kukut, entonces, maxtakani:nchu lhi:lhtoq, paksi:nchu xlhilhtoqoqo:kani palha este lhi:wa:y</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>usa na lhilh... nalhakaskinkani palha eh este na lhilhtoqo:kani palha qawi:t, paks wa xa:nchu iyma xkaqo:y</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>porque wi xa:nchu ni:ma este tlha:n kiwi', por ejemplo:no kukut wa xa:nchu tlha:n kiwi' kah lhisqonka:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>chumpalha este wa ni:ma palha lhakpalha kiwi', wi:nchu ni:ma kiwi' ni maklhakaskinqo:kán porque wi ni:ma ma:ti ni tlha:ni kiwi', por ejemplo, lhalhne',</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>ni:ti lhakaskini xa xakiwi' porque mat lha:qalhi wa xa jini', lha:qalhi:nán na lhakpitanuya:n na lha:qalhiya:n na malhaqaxoqeya:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>wa xa:no ni lhi:maklhakaskinkani lhalhne', porque ni:n wa xajini asta mat paksi palha min taqalhi:n, palha qalhi:ya mi xtilha:n na ma:lhaqaxoqeqo:y</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>wa:xa ni:lhi maklhakaskinkan wa:nchu wa ni:ma lhaqapasqo pi tlha:n kiwi' wa xa:nchu xlhajkaqo:y wa xa:nchu palha kukut, lhkutapiks,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>aqxu:nan kiwi', lhilhpatat, qo:ma', wa xa:nchu maklhakaskinqo:yi este iyma lhajkaqo:y</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>chu:n qo:ma' lhikwa maklhakaskinkani iyma lhi:tlhawakani chiki'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>wayma xwaniqo:yi poqche' xwaniqo:yi lhak ta:tahna' paks wa... paks wa xa:nchu xmaklhakaskinqo:yi eh... palha kxaqsiti:n xchij kan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>kumu kah karto:n, usa kah te:ja xmawakaqo:y pus wa xa:nchu iyma maklhakaskinkani kiwi qo:ma', porque, lhakslhapwa:ni stak </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>wa xa:nchu lhikwa na maklhakaskinqo talhiya:w wa xa:nchu xmaklhakaskinqo akxan, akxan wa ni:ma este kxchastu:ni tayiqo:yi xatalhiya:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>anta:ni taqlhpawakaqo:yi patsi:na' xwaniko:y, entonces, wa:nchu wa akxan porque ni ma:sa xa ni kapalha mas</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>wanwa akxan, cha:nchu wa:nti xqalhi tami:n ka xma:chukinani kukut, kukuti na:wa talhiya:w xwanikani iyma este xmaklhakaskinqo:y, pero, wa:nchu ma:n kukut kah xchukukani xa:nchu</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts264">
