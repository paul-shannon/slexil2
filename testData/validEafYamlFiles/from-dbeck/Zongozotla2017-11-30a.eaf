        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts329" TIME_SLOT_REF2="ts330">
                <ANNOTATION_VALUE>este xlhi:qalhchiqo:yi xwaniqo xtalhiya:w kan na lhakachi:wakaqo:yi anta:ni qalhnu nu:ma na lhi:chiwakaqo:yi xkiwi kan wa xa:nchu iyma miya:ki xalhaj ka:kiwi:n</ANNOTATION_VALUE>
