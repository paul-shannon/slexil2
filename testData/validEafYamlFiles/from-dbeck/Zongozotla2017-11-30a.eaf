            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>lhu:wa:no walhaqo:lhi nima:chi watiya tasiyiqo:yi xanati lhi:kaxtlhawananqo:kán, walhapa:no ni:ma ma ma ka xalhaklhma:ni na lhikwa lhikwa paqlha akxni:ma kalhkakna' tu wanikani ma:yoh xanat na watiya xa:nchu xnata:lhani na lhaqatiqo:kani lhi:kaxtlhawananqo:kán xpa:lhakata:no pi:na stlha:ni iyma xa tlha:ntlha kankanlha chu:nu stlha:ni tasiyóh xa xanati axni paqlh</ANNOTATION_VALUE>
