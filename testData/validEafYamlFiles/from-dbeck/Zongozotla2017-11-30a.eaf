        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>i wa:no wanqo:yi lhak ta:tahna pi chana ku tasaqo:yi akxni akxni paqlhqo:yi ayma:chi lhaktsu xanat, chu na akxni na akxni lhi:taminu lhikwa ma:si:ninanqo:y</ANNOTATION_VALUE>
