            <REF_ANNOTATION ANNOTATION_ID="a626" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>el fiscal y los topiles y los mascujunus , todos se juntaban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a627" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>ahora después ese …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a628" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>cuando llega el doce de diciembr</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a629" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>cuando va a salir la Virgen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a630" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>empezaban a sacar la Virgén donde llegaba con la estatua</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a631" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>hacían tamales</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a632" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>y iban los huehues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a633" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>esos (los huehues) que juntaban en su casa del jefe de los topíles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a634" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE></ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a635" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>buscaban los vestidos o las máscaras</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a636" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>pantalónes, porque hace mucho no eran muchos que tenían pantalónes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a637" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>puro calzón habían puestos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a638" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>después ahora, pues ese …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a639" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>terminaba … la posada </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a640" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>a los que llaman a la faena los autoridades les daba de comer </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a641" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>todos allí iban las policias y topíles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a642" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>todos se juntaban allí y los regidores les daban de tomar en la presidencia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a643" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>entonces, los menores (los que hacían su primer cargo), esos … los mascujunus</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a644" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>los viejos jefes están en las casa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a645" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>y a los menores los mandan y los mandan a servir </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a646" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>ese … las autoridades les daban refino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a647" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>y si no quieres tomar el refino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a648" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>pues, si estás todavía un muchacho y todavía no te gusta tomar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a649" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>a fuerza te van a hacer tomar las autoridades</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a650" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>allí te empiezas a acustumbrar a tomar [vowels good]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a651" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>y si no quieres tomar, a fuerza te van a dar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a652" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>te van a querer dar los regidores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a653" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>si no te lo tomas ese refino, te van a mandar a encerrar, te mandan al bote</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a654" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>entonces, pues, ese … ese después, pues …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a655" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>pues, todas las autoridades están bien borrachos cuando ya llega las cuatro (de la tarde) o … a sí, las cuatro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a656" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>va a llegar la hora, van a ir, los van a llamar, allá van a invitar los a comer en la casa de los que llaman a la faena</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a657" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>entonces en la casa del {} ahora todavía les hacen tomar otra vez, les dan refino y cerveza</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a658" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>todo les daban de tomar, ese y después</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a659" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>se les daba la lista de los que le van a entrar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a660" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>el nuevo topil, el nuevo regidor, el nuevo fiscal teniente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a661" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>se le daba la lista al presidente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a662" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>ués, después ahora, ese …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a663" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>venían a la presidencia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a664" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>se había dado la lista, pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a665" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>se les empezaba a decir quienes van a ir como el jefe de los mascujunus y quien va a ir como jefe de los topiles, quien de fiscal teniente, quienes van a ir</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a666" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>pues, todos las policias y los topiles y los fiscales y ahora</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a667" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>todavía todos van y buscan a quienes van a entrarle</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a668" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>uno por uno los iban encontrando pasaban a traer, los que iban encontrando, los mandan a llevar a la presidencia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a669" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>estaban echando cohetes, estaban echando cohetes, y aparte estaban repicando (la campana)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a670" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>y aparte pusieron las cámparas, como sonaban, sonaban (hacían sonar)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a671" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>despues, fueron otra vez a buscar los que faltaban (que no podían encontrar)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a672" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>así traía cada uno</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a673" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>iban echando cohetes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a674" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>debía de ser bonito, ellos sabían como estaban haciendo, porque …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a675" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>bueno, también yo lo veo bonito, porque … </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a676" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>también yo serví en este cargo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a677" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>hace mucho así hacían</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a678" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>ahora despues vienía el 25, pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a679" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>ese …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a680" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>esos ya iban a ir entregando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a681" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>van a llevar plumas y huesos de pollos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a682" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>todo que está podrido, ese … ese olla </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a683" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>cualquier cosa que metía en la olla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a684" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>le llevaba a el que iba entrar como jefe de los mascujunús, allí lo llevaban otra vez</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a685" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>ahora se vestían los dos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a686" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>las … personas que buscaban, los que ponían nahuás</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a687" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>ahora buscaban a una persona que llevaba vestido</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a688" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>y ese llevaba el incenso [los de nauhuas (2) llevaban pukilhku, y el de vestido echaba incienso]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a689" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>ese …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a690" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>llevaban a uno que estaba llevando incienso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a691" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>uno de los huehues iba poniendo el incienso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a692" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>llevaban el incensario allí donde van a entregar los cargos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a693" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>y ahora doce veces entraban y salían de la casa, los que llevaban nahuas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a694" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>iban echando refino en los temazontles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a695" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>después ahora en el patio otra vez está parado el que sirve el refino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a696" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>se les van a dar, les iban dando así cada vez que estaban entrando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a697" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>les daba ahora salían otra vez y les daban otra vez</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a698" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>así como están bailando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a699" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>he: así, ese … ya estaban tocando, los que tocan violin y guitara</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a700" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>estaban tocando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a701" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>ahora ese, ahora después ese</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a702" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>ahora regresaban a la iglesia, ahora iban otra vez, iban otra vez a bailar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a703" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>entonces salían, doces veces también volvieron a entrar y doce veces volvieron a salir</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a704" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>también estaban echando allí refino y así iban poniendo incienso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a705" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>después, se terminó ahora …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a706" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>fueron a la casa de él que está saliendo [el viejo puxku]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a707" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE></ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a708" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>ya no más comen mole</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a709" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>y se lo lleva a (las casas de) esos que ponen nahuas, a los que buscaron (para poner nahuas)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a710" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>ahora despues, pues, terminaron</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a711" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>pues, al otro día, pues … nada más ahora comen el caldo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a712" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>ya tomaban esos que ya estaban saliendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a713" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>ya no tienen nada por que preocuparse</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a714" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>pues, se dispersaron a sus casas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a715" ANNOTATION_REF="a189">
                <ANNOTATION_VALUE>ya no se juntan después porque ya entraron los nuevos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a716" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>el mascujnú allí terminaba ese</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a717" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>ahora, va a llegar otra vez el año nuevo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a718" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>el viejo fiscal (el que termina su cargo) va a da de comer otra vez ya que es es el fin del año</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a719" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>va a volver a dar de comer igual que otra vez hicieron</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a720" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>también levantan todos los huesos de pollo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a721" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>los huesos de …, los huesos de …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a722" ANNOTATION_REF="a196">
                <ANNOTATION_VALUE>los huesos de pollo, y las plumas de pollo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a723" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>y ahora lo llevaban ese, parece que buscaban su bordón</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a724" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>una planta de plátano tierno que no se ha abierto </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a725" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>le amarraban ese, esa flor que se llama la nochebuena</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a726" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>eso amarraban y llevaban los que eran los meros púxkus (fiscales viejos)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a727" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>otra vez le iban a devolver, cuando ahora cuando fueron otra vez a entregar los cargos en la casa del  viejo fiscal</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a728" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>quebraron y disperaron ese que … todo que volvieron a traer todos los fiscales</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a729" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>después ahora ese …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a730" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>ahora van a terminar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a731" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>pues, ese también, ese, vuelven a aparecer en la iglesia, todos van allí otra vez</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a732" ANNOTATION_REF="a206">
                <ANNOTATION_VALUE>todos van otra vez y entregan los cargos y salen de la iglesia otra vez</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a733" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>bailan otra vez y van ahora donde va a salir el que ya es el viejo fiscal</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a734" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>allá empiezan a tomar otra vez</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a735" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>así ese … termina todo y ya está</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a736" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>ya han entrado los nuevos fiscales</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a737" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>el viejo fiscal ya ha entrado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a738" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>ya no van ahora, despues ellos, pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a739" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>cuando va a llegar otra vez la carnaval</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a740" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>a los dos meses buscan a un palo hueco</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a741" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>hacen parece un tambor hacen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a742" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>ahora buscan ese … hacen ese …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a743" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>buscan la piel de este … tejón, la piel de cualquier animal </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a744" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>empiezan a requintar allí este …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a745" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>en su parte de abajo, así en sus pies, lo con que amarraban y así se requintaba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a746" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>después a los ocho o quinze días empiezan a hacer lo sonar, (a ver) si ya está seco </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a747" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>cuando un mes estaban viendo si se ya se secó</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a748" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>pues poco a poco empezaban a ir tocándolo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a749" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>entonces cuando llegó el carnaval</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a750" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>llevan ese … ese tambor en ese … en el techo de la iglesia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a751" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>empiezan a subir allí tocando, como que decían antes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a752" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>parece muy de la mañana hacen con eso, empiezan a tocar arriba en el techo de la iglesia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a753" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>después en el techo de la iglesia ahora</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a754" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>toda la noche tamboreaban arriba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a755" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>pues, &lt;bajan ahora … no&gt;  el refino que llevaban empezaron a tomar arriba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a756" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>después bajan, pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a757" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>y ahora en la mañana ahora también van a empezar a reunirse</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a758" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>también vienen los de Tecpatlan y los de Cuatechalotla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a759" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>los de Cuaxalotla y los de ese … Cacahuatlan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a760" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>y los de Chicontla venían todos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a761" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>tomaban el refino porque … es la caranaval cuando lo hacían </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a762" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>compraban, los autoridades compraban dos garrafónes de refino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a763" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>y compraban los fiscales un garrafón y también ellos volvieron acomprar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a764" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>y el faena guys compraban otra vez así también compraban una garrfón más</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a765" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>entonces, el refino, ese …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a766" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>cuando empezaban a reunirse a como las diez</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a767" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>ya habían amarrados todos esos que se llamaban toros</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a768" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>ponían en las espaldas los costales y bascaban los girasoles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a769" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>y los ponían en los toritos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a770" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>después ahora, pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a771" ANNOTATION_REF="a247">
                <ANNOTATION_VALUE>van a llevarlos ahora al centro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a772" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>los viejos fiscales les empezaban a tocar el tambor</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a773" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>cuando van a empezar a tocar el tambor, van a venir</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a774" ANNOTATION_REF="a250">
                <ANNOTATION_VALUE>van a salir los huehues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a775" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>esos que … que atrapaban con laso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a776" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>entonces todos estaban parados en el patio de donde se jugaba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a777" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>cualquier persona nada más empezaba a ponérselo en la cabeza</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a778" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>llegaban y los ponían en las cabezas y empezaban a cornear con ellos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a779" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>después, pues, con eso se les hacían caer uno a otro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a780" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>o si se rompieron las bocas unos a otros o si se picaban las caras</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a781" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>todas las cosas nada más hacían con eso porque estaban borrachos, ya no se respectaban/no se daban lástima</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a782" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>como se jugaban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a783" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>después pues, las personas de todas partes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a784" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>pues, a todos les daban refino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a785" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>hasta las mujeres de Tecpatlan </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a786" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>todos tomaban refino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a787" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>así venían ya sabían cuando iban a hacer el carnaval</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a788" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>pero a todos se reunían, no había nadie que no viniera</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a789" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>la'hwá: la: ta:wama:ka' kúchu', sikáru, pó'htu </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a790" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>todos hacían, convidaban refino, cigarros, todo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a791" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>andaban el que servía el refino y el que daba los cerillos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a792" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>entonces, a ellos les daba gusto venir los de Cuatechalotla, los de Tecpatlan, los de Cacahuatlan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a793" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>todos como se juntaba harta gente, se hacía así, muchos festejaban la carnaval</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a794" ANNOTATION_REF="a270">
                <ANNOTATION_VALUE>ahora, después, ahora</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a795" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>el otro día otra vez hacían igual, así llevaron otra vez el refino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a796" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>nunca faltaba lo que tomaban en el centro porque están haciendo fiesta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a797" ANNOTATION_REF="a273">
                <ANNOTATION_VALUE>a todos no más convidaban el refino hasta los que estaban mirando desde lejos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a798" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>les daban a todos como hacían un circúlo con el refino y los cigarros</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a799" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>a todos le dieron, no había nadie a quien no dieron</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a800" ANNOTATION_REF="a276">
                <ANNOTATION_VALUE>muchos se juntaron, y …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a801" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>parece yo cuando estaba pequeño</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a802" ANNOTATION_REF="a278">
                <ANNOTATION_VALUE>lo veía bonito como hacían</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a803" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>todo ahora cuando ahora va a llegar otra vez ahora ese … semana santa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a804" ANNOTATION_REF="a280">
                <ANNOTATION_VALUE>van a cortar el tarro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a805" ANNOTATION_REF="a281">
                <ANNOTATION_VALUE>todos los que tenía cargos iban a cortar el tarro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a806" ANNOTATION_REF="a282">
                <ANNOTATION_VALUE>después odos llegaron con el tarro en la tarde</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a807" ANNOTATION_REF="a283">
                <ANNOTATION_VALUE>lo amontanaron detrás de la iglesia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a808" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>después … ese … </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a809" ANNOTATION_REF="a285">
                <ANNOTATION_VALUE>ahora cuando va a llegar el primer viernes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a810" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>a todos los fiscales avisaban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a811" ANNOTATION_REF="a287">
                <ANNOTATION_VALUE>van a buscar palmilla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a812" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>van a buscar el flor de plátano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a813" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>entonces, más antes </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a814" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>he visto ese … las muchachas jovenes que … que todavía no pedían</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a815" ANNOTATION_REF="a292">
                <ANNOTATION_VALUE>iban a coser en la iglesia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a816" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>levaban flores, ese … ese que le dicen simpasuche</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a817" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>muchas cosián, muchas muchacha iban a coser</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a818" ANNOTATION_REF="a295">
                <ANNOTATION_VALUE>llevaba sus canastas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a819" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>todas llevaban sus agujas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a820" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>terminaban de coser ahora</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a821" ANNOTATION_REF="a298">
                <ANNOTATION_VALUE>pués, este, ese …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a822" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>el mascujunú</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a823" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>hicieron unas cruces</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a824" ANNOTATION_REF="a302">
                <ANNOTATION_VALUE>hicieron unas cruces los mascujunús</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a825" ANNOTATION_REF="a303">
                <ANNOTATION_VALUE>van a ponerlas en la calle, donde las ponen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a826" ANNOTATION_REF="a304">
                <ANNOTATION_VALUE>después ahora ese … en la tarde ahora …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a827" ANNOTATION_REF="a305">
                <ANNOTATION_VALUE>pusieron el taro … ya se le han puesto esas … palmillas y flores como</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a828" ANNOTATION_REF="a306">
                <ANNOTATION_VALUE>como se amarraban a lo largo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a829" ANNOTATION_REF="a307">
                <ANNOTATION_VALUE>ahora, van a volver a buscar ese, ahora ese … ese …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a830" ANNOTATION_REF="a308">
                <ANNOTATION_VALUE>el flor de plátano que no le han pelado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a831" ANNOTATION_REF="a309">
                <ANNOTATION_VALUE>esas le colgaban en el punto del taro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a832" ANNOTATION_REF="a310">
                <ANNOTATION_VALUE>pues, es bonito como lo hacían antes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a833" ANNOTATION_REF="a311">
                <ANNOTATION_VALUE>lo he visto cuando todavía era pequeño</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a834" ANNOTATION_REF="a312">
                <ANNOTATION_VALUE>pero … tampoco ahora ya no haven así</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a835" ANNOTATION_REF="a313">
                <ANNOTATION_VALUE>ya se cambió</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a836" ANNOTATION_REF="a314">
                <ANNOTATION_VALUE>ya les da pena porque vienen muchos carros</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a837" ANNOTATION_REF="a315">
                <ANNOTATION_VALUE>y ya no hacen y no hay nada que hacían hace mucho cuando y crecí</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a838" ANNOTATION_REF="a316">
                <ANNOTATION_VALUE>yo vi como hacían</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a839" ANNOTATION_REF="a317">
                <ANNOTATION_VALUE>y es bonito como se hacía, como hacían los antiguos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a840" ANNOTATION_REF="a318">
                <ANNOTATION_VALUE>but … no hay nada de que vuelvan a ponerse de acuerdo porque muchos de los que son jovenes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a841" ANNOTATION_REF="a319">
                <ANNOTATION_VALUE>como los metían en los cargos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a842" ANNOTATION_REF="a320">
                <ANNOTATION_VALUE>empiezan a hacer que tomen, hasta los que todavía nunca han tomado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a843" ANNOTATION_REF="a321">
                <ANNOTATION_VALUE>a fuerza los regidores hacían tomar refino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a844" ANNOTATION_REF="a322">
                <ANNOTATION_VALUE>después, pués, si tú no quieres tomar el refino …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a845" ANNOTATION_REF="a323">
                <ANNOTATION_VALUE>a fuerza te hacen tomar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a846" ANNOTATION_REF="a324">
                <ANNOTATION_VALUE>si no te van a hacer disparar los regidores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a847" ANNOTATION_REF="a325">
                <ANNOTATION_VALUE>y pués como … tú lo vas a tomar porque solamente te esapantan y te dicen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a848" ANNOTATION_REF="a326">
                <ANNOTATION_VALUE>si no quieres tomar, te voy a encerrar te van a decir</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a849" ANNOTATION_REF="a327">
                <ANNOTATION_VALUE>y como tú si estás joven todavía</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a850" ANNOTATION_REF="a328">
                <ANNOTATION_VALUE>pués, vas a tener miedo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a851" ANNOTATION_REF="a329">
                <ANNOTATION_VALUE>es verdad lo que me están diciendo vas a pensar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a852" ANNOTATION_REF="a330">
                <ANNOTATION_VALUE>y porque ellos tienen cargo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a853" ANNOTATION_REF="a331">
                <ANNOTATION_VALUE>pues, por eso nada más vas a tomarlo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a854" ANNOTATION_REF="a332">
                <ANNOTATION_VALUE>pero … mucha gente hace mucho no tomaba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a855" ANNOTATION_REF="a333">
                <ANNOTATION_VALUE>allí enseñan a tomar las persona que están todavía joven, a quienes todvía no les gustaba tomar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a856" ANNOTATION_REF="a334">
                <ANNOTATION_VALUE>ahora dicen los que están más ancianos no han hecho nada</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a857" ANNOTATION_REF="a335">
                <ANNOTATION_VALUE>los jovenes ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a858" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>de verás lo que ellos estaban haciendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a859" ANNOTATION_REF="a337">
                <ANNOTATION_VALUE>pero no está bien lo que estaban haciendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a860" ANNOTATION_REF="a338">
                <ANNOTATION_VALUE>mucho se ha descompuesto</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a861" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>se descompone la presidencia como se movía</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a862" ANNOTATION_REF="a340">
                <ANNOTATION_VALUE>igual con la iglesia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a863" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>ya se estaba cayendo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a864" ANNOTATION_REF="a342">
                <ANNOTATION_VALUE>nadie dice yo voy a componerlo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a865" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>no quieren disparar la gente a pagar una cooperación con que componer la iglesia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a866" ANNOTATION_REF="a344">
                <ANNOTATION_VALUE>así como ya está</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a867" ANNOTATION_REF="a345">
                <ANNOTATION_VALUE>ninguno va a empezar a arreglarla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a868" ANNOTATION_REF="a346">
                <ANNOTATION_VALUE>no quiere pagar la gente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
