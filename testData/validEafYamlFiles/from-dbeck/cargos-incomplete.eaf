    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Text" PARENT_REF="Ex" TIER_ID="Line">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>ka:ma:sto'hkán …  tzamá: …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>[ka:]ma:sto'hkán … &lt;ka:ma:s … lho:&gt; [tzamá:] pi:xká:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>naxchík pi:xká:lh ka:ma:sto'hkán mayú:lhnu' he: pi:xká:lhna', pi:xká:lh teniente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>entonces, tzamá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>[ixta]lhawapa:lá:, tzamá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>ti: ja: taá'n a'ntzá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a353" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>tzamá: …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>tzamá: [x]ma:he:sto'hnikán kú:chu'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>a'htín nakváso [x]wi:li:kán tzamá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>cha:a'túnu ti: ja: [x]tachá:n tzukukán [x]a'hpu:xte'he:nikán ixkú:chu' akxni ja: paláj [ix]chá:n</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>entonces, akxní ja: … akxni xtachá:n chu:wá ixka:ma:wi:ho:'kán kú:chu &lt;tu:…&gt; tu: [ix]ta'hstó'hnitzá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>ti: xtala:wi:la:na:lh xtawate:lhatunká xlakán … xlakán ja: tu: wamá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a359" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>ja:tzá tu: xka:'hxte'he:ya:wa:nikán porque xlakán xtawi:la:na:lhtunká tacha:ní:' akxní ixlá asemblea</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>después, tzamá: … tzamá: akxní tzamá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a361" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>xlho:ho:'kán talaksákni'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>ma'htintzá tahachiho:' ti: … ti: talhawama:'ná:lh tzamá: talaksákni' ho:lú: pi:xká:lh he: pi:xká:lh teniente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a363" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>tama:lhawi:nín tzamá: tasto'hokán xli:pó'htu,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>pi:xká:lh he: mayú:lhnu' he: ma:skuju:nunín, ma'htín tasto'hokán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a365" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>&lt;ento&gt; ali:stá:n chu:wá tzamá:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>akxní chin tzáma: el doce de diciembre [akxní ixakchín ixhelhkajtú: diciembre]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a367" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>tzamá: akxní nataxtú sikwalán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a368" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>tzukú ma:xtukán tzamá: sikwalán ja: li:cha:nkán sikwalán</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a369" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>lhawakán wa'h</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>he: taá'n tzamá: … la'ho:lunún [LB lahaholunin]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a371" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>u:tzá &lt;wamá::&gt; ti: tasto'hokán naxchík ti: púxku mayú:lh</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE></ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>xputzakán tzamá: vestidos o … tala'hánu'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>pantalún porque la'hmajtzá ja: … ja: lhú:wa xhanán ti: … xhalhí: pantalún</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a375" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>wa:'h makya:wá:  xwi:li:kaní:'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a376" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>ali:stá:n chu:wá pus, tzamá: …</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a377" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>xa'hspúta tzamá: … la posada el 24</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE></ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a379" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>ma'htín a'ntzá xa'nho:kán pu:la:siyáxna' he: ma:yú:lhnu'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a380" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>pó'htu tasto'hkán an'tzá tzamá: skujnín [ix]tzukukán ka:ma:ho'tu:kán nakpu:chiwín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a381" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>entonces, tzama … ti: xanastankúnu' … tzamá: … ma:skujunu:nín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a382" ANNOTATION_REF="a36">
