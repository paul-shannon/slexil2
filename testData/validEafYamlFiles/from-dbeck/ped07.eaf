            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann761" ANNOTATION_REF="ann760">
                <ANNOTATION_VALUE>no lo juegues la tapa de mi agua (del tambo del agua).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann765" ANNOTATION_REF="ann764">
                <ANNOTATION_VALUE>sosiégate porque lo vas a manchar eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann771" ANNOTATION_REF="ann770">
                <ANNOTATION_VALUE>yo te voy a pegar si no obedeces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann774" ANNOTATION_REF="ann773">
                <ANNOTATION_VALUE>para qué lo jeugas ese don?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann780" ANNOTATION_REF="ann779">
                <ANNOTATION_VALUE>para qué lo juegas?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann787" ANNOTATION_REF="ann786">
                <ANNOTATION_VALUE>por qué (no quieres jugar)?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann803" ANNOTATION_REF="ann802">
                <ANNOTATION_VALUE>no lo agarres eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann835" ANNOTATION_REF="ann834">
                <ANNOTATION_VALUE>ya canta ahora don.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann841" ANNOTATION_REF="ann840">
                <ANNOTATION_VALUE>ya canta ahora.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann844" ANNOTATION_REF="ann843">
                <ANNOTATION_VALUE>no quieres cantar?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann878" ANNOTATION_REF="ann877">
                <ANNOTATION_VALUE>ya vete tú allá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann895" ANNOTATION_REF="ann894">
                <ANNOTATION_VALUE>ahora vete a jugar don.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann903" ANNOTATION_REF="ann902">
                <ANNOTATION_VALUE>no sirve agarrarlo, para qué lo quieres, lo vas a hacer tu comida?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann908" ANNOTATION_REF="ann907">
                <ANNOTATION_VALUE>rápido anda juega.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann918" ANNOTATION_REF="ann917">
                <ANNOTATION_VALUE>después.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann921" ANNOTATION_REF="ann920">
                <ANNOTATION_VALUE>qué vas a hacer tu comida?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann929" ANNOTATION_REF="ann928">
                <ANNOTATION_VALUE>no está.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann938" ANNOTATION_REF="ann937">
                <ANNOTATION_VALUE>sí le pega?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann949" ANNOTATION_REF="ann948">
                <ANNOTATION_VALUE>Pedro, a dónde vas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann958" ANNOTATION_REF="ann957">
                <ANNOTATION_VALUE>Pedrito ahí vienes?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann963" ANNOTATION_REF="ann962">
                <ANNOTATION_VALUE>vas a jugar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann969" ANNOTATION_REF="ann968">
                <ANNOTATION_VALUE>no lo metes nada en la boca pareces puerco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann977" ANNOTATION_REF="ann976">
                <ANNOTATION_VALUE>vete a jugar, sí?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
