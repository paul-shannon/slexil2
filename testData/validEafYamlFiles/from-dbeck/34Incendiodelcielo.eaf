    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="ft" PARENT_REF="Spanish" PARTICIPANT="unknown" TIER_ID="Totonac">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2" ANNOTATION_REF="ann1">
                <ANNOTATION_VALUE>relatan así en los pueblos totonacos cuando (se) platican.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann4" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>dizque cuando contínuamente ardía el cielo, no se sabe cómo se prendía (sólo).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann6" ANNOTATION_REF="ann5">
                <ANNOTATION_VALUE>ya estaba produciendo llamaradas a la hora que lo veían.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann7">
                <ANNOTATION_VALUE>todos en conjunto empezaban a llorar en todo el mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>nada más de repente empezaba al poco rato a soplar fuerte el viento o al siguiente día.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann12" ANNOTATION_REF="ann11">
                <ANNOTATION_VALUE>lo apagó San Mateo - decían cuando se apagaba el cielo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann13">
                <ANNOTATION_VALUE>así sucedió.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>nada más en medio del terror vivían hace tiempo, a cada momento se querían acabar el mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann18" ANNOTATION_REF="ann17">
                <ANNOTATION_VALUE>cuentan que también ya se había prendido la tierra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann19">
                <ANNOTATION_VALUE>cuentan que probablemente el cielo se ha de haber prendido ya cerca allá por donde termina la tierra y el cielo, nada más se han de haber prendido entre sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>también lo apagó san mateo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann24" ANNOTATION_REF="ann23">
                <ANNOTATION_VALUE>hizo llover mucho, también hizo soplar mucho el viento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann25">
                <ANNOTATION_VALUE>dizque cuando empezó a soplar el viento, se elevaron mucho los residuos de lo quemado de lo que había sobre la tierra, (en la parte) por donde ya se había quemado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>parecía que era de noche cuando estaba soplando el viento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann30" ANNOTATION_REF="ann29">
                <ANNOTATION_VALUE>lo había hecho obscurecer en toda la extensión de la tierra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann31">
                <ANNOTATION_VALUE>no solamente fué el obscurecimiento , ( sino que ) hubo muerte en gran escala.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>se asfixiaron por el humo de la tierra y del humo de lo que se quemaron sobre ella.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann36" ANNOTATION_REF="ann35">
                <ANNOTATION_VALUE>dizque no se podía respirar , aguantaron con sacrificio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann37">
                <ANNOTATION_VALUE>aquellos que sobraron ......</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>no hacía mucho tiempo que había sucedido esa desgracia, hubo enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann42" ANNOTATION_REF="ann41">
                <ANNOTATION_VALUE>hubo mucho tiempo ( duraron tiempo ) de estar enfermos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann43">
                <ANNOTATION_VALUE>acabando de soplar mucho viento, empezó a llover bastante.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>por eso ello poco a poco se fué apagando la tierra mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann48" ANNOTATION_REF="ann47">
                <ANNOTATION_VALUE>ya se había apagado al amanecer al siguiente día.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann50" ANNOTATION_REF="ann49">
                <ANNOTATION_VALUE>todo lo que andaban volando en el aire ( que ) había hecho obscurecer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann52" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>cuando comenzó a llover , también fueron descendiendo al suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann54" ANNOTATION_REF="ann53">
                <ANNOTATION_VALUE>todo allá se fué acumulando en las partes bajas de los llanos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann56" ANNOTATION_REF="ann55">
                <ANNOTATION_VALUE>las corrientes del agua pasó a recoger en las cimas de las lomas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann58" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>todo se convirtió en abono.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann60" ANNOTATION_REF="ann59">
                <ANNOTATION_VALUE>de eso se debe ahora que no se produce tanto en las lomas como en los llanos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann62" ANNOTATION_REF="ann61">
                <ANNOTATION_VALUE>si no fuera por las corrientes de agua que recogieran el abono en las lomas , en todas partes se produciría igual ( legumbre etc. ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann64" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>dizque dejó de arder el cielo al ( empezar ) llegar un año nuevo , ya entonces comenzaron a vivir bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann66" ANNOTATION_REF="ann65">
                <ANNOTATION_VALUE>se libraron del peligro que se presentaba a menudo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann68" ANNOTATION_REF="ann67">
                <ANNOTATION_VALUE>quién sabe por qué se había sentido ( enfadado ) el dios padre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann70" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>todo el tiempo estaba haciendo sufrir a sus hijos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann72" ANNOTATION_REF="ann71">
                <ANNOTATION_VALUE>no los hacían vivir en medio de la alegría.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann74" ANNOTATION_REF="ann73">
                <ANNOTATION_VALUE>cuentan algunos padres ancianos , que habían hecho enojar ( al dios ) ( porque ) dizque se comían a sus hijos ( criaturas ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann76" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>los que no se los comían , los llevaban arrojar vivos al río.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann78" ANNOTATION_REF="ann77">
                <ANNOTATION_VALUE>dizque le causaba muchísima lástima a la santa madre de los niños criaturas al matarlos nada más a fuerza , todavía no les tocaba que murieran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann80" ANNOTATION_REF="ann79">
                <ANNOTATION_VALUE>es la causa que los querían eliminar en todo el mundo , aunque algunos no le hacía daño a sus criaturas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann82" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>por unos nada más estaban siendo martirizados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann84" ANNOTATION_REF="ann83">
                <ANNOTATION_VALUE>todavía no había padres curas en aquella fecha que ( el dios ) quería acabar a los seres humanos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann86" ANNOTATION_REF="ann85">
                <ANNOTATION_VALUE>nadie veneraba todavía a dios , todavía vivían nada más así , solamente se ocupaban en comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann88" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>no se imaginaban si existía a quién tenían que pedirle para que vivieran bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann90" ANNOTATION_REF="ann89">
                <ANNOTATION_VALUE>otros ancianos cuentan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann92" ANNOTATION_REF="ann91">
                <ANNOTATION_VALUE>dizque les tenían el proyecto de criarles muchos tigres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann94" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>( para ) que ellos se los comieran vivos a cuantos seres humanos vivían.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann96" ANNOTATION_REF="ann95">
                <ANNOTATION_VALUE>dizque así había dispuesto realizar el dios padre , la virgen maría , madre bendita , no permitió.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann98" ANNOTATION_REF="ann97">
                <ANNOTATION_VALUE>empezó a llorar mucho por sus hijos cuando ya empezaron a criar los tigres.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann100" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>y otros más que comen ( seres humanos ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann102" ANNOTATION_REF="ann101">
                <ANNOTATION_VALUE>si no fuera por la virgen maría , madre bendita hablara por ellos , no habría remedio , los hubieran eliminado ( acabado ) a todos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann104" ANNOTATION_REF="ann103">
                <ANNOTATION_VALUE>serían los tigres que hubieran reinado , no viviríamos ahora si así hubieran tenido fin aquellos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann106" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>ellos tuvieron la culpa si se criaron los tigres , dizque más antes no había nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann108" ANNOTATION_REF="ann107">
                <ANNOTATION_VALUE>por el mismo acontecimiento de ciertas cosas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann110" ANNOTATION_REF="ann109">
                <ANNOTATION_VALUE>( que ) ha venido pasando que hicieran honor a dios ( en aguel principio ).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann112" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>poco a poco comenzaron a pensar que deben recordar en él al amanecer y al anochecer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann114" ANNOTATION_REF="ann113">
                <ANNOTATION_VALUE>si no recordáramos así , en un momento a otro nos pasaría algo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann116" ANNOTATION_REF="ann115">
                <ANNOTATION_VALUE>aunque en este tiempo existen ( animales ) lo que nos molestan , no podemos andar como quiera en los grandes bosques.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann118" ANNOTATION_REF="ann117">
                <ANNOTATION_VALUE>por la causa que hay tigres y otros animales que comen seres humanos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann120" ANNOTATION_REF="ann119">
                <ANNOTATION_VALUE>dizque entonces fueron criados para siempre cuando hubo quemazón a que se ha referido , después de pasar un tiempo , no los hicieron desaparecer , ( sino que ) vivieron para siempre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann122" ANNOTATION_REF="ann121">
                <ANNOTATION_VALUE>se fueron a vivir en lo(s) monte(s) grande(s).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann124" ANNOTATION_REF="ann123">
                <ANNOTATION_VALUE>solamente en las noches salen por las orillas de los montes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann126" ANNOTATION_REF="ann125">
                <ANNOTATION_VALUE>si no fuera por la actuación distinta los que vivieron en aquel tiempo ,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann128" ANNOTATION_REF="ann127">
                <ANNOTATION_VALUE>nada habría que no espantaran ahora , podríamos ir solo a cualquier monte grande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann130" ANNOTATION_REF="ann129">
                <ANNOTATION_VALUE>así conservan sus creencias , cómo pasaron los tiempos de antes , desde ( la época ) que nadie pensaba todavía cómo vivir en el mundo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann132" ANNOTATION_REF="ann131">
                <ANNOTATION_VALUE>todavía vivían entonces sin organización.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann134" ANNOTATION_REF="ann133">
                <ANNOTATION_VALUE>aun nadie se respetaba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
