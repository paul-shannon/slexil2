                <ANNOTATION_VALUE/>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a105" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE/>
            </REF_ANNOTATION>
        </ANNOTATION>
