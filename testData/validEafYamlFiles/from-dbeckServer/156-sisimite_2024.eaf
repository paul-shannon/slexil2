    </TIER>
    <TIER LINGUISTIC_TYPE_REF="ft" PARENT_REF="ref@JC" PARTICIPANT="JC" TIER_ID="ft@JC">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann3" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>JC: ‘Once upon a time, two young women were at the foot of a stream of water.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann7" ANNOTATION_REF="ann4">
                <ANNOTATION_VALUE>‘A Sasquatch found them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann8">
                <ANNOTATION_VALUE>‘Those two women went here, (they were) Kakao’s (sisters).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann15" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>‘The two were called “Jícara.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann16">
                <ANNOTATION_VALUE>‘The two were sisters.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann23" ANNOTATION_REF="ann20">
                <ANNOTATION_VALUE>‘And, thus the Sasquatch kidnapped them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann27" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>‘Thus he kidnapped them, he took them, he put them in the cave.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann28">
                <ANNOTATION_VALUE>‘That is what the Sasquatch did to them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann32">
                <ANNOTATION_VALUE>‘And then the wasp came (to release the women).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann39" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>‘The man (Kakao) took the shape of it (the wasp) because the man (the Sasquatch) is hairy.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann40">
                <ANNOTATION_VALUE>‘Thus, he took the shape of it (the wasp).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann47" ANNOTATION_REF="ann44">
                <ANNOTATION_VALUE>‘Then he took the shape of a yellow tiger when he arrived at the water, at the stone’s house.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann51" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>‘The yellow tiger arrived.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann55" ANNOTATION_REF="ann52">
                <ANNOTATION_VALUE>‘He (the Sasquatch) caught him by his tail. He threw him here, into the ditch, they said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann59" ANNOTATION_REF="ann56">
                <ANNOTATION_VALUE>‘And then, he (yellow tiger) came again to take another shape (a red tiger).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann63" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>‘When he possessed it and took the shape of it, he went here, as a red tiger (as) they call him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann67" ANNOTATION_REF="ann64">
                <ANNOTATION_VALUE>‘Thus once again he (Kakao) went to the stone house to find his sister.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann71" ANNOTATION_REF="ann68">
                <ANNOTATION_VALUE>‘When he arrived (as the red tiger), he (the Sasquatch) caught him once again by the tail.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann75" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>‘He threw him out.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann79" ANNOTATION_REF="ann76">
                <ANNOTATION_VALUE>‘The Sasquatch did this in that way, he threw him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann83" ANNOTATION_REF="ann80">
                <ANNOTATION_VALUE>‘It is said that he (Kakao) couldn’t do a thing.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann87" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>‘He didn’t do anything until this point, they said here.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann91" ANNOTATION_REF="ann88">
                <ANNOTATION_VALUE>‘Then the bat, as they said, entered the house of the Sasquatch to steal something.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann95" ANNOTATION_REF="ann92">
                <ANNOTATION_VALUE>‘The house was in the stone, the stones of the house, the stones of the house. It was in the stone.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann99" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>‘Thus, the bats entered.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann103" ANNOTATION_REF="ann100">
                <ANNOTATION_VALUE>‘He (the bat) was about to kidnap his spouse, as well as the stones of the house.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann107" ANNOTATION_REF="ann104">
                <ANNOTATION_VALUE>‘Thus he (the bat) kidnapped her.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann111" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>‘He kidnapped her, he already brought her.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann115" ANNOTATION_REF="ann112">
                <ANNOTATION_VALUE>‘This Sasquatch will look for her, he didn’t find her.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann119" ANNOTATION_REF="ann116">
                <ANNOTATION_VALUE>‘They (the bats) stole only one. They put her in this house of mahogany.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann123" ANNOTATION_REF="ann120">
                <ANNOTATION_VALUE>‘Before, thus once again the Sasquatch went to the house’s door.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann127" ANNOTATION_REF="ann124">
                <ANNOTATION_VALUE>‘They found him. They took him out.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann131" ANNOTATION_REF="ann128">
                <ANNOTATION_VALUE>‘They fought. He already did this. He got angry.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann135" ANNOTATION_REF="ann132">
                <ANNOTATION_VALUE>‘What he said, “I am going,” it is said that he said, “I am going here, I am waiting for you,” he said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann139" ANNOTATION_REF="ann136">
                <ANNOTATION_VALUE>‘And thus they grabbed each other with the spear as they said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann143" ANNOTATION_REF="ann140">
                <ANNOTATION_VALUE>‘The spear is like the point of the knife.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann147" ANNOTATION_REF="ann144">
                <ANNOTATION_VALUE>‘Thus “Here, I am going,” he said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann151" ANNOTATION_REF="ann148">
                <ANNOTATION_VALUE>‘ “Who are you shooting at?” he says.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann155" ANNOTATION_REF="ann152">
                <ANNOTATION_VALUE>‘ “Me,” he said to them, “here they looked for me and they went.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann159" ANNOTATION_REF="ann156">
                <ANNOTATION_VALUE>‘Thus, the Sasquatch alone went here.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann163" ANNOTATION_REF="ann160">
                <ANNOTATION_VALUE>‘When they shot the Sasquatch, that (spear) did not enter.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann167" ANNOTATION_REF="ann164">
                <ANNOTATION_VALUE>‘He fought them here, they said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann171" ANNOTATION_REF="ann168">
                <ANNOTATION_VALUE>‘The spear did not enter.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann175" ANNOTATION_REF="ann172">
                <ANNOTATION_VALUE>‘ “This is the reason why I am going now,” he said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann179" ANNOTATION_REF="ann176">
                <ANNOTATION_VALUE>‘Kakao took him, that man is strong (courageous).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann183" ANNOTATION_REF="ann180">
                <ANNOTATION_VALUE>‘This is the reason why he (Kakao) came.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann187" ANNOTATION_REF="ann184">
                <ANNOTATION_VALUE>‘When he (Kakao) hit him, there was a sound and he (the Sasquatch) fell inside.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann191" ANNOTATION_REF="ann188">
                <ANNOTATION_VALUE>‘It is the Sasquatch. He (Kakao) killed him there.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann195" ANNOTATION_REF="ann192">
                <ANNOTATION_VALUE>‘It is said that he (Kakao) entered the stone’s house.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann199" ANNOTATION_REF="ann196">
                <ANNOTATION_VALUE>‘He arrived. When he wnet in, the women were lying down.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann203" ANNOTATION_REF="ann200">
                <ANNOTATION_VALUE>‘When he saw them, they were pregnant, pregnant, it is said, (by) that Sasquatch.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann207" ANNOTATION_REF="ann204">
                <ANNOTATION_VALUE>‘ “Thus, um, I will take you just like that.” He said, “You are pregnant, you see.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann211" ANNOTATION_REF="ann208">
                <ANNOTATION_VALUE>‘What he said, “Come, stand on my feet!” what he said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann215" ANNOTATION_REF="ann212">
                <ANNOTATION_VALUE>‘When he threw his big foot a little, it is said the woman disappeared.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann219" ANNOTATION_REF="ann216">
                <ANNOTATION_VALUE>‘She completely disappeared. That’s as far as it goes for me.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <LINGUISTIC_TYPE GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="ref" TIME_ALIGNABLE="true"/>
    <LINGUISTIC_TYPE CONSTRAINTS="Symbolic_Association"
        GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="to" TIME_ALIGNABLE="false"/>
    <LINGUISTIC_TYPE CONSTRAINTS="Symbolic_Association"
        GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="ot" TIME_ALIGNABLE="false"/>
    <LINGUISTIC_TYPE CONSTRAINTS="Symbolic_Association"
        GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="ft" TIME_ALIGNABLE="false"/>
    <CONSTRAINT
        DESCRIPTION="Time subdivision of parent annotation's time interval, no time gaps allowed within this interval" STEREOTYPE="Time_Subdivision"/>
    <CONSTRAINT
        DESCRIPTION="Symbolic subdivision of a parent annotation. Annotations refering to the same parent are ordered" STEREOTYPE="Symbolic_Subdivision"/>
    <CONSTRAINT DESCRIPTION="1-1 association with a parent annotation" STEREOTYPE="Symbolic_Association"/>
    <CONSTRAINT
        DESCRIPTION="Time alignable annotations within the parent annotation's time interval, gaps are allowed" STEREOTYPE="Included_In"/>
</ANNOTATION_DOCUMENT>
