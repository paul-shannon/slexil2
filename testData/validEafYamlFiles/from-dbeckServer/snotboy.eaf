        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>nem’ yuhw tsam thuw’nilh q’e’mi’ sew’q’ ’ukw’ chumux, ’a.</ANNOTATION_VALUE>
