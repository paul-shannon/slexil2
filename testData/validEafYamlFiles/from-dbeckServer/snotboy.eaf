        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20"
                TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>nem’ suw’q’ ’ukw’ chumux, tthu tth’utth’e’tum’ chumux.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21"
                TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>hwun’ xut’e ’u tthey’ kwsus nem’ ni’ ’u tthu tsa’luqw, ’i’ ni’ wulh q’uq’a’tul ’u tu’i swiw’lus.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22"
                TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>suw’ shishutum’s thuw’nilh ’u tu’i tth’utth’eem’.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23"
                TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>suw’ xut’us ’uy’ ’uw’ m’iis ’ehwe’tum, ’i’ ’uw’ ’uwustum.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24"
                TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>’uw’ xut’ustum’, “ni ni’ ’u tnanulh.”</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25"
                TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>’i’ ni ’uw’ yu xut’ustum’ ’ul’ ’u tthey’ yu huy’thustum’ ’u tthu ni’ shni’s kws kwunnuhw tse’ tthu chumux.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26"
                TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>stl’i’s kws lhchumuxs thuw’nilh q’e’mi’.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34"
                TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>ni’ kwu’elh wulh tul’nuhwus kws nans ni’ wulh hwu tsakw tsa’luqw kwsus nem’ yu tsukwul’ul’qum’ ’u tthey’ swiw’lus ni’ ts’lhq’uq’a’tuls.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36"
                TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>suw’ yu kwunut-s tthu s’itth’ums swuqw’a’lh suw’ yu t’aqw’t-s suw’ yu q’el’q’t-s ’u tthu thqet ’u kwthu ni’ wulh nem’ yu shilhunun’e’s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>suw’ huye’s nem’ ’uw’ yu ’i’mush yu tsukwul’ul’qum’ ’u tthu ’i nem’ shtseelqums swiw’lus ni’ lumnuhwus.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37"
                TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>hwun’ xut’u ’i’ ni’ wulh nem’ hun’umutnum ’u tthuw’nilh ’u tthu lelum’s tthuw’nilh swiw’lus.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38"
                TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>ni’ wulh hwu tsa’luqw kwunnum ’u tthey’, tl’uw’ stl’eluqum</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>hun’utum’ skwathshun’, skwathshun’ kws nes tthey’ ni’ tskwuyxthut ’u thuw’nilh q’e’mi’ tun’ni’ ’utl’ me’luxulh ’u kwthu wulh hithulh.</ANNOTATION_VALUE>
