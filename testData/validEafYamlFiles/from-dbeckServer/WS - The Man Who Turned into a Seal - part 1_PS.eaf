                TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>nem’ tsun t’itsum kwunut tthunu sun’tsu.”</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31"
                TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>suw’ lhuw’tth’e’ums tthuw’nilh swiw’lus sus ’uw’ qwsuthut.</ANNOTATION_VALUE>
