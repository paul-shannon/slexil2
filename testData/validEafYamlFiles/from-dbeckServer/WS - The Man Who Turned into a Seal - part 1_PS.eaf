        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32"
                TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>nem’ kwunutus tthu ni’ skwulushs ’es-hw.</ANNOTATION_VALUE>
