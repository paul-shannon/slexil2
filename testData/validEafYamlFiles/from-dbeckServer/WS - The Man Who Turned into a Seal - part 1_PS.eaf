        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36"
                TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>ne.e.em’ t’itsum taal tthuw’nilh swiw’lus.</ANNOTATION_VALUE>
