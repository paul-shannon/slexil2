        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33"
                TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>’i’ ni’ ’uw’ xi’xlhem’ thu slheni’ ni’ ’u tthu ni’ shni’s.</ANNOTATION_VALUE>
