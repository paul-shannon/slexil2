                TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>tl’lim’ nuw’ pkw’um tthu qa’ kwus wulh kwunutum tthuw’nilh</ANNOTATION_VALUE>
