        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37"
                TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>tus ’ul’ ’u tthu ni’ shni’s tthu skwulushs kwus wulh wun’a.a.a’ m’i tuw’ kwunutus ’i’ m’i wulh p’kwuthut tthuw’nilh ’es-hw.</ANNOTATION_VALUE>
