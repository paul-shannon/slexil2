        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35"
                TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>xi’xlhe’mutus tthu sta’lusth kwus wulh qwsuthut.</ANNOTATION_VALUE>
