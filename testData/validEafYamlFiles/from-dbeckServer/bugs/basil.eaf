        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a656" ANNOTATION_REF="a305">
                <ANNOTATION_VALUE>What he prepared was quite long, and one end was thicker.
</ANNOTATION_VALUE>
