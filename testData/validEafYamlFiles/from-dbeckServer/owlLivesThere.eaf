   <TIER DEFAULT_LOCALE="tr" LINGUISTIC_TYPE_REF="english" PARENT_REF="lushootseed" TIER_ID="english">
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a1">
            <ANNOTATION_VALUE>Owl lives there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a2">
            <ANNOTATION_VALUE>And Owl has Frog as a wife.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a3">
            <ANNOTATION_VALUE>Frog who is always in the swamp.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a4">
            <ANNOTATION_VALUE>She always makes noise. She always talks.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a5">
            <ANNOTATION_VALUE>Not for long have they been living there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a6">
            <ANNOTATION_VALUE>Owl and Frog are married.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a7">
            <ANNOTATION_VALUE>Then, Frog is pregnant.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a8">
            <ANNOTATION_VALUE>And then, she and Owl had a baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a9">
            <ANNOTATION_VALUE>She and Owl have a little baby boy.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a10">
            <ANNOTATION_VALUE>Frog has a baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a11">
            <ANNOTATION_VALUE>And then Frogs baby always cries.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a12">
            <ANNOTATION_VALUE>Her baby always cries.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a13">
            <ANNOTATION_VALUE>And then, no one can sleep while they live there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a14">
            <ANNOTATION_VALUE>Frogs baby always cries and cries.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a15">
            <ANNOTATION_VALUE>Her little baby is never quiet.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a16">
            <ANNOTATION_VALUE>Frog never says anything.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a17">
            <ANNOTATION_VALUE>She just sits there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a18">
            <ANNOTATION_VALUE>Her mouth just flaps.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a19">
            <ANNOTATION_VALUE>Her mouth just flaps.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a20">
            <ANNOTATION_VALUE>Her mouth is just moving fast.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a21">
            <ANNOTATION_VALUE>Then he is spoken to,  “What is the matter with your wife that her mouth is just moving? What is the matter?” </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a22">
            <ANNOTATION_VALUE>Then I guess Frog is told by Owl that she should soothe the baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a23">
            <ANNOTATION_VALUE>Then Frog takes her little swaddled baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a24">
            <ANNOTATION_VALUE>She has him in a cradle board.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a25">
            <ANNOTATION_VALUE>And then, she rocks him.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a26">
            <ANNOTATION_VALUE>She says to him over and over,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a27">
            <ANNOTATION_VALUE> “Shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk.” </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a28">
            <ANNOTATION_VALUE>Crow …, or what …, Frog says over and over, She says over and over,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a29">
            <ANNOTATION_VALUE> “Shuwooluk, shuwooluk, shuwooluk.” </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a303" ANNOTATION_REF="a30">
            <ANNOTATION_VALUE>She rocks her little baby, she rocks him. And she says over and over.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a31">
            <ANNOTATION_VALUE> “Shuwooluk, shuwooluk, shuwooluk, shuwooluk.” </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a305" ANNOTATION_REF="a32">
            <ANNOTATION_VALUE>She tries to quiet him.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a33">
            <ANNOTATION_VALUE>And Frog talks on and on too.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a34">
            <ANNOTATION_VALUE>She speaks energetically to her little baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a35">
            <ANNOTATION_VALUE>And then Frog always says over and over,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a36">
            <ANNOTATION_VALUE> “Shuwooluk, shuwooluk, shuwooluk, shuwooluk shuwooluk, shuwooluk, shuwooluk.” </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a37">
            <ANNOTATION_VALUE>Frog never keeps quiet.  She talks on and on.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a38">
            <ANNOTATION_VALUE>Her baby cries and cries. And then she talks some more. She will not keep quiet...</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a39">
            <ANNOTATION_VALUE>until Owl gets fed up.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a40">
            <ANNOTATION_VALUE>He looks at his wife.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a41">
            <ANNOTATION_VALUE>She just talks on and on,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a42">
            <ANNOTATION_VALUE> “Shuwooluk, shuwooluk, shuwooluk, shuwooluk.”  She sings a lullaby to the baby. What happened?</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a43">
            <ANNOTATION_VALUE>She sings to her baby, her little baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a44">
            <ANNOTATION_VALUE>Then Raven, well now, she is seen by Raven … .</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a45">
            <ANNOTATION_VALUE>He sees her.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a46">
            <ANNOTATION_VALUE>He sees his wife.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a47">
            <ANNOTATION_VALUE>Owl.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a48">
            <ANNOTATION_VALUE>He sees his wife. Then he turns his face away. Then</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a49">
            <ANNOTATION_VALUE>She stands up in order to try to tend to the baby they had,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a50">
            <ANNOTATION_VALUE>Their little baby whom she had born.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a51">
            <ANNOTATION_VALUE>The little baby is a little frog.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a52">
            <ANNOTATION_VALUE>It is a little frog.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a53">
            <ANNOTATION_VALUE>So, Owl goes.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a54">
            <ANNOTATION_VALUE>He is afraid. He is fed up. He gets scared of him (Little Frog).</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a55">
            <ANNOTATION_VALUE>His wife does not keep quiet.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a56">
            <ANNOTATION_VALUE> “Make your wife stop! Why is she talking like that?” </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a57">
            <ANNOTATION_VALUE> “No. Shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk.”  Frog rocks the baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a58">
            <ANNOTATION_VALUE>She does not keep quiet. She always talks on and on. And again she talks on and on. </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a59">
            <ANNOTATION_VALUE> “Tend to the baby!” </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a60">
            <ANNOTATION_VALUE>Owl flies off. He is afraid. And then he flies off.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a61">
            <ANNOTATION_VALUE>And he would just turn his face away over there where he alights.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a62">
            <ANNOTATION_VALUE>And he does it again and he goes on. He goes even farther away.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a63">
            <ANNOTATION_VALUE>He is afraid of his wife.  And he is afraid of their little baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a64">
            <ANNOTATION_VALUE>And then Owl goes far off.  He is afraid.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a65">
            <ANNOTATION_VALUE>And so there is his wife. And she talks on and on.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a66">
            <ANNOTATION_VALUE>And so suddenly Changer is traveling.  Changer arrives.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a67">
            <ANNOTATION_VALUE>Changer arrives. And he peeks at them as he listens to them.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a68">
            <ANNOTATION_VALUE> And it is said, “Whats the matter with Frog? Whats the matter?&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a69">
            <ANNOTATION_VALUE> “She tends to the baby.  “And (the baby) just doesnt quiet down.” </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a70">
            <ANNOTATION_VALUE>What they have told her is that she and her husband Owl should quiet the baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a71">
            <ANNOTATION_VALUE>Owl gets scared. He went and he fled. He flew off.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a72">
            <ANNOTATION_VALUE>And the one who cries on and on is their baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a73">
            <ANNOTATION_VALUE>And she sings what she is saying .</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a74">
            <ANNOTATION_VALUE>Frog could not be quiet either. She speaks energetically. She is always talking.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a75">
            <ANNOTATION_VALUE>She did not shut up until Changer spoke</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a76">
            <ANNOTATION_VALUE> “I ought to just toss this Frog into the swamp.” </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a77">
            <ANNOTATION_VALUE>Then Changer grabs Owls wife, she has a baby,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a78">
            <ANNOTATION_VALUE>She has a little baby. And then he throws her there where the water is stagnant.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a79">
            <ANNOTATION_VALUE>It seems there are bullrushes. It is very wet.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a353" ANNOTATION_REF="a80">
            <ANNOTATION_VALUE>There is stagnant water, and it seems that there are frogs.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a81">
            <ANNOTATION_VALUE>That over-turned place. What would it be called? It is a swampy place. bug?  &quot;baby&quot; at the end?</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a82">
            <ANNOTATION_VALUE>Frog is thrown there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a83">
            <ANNOTATION_VALUE> “You are just there now. What you are saying over and over will be there when the future people arrive.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a84">
            <ANNOTATION_VALUE> “You will be saying that.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a85">
            <ANNOTATION_VALUE> “You will not be quiet. You will talk on and on making noise when you converse.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a359" ANNOTATION_REF="a86">
            <ANNOTATION_VALUE> “Shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk, you will be saying when the people are near.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a87">
            <ANNOTATION_VALUE> “This is how you will be heard.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a361" ANNOTATION_REF="a88">
            <ANNOTATION_VALUE> “You will be in the swamp which is where you will be.” </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a89">
            <ANNOTATION_VALUE>Frog along with her little baby, the little one she had born, is thrown away.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a363" ANNOTATION_REF="a90">
            <ANNOTATION_VALUE>Then they are tossed there. Then there they are. And Frog talked and talked.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a91">
            <ANNOTATION_VALUE>She talks on and on, on and on. And she makes noise in the swamp, in the bad water.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
   </TIER>
   <LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="speech" TIME_ALIGNABLE="true"/>
   <LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="morphemes" TIME_ALIGNABLE="false"/>
   <LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="morphemeGloss" TIME_ALIGNABLE="false"/>
   <LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="english" TIME_ALIGNABLE="false"/>
