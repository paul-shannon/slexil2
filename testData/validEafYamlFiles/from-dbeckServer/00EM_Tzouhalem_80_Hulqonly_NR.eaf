                TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>’uwu kw’s tsakws ’i’ ni’ tl’uw’ wulh nuqemutus tthu ni’ yu shhwune.e.em’s.</ANNOTATION_VALUE>
