        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>tus ’u tthu nuts’a’ ’i’ tl’lim’ hweluq ’i ’uwu ni’us yul’ew’ulnamut.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>wulh tl’ulim’ nuw’ ’ulh tsulel ’i’ ’uwkw’ tthu slhekw’ums ’i’ yelh sus yul’ew’ ’u tthu qa’ ni’ ’u tthey’ shqwuqwe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>si.i.i.is nem’ ’uw’ ts’tem nem’ ’uw’ yu shtetul’ ’u tthey’ ni’ nem’ shnuw’ilums.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>
xut’u ’i wulh... xut’u ’i wulh tus ’u tthu ni.i.i’ thi ’u tthey’ shqwuqwe sun’iw’ ’u thu smeent.
</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>sus ne.e.m’ ’uw’ yu ’i’mush ’i’ wulh tus ’u tthu stl’eyuq’um.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>sus ’uw’ nem’ yu ’i’mush nem’ stl’i’s kws lumnuhws ’uw’ niis tun’untsu tthu stl’eyuq’um.
