        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>yu sew’q’tus kw’ ni’ tse’ shkw’am’kw’um’s kws hwu shne’ums.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>sus ne.e.em’ ’uw’ tus ’u kw’i sqtheq kwus yu xut’e’ ’u tthey’, yu hun’qum’.</ANNOTATION_VALUE>
