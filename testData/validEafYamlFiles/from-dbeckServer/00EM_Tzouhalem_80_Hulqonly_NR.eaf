                TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>xut’u ’i’ ni’ wulh hwu nin’sus tthu hwuhwul’i’wun’ tl’itl’up ’u tthu qa’.</ANNOTATION_VALUE>
