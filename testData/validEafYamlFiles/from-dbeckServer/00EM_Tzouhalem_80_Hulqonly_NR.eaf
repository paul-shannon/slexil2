        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>sus nem’ ’uw’ nuw’ilum, ne.e.e.em’ nuw’ilum ’u tthey’ smeent.
