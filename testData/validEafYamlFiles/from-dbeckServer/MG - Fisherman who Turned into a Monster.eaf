                TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>nilh kwis hwtl’hwa’luqwum ’u tthu stl’eluqum, ni’ shxte’s ’u tthey’, ni’ t’aanthut.</ANNOTATION_VALUE>
