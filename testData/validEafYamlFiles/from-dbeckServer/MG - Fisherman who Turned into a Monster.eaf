        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>hwun’ ni’ ’u tthu tsuw’tsuw’ ’i’ wulh wutl’ul’uq tthu qa’.
