   </TIER>
   <TIER DEFAULT_LOCALE="tr" LINGUISTIC_TYPE_REF="english" PARENT_REF="lushootseed" TIER_ID="english">
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a469" ANNOTATION_REF="a1">
            <ANNOTATION_VALUE>In the distant past, there was no daylight.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a470" ANNOTATION_REF="a2">
            <ANNOTATION_VALUE>The land, it was dark in the distant past.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a471" ANNOTATION_REF="a3">
            <ANNOTATION_VALUE>The people talked it over. How can we manage to obtain the daylight?</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a472" ANNOTATION_REF="a4">
            <ANNOTATION_VALUE>Daylight is up there in the upriver country but how can we manage to get it?</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a473" ANNOTATION_REF="a5">
            <ANNOTATION_VALUE>These two youths prepared themselves.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a6">
            <ANNOTATION_VALUE>They bathed.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a475" ANNOTATION_REF="a7">
            <ANNOTATION_VALUE>They prepared themselves in order to be swift as they run.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a476" ANNOTATION_REF="a8">
            <ANNOTATION_VALUE>The ones who prepared themselves were Raven and Little Mink.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a9">
            <ANNOTATION_VALUE>They lined up the canoes. There must have been some shovel-nosed canoes but they could not yet jump over them.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a10">
            <ANNOTATION_VALUE>To become swift they had two canoes overturned.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a11">
            <ANNOTATION_VALUE>Now what they would jump over were two canoes.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a12">
            <ANNOTATION_VALUE>For a long time they trained to become swift as they run.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a13">
            <ANNOTATION_VALUE>It came to where they had three canoes overturned which they were jumping.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a14">
            <ANNOTATION_VALUE>Now prepared, now prepared four, four canoes turned over shovel nose canoe</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a483" ANNOTATION_REF="a15">
            <ANNOTATION_VALUE>And they jumped over these four canoes</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a484" ANNOTATION_REF="a16">
            <ANNOTATION_VALUE>And then they thought, nothing now can catch us.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a485" ANNOTATION_REF="a17">
            <ANNOTATION_VALUE>We are good enough to go after daylight where it is.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a486" ANNOTATION_REF="a18">
            <ANNOTATION_VALUE>They soon went, this here, traveled by water this here mink, and this here, and this raven.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a19">
            <ANNOTATION_VALUE>Walking went but not yet, that daylight  that upstream.land.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a20">
            <ANNOTATION_VALUE>As they drew near this place of daylight,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a21">
            <ANNOTATION_VALUE>light enveloped them.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a490" ANNOTATION_REF="a22">
            <ANNOTATION_VALUE>For a long time it would be day then it would again be dark.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a491" ANNOTATION_REF="a23">
            <ANNOTATION_VALUE>That (was how) knew they becoming near they.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a24">
            <ANNOTATION_VALUE>Then they left their canoe and walked.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a493" ANNOTATION_REF="a25">
            <ANNOTATION_VALUE>They walked now and arrived at these ...</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a494" ANNOTATION_REF="a26">
            <ANNOTATION_VALUE>... people who dwelled at the place of light.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a495" ANNOTATION_REF="a27">
            <ANNOTATION_VALUE>They will decide. “Which of us will take the light?&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a496" ANNOTATION_REF="a28">
            <ANNOTATION_VALUE>It would be bad if we both were to go, because we would be known to be going after this light.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a497" ANNOTATION_REF="a29">
            <ANNOTATION_VALUE>We will steal it from where it is.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a498" ANNOTATION_REF="a30">
            <ANNOTATION_VALUE>Little Mink said,  I am the one who will enter the building.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a499" ANNOTATION_REF="a31">
            <ANNOTATION_VALUE>I will pretend to be old and grey.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a500" ANNOTATION_REF="a32">
            <ANNOTATION_VALUE>Feebly, using a cane I will go in.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a501" ANNOTATION_REF="a33">
            <ANNOTATION_VALUE>I will go to the nobleman who has the daylight. There is where I will be.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a502" ANNOTATION_REF="a34">
            <ANNOTATION_VALUE>Raven says to him, I will be at this place here.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a503" ANNOTATION_REF="a35">
            <ANNOTATION_VALUE>I will wait for you to bring it.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a504" ANNOTATION_REF="a36">
            <ANNOTATION_VALUE>“Just so will you be clutching it and you will arrive here, and I am the one who will take it anew.”</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a505" ANNOTATION_REF="a37">
            <ANNOTATION_VALUE>I will take it.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a506" ANNOTATION_REF="a38">
            <ANNOTATION_VALUE>(Little Mink) ran. Little Mink went and he came to the nobleman who had daylight.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a507" ANNOTATION_REF="a39">
            <ANNOTATION_VALUE>He was old with grey hair and used a cane</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a508" ANNOTATION_REF="a40">
            <ANNOTATION_VALUE>He is seen by these people. “Oh, a person of a different tribe has arrived.” </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a509" ANNOTATION_REF="a41">
            <ANNOTATION_VALUE>Little Mink says. “Oh, I am poor.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a510" ANNOTATION_REF="a42">
            <ANNOTATION_VALUE>“I have nothing, nothing to put in my mouth to eat.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a511" ANNOTATION_REF="a43">
            <ANNOTATION_VALUE>“There is no one where I am who treats me well...&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a512" ANNOTATION_REF="a44">
            <ANNOTATION_VALUE>so I am coming, looking for the nobleman who possesses daylight. There I will lie down.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a513" ANNOTATION_REF="a45">
            <ANNOTATION_VALUE>“(There I will lie down) and I will be treated well.”</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a514" ANNOTATION_REF="a46">
            <ANNOTATION_VALUE>The old man was taken by the nobleman and spoken to,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a515" ANNOTATION_REF="a47">
            <ANNOTATION_VALUE>“There at the back you will lie down, you will have your mat.”</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a516" ANNOTATION_REF="a48">
            <ANNOTATION_VALUE>(Little Mink) spoke, “No, I need to go outside a bit during the night.”</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a517" ANNOTATION_REF="a49">
            <ANNOTATION_VALUE>“It is better that I be by the door.”</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a518" ANNOTATION_REF="a50">
            <ANNOTATION_VALUE>His place was made by the door.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a519" ANNOTATION_REF="a51">
            <ANNOTATION_VALUE>He would be there just watching what was done with it.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a520" ANNOTATION_REF="a52">
            <ANNOTATION_VALUE>He just watched it.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a521" ANNOTATION_REF="a53">
            <ANNOTATION_VALUE>As the sun would move to the other side, then the daylight would gradually get its face squeezed shut.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a522" ANNOTATION_REF="a54">
            <ANNOTATION_VALUE>It gradually became night.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a523" ANNOTATION_REF="a55">
            <ANNOTATION_VALUE>It would gradually get its face tied shut.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a524" ANNOTATION_REF="a56">
            <ANNOTATION_VALUE>It was then that it was dark.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a525" ANNOTATION_REF="a57">
            <ANNOTATION_VALUE>It was watched by Little Mink.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a526" ANNOTATION_REF="a58">
            <ANNOTATION_VALUE>When it was three days that Little Mink was there, then he went after the daylight.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a527" ANNOTATION_REF="a59">
            <ANNOTATION_VALUE>He can not reach it with his hand.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a528" ANNOTATION_REF="a60">
            <ANNOTATION_VALUE>It was still far away when it lit up.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a529" ANNOTATION_REF="a61">
            <ANNOTATION_VALUE>Quickly Little Mink jumped back and lay where he lay down.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a530" ANNOTATION_REF="a62">
            <ANNOTATION_VALUE>He went to bed covered by fine ash powder.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a531" ANNOTATION_REF="a63">
            <ANNOTATION_VALUE>He blew on this fine ash powder and is buried.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a532" ANNOTATION_REF="a64">
            <ANNOTATION_VALUE>The others at the far part of the house noticed it.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a533" ANNOTATION_REF="a65">
            <ANNOTATION_VALUE>“Why is the daylight blinking?”</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a534" ANNOTATION_REF="a66">
            <ANNOTATION_VALUE>The old fellow lying by the door covered in fine ash watched it.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a535" ANNOTATION_REF="a67">
            <ANNOTATION_VALUE>When it would again be night, Little Mink went after it again.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a536" ANNOTATION_REF="a68">
            <ANNOTATION_VALUE>For four days he went after the daylight, then his hand reached it.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a537" ANNOTATION_REF="a69">
            <ANNOTATION_VALUE>He snatched the daylight and ran off with it.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a538" ANNOTATION_REF="a70">
            <ANNOTATION_VALUE>Little Mink was chased.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a539" ANNOTATION_REF="a71">
            <ANNOTATION_VALUE>He kept below the logs he was going beneath over there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a540" ANNOTATION_REF="a72">
            <ANNOTATION_VALUE>He was not overtaken because he is swift.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a541" ANNOTATION_REF="a73">
            <ANNOTATION_VALUE>He jumped over the logs until he arrived at his friend, Raven.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a542" ANNOTATION_REF="a74">
            <ANNOTATION_VALUE>And he threw him the daylight.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a543" ANNOTATION_REF="a75">
            <ANNOTATION_VALUE>It was taken by Raven.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a544" ANNOTATION_REF="a76">
            <ANNOTATION_VALUE>Way up high Raven was twisting and turning.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a545" ANNOTATION_REF="a77">
            <ANNOTATION_VALUE>“Caw! Caw! Caw! Caw!”</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a546" ANNOTATION_REF="a78">
            <ANNOTATION_VALUE>There was no one who could catch him because he is swift.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a547" ANNOTATION_REF="a79">
            <ANNOTATION_VALUE>He is strong.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a548" ANNOTATION_REF="a80">
            <ANNOTATION_VALUE>Here on the ground was where (Little Mink) ran.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a549" ANNOTATION_REF="a81">
            <ANNOTATION_VALUE>Way up high was where (Raven) flew.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a550" ANNOTATION_REF="a82">
            <ANNOTATION_VALUE>There was no one who could manage to catch Raven.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a551" ANNOTATION_REF="a83">
            <ANNOTATION_VALUE>When he would tire, he would throw it to his friend.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a552" ANNOTATION_REF="a84">
            <ANNOTATION_VALUE>Little Mink as chased.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a553" ANNOTATION_REF="a85">
            <ANNOTATION_VALUE>He was way over there beneath the logs.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a554" ANNOTATION_REF="a86">
            <ANNOTATION_VALUE>Little Mink was way over there jumping over the high mass where he was running.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a555" ANNOTATION_REF="a87">
            <ANNOTATION_VALUE>There is nothing able to overtake this swift little animal.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a556" ANNOTATION_REF="a88">
            <ANNOTATION_VALUE>It was Wolf and Cougar who chased him.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a557" ANNOTATION_REF="a89">
            <ANNOTATION_VALUE>No one could overtake Little Mink because he is swift.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a558" ANNOTATION_REF="a90">
            <ANNOTATION_VALUE>When they got to their canoe, they got in and set off.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a559" ANNOTATION_REF="a91">
            <ANNOTATION_VALUE>Just as they set out it became foggy.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a560" ANNOTATION_REF="a92">
            <ANNOTATION_VALUE>Little Mink said,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a561" ANNOTATION_REF="a93">
            <ANNOTATION_VALUE>“I have a spirit power that I̓ll locate and the land will be foggy.”</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a562" ANNOTATION_REF="a94">
            <ANNOTATION_VALUE>The fog covered them and the people who chased them got lost.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a563" ANNOTATION_REF="a95">
            <ANNOTATION_VALUE>And they went.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a564" ANNOTATION_REF="a96">
            <ANNOTATION_VALUE>They took this daylight home.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a565" ANNOTATION_REF="a97">
            <ANNOTATION_VALUE>They were just managing to arrive with it.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a566" ANNOTATION_REF="a98">
            <ANNOTATION_VALUE>They were drawing near to this land where they were from.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a567" ANNOTATION_REF="a99">
            <ANNOTATION_VALUE>And sunshine would envelope the people.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a568" ANNOTATION_REF="a100">
            <ANNOTATION_VALUE>They said,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a569" ANNOTATION_REF="a101">
            <ANNOTATION_VALUE>“Oh, the men who sought the daylight have come.”</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a570" ANNOTATION_REF="a102">
            <ANNOTATION_VALUE>“They are coming nearer.”</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a571" ANNOTATION_REF="a103">
            <ANNOTATION_VALUE>“Light is covering us.”</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a572" ANNOTATION_REF="a104">
            <ANNOTATION_VALUE>They brought the daylight and came to the land they were from.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a573" ANNOTATION_REF="a105">
            <ANNOTATION_VALUE>And Raven took the daylight first.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a574" ANNOTATION_REF="a106">
            <ANNOTATION_VALUE>The one who watched it was he.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a575" ANNOTATION_REF="a107">
            <ANNOTATION_VALUE>No sooner it would become night than it became light again.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a576" ANNOTATION_REF="a108">
            <ANNOTATION_VALUE>Why were the people asleep?</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a577" ANNOTATION_REF="a109">
            <ANNOTATION_VALUE>It had also become light again.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a578" ANNOTATION_REF="a110">
            <ANNOTATION_VALUE>It was too fast.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a579" ANNOTATION_REF="a111">
            <ANNOTATION_VALUE>It was given to Little Mink and for a long time it would be night and grow light slowly.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a580" ANNOTATION_REF="a112">
            <ANNOTATION_VALUE>Because he knew how it is done with the hands.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a581" ANNOTATION_REF="a113">
            <ANNOTATION_VALUE>But Raven, he was too fast.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a582" ANNOTATION_REF="a114">
            <ANNOTATION_VALUE>Just when it became night then it became day again.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a583" ANNOTATION_REF="a115">
            <ANNOTATION_VALUE>Why were the people in bed when it had become light again?</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a584" ANNOTATION_REF="a116">
            <ANNOTATION_VALUE>My talking is finished now.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a585" ANNOTATION_REF="a117">
            <ANNOTATION_VALUE>It is a good story.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
   </TIER>
