      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
            <ANNOTATION_VALUE>tuhaʔkʷ tuhuyucut əlgʷəʔ dxʷʔal kʷi gʷədəxʷxʷəʔaʔxʷəʔils ləƛ̓əlayʔ</ANNOTATION_VALUE>
