      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1" TIME_SLOT_REF1="ts0" TIME_SLOT_REF2="ts1">
            <ANNOTATION_VALUE>ʔal kʷi tu, ʔal kʷi tuhaʔkʷ gʷəl xʷiʔ gʷətusləx̌il.</ANNOTATION_VALUE>
         </ALIGNABLE_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
            <ANNOTATION_VALUE>tiʔəʔ swatixʷtəd gʷəl tasbəsad ʔal kʷi tuhaʔkʷ</ANNOTATION_VALUE>
         </ALIGNABLE_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
            <ANNOTATION_VALUE>tudxʷadhadəxʷ tiʔəʔ ʔaciɬtalbixʷ.  gʷʔəsčaləxʷ kʷi gʷədəxʷkʷədxʷ čəɬ kʷi sləx̌il.</ANNOTATION_VALUE>
         </ALIGNABLE_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts7">
            <ANNOTATION_VALUE>ʔaʔ kʷi sləx̌il ʔal kʷi q̓xʷul̓gʷədxʷ gʷəl ʔəsčal kʷi gʷədəxʷkʷədxʷ čəɬ</ANNOTATION_VALUE>
         </ALIGNABLE_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts9">
            <ANNOTATION_VALUE>tuhuyucutəxʷ tiʔəʔ səsaliʔ ləgʷləgʷəb</ANNOTATION_VALUE>
         </ALIGNABLE_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts11">
            <ANNOTATION_VALUE>tuc̓agʷacutəxʷ</ANNOTATION_VALUE>
         </ALIGNABLE_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts13">
            <ANNOTATION_VALUE>tuhuyucut həlgʷəʔ dxʷʔal sxʷəxʷaʔxʷəʔs gʷəsutəlawils əlgʷəʔ</ANNOTATION_VALUE>
         </ALIGNABLE_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
            <ANNOTATION_VALUE>tiʔəʔ qaw'qs ʔi tiʔəʔ bibščəb kʷi tuhuyucut</ANNOTATION_VALUE>
         </ALIGNABLE_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
            <ANNOTATION_VALUE>tut̓ədalgʷiɬ gʷəl tux̌ʷ xʷiʔ uʔxʷ, tuʔaʔ tux̌ʷ xʷiʔ uʔxʷ ƛ̓əlayʔ ʔə huyu gʷəsəsaxʷəbabac</ANNOTATION_VALUE>
         </ALIGNABLE_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts19">
            <ANNOTATION_VALUE>ʔal kʷi sxʷəʔaʔxʷəʔils (lə)ləcəbagʷiɬil tiʔəʔ ʔəsx̌ək̓ʷtxʷ əlgʷəʔ ƛ̓əlayʔ</ANNOTATION_VALUE>
         </ALIGNABLE_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
