        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>suw’ tth’asut-s tthu se’uq, suw’ ’ulhtuns ’eelhtun.</ANNOTATION_VALUE>
