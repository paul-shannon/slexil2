            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154"
                TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
