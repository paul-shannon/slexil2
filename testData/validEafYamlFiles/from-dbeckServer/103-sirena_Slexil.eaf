    <TIER LINGUISTIC_TYPE_REF="ft" PARENT_REF="ref@DL" PARTICIPANT="DL" TIER_ID="ft@DL">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann3" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>DL: ‘Once upon a time, there was a man.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann7" ANNOTATION_REF="ann4">
                <ANNOTATION_VALUE>‘This man was spearer of fish.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann8">
                <ANNOTATION_VALUE>‘They went and came looking for fish only to eat with sasal.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann15" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>‘For this reason, one day, they caught the man.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann16">
                <ANNOTATION_VALUE>‘There were two men with the other man, they went to spear fish.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann23" ANNOTATION_REF="ann20">
                <ANNOTATION_VALUE>‘They went to the sheltered place in the river.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann27" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>‘But, going further, they only saw a big fish.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann28">
                <ANNOTATION_VALUE>‘It is said that they only saw the tail.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann32">
                <ANNOTATION_VALUE>‘That man said,’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann39" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>‘ “This one, I will spear this one”, it is said that he said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann40">
                <ANNOTATION_VALUE>‘But it is said that he went.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann47" ANNOTATION_REF="ann44">
                <ANNOTATION_VALUE>‘The fish went with the harpoon.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann51" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>‘It is said that he speared it in the tail.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann55" ANNOTATION_REF="ann52">
                <ANNOTATION_VALUE>‘The man quickly saw what she wanted to do to that man (his brother).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann59" ANNOTATION_REF="ann56">
                <ANNOTATION_VALUE>‘When he saw him, that man seemed like he was also getting lost.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann63" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>‘This fish was not an ordinary fish.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann67" ANNOTATION_REF="ann64">
                <ANNOTATION_VALUE>‘This fish was the Mother of the fish, in our language.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann71" ANNOTATION_REF="ann68">
                <ANNOTATION_VALUE>‘In Spanish, it is a mermaid.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann75" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>‘But, when he was watching,’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann79" ANNOTATION_REF="ann76">
                <ANNOTATION_VALUE>‘It is said that he disappeared, the man.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann83" ANNOTATION_REF="ann80">
                <ANNOTATION_VALUE>‘It is said that he didn’t see where she took him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann87" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>‘That man came back to his house to tell the spouse (of the other man).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann91" ANNOTATION_REF="ann88">
                <ANNOTATION_VALUE>‘When he arrived to tell her, it is said that he said, “I come alone.”’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann99" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>‘It is said that she said, “How?.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann103" ANNOTATION_REF="ann100">
                <ANNOTATION_VALUE>‘ “My brother was taken by the Big fish, the Mother of the fish, the mermaid.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann107" ANNOTATION_REF="ann104">
                <ANNOTATION_VALUE>‘It is said that she said, “I have to go to look for him.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann111" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>‘When they went to look for him, they didn’t find him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann115" ANNOTATION_REF="ann112">
                <ANNOTATION_VALUE>‘But looking thoroughly what they made, to that man.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann119" ANNOTATION_REF="ann116">
                <ANNOTATION_VALUE>‘It is said that the Mother of the fish had already taken him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann123" ANNOTATION_REF="ann120">
                <ANNOTATION_VALUE>‘They went to look for him, they never found him, it is said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann127" ANNOTATION_REF="ann124">
                <ANNOTATION_VALUE>‘But, it is said that the man said, “I do not have him.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann131" ANNOTATION_REF="ann128">
                <ANNOTATION_VALUE>‘“I am not afraid”, this is what he said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann135" ANNOTATION_REF="ann132">
                <ANNOTATION_VALUE>‘It is said that that is the reason why she took him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann139" ANNOTATION_REF="ann136">
                <ANNOTATION_VALUE>‘What they told, it is said that the mermaid did it to this man.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann143" ANNOTATION_REF="ann140">
                <ANNOTATION_VALUE>‘It is said that she lives in the sheltered place in the river.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann147" ANNOTATION_REF="ann144">
                <ANNOTATION_VALUE>‘There, he went.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann151" ANNOTATION_REF="ann148">
                <ANNOTATION_VALUE>‘It is said that it is true that that man is still alive.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann155" ANNOTATION_REF="ann152">
                <ANNOTATION_VALUE>‘She is his spouse.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann159" ANNOTATION_REF="ann156">
                <ANNOTATION_VALUE>‘Here that story has ended.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann163" ANNOTATION_REF="ann160">
                <ANNOTATION_VALUE>‘This is all.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <LINGUISTIC_TYPE GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="ref" TIME_ALIGNABLE="true"/>
    <LINGUISTIC_TYPE CONSTRAINTS="Symbolic_Association"
        GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="to" TIME_ALIGNABLE="false"/>
    <LINGUISTIC_TYPE CONSTRAINTS="Symbolic_Association"
        GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="ot" TIME_ALIGNABLE="false"/>
    <LINGUISTIC_TYPE CONSTRAINTS="Symbolic_Association"
        GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="ft" TIME_ALIGNABLE="false"/>
    <CONSTRAINT
        DESCRIPTION="Time subdivision of parent annotation's time interval, no time gaps allowed within this interval" STEREOTYPE="Time_Subdivision"/>
    <CONSTRAINT
        DESCRIPTION="Symbolic subdivision of a parent annotation. Annotations refering to the same parent are ordered" STEREOTYPE="Symbolic_Subdivision"/>
    <CONSTRAINT DESCRIPTION="1-1 association with a parent annotation" STEREOTYPE="Symbolic_Association"/>
    <CONSTRAINT
        DESCRIPTION="Time alignable annotations within the parent annotation's time interval, gaps are allowed" STEREOTYPE="Included_In"/>
</ANNOTATION_DOCUMENT>
