        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a10" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>he told us only.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a11" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>Well it (bear) really likes it (red).</ANNOTATION_VALUE>
