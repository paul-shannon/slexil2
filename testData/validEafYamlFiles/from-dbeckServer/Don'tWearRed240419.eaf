                <ANNOTATION_VALUE>When we're going to go (for berries)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a9" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>My father, "Red</ANNOTATION_VALUE>
