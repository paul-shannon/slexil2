    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Gloss"
        PARENT_REF="Hul'q'umi'num'" TIER_ID="Free Translation">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a713" ANNOTATION_REF="a428">
                <ANNOTATION_VALUE>I'm going to tell you a story about Raven</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a728" ANNOTATION_REF="a714">
                <ANNOTATION_VALUE>Raven was going for a walk to visit his older sibling.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a652" ANNOTATION_REF="a430">
                <ANNOTATION_VALUE>Raven must have been walking a far distance to his older sibling's place.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a653" ANNOTATION_REF="a431">
                <ANNOTATION_VALUE>He arrived and went in
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a654" ANNOTATION_REF="a432">
                <ANNOTATION_VALUE>And he said ..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a655" ANNOTATION_REF="a433">
                <ANNOTATION_VALUE>“Walk in, Sir. Walk in, my younger sibling.Sit down over there.”</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a656" ANNOTATION_REF="a434">
                <ANNOTATION_VALUE>Eagle went and sat on his house.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2473" ANNOTATION_REF="a435">
                <ANNOTATION_VALUE>He sat looking out the middle of the water.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a658" ANNOTATION_REF="a436">
                <ANNOTATION_VALUE>After a while he said "Bring me my clothes! Bring them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a659" ANNOTATION_REF="a437">
                <ANNOTATION_VALUE>yuxwule' was given his clothes and he flew away.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a646" ANNOTATION_REF="a438">
                <ANNOTATION_VALUE>He flew away, and it wasn't very long and he returned with a spring salmon</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a660" ANNOTATION_REF="a440">
                <ANNOTATION_VALUE>It was filleted and barbecued, and as they cooked it, Raven was there.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a662" ANNOTATION_REF="a442">
                <ANNOTATION_VALUE>Cook mine like this. Don't over cook mine. Jusr a little, like tthis. Remove it. Remove it.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a663" ANNOTATION_REF="a443">
                <ANNOTATION_VALUE>They set the spring salmon aside, and Raven ate it up.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2572" ANNOTATION_REF="a444">
                <ANNOTATION_VALUE>And Raven said "I'm going home older brother. I'm going home.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2579" ANNOTATION_REF="a445">
                <ANNOTATION_VALUE>"aa! Go ahead goodbye.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2582" ANNOTATION_REF="a447">
                <ANNOTATION_VALUE>And he went home.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a664" ANNOTATION_REF="a448">
                <ANNOTATION_VALUE>When he arrived home he was lazy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2603" ANNOTATION_REF="a449">
                <ANNOTATION_VALUE>Next day Eagle said "I'm going to see Raven.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2613" ANNOTATION_REF="a450">
                <ANNOTATION_VALUE>I'm going to see how he is doing.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2618" ANNOTATION_REF="a451">
                <ANNOTATION_VALUE>aa go ahead.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2629" ANNOTATION_REF="a452">
                <ANNOTATION_VALUE>He left. His younger brother must have lived far away.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3186" ANNOTATION_REF="a453">
                <ANNOTATION_VALUE>He went traveling to his place and he went in.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3182" ANNOTATION_REF="a1134">
                <ANNOTATION_VALUE>Raven said "walk in my older brother walk in. Sit over there sit."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3188" ANNOTATION_REF="a455">
                <ANNOTATION_VALUE>And Raven decided to copy his brother so he went and sat on the roof of his house.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3261" ANNOTATION_REF="a456">
                <ANNOTATION_VALUE>And then</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3262" ANNOTATION_REF="a457">
                <ANNOTATION_VALUE>He called his children and said "Oh! Give me my clothes children give me my clothes."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3250" ANNOTATION_REF="a459">
                <ANNOTATION_VALUE>Raven disappeared. What happened to him?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3243" ANNOTATION_REF="a460">
                <ANNOTATION_VALUE>Eagle arrived to where his younger brother was and sat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3227" ANNOTATION_REF="a461">
                <ANNOTATION_VALUE>And he said "Your father is drifting along and he is getting near and he's dead. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3213" ANNOTATION_REF="a462">
                <ANNOTATION_VALUE>And he went to him and his beak was all broken up.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3214" ANNOTATION_REF="a463">
                <ANNOTATION_VALUE>He had bitten into a rock and had broken his beak.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1268" ANNOTATION_REF="a465">
                <ANNOTATION_VALUE>So they brought him home. And they got home and they were all very sad and they were very unhappy because his younger brother died</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3160" ANNOTATION_REF="a466">
                <ANNOTATION_VALUE>So [Eagle]he went on home.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3158" ANNOTATION_REF="a467">
                <ANNOTATION_VALUE>And it wasn't long after and someone appeared. holy cow. The one who died is also the one walking.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3140" ANNOTATION_REF="a3126">
                <ANNOTATION_VALUE>Unexpected, Is it you who got home?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3110" ANNOTATION_REF="a1319">
                <ANNOTATION_VALUE>“Aa! it is me.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3108" ANNOTATION_REF="a469">
                <ANNOTATION_VALUE>“Aa! I have. And  I'm going to visit your younger sibling Seal."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3107" ANNOTATION_REF="a471">
                <ANNOTATION_VALUE>[Eagle says] "Yes, go ahead."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3104" ANNOTATION_REF="a472">
                <ANNOTATION_VALUE>So Raven left to visit his sister.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1352" ANNOTATION_REF="a473">
                <ANNOTATION_VALUE>Upon arriving his sibling said "Walk in walk in!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3092" ANNOTATION_REF="a474">
                <ANNOTATION_VALUE>And he sat down and she (Seal) was saying "Bring me the dish children bring me the dish."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3094" ANNOTATION_REF="a475">
                <ANNOTATION_VALUE>So they gave her the dish.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3085" ANNOTATION_REF="a476">
                <ANNOTATION_VALUE>And Seal started warming her hands.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3078" ANNOTATION_REF="a477">
                <ANNOTATION_VALUE>And then grease started dripping from her hand.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3071" ANNOTATION_REF="a478">
                <ANNOTATION_VALUE>And it didn't take very long and the pan was full of the grease dripping from seal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2409" ANNOTATION_REF="a1433">
                <ANNOTATION_VALUE>And they took the dish and put in from of Raven, and Raven drank the grease all down really fast.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3048" ANNOTATION_REF="a480">
                <ANNOTATION_VALUE>And then he said "I guess I'd better go home."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2483" ANNOTATION_REF="a481">
                <ANNOTATION_VALUE>[Seal said] " go ahead and go."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3044" ANNOTATION_REF="a1476">
                <ANNOTATION_VALUE>When he got home he was sitting around.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1489" ANNOTATION_REF="a483">
                <ANNOTATION_VALUE>The next day Seal went to see her brother.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3011" ANNOTATION_REF="a1519">
                <ANNOTATION_VALUE>She arrived there at her brother's place, and Raven said "Come in come in and go sit over there."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2961" ANNOTATION_REF="a486">
                <ANNOTATION_VALUE>Raven says "bring the dish, bring it, and the children brought the dish over to where they were at and layed it down, and Raven decided to heat his hands </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2931" ANNOTATION_REF="a489">
                <ANNOTATION_VALUE>His hands were blistered up and burst open.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2918" ANNOTATION_REF="a490">
                <ANNOTATION_VALUE>And Seal called out "Move back , move back."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2896" ANNOTATION_REF="a492">
                <ANNOTATION_VALUE>So he moved back, and Seal went and warmed her hands.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2912" ANNOTATION_REF="a493">
                <ANNOTATION_VALUE>She filled the plate really fast with her own fat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2913" ANNOTATION_REF="a494">
                <ANNOTATION_VALUE>Raven drank it all up and went home.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1643" ANNOTATION_REF="a495">
                <ANNOTATION_VALUE>She got home and she was very sad that her brother's burned hands.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2873" ANNOTATION_REF="a496">
                <ANNOTATION_VALUE>And the next day Raven did the same thing.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2862" ANNOTATION_REF="a497">
                <ANNOTATION_VALUE>“Aa! I'm going over there.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2861" ANNOTATION_REF="a498">
                <ANNOTATION_VALUE>I'm going to walk. It's quite far where i'm going.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2860" ANNOTATION_REF="a499">
                <ANNOTATION_VALUE>He was going traveling and he knew about Deer. a big deer over at the point.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2849" ANNOTATION_REF="a500">
                <ANNOTATION_VALUE>So, the next day he left.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2847" ANNOTATION_REF="a504">
                <ANNOTATION_VALUE>And he says "I have come to see you. I have come to see you."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2848" ANNOTATION_REF="a503">
                <ANNOTATION_VALUE>Oh You have come.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
