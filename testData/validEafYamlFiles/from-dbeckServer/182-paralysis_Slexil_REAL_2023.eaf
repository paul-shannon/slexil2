    <TIER LINGUISTIC_TYPE_REF="ft" PARENT_REF="ref@AL" PARTICIPANT="AL" TIER_ID="ft@AL">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann3" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>AL: ‘I don’t know it.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann8">
                <ANNOTATION_VALUE>‘That disease, all of our body, it is my body.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann15" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>‘Traveling, (that is) where it (my body) became stiff, my joints became stiff, traveling, I did not move.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann16">
                <ANNOTATION_VALUE>‘My joints became stiff, and the doctor told me, my children know.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann27" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>‘(As) I go around like this alone, they tell me to come since then.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann28">
                <ANNOTATION_VALUE>‘(With) the strength of injection (they put into me), I (can) walk.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann39" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>AL: ‘With the strength of the injection.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann40">
                <ANNOTATION_VALUE>‘Me, my body was like that I got better. (Without the injection), people would not had seen me.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann47" ANNOTATION_REF="ann44">
                <ANNOTATION_VALUE>‘If it were not true, they would hear my name only, barely anything else (they would have not recognized me).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann55" ANNOTATION_REF="ann52">
                <ANNOTATION_VALUE>AL: ‘My children did things just like this (swiftly). I don’t know (how) they took me (to the doctor).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann59" ANNOTATION_REF="ann56">
                <ANNOTATION_VALUE>‘They did it. I don’t know. Only they know it (that I was sick).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann67" ANNOTATION_REF="ann64">
                <ANNOTATION_VALUE>‘I became like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann75" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>‘That is why I became like that now.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann79" ANNOTATION_REF="ann76">
                <ANNOTATION_VALUE>‘I am also not well. I can take some steps. They bring me here like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann83" ANNOTATION_REF="ann80">
                <ANNOTATION_VALUE>‘With the strength (of the injection), I walk, like that, even though I walk like before (with) a stick, step (by) step.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann91" ANNOTATION_REF="ann88">
                <ANNOTATION_VALUE>‘I walk like this, our father (God) gives me (the strength), I walk like this.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann99" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>‘This, however, inside my knees (is) almost dead. This did not move, it did not move. They became hard. My leg did not want to work.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann107" ANNOTATION_REF="ann104">
                <ANNOTATION_VALUE>AL: ‘He (doctor) touched my back. When I laid down, even though that one (one leg) did not move, with the strength of the injection (the leg began to move).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann111" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>‘I say, I come (for) the injection. They injected me here in the (health) center too, (they gave me) the injection.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann119" ANNOTATION_REF="ann116">
                <ANNOTATION_VALUE>‘They injected me, and the people (who were in the health center gave me) the injection. My children give me (money). They (people in the center) inject me.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann123" ANNOTATION_REF="ann120">
                <ANNOTATION_VALUE>‘People helped me a lot. I live here like these people.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann135" ANNOTATION_REF="ann132">
                <ANNOTATION_VALUE>AL: ‘Yes, I am like this, if there had been nothing, me, I would have no disease.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann143" ANNOTATION_REF="ann140">
                <ANNOTATION_VALUE>AL: ‘An evil got a hold of me.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann151" ANNOTATION_REF="ann148">
                <ANNOTATION_VALUE>AL: ‘A disease, it is like this, they say its name, I forgot everything.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann155" ANNOTATION_REF="ann152">
                <ANNOTATION_VALUE>‘That disease, they say it is like this. Yes.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann163" ANNOTATION_REF="ann160">
                <ANNOTATION_VALUE>‘It is that disease, the fever got me.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann171" ANNOTATION_REF="ann168">
                <ANNOTATION_VALUE>AL: ‘Until now I was like anyone else, even though I had bone problems.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann175" ANNOTATION_REF="ann172">
                <ANNOTATION_VALUE>‘Now I feel like a person.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann183" ANNOTATION_REF="ann180">
                <ANNOTATION_VALUE>AL: ‘Yes, it is because of that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann191" ANNOTATION_REF="ann188">
                <ANNOTATION_VALUE>AL: ‘You would have not recognized me.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann199" ANNOTATION_REF="ann196">
                <ANNOTATION_VALUE>AL: ‘You would have not recognized me, even though people too would not have recognized me, like this, like this, I went walking.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann207" ANNOTATION_REF="ann204">
                <ANNOTATION_VALUE>‘It is like that, your mother came to see me, she went one day, I was still bad.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann215" ANNOTATION_REF="ann212">
                <ANNOTATION_VALUE>‘My body was not good. When your mother came, she came, she saw me and left.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann223" ANNOTATION_REF="ann220">
                <ANNOTATION_VALUE>‘She did not tell him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann231" ANNOTATION_REF="ann228">
                <ANNOTATION_VALUE>AL: ‘She said  to me.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann251" ANNOTATION_REF="ann248">
                <ANNOTATION_VALUE>AL: ‘It was like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann259" ANNOTATION_REF="ann256">
                <ANNOTATION_VALUE>AL: ‘Yes, it is like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann267" ANNOTATION_REF="ann264">
                <ANNOTATION_VALUE>AL: ‘Yes, God made me like that and he took me like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann271" ANNOTATION_REF="ann268">
                <ANNOTATION_VALUE>‘He did not tell me like that and he took me, he brought me.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann279" ANNOTATION_REF="ann276">
                <ANNOTATION_VALUE>‘He took me, he brought me.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann287" ANNOTATION_REF="ann284">
                <ANNOTATION_VALUE>AL: ‘Yes, it is like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann295" ANNOTATION_REF="ann292">
                <ANNOTATION_VALUE>AL: ‘Ah!’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann303" ANNOTATION_REF="ann300">
                <ANNOTATION_VALUE>AL: ‘Yes, it has been like that since that time.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann311" ANNOTATION_REF="ann308">
                <ANNOTATION_VALUE>‘Since then, even though I was (sick), (I don’t know) how this disease will evolve.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann315" ANNOTATION_REF="ann312">
                <ANNOTATION_VALUE>‘You found me here, the doctor gave me the pill, then he gave me that pill.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann319" ANNOTATION_REF="ann316">
                <ANNOTATION_VALUE>‘He had given me six months of treatment. I took everything already long ago.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann327" ANNOTATION_REF="ann324">
                <ANNOTATION_VALUE>‘That is why, I don’t know where I will I get this pill.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann335" ANNOTATION_REF="ann332">
                <ANNOTATION_VALUE>‘There aren’t any downtown, either.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann343" ANNOTATION_REF="ann340">
                <ANNOTATION_VALUE>AL: ‘That pill, that pill is a different pill (to the one I usually take).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann351" ANNOTATION_REF="ann348">
                <ANNOTATION_VALUE>‘Since then, the doctor...’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann355" ANNOTATION_REF="ann352">
                <ANNOTATION_VALUE>‘He told me, he gave it to me and they don’t bring that pill here (in our village) either. There are none. It is like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann367" ANNOTATION_REF="ann364">
                <ANNOTATION_VALUE>AL: ‘These merchants they come (but) they don’t bring it here.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann375" ANNOTATION_REF="ann372">
                <ANNOTATION_VALUE>AL: ‘(They have) pills, just different ones, only different ones.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann379" ANNOTATION_REF="ann376">
                <ANNOTATION_VALUE>‘They bring so I buy it, there is a lot, mhm, they don’t have that pill, only different ones, only different ones.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann383" ANNOTATION_REF="ann380">
                <ANNOTATION_VALUE>‘They bring it, it is like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann399" ANNOTATION_REF="ann396">
                <ANNOTATION_VALUE>AL: ‘(Because) of that I was (feeling) bad.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann403" ANNOTATION_REF="ann400">
                <ANNOTATION_VALUE>‘Yes, bad, I was (feeling) bad.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann415" ANNOTATION_REF="ann412">
                <ANNOTATION_VALUE>AL: ‘Yes.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann419" ANNOTATION_REF="ann416">
                <ANNOTATION_VALUE>‘Ah!’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann427" ANNOTATION_REF="ann424">
                <ANNOTATION_VALUE>AL: ‘Ah, mm.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann443" ANNOTATION_REF="ann440">
                <ANNOTATION_VALUE>AL: ‘Ah, ah, ah!’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann447" ANNOTATION_REF="ann444">
                <ANNOTATION_VALUE>‘Her belly hurt.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann475" ANNOTATION_REF="ann472">
                <ANNOTATION_VALUE>AL: ‘Ah, ah!’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann479" ANNOTATION_REF="ann476">
                <ANNOTATION_VALUE>‘Yes.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann483" ANNOTATION_REF="ann480">
                <ANNOTATION_VALUE>‘True.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann491" ANNOTATION_REF="ann488">
                <ANNOTATION_VALUE>AL: ‘With that disease, she goes lying down.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann503" ANNOTATION_REF="ann500">
                <ANNOTATION_VALUE>AL: ‘True.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann507" ANNOTATION_REF="ann504">
                <ANNOTATION_VALUE>‘A little.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann511" ANNOTATION_REF="ann508">
                <ANNOTATION_VALUE>‘Yes.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann527" ANNOTATION_REF="ann524">
                <ANNOTATION_VALUE>AL: ‘It is like that, (with) us, old age. Disease catches up with us so quickly.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann531" ANNOTATION_REF="ann528">
                <ANNOTATION_VALUE>‘We got well soon, a while ago and we are like this.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann539" ANNOTATION_REF="ann536">
                <ANNOTATION_VALUE>AL: ‘We were lying down for a long time, we did not get well fast.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann547" ANNOTATION_REF="ann544">
                <ANNOTATION_VALUE>‘When it catches us, it catches us.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann555" ANNOTATION_REF="ann552">
                <ANNOTATION_VALUE>AL: ‘Like us, old age.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann559" ANNOTATION_REF="ann556">
                <ANNOTATION_VALUE>‘We say the disease, when it catches us, it hurts us for a moment.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann563" ANNOTATION_REF="ann560">
                <ANNOTATION_VALUE>‘Yes, it is like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann575" ANNOTATION_REF="ann572">
                <ANNOTATION_VALUE>‘That is why I do not go to the mountain, then I don’t bathe, I don’t hear (correctly).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann579" ANNOTATION_REF="ann576">
                <ANNOTATION_VALUE>‘It is like that, I live with my children, I walk a little.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann587" ANNOTATION_REF="ann584">
                <ANNOTATION_VALUE>‘Like that outside, even if I am in the mood, I don’t go far.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann599" ANNOTATION_REF="ann596">
                <ANNOTATION_VALUE>‘It is like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann611" ANNOTATION_REF="ann608">
                <ANNOTATION_VALUE>AL: ‘Yes, it is like that, yes.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
