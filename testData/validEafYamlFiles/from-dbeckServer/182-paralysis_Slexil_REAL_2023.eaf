    <TIER LINGUISTIC_TYPE_REF="ft" PARENT_REF="ref@AM" PARTICIPANT="AM" TIER_ID="ft@AM">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann32">
                <ANNOTATION_VALUE>AM: ‘It is true.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann51" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>AM: ‘It is true.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann103" ANNOTATION_REF="ann100">
                <ANNOTATION_VALUE>AM: ‘It is true.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann131" ANNOTATION_REF="ann128">
                <ANNOTATION_VALUE>AM: ‘It is true, grandmother.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann139" ANNOTATION_REF="ann136">
                <ANNOTATION_VALUE>AM: ‘That’s awful!’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann147" ANNOTATION_REF="ann144">
                <ANNOTATION_VALUE>AM: ‘It is true.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann167" ANNOTATION_REF="ann164">
                <ANNOTATION_VALUE>AM: ‘It is true.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann179" ANNOTATION_REF="ann176">
                <ANNOTATION_VALUE>AM: ‘That’s awful!’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann187" ANNOTATION_REF="ann184">
                <ANNOTATION_VALUE>AM: ‘Oh God!’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann195" ANNOTATION_REF="ann192">
                <ANNOTATION_VALUE>AM: ‘It is true.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann227" ANNOTATION_REF="ann224">
                <ANNOTATION_VALUE>AM: ‘Yes, she told met.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann235" ANNOTATION_REF="ann232">
                <ANNOTATION_VALUE>AM: ‘Yes.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann243" ANNOTATION_REF="ann240">
                <ANNOTATION_VALUE>‘"This one, my child’s godmother Agustina is a bit sick.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann247" ANNOTATION_REF="ann244">
                <ANNOTATION_VALUE>‘"You are ill", she said to me.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann255" ANNOTATION_REF="ann252">
                <ANNOTATION_VALUE>AM: ‘Damn!’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann263" ANNOTATION_REF="ann260">
                <ANNOTATION_VALUE>AM: ‘Then our God wanted it, already a bit. You recovered already.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann283" ANNOTATION_REF="ann280">
                <ANNOTATION_VALUE>AM: ‘It is true.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann291" ANNOTATION_REF="ann288">
                <ANNOTATION_VALUE>AM: ‘What a pity! but everything else is peaceful here.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann299" ANNOTATION_REF="ann296">
                <ANNOTATION_VALUE>AM: ‘Everything else is peaceful.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann339" ANNOTATION_REF="ann336">
                <ANNOTATION_VALUE>AM: ‘There are none.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann359" ANNOTATION_REF="ann356">
                <ANNOTATION_VALUE>AM: ‘Yes.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann371" ANNOTATION_REF="ann368">
                <ANNOTATION_VALUE>AM: It is true.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann391" ANNOTATION_REF="ann388">
                <ANNOTATION_VALUE>AM: ‘Look.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann395" ANNOTATION_REF="ann392">
                <ANNOTATION_VALUE>‘That (is) a bit bad, but it is true.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann411" ANNOTATION_REF="ann408">
                <ANNOTATION_VALUE>AM: ‘My grandmother Paulina also caught a disease.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann423" ANNOTATION_REF="ann420">
                <ANNOTATION_VALUE>AM: ‘Something hurt her, here, (she had) a fever, headaches, here, she vomited.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann439" ANNOTATION_REF="ann436">
                <ANNOTATION_VALUE>AM: ‘The belly, the belly ache, it got her.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann451" ANNOTATION_REF="ann448">
                <ANNOTATION_VALUE>AM: ‘Yes.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann459" ANNOTATION_REF="ann456">
                <ANNOTATION_VALUE>‘And also this one.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann463" ANNOTATION_REF="ann460">
                <ANNOTATION_VALUE>‘The fever, the fever, she had a lot of fever already on the third and fourth of the month of November.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann471" ANNOTATION_REF="ann468">
                <ANNOTATION_VALUE>‘She did not get up in December, January, February.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann487" ANNOTATION_REF="ann484">
                <ANNOTATION_VALUE>AM: ‘That disease, yes.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann495" ANNOTATION_REF="ann492">
                <ANNOTATION_VALUE>AM: ‘But now I took her to the hospital.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann499" ANNOTATION_REF="ann496">
                <ANNOTATION_VALUE>‘She already feels a little better, because she has been taking the medicine for a little while.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann515" ANNOTATION_REF="ann512">
                <ANNOTATION_VALUE>AM: ‘Yes.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann535" ANNOTATION_REF="ann532">
                <ANNOTATION_VALUE>AM: ‘Yes.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann551" ANNOTATION_REF="ann548">
                <ANNOTATION_VALUE>AM: It is true.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann603" ANNOTATION_REF="ann600">
                <ANNOTATION_VALUE>AM: ‘And now your body that is a little less sick, this is how it got.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann607" ANNOTATION_REF="ann604">
                <ANNOTATION_VALUE>‘You are going to stay outside (on the patio).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
