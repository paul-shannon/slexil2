            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann206" ANNOTATION_REF="ann204">
                <ANNOTATION_VALUE>POSS3SG–kesh.ceremony	O3SG–APPL.R–get.away–S3SG–PST	DIST.DEM=LOC=TOP</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="ft" PARENT_REF="ref@VG" PARTICIPANT="VG" TIER_ID="ft@VG">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann3" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>VG: ‘Like those who tell about that, those who tell it, those who lived before.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann7" ANNOTATION_REF="ann4">
                <ANNOTATION_VALUE>‘I am going to tell, they had it, and the reason why here they only speak Spanish.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann8">
                <ANNOTATION_VALUE>‘Some of those who go through that experience seem like they are going to do something.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann15" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>‘It seems they will do something.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann16">
                <ANNOTATION_VALUE>‘As if they were mestizos. At least you should learn a little, despite them knowing the books.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann23" ANNOTATION_REF="ann20">
                <ANNOTATION_VALUE>‘But it is in vain. Before there used to be a lagoon here.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann27" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>‘And a prankster lived there.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann28">
                <ANNOTATION_VALUE>‘He lived here only with his nine brothers.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann32">
                <ANNOTATION_VALUE>‘They lived here, in the village of “Carbón.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann39" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>‘They lived there before, they went hunting over there.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann40">
                <ANNOTATION_VALUE>‘There, to spear small ones, with a long stick.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann51" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>‘They go, come and go up like that, they come and go up with their families. They went.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann55" ANNOTATION_REF="ann52">
                <ANNOTATION_VALUE>‘They killed bobo mullet, they dried it and they brought it.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann59" ANNOTATION_REF="ann56">
                <ANNOTATION_VALUE>‘Among the brothers there was a prankster. (He told them), “Why don’t you take me too?” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann63" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>‘ “If you go, you will do something bad.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a226" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>‘ “No,” (he said).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann67" ANNOTATION_REF="ann64">
                <ANNOTATION_VALUE>‘He also had a long stick.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann71" ANNOTATION_REF="ann68">
                <ANNOTATION_VALUE>‘He had a long stick. (He told them), “I will follow you and go with you and come.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann75" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>‘(He told them), “I will follow and go with you and come.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a227" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>‘ “No, no, don’t go my brother, if you go you will do bad things, like these ones.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann79" ANNOTATION_REF="ann76">
                <ANNOTATION_VALUE>‘ “We went under (water) and came back, to the source of the river, where the tail of the mother swims,” they told him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann87" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>‘ “I want to see it immediately.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a228" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>‘ “No, we won’t take you, we won’t take you,” it is said that they told him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann91" ANNOTATION_REF="ann88">
                <ANNOTATION_VALUE>‘The people grabbed their things, they did. They left the next day. They told him at the same time.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann95" ANNOTATION_REF="ann92">
                <ANNOTATION_VALUE>‘They arrived and they fell into the source of the river already.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann99" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>‘It swam there. Only the tail of the mother was coming and going.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann103" ANNOTATION_REF="ann100">
                <ANNOTATION_VALUE>‘ “You will see a group of baby fish that were brought and taken on top of the rocks.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann107" ANNOTATION_REF="ann104">
                <ANNOTATION_VALUE>‘ “They were taking long sticks,” they told them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann111" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>‘ “Be careful, don’t impale the mother where she swims.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann115" ANNOTATION_REF="ann112">
                <ANNOTATION_VALUE>‘ “We impale the small ones.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann119" ANNOTATION_REF="ann116">
                <ANNOTATION_VALUE>‘ “No, I will impale and take the mother,” he told them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann127" ANNOTATION_REF="ann124">
                <ANNOTATION_VALUE>VG: ‘ “Why do you say that you want to impale her? You are crazy my brother,” they told him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann131" ANNOTATION_REF="ann128">
                <ANNOTATION_VALUE>‘ “Why will you impale her?” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann135" ANNOTATION_REF="ann132">
                <ANNOTATION_VALUE>‘The brothers, they say, had already taken out around ten, small ones.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann139" ANNOTATION_REF="ann136">
                <ANNOTATION_VALUE>‘Those are tame, you see. So that he (the prankster) entered and came out.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann143" ANNOTATION_REF="ann140">
                <ANNOTATION_VALUE>‘He told them, “I will impale her, I will impale her.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann147" ANNOTATION_REF="ann144">
                <ANNOTATION_VALUE>‘(It sounded,) “Chas” when he did it.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann151" ANNOTATION_REF="ann148">
                <ANNOTATION_VALUE>‘They say he covered her with his long rod and he got lost.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann155" ANNOTATION_REF="ann152">
                <ANNOTATION_VALUE>‘Wow, you see, she took him, we told them, he did not hear.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann159" ANNOTATION_REF="ann156">
                <ANNOTATION_VALUE>‘They fled, they got away and came.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann163" ANNOTATION_REF="ann160">
                <ANNOTATION_VALUE>‘The group of brothers fled, they went, came and went up, just three of them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann171" ANNOTATION_REF="ann168">
                <ANNOTATION_VALUE>VG: ‘They came and went up and spread the news there.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann175" ANNOTATION_REF="ann172">
                <ANNOTATION_VALUE>‘ “While only my brother impaled the mother, his hand almost killed her, he became crazy. Because he impaled her, he became crazy,” they told them (the villagers).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann179" ANNOTATION_REF="ann176">
                <ANNOTATION_VALUE>‘Only the prankster saw her. She took him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann183" ANNOTATION_REF="ann180">
                <ANNOTATION_VALUE>‘She took him, and she put him in her house immediately, it is said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann187" ANNOTATION_REF="ann184">
                <ANNOTATION_VALUE>‘That is true, she took him and put him away.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann191" ANNOTATION_REF="ann188">
                <ANNOTATION_VALUE>‘They say he lives there, inside that hill.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>‘She brought him to possess him. The mother of the bobo mullets said, “You, you will become the care taker of my children,” she said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann199" ANNOTATION_REF="ann196">
                <ANNOTATION_VALUE>‘She told him, they say.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann207" ANNOTATION_REF="ann204">
                <ANNOTATION_VALUE>VG: ‘He left the Kesh (ceremony), there.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
