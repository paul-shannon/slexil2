            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>O3SG–bring–Ø–put.in–S3SG–PST	bobo.mullet	POSS3SG–mother=ERG	say–O3SG–S3SG–PST	PRO2=TOP	POSS1–small	see–AG.NMLZ	MID–make–S2–FUT=FOC	say–O3SG–S3SG–PST</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
