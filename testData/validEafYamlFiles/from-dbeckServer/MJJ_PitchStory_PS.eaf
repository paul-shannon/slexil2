                <ANNOTATION_VALUE>’uy’ tthuw’nilh chumux.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a135" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>ts=kwim qwlhey’ ts=kwim=s</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a136" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>suw’ thut=s thuw’nilh, “mustimuhw ’ulh ’ul’ ’i’ nu s=ta’lus ch</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="translation" PARENT_REF="transcription" TIER_ID="morphemeGloss">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>CONJ LNK √walk DT.LNK.3FOC √walk CONJ LNK AUX then then DT	
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>√good DT.LNK.3FOC √pitch</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>make=√red √log make=√red=POS</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>AUX.N.LNK √say=POS DT.LNK.3FOC √person PST just CONN 1SG ST=spouse 2SG 
</ANNOTATION_VALUE>
