            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41"
                TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>ni’ ch tse’ hay kw’us hwahwiyum ’us ’uw’ hwi’ toothinum, tun’ni’ ’u tthu ni’ ’i’luqut tthun’ shun’tsu.
</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42"
                TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>’uw’ hay ’un’ shhwimelu tthu ni’ ’iluqut tthun’ stseelhtun.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43"
                TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>s’ulhtun ’i’ tthu kw’ikwul’shun’ tthu hwi’ meens, ’i’ tthu kesulin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44"
                TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>wire tthun’ kw’ikwul’shun’.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45"
                TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>nilh tthun’ gurdies ni’ hwakw’ulhtha’mu, ’u kw’us m’i se’t ’u kw’us tsshun’tsu.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46"
                TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>skw’ey thulh kw’us sen’hw ’uw’ tselushum’etuhw ’al’; n’an ’uw’ hwutus.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47"
                TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>nilh nu s-hul’uthutulh kw’unus hwun’ kw’ookw’i’ukwulh, tthu ni’ nu sqwul’qwul’.
</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48"
                TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>ni’ hay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="non timed" PARENT_REF="hwulmuhwqun" TIER_ID="english">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>Salmon Trolling</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>Arnold Guerin</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>August 1st, 1986
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>There were many things that you did, and many things that you used when you were trawling.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>You were always working on your spoons and bait, before you could start catching salmon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>You could not just simply drag them, your spoons—nothing will bite on them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>I just went out and bought metal,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>and made my own flashers.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>I didn’t buy those that were ready-made and being sold.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>If you could get it fixed so that salmon will bite on them, those flashers that you made yourself would always be catching salmon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>No one could beat you.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>But if you just followed along with whatever the other fishermen were buying and using, it was not very long before the salmon would quit biting on it.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a61" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>It was as though the salmon got to know it; they got educated and quit biting on it.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a62" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>I guess it’s because they see too many of one kind of flasher that is being used by those that you are trawling with.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a63" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Once you get your bait working properly, then the next step is to trawl, and to drag those flashers at the proper speed that they will flash.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>If you are too fast with your boat, if you trawl too fast, then you don’t catch fish.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>When your bait is moving differently than before because of the speed of your boat [you don’t catch anything].
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>Now, once you get the speed of your boat right, your next problem is finding the depth that the most fish are caught at.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>You are always looking around to try to find where there are the most fish, and you will trawl in that area.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Sometimes, you will catch the salmon at 40 and 50 fathoms deep, down in the water.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>And you will use 30-40 lbs. of lead before you reach where the salmon are.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>Now, if you were fishing for spring salmon and the water is deep wherever you are, you will just drop your flashers down to 50 fathoms and fish that way, when it is daytime when you are trawling.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>It is only when it is beginning to get dark, towards evening, that the spring salmon come up near the surface.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>But coho, I never got them beyond 40 fathoms in depth.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>I always got them kind of lying down in the bottom of the sea, so I looked for depths that weren’t more than 40 fathoms to trawl in.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>[Places] where there were only those little bugs that are swimming around, way down on the ground, underneath the water, that’s what they feed on.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>This is the way that I fished when I was a trawler.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>If you should reach where there’s a lot of salmon, when your rigging is good, you will be going at full tilt.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>You will get to the point when you just drop your gear down to the depth, and you can immediately feel a salmon on it.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>Sometimes, all your spoons have salmon on them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>As soon as they stop biting, you get your knife, and you start to clean what you have caught.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>There were times when you could never get a chance to eat, when you are being kept very busy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>That is the way trawling goes.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>It’s big money for you, when you use good gear.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>You don’t get much sleep when you are trawling.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>You are up at 3 o’clock in the morning, and you will go out to where you are going to trawl.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>When you are catching fish, you cannot go ashore.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>You will be trawling the whole day through.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>It’ll be only when it’s too dark that you go ashore and go up beside the buyer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>Sometimes, it’s near midnight before you are through selling, when there are a lot of boats tied up, lined up beside the buyer, ahead of you. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>When you are through selling, you will buy grub for the next day, from the place you sold your salmon to.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>That is the only store you have, the one that buys your salmon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>It’s grub and fishing gear that he sells, and your gas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>Your fishing line is a wire line.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>It is your gurdies that pull up the line for you, when you lift it up, when you catch something on the line.
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>But you cannot lift the gear by hand; it is too heavy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>That is what I used to do when I was a trawler, as I have spoken about it.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>The End</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
