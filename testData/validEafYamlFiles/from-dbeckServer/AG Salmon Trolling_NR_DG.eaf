        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>xni’ ch thuynuhw tthu sxwums tthun’ pout, ’i’ hwi’ nilh tthu shtu’es kws tl’ups tthu stseelhtun.</ANNOTATION_VALUE>
