        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>ha’ ch thuynuhw kws hwu ts’uts’um’utewut, tthu ’uw’ ’un’ swe’ ’un’ sxut’eem’ flashers, ’us ’uw’ yath ’uw’ hwu tsshan’tsu.</ANNOTATION_VALUE>
