                TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>’uwu te’ kwelh tl’hwuthamu.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>’i’ ha’ ch ’uw’ tetul’ ’al’ ’u tthu ha’kwushus tthu ’un’ ts’lhkw’ookw’i’ookw ’i’ ’uwu kws hiths ’i’ wulh kwe’tum ’u tthu stseelhtun. </ANNOTATION_VALUE>
