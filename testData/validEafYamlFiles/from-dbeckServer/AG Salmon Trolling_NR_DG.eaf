        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21"
                TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>lhuhwulhshe’ ’i’ tus xuthunlhshe’ pawun tthu shet ha’kwushuhw yelhus tusnehw ’u thu ni’ shni’s tthu stseelhtun.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22"
                TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>ha’ tl’up tthu ’u shni’ kw’us tstth’atth’uqwi’ suw’ 50 fathoms kw’us tl’itl’upstuhw tthun’ flashers, kws skweyuls kwus kw’ookw’i’ukw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23"
                TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>’uw’ hay ’u kws nem’s yu lhalhutsthut ’u kws hwune’unt-s, yelhs m’is p’kwuthut tthu stth’aqwi’.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24"
                TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>hay tthu the’wun ’uwu kws yul’ew’s xuthunlhshe’ fathom kw’unus kwan’nuhw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25"
                TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>yath ’uw’ tuw’ slhelhuq’ ’u kw’i tl’itl’up ’u thu qa’ kw’unus kwan’nuhw tthu the’wun.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26"
                TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>’uw’ hay tthu tuw’ stul’em’ ’al’ stth’ul’i’tth’kw’ shilishutum’, ni’ ’u kw’i stutes ’u tthu tumuhw ’u kw’i tl’itl’up ’u tthu qa’, ni’ s’i’lhtun’s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27"
                TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>nilh nu swe’ulh nu shtu’e kws ’een’thusulh hwun’ kw’ookw’i’ukw.
