                TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>ha’ n’an ’uw’ xwum tthun’ pout kw’us kw’ookw’i’ookw ’i’ ’uwu kw’us tsshun’tsu.</ANNOTATION_VALUE>
