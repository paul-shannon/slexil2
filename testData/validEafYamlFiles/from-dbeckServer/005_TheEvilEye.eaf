    </TIER>
    <TIER LINGUISTIC_TYPE_REF="ft" PARENT_REF="ref@JH" PARTICIPANT="JH" TIER_ID="ft@JH">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann3" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>‘For the kids, for whom I make medicine.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann7" ANNOTATION_REF="ann4">
                <ANNOTATION_VALUE>‘They call it the (evil) eye, the sick eye.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann8">
                <ANNOTATION_VALUE>‘I see two kids, their sick body, it is truly the (evil) eye.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann15" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>‘(If) it is not the (evil) eye, it is something. I look at his body. I check the whole child.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann16">
                <ANNOTATION_VALUE>‘Whether it is truly the (evil) eye or not, it is something. I check all of him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann27" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>‘His little hands, how they are moving, how they rise.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann28">
                <ANNOTATION_VALUE>‘If it turns out it is not the (evil) eye, then like that there, I check him well.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann32">
                <ANNOTATION_VALUE>‘(When) I have checked him, (if) one eye is small, the fever is making (it) hot.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann39" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>‘Truly, that one, it is already the (evil) eye.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann40">
                <ANNOTATION_VALUE>‘It grabbed the eye. Those (fever and sickness) put his eye like the evil (eye). I saw him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann47" ANNOTATION_REF="ann44">
                <ANNOTATION_VALUE>‘It happened to the child.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann51" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>‘That is why truly, it is the (evil) eye.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann55" ANNOTATION_REF="ann52">
                <ANNOTATION_VALUE>‘I say it. There, it is what I say.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann59" ANNOTATION_REF="ann56">
                <ANNOTATION_VALUE>‘This is what I say, I search for the medicine (against) the (evil) eye.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a361">
                <ANNOTATION_VALUE>‘ “It is the one you will look for and buy!” I told his father and his mother.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann63" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>‘ “The medicine you will look for.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann67" ANNOTATION_REF="ann64">
                <ANNOTATION_VALUE>‘Two eggs (that) the chickens laid.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann71" ANNOTATION_REF="ann68">
                <ANNOTATION_VALUE>‘Eggs of the homegrown type, like those two and rue.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann75" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>‘That one, it is (found) in the market.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann79" ANNOTATION_REF="ann76">
                <ANNOTATION_VALUE>‘ “There, you are going to buy it,” I tell them. It is over there that I send them like this.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann83" ANNOTATION_REF="ann80">
                <ANNOTATION_VALUE>‘A spicy drink that can be found here.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann87" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>‘They drink outside.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann91" ANNOTATION_REF="ann88">
                <ANNOTATION_VALUE>‘Like other people drink. Like the foreigners drink over there.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann95" ANNOTATION_REF="ann92">
                <ANNOTATION_VALUE>‘ “Half of it, you buy it and bring it.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann99" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>‘ “You give it to me,” I tell them. “Now, here,” they say.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann103" ANNOTATION_REF="ann100">
                <ANNOTATION_VALUE>‘It comes in a small container, its name is “Agua Florida.” It is called like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann107" ANNOTATION_REF="ann104">
                <ANNOTATION_VALUE>‘Then, it is a small container like this.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann111" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>‘ “You bring the medicine, I will make (it for) you, because it is the (evil) eye this child has in an eye.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann115" ANNOTATION_REF="ann112">
                <ANNOTATION_VALUE>‘ “Because that is the disease he has.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann119" ANNOTATION_REF="ann116">
                <ANNOTATION_VALUE>‘ “I make him the medicine,” I tell the people.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann123" ANNOTATION_REF="ann120">
                <ANNOTATION_VALUE>‘It is true, they buy and bring the medicine, I make (it for) them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann127" ANNOTATION_REF="ann124">
                <ANNOTATION_VALUE>‘First with the eggs, I rub him with that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann131" ANNOTATION_REF="ann128">
                <ANNOTATION_VALUE>‘I rub them a lot, I leave them alone.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann135" ANNOTATION_REF="ann132">
                <ANNOTATION_VALUE>‘Because today there are two, one like that, with his eye I rub him, I do it.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann139" ANNOTATION_REF="ann136">
                <ANNOTATION_VALUE>‘I rub them up to the head, (and) down, truly, down to the feet I put a lot on the lower part.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann143" ANNOTATION_REF="ann140">
                <ANNOTATION_VALUE>‘Then I repeat it, then I grab his small foot, then I bring him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann147" ANNOTATION_REF="ann144">
                <ANNOTATION_VALUE>‘I go up to the head. I do that with the egg.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann151" ANNOTATION_REF="ann148">
                <ANNOTATION_VALUE>‘There is that medicine like that. Afterwards, that rue I told him.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann155" ANNOTATION_REF="ann152">
                <ANNOTATION_VALUE>‘It is crushed, already crushed, several times, several times.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann159" ANNOTATION_REF="ann156">
                <ANNOTATION_VALUE>‘I squeeze it several times, the water, that water like I said, that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann163" ANNOTATION_REF="ann160">
                <ANNOTATION_VALUE>‘A spicy drink, over there they call it guaro. Like that, I sprinkle it with that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann167" ANNOTATION_REF="ann164">
                <ANNOTATION_VALUE>‘I did not make it, I forgot that, I make that one.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann171" ANNOTATION_REF="ann168">
                <ANNOTATION_VALUE>‘It is holy water they say. I sprinkle it with that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann175" ANNOTATION_REF="ann172">
                <ANNOTATION_VALUE>‘With the leaf, I squeeze the stick, with holy water.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann179" ANNOTATION_REF="ann176">
                <ANNOTATION_VALUE>‘I squeeze for a long time, I sprinkle it with that. I make it (stick) wet.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann183" ANNOTATION_REF="ann180">
                <ANNOTATION_VALUE>‘I sprinkle it there. I put a little bit of guaro.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann187" ANNOTATION_REF="ann184">
                <ANNOTATION_VALUE>‘To that one (child), I repeatedly make the sign of the cross. I rub them, I rub the kids with the rue.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann191" ANNOTATION_REF="ann188">
                <ANNOTATION_VALUE>‘Then I rub them for a long time. I leave them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann195" ANNOTATION_REF="ann192">
                <ANNOTATION_VALUE>‘I would do it with an egg. I do it, with this one, with rue. I do it like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann199" ANNOTATION_REF="ann196">
                <ANNOTATION_VALUE>‘With the herb that they say.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann203" ANNOTATION_REF="ann200">
                <ANNOTATION_VALUE>‘Then like this, the next day, the other people (foreigners) drink the spicy guaro, I say.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann207" ANNOTATION_REF="ann204">
                <ANNOTATION_VALUE>‘Then it was Agua Florida.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann211" ANNOTATION_REF="ann208">
                <ANNOTATION_VALUE>‘A small plate, with that I empty it, I empty it there. I sprinkle it with guaro.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann215" ANNOTATION_REF="ann212">
                <ANNOTATION_VALUE>‘Then, like this, also with the Agua Florida, I write that. I also make that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann219" ANNOTATION_REF="ann216">
                <ANNOTATION_VALUE>‘I write it, I take it, I write it, I bring it, I do it there.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann223" ANNOTATION_REF="ann220">
                <ANNOTATION_VALUE>‘It is that fire that we take out, the match as we call it.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann227" ANNOTATION_REF="ann224">
                <ANNOTATION_VALUE>‘With that I take it, I light it (guaro), I put and make (fire inside the plate with the guaro and the Agua Florida).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann231" ANNOTATION_REF="ann228">
                <ANNOTATION_VALUE>‘With the plate, I sprinkle it, I put it in water in the one I say.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann235" ANNOTATION_REF="ann232">
                <ANNOTATION_VALUE>‘This one, with the guaro, the Agua Florida, I sprinkle it, I leave it.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann239" ANNOTATION_REF="ann236">
                <ANNOTATION_VALUE>‘There I mix it, I light it on fire there.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann243" ANNOTATION_REF="ann240">
                <ANNOTATION_VALUE>‘I burn it there that one.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann247" ANNOTATION_REF="ann244">
                <ANNOTATION_VALUE>‘It is this gas that catches, like we say.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann251" ANNOTATION_REF="ann248">
                <ANNOTATION_VALUE>‘It is lit and taken out, it was lit and taken along with what got burnt.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann255" ANNOTATION_REF="ann252">
                <ANNOTATION_VALUE>‘Everything got burnt, there was no water for a little while, it got emptied to a low (level).’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann259" ANNOTATION_REF="ann256">
                <ANNOTATION_VALUE>‘With that, I sprinkle in the rue. I sprinkle it with that, I rub the children.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann263" ANNOTATION_REF="ann260">
                <ANNOTATION_VALUE>‘With that I rub them several times.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann267" ANNOTATION_REF="ann264">
                <ANNOTATION_VALUE>‘Those ones, I bathe them with that, I sprinkle them with water, and I bathe them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann271" ANNOTATION_REF="ann268">
                <ANNOTATION_VALUE>‘Because a lot of water remained, (with what) got burnt.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann275" ANNOTATION_REF="ann272">
                <ANNOTATION_VALUE>‘I do it like that, I leave the children, I do it like that, they sweat.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann279" ANNOTATION_REF="ann276">
                <ANNOTATION_VALUE>‘She covers them well, she will lay them down, their mother lays them down. There they sweat.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann283" ANNOTATION_REF="ann280">
                <ANNOTATION_VALUE>‘There it comes out of them, his (evil) eye, then (thanks to) the egg I said.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann287" ANNOTATION_REF="ann284">
                <ANNOTATION_VALUE>‘I already finished rubbing them, I leave them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann291" ANNOTATION_REF="ann288">
                <ANNOTATION_VALUE>‘Because they are already well covered, because they lay down, I tell their mother.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann295" ANNOTATION_REF="ann292">
                <ANNOTATION_VALUE>‘This egg is no longer in the water.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann299" ANNOTATION_REF="ann296">
                <ANNOTATION_VALUE>‘ “Bring half of a glass of water.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann303" ANNOTATION_REF="ann300">
                <ANNOTATION_VALUE>‘ “You bring it to put in some water.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann307" ANNOTATION_REF="ann304">
                <ANNOTATION_VALUE>‘ “The egg, break it, just splatter it,” I tell them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann311" ANNOTATION_REF="ann308">
                <ANNOTATION_VALUE>‘ “Break it, splatter it on, put it just here.” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann315" ANNOTATION_REF="ann312">
                <ANNOTATION_VALUE>‘ “Where the child sleeps there, you will put it in and put it under the child('s pillow).” ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann319" ANNOTATION_REF="ann316">
                <ANNOTATION_VALUE>‘ “That egg with the water, with the glass of water.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann323" ANNOTATION_REF="ann320">
                <ANNOTATION_VALUE>‘Truly, they do it like that there. It comes out already, the next day when they go see them.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann327" ANNOTATION_REF="ann324">
                <ANNOTATION_VALUE>‘There the eye put itself (became healthy). It is as if the (evil) eye came out from the cooked egg. It becomes healthy.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann331" ANNOTATION_REF="ann328">
                <ANNOTATION_VALUE>‘It is like half cooked, it is all ashy (rotten), the egg white.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann335" ANNOTATION_REF="ann332">
                <ANNOTATION_VALUE>‘The egg white became completely ashy.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann339" ANNOTATION_REF="ann336">
                <ANNOTATION_VALUE>‘Only the yolk, half of the yolk is that eye.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann343" ANNOTATION_REF="ann340">
                <ANNOTATION_VALUE>‘Truly, our eye is like that.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann347" ANNOTATION_REF="ann344">
                <ANNOTATION_VALUE>‘That one, here, round and small, it is inside.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann351" ANNOTATION_REF="ann348">
                <ANNOTATION_VALUE>‘That comes out like that, it is the (evil) eye.’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann359" ANNOTATION_REF="ann356">
                <ANNOTATION_VALUE>‘I heal them like that even now. ’</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
