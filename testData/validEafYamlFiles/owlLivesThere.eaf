   </TIER>
   <TIER DEFAULT_LOCALE="tr" LINGUISTIC_TYPE_REF="english" PARENT_REF="lushootseed" TIER_ID="english">
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a385" ANNOTATION_REF="a1">
            <ANNOTATION_VALUE>Owl lives there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a386" ANNOTATION_REF="a2">
            <ANNOTATION_VALUE>And Owl has Frog as a wife.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a387" ANNOTATION_REF="a3">
            <ANNOTATION_VALUE>Frog who is always in the swamp.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a4">
            <ANNOTATION_VALUE>She always makes noise. She always talks.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a389" ANNOTATION_REF="a5">
            <ANNOTATION_VALUE>Not for long have they been living there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a390" ANNOTATION_REF="a6">
            <ANNOTATION_VALUE>Owl and Frog are married.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a391" ANNOTATION_REF="a7">
            <ANNOTATION_VALUE>Then, Frog is pregnant.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a392" ANNOTATION_REF="a8">
            <ANNOTATION_VALUE>And then, she and Owl had a baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a393" ANNOTATION_REF="a9">
            <ANNOTATION_VALUE>She and Owl have a little baby boy.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a10">
            <ANNOTATION_VALUE>Frog has a baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a395" ANNOTATION_REF="a11">
            <ANNOTATION_VALUE>And then Frogs baby always cries.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a396" ANNOTATION_REF="a12">
            <ANNOTATION_VALUE>Her baby always cries.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a397" ANNOTATION_REF="a13">
            <ANNOTATION_VALUE>And then, no one can sleep while they live there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a398" ANNOTATION_REF="a14">
            <ANNOTATION_VALUE>Frogs baby always cries and cries.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a399" ANNOTATION_REF="a15">
            <ANNOTATION_VALUE>Her little baby is never quiet.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a400" ANNOTATION_REF="a16">
            <ANNOTATION_VALUE>Frog never says anything.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a401" ANNOTATION_REF="a17">
            <ANNOTATION_VALUE>She just sits there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a402" ANNOTATION_REF="a18">
            <ANNOTATION_VALUE>Her mouth just flaps.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a403" ANNOTATION_REF="a19">
            <ANNOTATION_VALUE>Her mouth just flaps.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a404" ANNOTATION_REF="a20">
            <ANNOTATION_VALUE>Her mouth is just moving fast.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a405" ANNOTATION_REF="a21">
            <ANNOTATION_VALUE>Then he is spoken to,  &quot;What is the matter with your wife that her mouth is just moving? What is the matter?&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a22">
            <ANNOTATION_VALUE>Then I guess Frog is told by Owl that she should soothe the baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a407" ANNOTATION_REF="a23">
            <ANNOTATION_VALUE>Then Frog takes her little swaddled baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a24">
            <ANNOTATION_VALUE>She has him in a cradle board.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a25">
            <ANNOTATION_VALUE>And then, she rocks him.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a26">
            <ANNOTATION_VALUE>She says to him over and over,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a27">
            <ANNOTATION_VALUE> &quot;Shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk.&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a412" ANNOTATION_REF="a28">
            <ANNOTATION_VALUE>Crow …, or what …, Frog says over and over, She says over and over,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a413" ANNOTATION_REF="a29">
            <ANNOTATION_VALUE> &quot;Shuwooluk, shuwooluk, shuwooluk.&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a414" ANNOTATION_REF="a30">
            <ANNOTATION_VALUE>She rocks her little baby, she rocks him. And she says over and over.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a415" ANNOTATION_REF="a31">
            <ANNOTATION_VALUE> &quot;Shuwooluk, shuwooluk, shuwooluk, shuwooluk.&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a32">
            <ANNOTATION_VALUE>She tries to quiet him.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a33">
            <ANNOTATION_VALUE>And Frog talks on and on too.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a34">
            <ANNOTATION_VALUE>She speaks energetically to her little baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a35">
            <ANNOTATION_VALUE>And then Frog always says over and over,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a36">
            <ANNOTATION_VALUE> &quot;Shuwooluk, shuwooluk, shuwooluk, shuwooluk shuwooluk, shuwooluk, shuwooluk.&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a37">
            <ANNOTATION_VALUE>Frog never keeps quiet.  She talks on and on.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a38">
            <ANNOTATION_VALUE>Her baby cries and cries. And then she talks some more. She will not keep quiet...</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a39">
            <ANNOTATION_VALUE>until Owl gets fed up.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a424" ANNOTATION_REF="a40">
            <ANNOTATION_VALUE>He looks at his wife.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a425" ANNOTATION_REF="a41">
            <ANNOTATION_VALUE>She just talks on and on,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a426" ANNOTATION_REF="a42">
            <ANNOTATION_VALUE> &quot;Shuwooluk, shuwooluk, shuwooluk, shuwooluk.&quot;  She sings a lullaby to the baby. What happened?</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a43">
            <ANNOTATION_VALUE>She sings to her baby, her little baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a428" ANNOTATION_REF="a44">
            <ANNOTATION_VALUE>Then Raven, well now, she is seen by Raven … .</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a429" ANNOTATION_REF="a45">
            <ANNOTATION_VALUE>He sees her.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a430" ANNOTATION_REF="a46">
            <ANNOTATION_VALUE>He sees his wife.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a431" ANNOTATION_REF="a47">
            <ANNOTATION_VALUE>Owl.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a48">
            <ANNOTATION_VALUE>He sees his wife. Then he turns his face away. Then</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a433" ANNOTATION_REF="a49">
            <ANNOTATION_VALUE>She stands up in order to try to tend to the baby they had,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a434" ANNOTATION_REF="a50">
            <ANNOTATION_VALUE>Their little baby whom she had born.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a435" ANNOTATION_REF="a51">
            <ANNOTATION_VALUE>The little baby is a little frog.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a436" ANNOTATION_REF="a52">
            <ANNOTATION_VALUE>It is a little frog.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a437" ANNOTATION_REF="a53">
            <ANNOTATION_VALUE>So, Owl goes.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a438" ANNOTATION_REF="a54">
            <ANNOTATION_VALUE>He is afraid. He is fed up. He gets scared of him (Little Frog).</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a439" ANNOTATION_REF="a55">
            <ANNOTATION_VALUE>His wife does not keep quiet.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a440" ANNOTATION_REF="a56">
            <ANNOTATION_VALUE> &quot;Make your wife stop! Why is she talking like that?&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a441" ANNOTATION_REF="a57">
            <ANNOTATION_VALUE> &quot;No. Shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk.&quot;  Frog rocks the baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a442" ANNOTATION_REF="a58">
            <ANNOTATION_VALUE>She does not keep quiet. She always talks on and on. And again she talks on and on. </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a443" ANNOTATION_REF="a59">
            <ANNOTATION_VALUE> &quot;Tend to the baby!&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a444" ANNOTATION_REF="a60">
            <ANNOTATION_VALUE>Owl flies off. He is afraid. And then he flies off.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a445" ANNOTATION_REF="a61">
            <ANNOTATION_VALUE>And he would just turn his face away over there where he alights.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a446" ANNOTATION_REF="a62">
            <ANNOTATION_VALUE>And he does it again and he goes on. He goes even farther away.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a447" ANNOTATION_REF="a63">
            <ANNOTATION_VALUE>He is afraid of his wife.  And he is afraid of their little baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a448" ANNOTATION_REF="a64">
            <ANNOTATION_VALUE>And then Owl goes far off.  He is afraid.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a449" ANNOTATION_REF="a65">
            <ANNOTATION_VALUE>And so there is his wife. And she talks on and on.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a450" ANNOTATION_REF="a66">
            <ANNOTATION_VALUE>And so suddenly Changer is traveling.  Changer arrives.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a451" ANNOTATION_REF="a67">
            <ANNOTATION_VALUE>Changer arrives. And he peeks at them as he listens to them.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a452" ANNOTATION_REF="a68">
            <ANNOTATION_VALUE> And it is said, &quot;Whats the matter with Frog? Whats the matter?&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a69">
            <ANNOTATION_VALUE> &quot;She tends to the baby. And (the baby) just doesnt quiet down.&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a454" ANNOTATION_REF="a70">
            <ANNOTATION_VALUE>What they have told her is that she and her husband Owl should quiet the baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a455" ANNOTATION_REF="a71">
            <ANNOTATION_VALUE>Owl gets scared. He went and he fled. He flew off.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a456" ANNOTATION_REF="a72">
            <ANNOTATION_VALUE>And the one who cries on and on is their baby.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a457" ANNOTATION_REF="a73">
            <ANNOTATION_VALUE>And she sings what she is saying .</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a458" ANNOTATION_REF="a74">
            <ANNOTATION_VALUE>Frog could not be quiet either. She speaks energetically. She is always talking.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a459" ANNOTATION_REF="a75">
            <ANNOTATION_VALUE>She did not shut up until Changer spoke</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a460" ANNOTATION_REF="a76">
            <ANNOTATION_VALUE> &quot;I ought to just toss this Frog into the swamp.&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a461" ANNOTATION_REF="a77">
            <ANNOTATION_VALUE>Then Changer grabs Owls wife, she has a baby,</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a462" ANNOTATION_REF="a78">
            <ANNOTATION_VALUE>She has a little baby. And then he throws her there where the water is stagnant.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a463" ANNOTATION_REF="a79">
            <ANNOTATION_VALUE>It seems there are bullrushes. It is very wet.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a464" ANNOTATION_REF="a80">
            <ANNOTATION_VALUE>There is stagnant water, and it seems that there are frogs.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a465" ANNOTATION_REF="a81">
            <ANNOTATION_VALUE>That over-turned place. What would it be called? It is a swampy place.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a466" ANNOTATION_REF="a82">
            <ANNOTATION_VALUE>Frog is thrown there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a467" ANNOTATION_REF="a83">
            <ANNOTATION_VALUE> &quot;You are just there now. What you are saying over and over will be there when the future people arrive.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a468" ANNOTATION_REF="a84">
            <ANNOTATION_VALUE> &quot;You will be saying that.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a469" ANNOTATION_REF="a85">
            <ANNOTATION_VALUE> &quot;You will not be quiet. You will talk on and on making noise when you converse.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a470" ANNOTATION_REF="a86">
            <ANNOTATION_VALUE> &quot;Shuwooluk, shuwooluk, shuwooluk, shuwooluk, shuwooluk, you will be saying when the people are near.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a471" ANNOTATION_REF="a87">
            <ANNOTATION_VALUE> &quot;This is how you will be heard.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a472" ANNOTATION_REF="a88">
            <ANNOTATION_VALUE> &quot;You will be in the swamp which is where you will be.&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a473" ANNOTATION_REF="a89">
            <ANNOTATION_VALUE>Frog along with her little baby, the little one she had born, is thrown away.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a90">
            <ANNOTATION_VALUE>Then they are tossed there. Then there they are. And Frog talked and talked.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a475" ANNOTATION_REF="a91">
            <ANNOTATION_VALUE>She talks on and on, on and on. And she makes noise in the swamp, in the bad water.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a476" ANNOTATION_REF="a92">
            <ANNOTATION_VALUE>And so that one is all right now. Frog talks and talks. &quot;You will just be a frog.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a93">
            <ANNOTATION_VALUE> &quot;You will talk and talk everywhere the ground is wet, a bullrush place.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a94">
            <ANNOTATION_VALUE> &quot;There is where you will be.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a95">
            <ANNOTATION_VALUE> &quot;It will be bad. You will be a little animal. You will be good for nothing.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a96">
            <ANNOTATION_VALUE> &quot;You will talk on and on. You are the one who will be speaking all the time.  No longer be quiet ...&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a97">
            <ANNOTATION_VALUE>&quot;And your little baby.&quot; They are thrown.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a98">
            <ANNOTATION_VALUE>Owl arrived.  He peered about.  His wife is not there.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a483" ANNOTATION_REF="a99">
            <ANNOTATION_VALUE>He just got more scared. And he went again. Owl flew off.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a484" ANNOTATION_REF="a100">
            <ANNOTATION_VALUE> &quot;Until he was made to disappear.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a485" ANNOTATION_REF="a101">
            <ANNOTATION_VALUE> &quot;No, it is better that he just become an owl, this owl.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a486" ANNOTATION_REF="a102">
            <ANNOTATION_VALUE> &quot;He will not be a person any more.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a103">
            <ANNOTATION_VALUE> &quot;He will be just a little animal. It will be night when he talks, when he makes noise.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a104">
            <ANNOTATION_VALUE> &quot;Perhaps he will forecast the weather. Perhaps good weather will come. And he will speak and speak&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a105">
            <ANNOTATION_VALUE> &quot;Owl will speak.&quot;</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a490" ANNOTATION_REF="a106">
            <ANNOTATION_VALUE> &quot;That will be his work.&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a491" ANNOTATION_REF="a107">
            <ANNOTATION_VALUE>So, there is Owl. He was tossed...</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a108">
            <ANNOTATION_VALUE>...into the brush, brush and things, the Douglas fir.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a493" ANNOTATION_REF="a109">
            <ANNOTATION_VALUE>So there was his former wife.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a494" ANNOTATION_REF="a110">
            <ANNOTATION_VALUE>Then the people are fine now.  They managed to better themselves.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a495" ANNOTATION_REF="a111">
            <ANNOTATION_VALUE>Then they have become sick and tired of the wife of Owl.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a496" ANNOTATION_REF="a112">
            <ANNOTATION_VALUE>It was the same with Owl.  He makes noise.  He makes noise.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a497" ANNOTATION_REF="a113">
            <ANNOTATION_VALUE> &quot;Children are left behind, Children are left behind.&quot; </ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a498" ANNOTATION_REF="a114">
            <ANNOTATION_VALUE>The way Owl always talks there is spoken (like that).</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a499" ANNOTATION_REF="a115">
            <ANNOTATION_VALUE>That is his language over there where he has been thrown.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a500" ANNOTATION_REF="a116">
            <ANNOTATION_VALUE>So then, there she (Frog) was. Shuwooluk, shuwooluk, shuwooluk, shuwooluk. It is in the water.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a501" ANNOTATION_REF="a117">
            <ANNOTATION_VALUE>In the bullrush places where she will be.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a502" ANNOTATION_REF="a118">
            <ANNOTATION_VALUE>That is what Owl was doing until the end.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a503" ANNOTATION_REF="a119">
            <ANNOTATION_VALUE>He simply lost his wife. He does not know...</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a504" ANNOTATION_REF="a120">
            <ANNOTATION_VALUE>...what to do to bring her back again.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a505" ANNOTATION_REF="a121">
            <ANNOTATION_VALUE>Then the people who live there are sick and tired of her.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a506" ANNOTATION_REF="a122">
            <ANNOTATION_VALUE>She is too talkative. The people could not sleep.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a507" ANNOTATION_REF="a123">
            <ANNOTATION_VALUE>This is why Frog is the way she is now. Only in that bad bullrush place.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a508" ANNOTATION_REF="a124">
            <ANNOTATION_VALUE>There are the noises that Frog makes, her chatter when she is in the place where she chatters.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a509" ANNOTATION_REF="a125">
            <ANNOTATION_VALUE>She will talk and talk and talk and talk! They will make noise everywhere</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a510" ANNOTATION_REF="a126">
            <ANNOTATION_VALUE>in the brush, where the land is wet, where the bullrush are in the bad lands.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a511" ANNOTATION_REF="a127">
            <ANNOTATION_VALUE>That is the end. That is the end of the traditional story about Frog and Owl, her husband.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
      <ANNOTATION>
         <REF_ANNOTATION ANNOTATION_ID="a512" ANNOTATION_REF="a128">
            <ANNOTATION_VALUE>Her husband was Owl.</ANNOTATION_VALUE>
         </REF_ANNOTATION>
      </ANNOTATION>
   </TIER>
   <LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="speech" TIME_ALIGNABLE="true"/>
   <LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="morphemes" TIME_ALIGNABLE="false"/>
   <LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="morphemeGloss" TIME_ALIGNABLE="false"/>
   <LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="english" TIME_ALIGNABLE="false"/>
   <LOCALE LANGUAGE_CODE="tr" VARIANT="STANDARD"/>
   <LOCALE LANGUAGE_CODE="en" VARIANT="ASCII"/>
</ANNOTATION_DOCUMENT>
