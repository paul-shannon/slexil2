    <TIER LINGUISTIC_TYPE_REF="ot" PARENT_REF="ref@FcM"
        PARTICIPANT="FcM" TIER_ID="ot@FcM">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3809" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>V1: así, contar a ese / V2: Así, contar eso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3810" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>lo que fue la abeja y el picure</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3811" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>el picure era como su suegra</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3812" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>la abeja como su nuera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3813" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>Como awadudui, estaba casada con Awadudui.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3814" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>Ahí fueron a buscar yuca, la picura, la abeja, en el conuco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3815" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>Por allá, ella la abeja fue enseguida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3816" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>La abeja sacó dos tuberculos de yuca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3817" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>Dos, dos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3818" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>sí, su tuberculo, se lo trajo aquí, no en la cesta, aquí mismito</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3819" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>Se lo trajo aquí, no en la cesta, aquí mismito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3820" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Es por eso que la abeja lleva ahí mismo, eso, lo que hace para su miel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3821" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>Todavía aquí en su brazo lo pega.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3822" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>Ella se fue, aquella,§ la picure se fue por allá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3823" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Su suegra estaba sacando (la yuca) en el medio del conuco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3824" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Así, mientras ella estaba allá, ella se vino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3825" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>Con ese tuberculo,§ la dejó allá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3826" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>Lo puso allí en la kanawa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3827" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Eso se puso grande (mucho).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3828" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Lo que era dos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3829" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>El nombre del picure era "Manawa".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3830" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>El nombre de la abeja era Tajööju.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3831" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Es porque ella lo llevo en su brazo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3832" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>Ahí llegó ella (la picure).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3833" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>Tarde§ como a medio día, así dice ye'kwana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3834" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Ahí llegó ella la picure.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3835" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>Con yuca, así mucho (bastante yuca).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3836" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>Ella ya en masa, ella.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3837" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>Lo puso en dos sebucanes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3838" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>Ya había hecho la bebida (kushi) ella misma, la abeja misma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3839" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Lo había hecho rico (dulce), como si fuera con azúcar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3840" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>V1: Eso, para enjuagar la boca [era] aparte./ V2: Eso... el enjuague para la boca estaba aparte...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3841" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>V1: enjuagar la boca también era rico/ V2: El enjuage de boca también era rico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3842" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>Así soltó (puso) su cesta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="ot" PARENT_REF="ref@Anl"
        PARTICIPANT="Anl" TIER_ID="ot@Anl">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3892" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>¿Tubérculo de yuca?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3893" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>¿Hasta ahora?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3894" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>¿su suegra?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3895" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>¿Lo que era dos?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3896" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>Manawa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3897" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>Tajööju</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="ft" PARENT_REF="ref@FcM"
        PARTICIPANT="FcM" TIER_ID="ft-en@FcM">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3916" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>The story of that is like that then,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3917" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>the past living of Agouti and Bee.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3918" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>She was her mother-in-law, Agouti.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3919" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>Bee was her daughter in law.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3920" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>She was (married) as Awadudui... as... with Awadudui.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3921" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>At that moment they went to look for manioc, Agouti, Bee, in the garden.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3922" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>There, in a swift, she cam.... went... was going back and forth, Bee.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3923" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>Bee took out only two manioc tubers,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3924" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>Two, two.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3925" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>Yes, its tubers.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3926" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>She brought it here (on arms), not only in the basket then, exactly here.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3927" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>That is why the bee carries it precisely there then, that, the thing she does for honey.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3928" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>Yes, she still sticks it on her arms, here.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3929" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>She went that one (I mentioned) then.§ Agouti went there. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3930" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Her mother-in-law was harvesting it in the middle of the garden then.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3931" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Thus, (while) still being there, she arrived again then,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3932" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>Loaded with that tuber.§ She unloaded then there.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3933" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>She put it there inside the canoe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3934" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Um, it became big (lots) then.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3935" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>That which was two.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3936" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>Her name was, Agouti's name, "Manawa".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3937" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>The name of Bee was then "Tajööjü",</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3938" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Um, because she carried it on her own arms, it is said.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3939" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>At that moment, she (Agouti) arrived then,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3940" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>Late, (the sun) was here.§ "It being after noon", it is said (in) Ye'kwana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3941" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>At that moment she arrived, Agouti,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3942" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>Loaded with this much manioc.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3943" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>That was poured then. Two...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3944" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>That filled two manioc presses.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3945" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>She also had also prepared the drink then, Bee also.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3946" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>She had prepared it tasty, it is said, as if it had sugar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3947" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>That, the mouth rinse was also on the side then.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3948" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>The mouth rinse was also tasty.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3949" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>Thus she let it go then, her own basket.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="ft" PARENT_REF="ref@Anl"
        PARTICIPANT="Anl" TIER_ID="ft-en@Anl">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3999" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Manioc tubers?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4000" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>Currently?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4001" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>Her mother-in-law?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4002" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>That which was two?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4003" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>Manawa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4004" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>Tajööju.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="tx" PARENT_REF="ref@FcM"
        PARTICIPANT="FcM" TIER_ID="tx@FcM">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4023" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>Mödöje, mödö ekammajötüdü yawö,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4024" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>akudi akkö wanö yeijü'komo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4025" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>Yo'jüdüje küna'jaakö tüwü, akudi...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4026" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>wanö ijadanüje.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4027" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>Awaduduije, Awadudui j- Awadudui jadö küna'jaakö.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4028" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>Yaawö öömiche küntööjö'a'to, akudi, wanö, kiyedaka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4029" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>inña, a'ye küney- küntömö, küntööjö'aakö tüwü, wanö.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4030" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>aakömma wanö... kiyede munu kunu'kwai.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4031" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>Aakö, aakö.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4032" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>Ee, yumunu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4033" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>Eetö künnejö yaawö, wüwaka'damma yaawö, eetöösamma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4034" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Yööje yeijökkö möötö denña wanö nadöa yaawö, iyö, tüweukuduije nüdüaadü.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4035" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>Ee, tajödüjökkö denña eetö, ñaajoijodü.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4036" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>Tüwü küntömö yaawö ñöödö,§ akudi küntömö unwa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4037" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Yo'jüdü, Kiyede annawööne kunu'kwaakö yaawö.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4038" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Yööje... inña... yeichü denña künejö denña tüwü yaawö.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4039" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>Iyö yumunu'kö ya'me yaawö,§ künö'düi yaawö inña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4040" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>Yöötö kanaawaka künnüi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4041" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Iyö, ajo'jo künö'düi yaawö.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4042" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Aakoto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4043" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>Chöötü küna'jaakö tüwü... akudi etü, "Manawa".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4044" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>Tüw- tüwü wanö etü küna'jaakö yaawö, Tajööju.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4045" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Iyö, tajödüjo adö'jüdü weijökkö, ke.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4046" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>Yaawö, künö'düi tüwü yaawö.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4047" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>Ökude eetö yeichü.§ Önunnake yei'jüje yeichü, ke, ye'kwana a'deddu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4048" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Yaawö künö'düi tüwü, akudi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4049" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>Kiyede ya'me edöje insho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4050" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>Tüwü ta'kajö'e tüwü yaawö, aakö...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4051" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>Aakö tünküi künenüntöi iyö.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4052" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>Kusshi künnüi chenña tüwümmaja yaawö. Wanömmaja.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4053" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Kaado küna'jaakö inñüdü ke, asuka'jaano wa'kö.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4054" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>Iyö... yentatütojo addödömmaja yaawö...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4055" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>Kaadommaja yentatü'tojo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4056" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>Yööje kunummichai yaawö. Tüuwadü.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
