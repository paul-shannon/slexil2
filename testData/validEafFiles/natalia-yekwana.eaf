        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>yööje yeijökkö möötödenña wanö nadöa yaawö iyö tüweukuduije  (tö'kudui) nüdüaadü</ANNOTATION_VALUE>
