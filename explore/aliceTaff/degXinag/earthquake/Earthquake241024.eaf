        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190"
                TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>'Ngo, gits'i duxt'anh,' xiłne tux,</ANNOTATION_VALUE>
