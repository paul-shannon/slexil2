        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183"
                TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>Q'idughitux xiłdi yuxudz, getiy gho gits'i dixit'anh tux,</ANNOTATION_VALUE>
