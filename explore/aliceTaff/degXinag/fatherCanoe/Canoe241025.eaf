        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>Mom then, "Right here we'll make fire.</ANNOTATION_VALUE>
