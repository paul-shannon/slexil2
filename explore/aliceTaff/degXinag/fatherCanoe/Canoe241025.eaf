        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>Tea we'll drink," she says.</ANNOTATION_VALUE>
