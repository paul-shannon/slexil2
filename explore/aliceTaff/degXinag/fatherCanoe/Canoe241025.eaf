        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>So then at the shore we stop.</ANNOTATION_VALUE>
