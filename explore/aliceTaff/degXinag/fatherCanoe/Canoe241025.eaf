            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>My father then, in that canoe,</ANNOTATION_VALUE>
