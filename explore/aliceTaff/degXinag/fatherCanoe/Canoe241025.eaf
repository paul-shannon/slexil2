        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>place where she'll make fire.</ANNOTATION_VALUE>
