CODE_ROOT=/Users/paul/github/slexil2
LANGUAGE = tlingit
HELP_FILE = ../help-tlingit.html
HELP_BUTTON_LABEL = "How To"
HOST = https://slexildata.artsrn.ualberta.ca
SCP_HOST = ptshannon@10.194.218.48

default:
	@echo eafStructure
	@echo movieCurl
	@echo movieScp
	@echo venv
	@echo checkTimes
	@echo removeSpeakerIDs
	@echo html
	@echo s2h
	@echo e2s2h
	@echo publish
	@echo publish-alberta
	@echo view
	@echo viewRemote
	@echo eafscp
	@echo update

venv:
	@echo source $(CODE_ROOT)/py3119slexil/bin/activate

eafStructure:
	python -i $(CODE_ROOT)/utils/eafStructure.py --eaf $(EAF)

movieCurl:
	curl -I $(HOST)/$(LANGUAGE)/$(VID)

movieScp:
	scp $(VID) $(SCP_HOST):$(LANGUAGE)
	
checkTimes:
	python  $(CODE_ROOT)/utils/eafCheck.py --eaf $(EAF) --times

e2s:
	python /Users/paul/github/slexil2/utils/eaf2sfmt.py --eaf $(EAF) --title $(TITLE) --outputDir .

removeSpeakerIDs:
	python /Users/paul/github/slexil2/utils/removeSpeakerIDs.py $(SFMT.FILE)

s2h:
	python /Users/paul/github/slexil2/utils/sfmt2html.py \
       --sfmt $(SFMT.FILE) \
       --htmlFile $(HTML.FILE) \
       --pageTitle $(TITLE) \
       --helpFile $(HELP_FILE) \
       --helpButtonLabel $(HELP_BUTTON_LABEL) \
       --outputDir .
#       --verbose \


e2s2h:
	python /Users/paul/github/slexil2/utils/eaf2sfmt2html.py \
       --eaf $(EAF) \
       --html $(HTML.FILE) \
       --pageTitle $(TITLE) \
       --helpFile $(HELP_FILE) \
       --helpButtonLabel $(HELP_BUTTON_LABEL) \
       --fixOverlappingTimeSegments \
       --outputDir .



html:
	python $(CODE_ROOT)/utils/eaf2html.py  \
	                     --eaf $(EAF) \
                        --tierGuide ../tierGuide.yaml \
                        --helpFile $(HELP_FILE) \
                        --helpButtonLabel $(HELP_BUTTON_LABEL) \
                        --pageTitle $(TITLE) \
                        --verbose \
                        --fixOverlappingTimeSegments \
	                     --fontSizeControls

publish-alberta:
	scp $(HTML.FILE) pshannon@206.12.95.4:www/$(LANGUAGE)/$(HTML.FILE)

publish:
	scp $(HTML.FILE) $(SCP_HOST):$(LANGUAGE)/$(HTML.FILE)

view:
	open $(HTML.FILE)

viewRemote:
	open $(HOST)/$(LANGUAGE)/$(HTML.FILE)

eafscp:
	scp $(EAF) pshannon@206.12.95.4:www/$(LANGUAGE)/eaf/

publish-uas:
	scp $(HTML.FILE) ptshannon@10.194.218.48:tlingit/

update:  e2s2h removeSpeakerIDs s2h publish-uas viewRemote

