CODE_ROOT=/Users/paul/github/slexil2
LANGUAGE = tlingit
HELP_FILE = ../help-tlingit.html
HELP_BUTTON_LABEL = "How To"

default:
	@echo eafStructure
	@echo movieCurl
	@echo scp
	@echo venv
	@echo checkTimes
	@echo removeSpeakerIDs
	@echo html
	@echo s2h
	@echo e2s2h
	@echo publish
	@echo view
	@echo viewRemote
	@echo eafscp

venv:
	@echo source $(CODE_ROOT)/py3105slexil/bin/activate

eafStructure:
	python -i $(CODE_ROOT)/utils/eafStructure.py --eaf $(EAF)

movieCurl:
	curl -I https://slexildata.artsrn.ualberta.ca/$(LANGUAGE)/$(VID)

scp:
	scp $(VID) pshannon@206.12.95.4:www/$(LANGUAGE)
	
checkTimes:
	python  $(CODE_ROOT)/utils/eafCheck.py --eaf $(EAF) --times

e2s:
	python /Users/paul/github/slexil2/utils/eaf2sfmt.py --eaf $(EAF) --title $(TITLE) --outputDir .

removeSpeakerIDs:
	python /Users/paul/github/slexil2/utils/removeSpeakerIDs.py $(SFMT.FILE)

s2h:
	python /Users/paul/github/slexil2/utils/sfmt2html.py \
       --sfmt $(SFMT.FILE) \
       --htmlFile $(HTML.FILE) \
       --verbose \
       --pageTitle $(TITLE) \
       --helpFile $(HELP_FILE) \
       --helpButtonLabel $(HELP_BUTTON_LABEL) \
       --outputDir .

e2s2h:
	python /Users/paul/github/slexil2/utils/eaf2sfmt2html.py \
       --eaf $(EAF) \
       --html $(HTML.FILE) \
       --pageTitle $(TITLE) \
       --helpFile $(HELP_FILE) \
       --helpButtonLabel $(HELP_BUTTON_LABEL) \
       --fixOverlappingTimeSegments \
       --outputDir .



html:
	python $(CODE_ROOT)/utils/eaf2html.py  \
	                     --eaf $(EAF) \
                        --tierGuide ../tierGuide.yaml \
                        --helpFile $(HELP_FILE) \
                        --helpButtonLabel $(HELP_BUTTON_LABEL) \
                        --pageTitle $(TITLE) \
                        --verbose \
                        --fixOverlappingTimeSegments \
	                     --fontSizeControls

publish:
	scp $(HTML.FILE) pshannon@206.12.95.4:www/$(LANGUAGE)/$(HTML.FILE)

view:
	open $(HTML.FILE)

viewRemote:
	open https://slexildata.artsrn.ualberta.ca/$(LANGUAGE)/$(HTML.FILE)

eafscp:
	scp $(EAF) pshannon@206.12.95.4:www/$(LANGUAGE)/eaf/