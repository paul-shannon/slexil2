                TIME_SLOT_REF1="ts739" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>Three days áwé yéi kdunéix̱ch ḵaa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331"
                TIME_SLOT_REF1="ts741" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>ḵaa yakg̱wahéiyagu áyá tle haa x̱óo yéi yatee. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332"
                TIME_SLOT_REF1="ts743" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>A áwé,</ANNOTATION_VALUE>
