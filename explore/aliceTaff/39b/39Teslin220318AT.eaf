        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1668"
                TIME_SLOT_REF1="ts765" TIME_SLOT_REF2="ts766">
                <ANNOTATION_VALUE>I can remember</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
