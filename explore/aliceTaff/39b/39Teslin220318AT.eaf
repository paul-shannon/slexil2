        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1661"
                TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>they believe in it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311"
                TIME_SLOT_REF1="ts693" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>I used to hear it, ax̱ tláa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312"
                TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>«Áyú neek gax̱du.aax̱í</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313"
                TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>tle ha' yéi haa daa aḵaach, wé x̱'aan tle duwa.aax̱ch.»</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314"
                TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>Du áan du neejí </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315"
                TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts702">
                <ANNOTATION_VALUE>Aaá</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316"
                TIME_SLOT_REF1="ts703" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>Aag̱áa ax̱ tláa yei haa daayaḵá, «Tlél ayáx̱ awé ustí.»</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317"
                TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>Tle tsu sakwnéin,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318"
                TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>déi yan adaanéiyi yan yila.átgin kaadéi yéi adaané.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319"
                TIME_SLOT_REF1="ts709" TIME_SLOT_REF2="ts710">
                <ANNOTATION_VALUE>Really dulg̱aas'. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320"
                TIME_SLOT_REF1="ts711" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>Wéi Lingít ḵustuyáx̱ aas áwé</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1662"
                TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>yéi yu dleit ḵáa ḵa Lingít,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321"
                TIME_SLOT_REF1="ts715" TIME_SLOT_REF2="ts716">
                <ANNOTATION_VALUE>ch'a tliyéix' yéi daadunéit. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
