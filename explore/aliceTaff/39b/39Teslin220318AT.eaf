                TIME_SLOT_REF1="ts749" TIME_SLOT_REF2="ts750">
                <ANNOTATION_VALUE>Yéi áwé duwasáakw,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336"
                TIME_SLOT_REF1="ts751" TIME_SLOT_REF2="ts752">
                <ANNOTATION_VALUE>G̱an Nana Héeni.</ANNOTATION_VALUE>
