                TIME_SLOT_REF1="ts823" TIME_SLOT_REF2="ts824">
                <ANNOTATION_VALUE>tle hú áwé ḵumdzitee. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1680"
                TIME_SLOT_REF1="ts825" TIME_SLOT_REF2="ts827">
                <ANNOTATION_VALUE>We see it. Thereʼs lots of</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363"
                TIME_SLOT_REF1="ts826" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>ax̱ x̱oonx'i ín,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364"
                TIME_SLOT_REF1="ts829" TIME_SLOT_REF2="ts830">
                <ANNOTATION_VALUE>toositeen tsú</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1681"
                TIME_SLOT_REF1="ts831" TIME_SLOT_REF2="ts832">
                <ANNOTATION_VALUE>like her.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1682"
                TIME_SLOT_REF1="ts833" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>We really believe in it strong.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365"
                TIME_SLOT_REF1="ts835" TIME_SLOT_REF2="ts836">
                <ANNOTATION_VALUE>Ḵux̱dugútch lingít.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1683"
                TIME_SLOT_REF1="ts837" TIME_SLOT_REF2="ts838">
                <ANNOTATION_VALUE>The reincarnated.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366"
                TIME_SLOT_REF1="ts839" TIME_SLOT_REF2="ts840">
                <ANNOTATION_VALUE>Ḵaa saayí tsú tle ḵa wé s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
