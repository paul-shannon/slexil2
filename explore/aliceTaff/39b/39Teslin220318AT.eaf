                TIME_SLOT_REF1="ts767" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>ax̱ sánee</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343"
                TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>Yeil Naawú,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1669"
                TIME_SLOT_REF1="ts771" TIME_SLOT_REF2="ts772">
                <ANNOTATION_VALUE>When one of our people died, they take them to the church. Then they take them and they take them to the graveyard.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344"
                TIME_SLOT_REF1="ts773" TIME_SLOT_REF2="ts774">
                <ANNOTATION_VALUE>Aax̱ áwé, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1670"
                TIME_SLOT_REF1="ts775" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>before they move it from that first, the grave site,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345"
                TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>áwé has adatínch</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346"
                TIME_SLOT_REF1="ts779" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>ayá yéede aduténsyin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347"
                TIME_SLOT_REF1="ts781" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>Am, ax̱ sánee, Yeil Naawú, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348"
                TIME_SLOT_REF1="ts783" TIME_SLOT_REF2="ts784">
                <ANNOTATION_VALUE>du x̱ooní áwé yéi woonei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1671"
                TIME_SLOT_REF1="ts785" TIME_SLOT_REF2="ts786">
                <ANNOTATION_VALUE>And he could always remember his speech.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349"
                TIME_SLOT_REF1="ts787" TIME_SLOT_REF2="ts788">
                <ANNOTATION_VALUE>Ax̱ sánee,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1672"
                TIME_SLOT_REF1="ts789" TIME_SLOT_REF2="ts790">
                <ANNOTATION_VALUE>w hen he made that speech. Everybody was sorry. I was. And then when he made that speech he said, "Thatʼs the Beaver Clan people. And the beaver, he was tired. He worked hard. His home was overcrowded. And thatʼs why he swam out and he swam out and he went down to there</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350"
                TIME_SLOT_REF1="ts791" TIME_SLOT_REF2="ts792">
                <ANNOTATION_VALUE>Anana Héeni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1673"
                TIME_SLOT_REF1="ts793" TIME_SLOT_REF2="ts794">
                <ANNOTATION_VALUE>So heʼs free out again and heʼs happy. When he said that speech and I really felt good over it again. I think, I think, ah, that person, his spirit, thatʼs where it is. And if everybody else felt good when he made that speech, Uncle Tom, how he told it. And the same way they did with the Eagle, you know, our Eagle people. They made that speech before they moved the coffin out. He was tired and he was just tired from being on Earth. His kids were taking over and he wanted peace and quiet. So he flew out to the horizon. When you say it in Tlingit itʼs, itʼs just beautiful. Thatʼs ??? ways and we really </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351"
                TIME_SLOT_REF1="ts795" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE> Uháan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1675"
                TIME_SLOT_REF1="ts797" TIME_SLOT_REF2="ts798">
                <ANNOTATION_VALUE>We really {breath} believe (in)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352"
                TIME_SLOT_REF1="ts799" TIME_SLOT_REF2="ts800">
                <ANNOTATION_VALUE>ḵux̱dugútch lingít.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353"
                TIME_SLOT_REF1="ts801" TIME_SLOT_REF2="ts802">
                <ANNOTATION_VALUE>Ḵaa saayí.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354"
                TIME_SLOT_REF1="ts803" TIME_SLOT_REF2="ts804">
                <ANNOTATION_VALUE>Héit.aa lingít,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355"
                TIME_SLOT_REF1="ts805" TIME_SLOT_REF2="ts806">
                <ANNOTATION_VALUE>ḵux̱wudigút áwé lingít. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1676"
                TIME_SLOT_REF1="ts807" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>She used to, we lost her when the highway first come throug̱h. She was a nurse to other people. Everybody had the measles and everything. Young girl, she was about 22, 23 years old.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356"
                TIME_SLOT_REF1="ts809" TIME_SLOT_REF2="ts810">
                <ANNOTATION_VALUE>Á áwé. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1677"
                TIME_SLOT_REF1="ts811" TIME_SLOT_REF2="ts812">
                <ANNOTATION_VALUE>She picked up that</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357"
                TIME_SLOT_REF1="ts813" TIME_SLOT_REF2="ts814">
                <ANNOTATION_VALUE>wunéekw tle,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358"
                TIME_SLOT_REF1="ts815" TIME_SLOT_REF2="ts816">
                <ANNOTATION_VALUE>tle ash woodlaaḵ. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359"
                TIME_SLOT_REF1="ts817" TIME_SLOT_REF2="ts818">
                <ANNOTATION_VALUE>Tle ayéi haa jee yéi woonee. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360"
                TIME_SLOT_REF1="ts819" TIME_SLOT_REF2="ts820">
                <ANNOTATION_VALUE>A eetí dáx̱ gushé haa anáḵ dul.áan haa eetí dáx̱ du tlaa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361"
                TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts822">
                <ANNOTATION_VALUE>Du tláa, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
