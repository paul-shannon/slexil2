        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1667"
                TIME_SLOT_REF1="ts761" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>Itʼs so swift, that water, you canʼt come back up it again. And thatʼs where the spirit goes down the river.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341"
                TIME_SLOT_REF1="ts763" TIME_SLOT_REF2="ts764">
                <ANNOTATION_VALUE>Uháan,</ANNOTATION_VALUE>
