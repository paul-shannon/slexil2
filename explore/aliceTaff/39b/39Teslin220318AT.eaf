        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1664"
                TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts728">
                <ANNOTATION_VALUE>Play it cool til that person is buried. And then itʼs finished.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327"
                TIME_SLOT_REF1="ts729" TIME_SLOT_REF2="ts730">
                <ANNOTATION_VALUE>Aag̱áa áwé dikée yéi ananeich. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1665"
                TIME_SLOT_REF1="ts731" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>We can do anything then.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328"
                TIME_SLOT_REF1="ts733" TIME_SLOT_REF2="ts734">
                <ANNOTATION_VALUE>Yan ḵaa, </ANNOTATION_VALUE>
