        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a918" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>Respecting each other is priceless is what the elderly people used to say long ago.</ANNOTATION_VALUE>
